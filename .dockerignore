# ════════════════════════════════════════════════════════════════════════════════
# DOCKERIGNORE - Files excluded from Docker build context
# ════════════════════════════════════════════════════════════════════════════════
# This reduces build context size, improves build speed, and minimizes image bloat.

# Node.js
node_modules
npm-debug.log
npm-error.log
yarn-error.log
.npm
.eslintcache
# Note: package-lock.json should NOT be ignored for reproducible builds

# Version Control
.git
.gitignore
.github
.gitattributes

# IDE/Editor
.vscode
.idea
*.swp
*.swo
*.orig
*.code-workspace
.DS_Store
Thumbs.db
.env.local
.env.*.local

# Build/Dist
dist
build
coverage
.next
out

# Runtime/Temp
data
public/uploads
uploads
temp*.js

# Documentation (keep out of image)
*.md
ANALISIS_*.md
ARREGLOS_*.md
AUDITORIA_*.md
CAMBIOS_*.md
CORRECCIONES_*.md
DESCUENTOS_*.md
FASE_*.md
FLUJO_*.md
GUIA*.md
IMPLEMENTACION_*.md
IMPLEMENTATION_*.md
MANUAL_*.md
MEJORAS_*.md
MODAL_*.md
NUEVO_*.md
PROJECT_*.md
PROYECTO_*.md
QUICK_*.md
README_*.md
RESUMEN_*.md
SESSION_*.md
SISTEMA_*.md
VERIFICACION_*.md

# Config files not needed in image
.dockerignore
.editorconfig
.prettierrc
Procfile
render.yaml
vercel.json

# Test directories (exclude tests but include spec for API docs)
test
tests
__tests__

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
