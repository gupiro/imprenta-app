# .env.example - Copy to .env and fill in your values
# DO NOT commit .env file to git - use this as a template

# Session Configuration
# Use a strong random string in production (at least 32 characters)
SESSION_SECRET=your_secret_key_here_change_in_production

# Database
DB_PATH=./imprenta.db

# Port
PORT=3000

# Node Environment
NODE_ENV=development
