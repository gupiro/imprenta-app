# ENVIRONMENT VARIABLES - Copy to .env.production for Render deployment
# Never commit actual secrets to git!

# ═══════════════════════════════════════════════════════════════
# Session Configuration
# ═══════════════════════════════════════════════════════════════
# IMPORTANT: Generate a random string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_here_min_32_chars

# ═══════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════
# For LOCAL DEVELOPMENT (localhost):
#   DB_FILE=./imprenta.db
#
# For RENDER DEPLOYMENT:
#   Set DATABASE_URL environment variable in Render dashboard
#   Format: /opt/render/project/src/imprenta.db
#   (Render will set this automatically for persistent disk)
#   Do NOT set DB_FILE when DATABASE_URL is present

# DB_FILE=./imprenta.db
DATABASE_URL=/opt/render/project/src/imprenta.db

# ═══════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
# Anthropic API Configuration
# ═══════════════════════════════════════════════════════════════
# Get your API key from: https://console.anthropic.com/account/keys
# IMPORTANT: Never commit real keys! Set only in Render environment variables
ANTHROPIC_API_KEY=your_actual_anthropic_api_key_here

# ═══════════════════════════════════════════════════════════════
# Render-Specific Configurations
# ═══════════════════════════════════════════════════════════════
# RENDER=true
# RENDER_ENVIRONMENT_SLUG=production
