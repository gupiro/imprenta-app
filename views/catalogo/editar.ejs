<!-- views/catalogo/editar.ejs -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>✏️ Editar Producto del Catálogo</h2>
    <a href="/catalogo" class="btn btn-outline-secondary">← Volver</a>
  </div>

  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-danger"><%= Array.isArray(error) ? error.join('<br>') : error %></div>
  <% } %>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <form action="/catalogo/editar/<%= producto.id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="row">
              <div class="col-md-8 mb-4">
                <label for="nombre" class="form-label fw-bold">Nombre del Producto *</label>
                <input type="text" id="nombre" name="nombre" class="form-control" required
                       value="<%= producto.nombre %>" placeholder="Ej: Lona estándar">
              </div>
              <div class="col-md-4 mb-4">
                <label for="codigo" class="form-label fw-bold">Código *</label>
                <input type="text" id="codigo" name="codigo" class="form-control" required
                       value="<%= producto.codigo %>" placeholder="Ej: 001-T">
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-4">
                <label for="tipo" class="form-label fw-bold">Tipo de Cálculo *</label>
                <select id="tipo" name="tipo" class="form-select" required>
                  <option value="">-- Seleccionar --</option>
                  <option value="lona" <%= producto.tipo === 'lona' ? 'selected' : '' %>>📐 Lona (m²)</option>
                  <option value="fotocopia" <%= producto.tipo === 'fotocopia' ? 'selected' : '' %>>📄 Fotocopia (unidades)</option>
                  <option value="impresion" <%= producto.tipo === 'impresion' ? 'selected' : '' %>>🖨️ Impresión (unidades)</option>
                  <option value="otro" <%= producto.tipo === 'otro' ? 'selected' : '' %>>📦 Otro (unidades)</option>
                </select>
              </div>
              <div class="col-md-6 mb-4">
                <label for="precio_base" class="form-label fw-bold">Precio Base ($) *</label>
                <input type="number" id="precio_base" name="precio_base" step="0.01" min="0" 
                       class="form-control" required value="<%= producto.precio_base %>" placeholder="0.00">
              </div>
            </div>

            <div class="mb-4">
              <label for="minimo" class="form-label fw-bold">Cantidad Mínima</label>
              <input type="number" id="minimo" name="minimo" step="0.1" 
                     class="form-control" value="<%= producto.minimo %>" placeholder="1">
              <small class="text-muted">Para lona: unidad en m². Para otros: unidades.</small>
            </div>

            <div class="d-flex gap-2 mt-5">
              <button class="btn btn-primary btn-lg px-5" type="submit">
                <i class="bi bi-check-circle"></i> Guardar Cambios
              </button>
              <a href="/catalogo" class="btn btn-outline-secondary btn-lg px-5">
                <i class="bi bi-x-circle"></i> Cancelar
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- INFO LATERAL -->
    <div class="col-lg-4">
      <div class="card bg-light border-0">
        <div class="card-body">
          <h6 class="card-title mb-3">📋 Información</h6>
          <p class="small mb-2"><strong>ID:</strong> #<%= producto.id %></p>
          <p class="small mb-2"><strong>Creado:</strong> <%= producto.created_at || 'N/A' %></p>
          <div class="alert alert-info small mt-3 mb-0">
            <strong>💡 Tip:</strong> Los cambios se guardan inmediatamente. Verifica que el tipo sea correcto para cálculos precisos.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
