<main class="container py-4">
  <div class="row mb-4 align-items-center">
    <div class="col">
      <h2 class="mb-0">Catálogo de Productos</h2>
    </div>
    <div class="col-auto">
      <a href="/catalogo/nuevo" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Agregar Producto
      </a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <form action="/catalogo" method="GET" class="row g-2">
        <div class="col-md-6">
          <input type="text" name="q" class="form-control" placeholder="Buscar por nombre o código..." 
                 value="<%= busqueda || '' %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search"></i> Buscar
          </button>
        </div>
        <% if (busqueda) { %>
          <div class="col-md-4">
            <a href="/catalogo" class="btn btn-outline-secondary w-100">
              <i class="bi bi-x-circle"></i> Limpiar búsqueda
            </a>
          </div>
        <% } %>
      </form>
    </div>
  </div>

  <% if (busqueda) { %>
    <div class="alert alert-info mb-3">
      <i class="bi bi-search"></i> Resultados para: <strong>"<%= busqueda %>"</strong>
      <% if (productos.length === 0) { %>
        - No se encontraron coincidencias
      <% } else { %>
        - Se encontraron <strong><%= productos.length %></strong> producto(s)
      <% } %>
    </div>
  <% } %>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th style="width: 80px;">Código</th>
          <th>Nombre</th>
          <th style="width: 100px;">Tipo</th>
          <th style="width: 120px; text-align: right;">Precio Base</th>
          <th style="width: 80px; text-align: center;">Mínimo</th>
          <th style="width: 180px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (Array.isArray(productos) && productos.length > 0) { %>
          <% productos.forEach(p => { %>
            <tr>
              <td>
                <% if (p.codigo) { %>
                  <code class="bg-light p-2"><strong><%= p.codigo %></strong></code>
                <% } else { %>
                  <span class="text-muted small">-</span>
                <% } %>
              </td>
              <td><strong><%= p.nombre %></strong></td>
              <td>
                <span class="badge bg-secondary"><%= p.tipo %></span>
              </td>
              <td style="text-align: right;">
                <strong>$<%= Number(p.precio_base).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
              </td>
              <td style="text-align: center;"><%= p.minimo %></td>
              <td>
                <div class="btn-group btn-group-sm" role="group">
                  <a href="/catalogo/editar/<%= p.id %>" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Editar
                  </a>
                  <form action="/catalogo/eliminar/<%= p.id %>" method="POST" class="d-inline"
                        onsubmit="return confirm('¿Estás seguro de eliminar este producto?')">
                    <button type="submit" class="btn btn-danger">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-4">
              <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.5;"></i>
              <p class="text-muted mt-2">
                <%= busqueda ? 'No hay productos que coincidan con la búsqueda' : 'No hay productos en el catálogo aún' %>
              </p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</main>
