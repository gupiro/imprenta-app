<main class="container py-4">
  <h2>Nuevo Producto del Catálogo</h2>

  <% if (error && error.length) { %>
    <div class="alert alert-danger text-center"><%= error %></div>
  <% } %>

  <form action="/catalogo/nuevo" method="POST" class="border p-4 rounded bg-light">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="col-md-6 mb-3">
        <label for="codigo" class="form-label">Código (opcional)</label>
        <input type="text" id="codigo" name="codigo" class="form-control" placeholder="Ej: PROD-001">
      </div>

      <div class="col-md-6 mb-3">
        <label for="nombre" class="form-label">Nombre *</label>
        <input type="text" id="nombre" name="nombre" class="form-control" required placeholder="Ej: Cartel lona, Afiches, Stickers">
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label for="tipo" class="form-label">Tipo *</label>
        <select id="tipo" name="tipo" class="form-select" required>
          <option value="">Seleccionar tipo…</option>
          <option value="lona">Lona</option>
          <option value="fotocopia">Fotocopia</option>
          <option value="impresion">Impresión</option>
          <option value="otro">Otro</option>
        </select>
      </div>

      <div class="col-md-6 mb-3">
        <label for="precio_base" class="form-label">Precio base ($) *</label>
        <input type="number" id="precio_base" name="precio_base" step="0.01" min="0" class="form-control" required>
      </div>
    </div>

    <div class="mb-3">
      <label for="minimo" class="form-label">Cantidad mínima (opcional)</label>
      <input type="number" id="minimo" name="minimo" step="0.1" class="form-control" placeholder="Ej: 1">
    </div>

    <div class="text-center mt-4">
      <a href="/catalogo" class="btn btn-outline-secondary me-2">Cancelar</a>
      <button class="btn btn-success px-5" type="submit">
        <i class="bi bi-save"></i> Guardar Producto
      </button>
    </div>
  </form>
</main>
