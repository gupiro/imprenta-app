<%- include('../partials/header', { title }) %>

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-2">Historial de Pedidos de <%= cliente.name %></h1>
      <% if (cliente.deuda_total > 0) { %>
        <div class="alert alert-warning mb-0">
          <i class="bi bi-exclamation-triangle"></i> 
          <strong>Deuda Total:</strong> 
          <span class="badge bg-danger fs-6">$<%= cliente.deuda_total.toLocaleString('es-AR') %></span>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">Sin deudas pendientes</p>
      <% } %>
    </div>
    <div>
      <a href="/pedidos/nuevo?clienteId=<%= cliente.id %>" class="btn btn-success">
        ➕ Crear nuevo pedido
      </a>
      <a href="/clientes" class="btn btn-secondary">← Volver</a>
    </div>
  </div>

  <% if (pedidos.length > 0) { %>
    <div class="list-group">
      <% pedidos.forEach(p => { %>
        <a href="/pedidos/detalle/<%= p.id %>"
           class="list-group-item list-group-item-action">
          <div class="d-flex justify-content-between">
            <div>
              <strong>#<%= p.id %></strong> – <%= p.fecha %>
            </div>
            <div>
              <strong>Total:</strong> $<%= Math.round(p.precio||0) %>
              <% if (p.saldo_mostrar > 0) { %>
                <br><small class="text-danger">Saldo: $<%= Math.round(p.saldo_mostrar) %></small>
              <% } %>
            </div>
          </div>
          <% if (p.productos.length) { %>
            <small class="text-muted">Productos:
              <%= p.productos.map(x => `${x.material} (${x.ancho}×${x.alto})`).join(', ') %>
            </small>
          <% } %>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info">Este cliente no tiene pedidos aún.</div>
  <% } %>
</main>

