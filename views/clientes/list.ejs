<main class="container py-4">
  <div class="mb-4">
    <h1 class="display-6 mb-2"><i class="bi bi-people-fill"></i> Clientes</h1>
    <p class="text-muted">Gestión de clientes registrados</p>
  </div>

  <div class="mb-4 text-end">
    <a href="/clientes/nuevo" class="btn btn-primary">
      <i class="bi bi-person-plus"></i> Nuevo Cliente
    </a>
  </div>

  <div class="mb-3">
    <input
      type="text"
      id="buscarCliente"
      class="form-control"
      placeholder="🔍 Busca por nombre..."
    >
  </div>

  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success && success.length) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (!clients || clients.length === 0) { %>
    <div class="alert alert-info">No hay clientes registrados todavía.</div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-striped align-middle" id="tablaClientes">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th onclick="ordenarClientes('nombre')" style="cursor:pointer; user-select:none;">
            Nombre <span id="flecha-nombre" class="text-warning">⇅</span>
          </th>
          <th>Teléfono</th>
          <th class="text-center" onclick="ordenarClientes('presup')" style="cursor:pointer; user-select:none;">
            Presupuestos Pendientes <span id="flecha-presup" class="text-warning">⇅</span>
          </th>
          <th class="text-end" onclick="ordenarClientes('deuda')" style="cursor:pointer; user-select:none;">
            Deuda Total <span id="flecha-deuda" class="text-warning">⇅</span>
          </th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% clients.forEach(client => { %>
          <tr data-nombre="<%= client.name.toLowerCase() %>"
              data-presup="<%= client.cant_presupuestos %>"
              data-deuda="<%= client.deuda_total %>"
              <%= client.deuda_total > 0 || client.cant_presupuestos > 0 ? 'class="table-warning"' : '' %>>
            <td><%= client.id %></td>
            <td class="col-nombre"><strong><%= client.name %></strong></td>
            <td><%= client.phone || '-' %></td>
            <td class="text-center">
              <% if (client.cant_presupuestos > 0) { %>
                <span class="badge bg-info"><%= client.cant_presupuestos %></span>
                <button class="btn btn-sm btn-outline-info ms-1" type="button" data-bs-toggle="collapse" 
                        data-bs-target="#presup-<%= client.id %>" title="Ver presupuestos">
                  <i class="bi bi-chevron-down"></i>
                </button>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td class="text-end">
              <% if (client.deuda_total > 0) { %>
                <span class="badge bg-danger">$<%= client.deuda_total.toLocaleString('es-AR') %></span>
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <a href="/pedidos/nuevo?clienteId=<%= client.id %>" class="btn btn-success" title="Nuevo Pedido">
                  <i class="bi bi-cart-plus"></i>
                </a>
                <a href="/clientes/editar/<%= client.id %>" class="btn btn-warning" title="Editar Cliente">
                  <i class="bi bi-pencil"></i>
                </a>
                <a href="/clientes/<%= client.id %>/historial" class="btn btn-info" title="Ver Historial">
                  <i class="bi bi-clock-history"></i>
                </a>
                <button type="button" class="btn btn-outline-info" title="Alertas de Riesgo"
                        onclick="analizarRiesgoCliente(<%= client.id %>, '<%= client.name.replace(/'/g, "\\'") %>')">
                  <i class="bi bi-exclamation-triangle"></i>
                </button>
                <% if (client.phone) {
                  const tel = client.phone.replace(/\D/g,'');
                  const msgDeuda = encodeURIComponent(
                    `Hola ${client.name}, le recordamos desde Imprenta El Gráfico que tiene un saldo pendiente. ` +
                    `Por favor comuníquese con nosotros para regularizar su cuenta. ¡Muchas gracias!`
                  );
                %>
                  <a href="https://wa.me/549<%= tel %>?text=<%= msgDeuda %>"
                     target="_blank" class="btn btn-success" title="Contactar por WhatsApp">
                    📲
                  </a>
                <% } %>
                <button type="button" class="btn btn-danger" title="Eliminar Cliente"
                        data-bs-toggle="modal" data-bs-target="#modalEliminarCliente"
                        onclick="document.getElementById('clienteIdEliminar').value = '<%= client.id %>'; document.getElementById('clienteNombreEliminar').textContent = '<%= client.name %>'">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          
          <!-- Fila expandible con presupuestos -->
          <% if (client.cant_presupuestos > 0) { %>
          <tr class="collapse" id="presup-<%= client.id %>">
            <td colspan="6">
              <div class="p-3 bg-light">
                <h6 class="mb-3">Presupuestos Pendientes de <%= client.name %></h6>
                <div class="table-responsive">
                  <table class="table table-sm table-hover">
                    <thead class="table-secondary">
                      <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% client.presupuestos_pendientes.forEach(presup => { %>
                        <tr>
                          <td><strong><%= presup.id %></strong></td>
                          <td><%= new Date(presup.fecha_creacion).toLocaleDateString('es-AR') %></td>
                          <td>$<%= presup.precio_estimado.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                          <td>
                            <span class="badge bg-<%= presup.estado === 'ACEPTADO' ? 'success' : 'warning' %>">
                              <%= presup.estado %>
                            </span>
                          </td>
                          <td>
                            <a href="/presupuestos/<%= presup.id %>" class="btn btn-xs btn-outline-primary">
                              <i class="bi bi-eye"></i> Ver
                            </a>
                            <% if (presup.estado === 'ACEPTADO') { %>
                              <form action="/presupuestos/<%= presup.id %>/crear-pedido" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-xs btn-outline-success" onclick="return confirm('¿Convertir a pedido?')">
                                  <i class="bi bi-arrow-right-square"></i> A Pedido
                                </button>
                              </form>
                            <% } %>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </td>
          </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

<!-- Modal: Perfil de Riesgo del Cliente -->
<div class="modal fade" id="modalPerfilRiesgo" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Análisis de Riesgo - Cliente</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="riesgoCargando" class="text-center py-4">
          <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Analizando...</span>
          </div>
          <p class="mt-2 text-muted">Analizando perfil del cliente...</p>
        </div>

        <div id="riesgoResultado" style="display: none;">
          <!-- Métricas -->
          <div class="row mb-4">
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Deuda Total</p>
                  <h5 id="metricaDeuda" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Pedidos Totales</p>
                  <h5 id="metricaPedidos" class="mb-0">0</h5>
                </div>
              </div>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Días Promedio de Pago</p>
                  <h5 id="metricaDiasPago" class="mb-0">-</h5>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Pedidos Vencidos</p>
                  <h5 id="metricaVencidos" class="mb-0">0</h5>
                </div>
              </div>
            </div>
          </div>

          <!-- Score de Riesgo -->
          <div class="card mb-4 border-warning">
            <div class="card-body">
              <p class="text-muted mb-2"><strong>Nivel de Riesgo:</strong> <span id="nivelRiesgo" class="badge bg-secondary">-</span></p>
              <div class="progress">
                <div id="barraPorcentajeRiesgo" class="progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <small class="text-muted mt-2 d-block" id="porcentajeRiesgo">Score: 0/100</small>
            </div>
          </div>

          <!-- Evaluación -->
          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">Evaluación y Recomendaciones</h6>
            </div>
            <div class="card-body">
              <p id="evaluacionText" class="text-muted mb-0"></p>
            </div>
          </div>
        </div>

        <div id="riesgoError" class="alert alert-danger mb-0" style="display: none;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Eliminar Cliente -->
<div class="modal fade" id="modalEliminarCliente" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">
          <i class="bi bi-exclamation-triangle"></i> Eliminar Cliente
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">
          ¿Seguro que querés eliminar a <strong id="clienteNombreEliminar"></strong>?
        </p>
        <p class="text-danger small mb-3">
          ⚠️ Esta acción no se puede deshacer.
        </p>
        <form id="formEliminarCliente" action="" method="POST" class="needs-validation">
          <div class="mb-3">
            <label for="claveEliminar" class="form-label fw-bold">Ingresa la clave para confirmar:</label>
            <input type="password" id="claveEliminar" name="clave" class="form-control" required
                   placeholder="Clave de seguridad">
            <small class="text-muted">Ingresa: <code>admin</code></small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" onclick="confirmarEliminarCliente()">
          <i class="bi bi-trash"></i> Eliminar Cliente
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let modalPerfilRiesgo = null;

  async function analizarRiesgoCliente(clienteId, clienteNombre) {
    // Limpiar modal
    document.getElementById('riesgoCargando').style.display = 'block';
    document.getElementById('riesgoResultado').style.display = 'none';
    document.getElementById('riesgoError').style.display = 'none';

    if (!modalPerfilRiesgo) {
      modalPerfilRiesgo = new bootstrap.Modal(document.getElementById('modalPerfilRiesgo'));
    }
    modalPerfilRiesgo.show();

    try {
      const response = await fetch('/api/ia/perfil-cliente', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ cliente_id: clienteId })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Error desconocido');
      }

      const data = await response.json();

      if (data.ok) {
        // Mostrar métricas
        document.getElementById('metricaDeuda').textContent =
          '$' + data.metricas.deudaTotal.toLocaleString('es-AR');
        document.getElementById('metricaPedidos').textContent = data.metricas.pedidosTotales;
        document.getElementById('metricaDiasPago').textContent =
          data.metricas.diasPromedioPago ? data.metricas.diasPromedioPago + ' días' : '-';
        document.getElementById('metricaVencidos').textContent = data.metricas.pedidosVencidos;

        // Mostrar nivel de riesgo
        const nivelBadge = {
          'BAJO': 'bg-success',
          'MEDIO': 'bg-warning',
          'ALTO': 'bg-danger',
          'MUY ALTO': 'bg-dark'
        }[data.metricas.nivelRiesgo] || 'bg-secondary';

        document.getElementById('nivelRiesgo').className = 'badge ' + nivelBadge;
        document.getElementById('nivelRiesgo').textContent = data.metricas.nivelRiesgo;

        // Mostrar barra de porcentaje
        const porcentaje = data.metricas.riesgoScore;
        document.getElementById('barraPorcentajeRiesgo').style.width = porcentaje + '%';
        document.getElementById('barraPorcentajeRiesgo').className =
          'progress-bar ' + (porcentaje > 70 ? 'bg-danger' : porcentaje > 50 ? 'bg-warning' : 'bg-success');
        document.getElementById('porcentajeRiesgo').textContent = `Score: ${porcentaje}/100`;

        // Mostrar evaluación
        document.getElementById('evaluacionText').textContent = data.evaluacion;

        document.getElementById('riesgoCargando').style.display = 'none';
        document.getElementById('riesgoResultado').style.display = 'block';
      } else {
        throw new Error(data.error || 'Error en la respuesta');
      }
    } catch (error) {
      console.error('Error:', error);
      document.getElementById('riesgoError').textContent = error.message || 'Error al analizar el perfil';
      document.getElementById('riesgoError').style.display = 'block';
      document.getElementById('riesgoCargando').style.display = 'none';
    }
  }

  // ═══ ORDENAMIENTO DE TABLA ════════════════════════════════════
  let sortState = { col: null, dir: 'asc' };

  function ordenarClientes(col) {
    if (sortState.col === col) {
      sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
    } else {
      sortState.col = col;
      sortState.dir = col === 'nombre' ? 'asc' : 'desc'; // nombre: A-Z por defecto; números: mayor primero
    }

    // Actualizar flechas
    ['nombre', 'presup', 'deuda'].forEach(c => {
      const el = document.getElementById('flecha-' + c);
      if (el) el.textContent = c === sortState.col ? (sortState.dir === 'asc' ? '↑' : '↓') : '⇅';
    });

    const tbody = document.querySelector('#tablaClientes tbody');

    // Recolectar pares (fila principal + filas collapse que la siguen)
    const pares = [];
    let current = null;
    Array.from(tbody.children).forEach(row => {
      if (row.hasAttribute('data-nombre')) {
        // Es fila principal
        current = { main: row, collapse: [] };
        pares.push(current);
      } else if (current && row.classList.contains('collapse')) {
        current.collapse.push(row);
      } else {
        current = null;
      }
    });

    // Ordenar pares
    pares.sort((a, b) => {
      let valA, valB;
      if (sortState.col === 'nombre') {
        valA = a.main.getAttribute('data-nombre') || '';
        valB = b.main.getAttribute('data-nombre') || '';
        return sortState.dir === 'asc'
          ? valA.localeCompare(valB, 'es')
          : valB.localeCompare(valA, 'es');
      } else {
        valA = parseFloat(a.main.getAttribute('data-' + sortState.col)) || 0;
        valB = parseFloat(b.main.getAttribute('data-' + sortState.col)) || 0;
        return sortState.dir === 'asc' ? valA - valB : valB - valA;
      }
    });

    // Reinsertar en el DOM en el nuevo orden
    pares.forEach(par => {
      tbody.appendChild(par.main);
      par.collapse.forEach(r => tbody.appendChild(r));
    });
  }

  document.getElementById('buscarCliente').addEventListener('input', function () {
    const filtro = this.value.trim().toLowerCase();
    document.querySelectorAll('#tablaClientes tbody tr').forEach(row => {
      const nombre = row.querySelector('.col-nombre');
      if (nombre) {
        const matches = nombre.textContent.toLowerCase().includes(filtro);
        // Show/hide the main row and related expandable rows
        const nextRows = [];
        let currentRow = row.nextElementSibling;
        while (currentRow && currentRow.classList.contains('collapse')) {
          nextRows.push(currentRow);
          currentRow = currentRow.nextElementSibling;
        }

        row.style.display = matches ? '' : 'none';
        nextRows.forEach(r => r.style.display = matches ? '' : 'none');
      }
    });
  });

  // Hidden fields para almacenar ID y nombre del cliente a eliminar
  const clienteIdInput = document.createElement('input');
  clienteIdInput.type = 'hidden';
  clienteIdInput.id = 'clienteIdEliminar';
  document.body.appendChild(clienteIdInput);

  function confirmarEliminarCliente() {
    const clave = document.getElementById('claveEliminar').value;
    const clienteId = document.getElementById('clienteIdEliminar').value;

    if (!clave) {
      alert('Por favor ingresa la clave para confirmar');
      return;
    }

    if (!clienteId) {
      alert('Error: No se pudo identificar el cliente');
      return;
    }

    const form = document.getElementById('formEliminarCliente');
    form.action = '/clientes/eliminar/' + clienteId;
    form.submit();
  }
</script>
