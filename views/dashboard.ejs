<!-- views/dashboard.ejs -->
<div class="container-fluid py-0 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-1">
    <div class="col-md-12">
      <h5 style="font-size: 1.2rem; margin-bottom: 0.25rem;"><i class="bi bi-graph-up"></i> Dashboard Financiero</h5>
      <p class="text-muted small mb-0" style="font-size: 0.75rem;">Análisis completo de ingresos, gastos y operaciones</p>
    </div>
  </div>

  <!-- INFORMACIÓN FINANCIERA - SOLO PARA ADMIN -->
  <% if (user && user.rol === 'admin') { %>

  <!-- FILA 1: KPIs PRINCIPALES (6 tarjetas) -->
  <div class="row mb-1">
    <!-- Ingresos Hoy -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💰 Ingresos Hoy</p>
              <h6 class="mb-0 text-success">$<%= ingresosHoy.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ingresos Mes -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">📊 Ingresos Mes</p>
              <h6 class="mb-0 text-success">$<%= ingresosMes.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <% if (cambioIngresos !== 0) { %>
                <small class="<%= cambioIngresos > 0 ? 'text-success' : 'text-danger' %>">
                  <%= cambioIngresos > 0 ? '↑' : '↓' %> <%= Math.abs(cambioIngresos).toFixed(1) %>% vs mes ant.
                </small>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gastos Mes -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💸 Gastos Mes</p>
              <h6 class="mb-0 text-danger">$<%= gastosMes.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <% if (cambioGastos !== 0) { %>
                <small class="<%= cambioGastos > 0 ? 'text-danger' : 'text-success' %>">
                  <%= cambioGastos > 0 ? '↑' : '↓' %> <%= Math.abs(cambioGastos).toFixed(1) %>%
                </small>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Saldo Neto -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💼 Saldo Neto</p>
              <h6 class="mb-0 <%= saldoNeto >= 0 ? 'text-success' : 'text-danger' %>">$<%= saldoNeto.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <%
                const margen = ingresosMes > 0 ? ((saldoNeto / ingresosMes) * 100) : 0;
              %>
              <small class="text-muted"><%= margen.toFixed(1) %>% margen</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Deuda Total -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">⚠️ Deuda Total</p>
              <h6 class="mb-0 text-warning">$<%= deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <small class="text-muted"><%= deudores.length %> cliente<%= deudores.length !== 1 ? 's' : '' %></small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pedidos Activos -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">📋 Activos</p>
              <h6 class="mb-0 text-info"><%= pedidosActivos %></h4>
              <small class="text-muted">En proceso</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECCIÓN: GRÁFICOS (Tabs compactos para evitar auto-scroll) -->
  <div class="row mb-1">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <ul class="nav nav-tabs card-header-tabs" id="graficosTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="tab-7dias" data-bs-toggle="tab"
                data-bs-target="#panel-7dias" type="button" role="tab"
                onclick="iniciarGrafico7Dias()">
                <i class="bi bi-bar-chart me-1"></i>Ingresos 7 Días
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-6meses" data-bs-toggle="tab"
                data-bs-target="#panel-6meses" type="button" role="tab"
                onclick="iniciarGrafico6Meses()">
                <i class="bi bi-graph-up me-1"></i>Ingresos vs Egresos
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-pedidos" data-bs-toggle="tab"
                data-bs-target="#panel-pedidos" type="button" role="tab"
                onclick="iniciarGraficoPedidos()">
                <i class="bi bi-pie-chart me-1"></i>Estado Pedidos
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="tab-gastos" data-bs-toggle="tab"
                data-bs-target="#panel-gastos" type="button" role="tab"
                onclick="iniciarGraficoGastos()">
                <i class="bi bi-pie-chart-fill me-1"></i>Gastos por Categoría
              </button>
            </li>
          </ul>
        </div>
        <div class="card-body p-3">
          <div class="tab-content" id="graficosTabContent">
            <!-- Tab 1: Ingresos últimos 7 días -->
            <div class="tab-pane fade show active" id="panel-7dias" role="tabpanel">
              <div style="height: 230px; position: relative;">
                <canvas id="grafico7Dias"></canvas>
              </div>
            </div>
            <!-- Tab 2: Ingresos vs Egresos últimos 6 meses -->
            <div class="tab-pane fade" id="panel-6meses" role="tabpanel">
              <div style="height: 230px; position: relative;">
                <canvas id="grafico6Meses"></canvas>
              </div>
            </div>
            <!-- Tab 3: Estado de pedidos -->
            <div class="tab-pane fade" id="panel-pedidos" role="tabpanel">
              <div class="row align-items-center">
                <div class="col-md-6" style="height: 230px; position: relative;">
                  <canvas id="graficoPedidos"></canvas>
                </div>
                <div class="col-md-6" id="legendaPedidos"></div>
              </div>
            </div>
            <!-- Tab 4: Gastos por categoría -->
            <div class="tab-pane fade" id="panel-gastos" role="tabpanel">
              <div class="row align-items-center">
                <div class="col-md-6" style="height: 230px; position: relative;">
                  <canvas id="graficoGastos"></canvas>
                </div>
                <div class="col-md-6" id="legendaGastos"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILA 4: ALERTAS Y DEUDORES -->
  <div class="row mb-1">
    <!-- Deudores -->
    <div class="col-lg-6 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-exclamation-triangle"></i> Top 5 Deudores</h6>
          <% if (deudores.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead>
                  <tr class="border-bottom">
                    <th>Cliente</th>
                    <th>Deuda</th>
                    <th>Días</th>
                  </tr>
                </thead>
                <tbody>
                  <% deudores.forEach(d => { %>
                    <tr>
                      <td>
                        <strong><%= d.cliente_nombre || 'Sin nombre' %></strong><br/>
                        <small class="text-muted"><%= d.phone || '-' %></small>
                      </td>
                      <td><strong class="text-danger">$<%= d.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></strong></td>
                      <td>
                        <span class="badge <%= d.dias_deuda > 30 ? 'bg-danger' : (d.dias_deuda > 7 ? 'bg-warning' : 'bg-info') %>">
                          <%= d.dias_deuda %> días
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="mt-2">
              <a href="/reportes/deudores" class="btn btn-sm btn-outline-danger">Ver todos →</a>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">✅ No hay deudas pendientes</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Alertas del Sistema -->
    <div class="col-lg-6 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-bell"></i> Alertas del Sistema</h6>

          <!-- Presupuestos pendientes -->
          <% if (presupuestosPendientes.length > 0) { %>
            <div class="alert alert-warning alert-sm mb-3" role="alert">
              <strong>⏰ <%= presupuestosPendientes.length %> presupuesto<%= presupuestosPendientes.length !== 1 ? 's' : '' %> sin respuesta</strong>
              <div class="small mt-2">
                <% presupuestosPendientes.forEach(p => { %>
                  <div class="mb-1">
                    <%= p.cliente %>: $<%= p.precio_estimado.toLocaleString('es-AR', {minimumFractionDigits: 0}) %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Stock bajo -->
          <% if (stockBajo.length > 0) { %>
            <div class="alert alert-danger alert-sm mb-3" role="alert">
              <strong>📦 <%= stockBajo.length %> producto<%= stockBajo.length !== 1 ? 's' : '' %> con stock bajo</strong>
              <div class="small mt-2">
                <% stockBajo.forEach(s => { %>
                  <div class="mb-1">
                    <%= s.nombre %>: <%= s.cantidad %> <%= s.unidad %> (mín: <%= s.stock_minimo %>)
                  </div>
                <% }); %>
              </div>
            </div>
          <% } else if (totalStock === 0) { %>
            <div class="alert alert-secondary alert-sm" role="alert">
              ⚠️ Sin artículos en stock configurados
            </div>
          <% } else { %>
            <div class="alert alert-success alert-sm" role="alert">
              ✅ Todo el stock está bien
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% } else { %>
    <!-- ACCESO A CAJA DIARIA PARA NO-ADMIN -->
    <div class="row mb-1">
      <div class="col-lg-3 col-md-6 mb-1">
        <a href="/caja-diaria" class="text-decoration-none">
          <div class="card border-0 shadow-sm h-100 bg-primary text-white" style="cursor: pointer; transition: transform 0.2s;">
            <div class="card-body p-3 text-center">
              <h3 class="mb-2"><i class="bi bi-cash-coin"></i></h3>
              <h6 class="mb-0">📊 Caja Diaria</h6>
              <small class="mt-2 d-block">Registrar movimientos</small>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% } %>

  <!-- FILA 5: ÚLTIMOS PEDIDOS -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-list-check"></i> Últimos Pedidos</h6>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead>
                <tr class="border-bottom">
                  <th>#</th>
                  <th>Cliente</th>
                  <th>Monto</th>
                  <th>Estado</th>
                  <th>Fecha</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody>
                <% ultimosPedidos.forEach(p => { %>
                  <tr>
                    <td><strong>#<%= p.id %></strong></td>
                    <td><%= p.cliente_nombre || 'Sin cliente' %></td>
                    <td>$<%= p.precio.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></td>
                    <td>
                      <%
                        let badgeClass = 'bg-secondary';
                        if (p.estado === 'PENDIENTE') badgeClass = 'bg-danger';
                        if (p.estado === 'EN_PRODUCCION') badgeClass = 'bg-warning';
                        if (p.estado === 'LISTO') badgeClass = 'bg-info';
                        if (p.estado === 'ENTREGADO') badgeClass = 'bg-success';
                      %>
                      <span class="badge <%= badgeClass %>"><%= p.estado %></span>
                    </td>
                    <td><small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small></td>
                    <td>
                      <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILA 6: PREDICCIONES DE FLUJO DE CAJA -->
  <div class="row mt-4">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="card-title mb-0"><i class="bi bi-graph-up"></i> Predicciones - Próximos 30 Días</h6>
            <button type="button" class="btn btn-sm btn-info" onclick="cargarPredicciones()">
              <i class="bi bi-arrow-clockwise"></i> Cargar Proyecciones
            </button>
          </div>
          <div id="prediccionesContainer">
            <p class="text-muted text-center py-4">Haz click en "Cargar Proyecciones" para ver el análisis de flujo de caja predicho</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTÓN DE ANÁLISIS CON IA -->
  <div class="row mt-3 mb-2">
    <div class="col-12">
      <button type="button" class="btn btn-lg btn-primary" onclick="abrirAnalisisIA()">
        <i class="bi bi-robot"></i> 🤖 Analizar Situación Financiera
      </button>
    </div>
  </div>
</div>

<!-- MODAL: PREDICCIONES -->
<div class="modal fade" id="modalPredicciones" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title"><i class="bi bi-graph-up"></i> Predicciones de Flujo de Caja - 60 días</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="prediccionesCargando" class="text-center py-5">
          <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="mt-3 text-muted">Generando predicciones...</p>
        </div>

        <div id="prediccionesResultado" style="display: none;">
          <!-- Resumen de predicciones -->
          <div class="row mb-4">
            <div class="col-md-3">
              <div class="card bg-success text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Ingresos Predichos</p>
                  <h5 id="resumenIngresos" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-danger text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Gastos Estimados</p>
                  <h5 id="resumenGastos" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-primary text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Saldo Proyectado</p>
                  <h5 id="resumenSaldo" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-secondary text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Gasto Diario Promedio</p>
                  <h5 id="resumenGastoDiario" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
          </div>

          <!-- Canvas para gráfico -->
          <div class="card mb-4">
            <div class="card-body">
              <canvas id="graficoFlujo" height="80"></canvas>
            </div>
          </div>

          <!-- Análisis de predicciones -->
          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">Análisis y Recomendaciones</h6>
            </div>
            <div class="card-body">
              <p id="analissiPredicciones" class="text-muted mb-0"></p>
            </div>
          </div>
        </div>

        <div id="prediccionesError" class="alert alert-danger" style="display: none;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: ANÁLISIS CON IA -->
<div class="modal fade" id="modalAnalisisIA" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">🤖 Análisis Inteligente - Claude IA</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="iaSpinner" class="text-center py-5" style="display: none;">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Analizando...</span>
          </div>
          <p class="mt-3 text-muted">Analizando tu situación financiera con IA...</p>
        </div>
        <div id="iaResultado" style="white-space: pre-wrap; font-family: monospace; font-size: 0.95rem; max-height: 400px; overflow-y: auto; display: none;"></div>
        <div id="iaError" class="alert alert-danger" style="display: none;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts de gráficos removidos por performance -->

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
let chartFluxoInstance = null;

function cargarPredicciones() {
  const modal = new bootstrap.Modal(document.getElementById('modalPredicciones'));
  modal.show();

  // Mostrar spinner y ocultar resultados
  document.getElementById('prediccionesCargando').style.display = 'block';
  document.getElementById('prediccionesResultado').style.display = 'none';
  document.getElementById('prediccionesError').style.display = 'none';

  // Llamar a la API
  fetch('/api/ia/predicciones', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'CSRF-Token': '<%= csrfToken %>'
    },
    body: JSON.stringify({})
  })
  .then(res => res.json())
  .then(data => {
    document.getElementById('prediccionesCargando').style.display = 'none';

    if (data.ok) {
      // Mostrar resumen
      document.getElementById('resumenIngresos').textContent =
        '$' + data.resumen.ingresosPredichosTotal.toLocaleString('es-AR', { minimumFractionDigits: 0 });
      document.getElementById('resumenGastos').textContent =
        '$' + data.resumen.gastosProdichos30.toLocaleString('es-AR', { minimumFractionDigits: 0 });
      document.getElementById('resumenSaldo').textContent =
        '$' + data.resumen.saldoProyectado.toLocaleString('es-AR', { minimumFractionDigits: 0 });
      document.getElementById('resumenGastoDiario').textContent =
        '$' + data.resumen.gastoPromedioDiario.toLocaleString('es-AR', { minimumFractionDigits: 0 });

      // Mostrar análisis
      document.getElementById('analissiPredicciones').textContent = data.analisisPredicciones;

      // Dibujar gráfico
      if (data.datosGrafico && data.datosGrafico.length > 0) {
        const labels = data.datosGrafico.map(d => d.fecha);
        const ingresos = data.datosGrafico.map(d => d.ingreso);
        const gastos = data.datosGrafico.map(d => d.gasto);
        const saldo = data.datosGrafico.map((d, i) => {
          let acumulado = 0;
          for (let j = 0; j <= i; j++) {
            acumulado += data.datosGrafico[j].ingreso - data.datosGrafico[j].gasto;
          }
          return acumulado;
        });

        // Destruir gráfico anterior si existe
        if (chartFluxoInstance) {
          chartFluxoInstance.destroy();
        }

        const ctx = document.getElementById('graficoFlujo').getContext('2d');
        chartFluxoInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [
              {
                label: 'Ingresos',
                data: ingresos,
                borderColor: '#198754',
                backgroundColor: 'rgba(25, 135, 84, 0.1)',
                tension: 0.3,
                borderWidth: 2,
                fill: false
              },
              {
                label: 'Gastos',
                data: gastos,
                borderColor: '#dc3545',
                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                tension: 0.3,
                borderWidth: 2,
                fill: false
              },
              {
                label: 'Saldo Acumulado',
                data: saldo,
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                tension: 0.3,
                borderWidth: 2,
                fill: true,
                yAxisID: 'y1'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            interaction: {
              mode: 'index',
              intersect: false,
            },
            scales: {
              y: {
                type: 'linear',
                display: true,
                position: 'left',
                ticks: {
                  callback: function(value) {
                    return '$' + value.toLocaleString('es-AR');
                  }
                }
              },
              y1: {
                type: 'linear',
                display: true,
                position: 'right',
                ticks: {
                  callback: function(value) {
                    return '$' + value.toLocaleString('es-AR');
                  }
                },
                grid: {
                  drawOnChartArea: false,
                }
              }
            },
            plugins: {
              legend: {
                display: true,
                position: 'top'
              }
            }
          }
        });
      }

      document.getElementById('prediccionesResultado').style.display = 'block';
    } else {
      document.getElementById('prediccionesError').textContent = 'Error: ' + (data.error || 'No se pudo generar las predicciones');
      document.getElementById('prediccionesError').style.display = 'block';
    }
  })
  .catch(err => {
    document.getElementById('prediccionesCargando').style.display = 'none';
    document.getElementById('prediccionesError').textContent = 'Error de conexión: ' + err.message;
    document.getElementById('prediccionesError').style.display = 'block';
  });
}

function abrirAnalisisIA() {
  const modal = new bootstrap.Modal(document.getElementById('modalAnalisisIA'));
  modal.show();

  // Mostrar spinner y ocultar resultados
  document.getElementById('iaSpinner').style.display = 'block';
  document.getElementById('iaResultado').style.display = 'none';
  document.getElementById('iaError').style.display = 'none';

  // Llamar a la API
  fetch('/api/ia/analizar', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'CSRF-Token': '<%= csrfToken %>'
    },
    body: JSON.stringify({})
  })
  .then(res => res.json())
  .then(data => {
    document.getElementById('iaSpinner').style.display = 'none';

    if (data.ok && data.analisis) {
      document.getElementById('iaResultado').textContent = data.analisis;
      document.getElementById('iaResultado').style.display = 'block';
    } else {
      document.getElementById('iaError').textContent = 'Error: ' + (data.error || 'No se pudo generar el análisis');
      document.getElementById('iaError').style.display = 'block';
    }
  })
  .catch(err => {
    document.getElementById('iaSpinner').style.display = 'none';
    document.getElementById('iaError').textContent = 'Error de conexión: ' + err.message;
    document.getElementById('iaError').style.display = 'block';
  });
}

// ═══════════════════════════════════════════════════════════════
// GRÁFICOS CON TABS (Inicialización Lazy)
// ═══════════════════════════════════════════════════════════════

// Datos desde backend (variables EJS → JS)
const datos7Dias    = { labels: <%- graficoLabels %>, data: <%- graficoDatos %> };
const datos6Meses   = { labels: <%- meses6Labels %>, ingresos: <%- ingresos6Meses %>, egresos: <%- egresos6Meses %> };
const datosPedidos  = { labels: <%- estadoLabels %>, data: <%- estadoDatos %> };
const datosGastos   = JSON.parse('<%- gastosPorCategoria %>');

// Instancias de gráficos (para evitar duplicados)
let chart7Dias = null, chart6Meses = null, chartPedidos = null, chartGastos = null;

const COLORES = ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#f97316','#14b8a6'];

// TAB 1: Ingresos últimos 7 días (barras)
function iniciarGrafico7Dias() {
  if (chart7Dias) return;
  const ctx = document.getElementById('grafico7Dias');
  if (!ctx) return;
  chart7Dias = new Chart(ctx.getContext('2d'), {
    type: 'bar',
    data: {
      labels: datos7Dias.labels,
      datasets: [{
        label: 'Ingresos',
        data: datos7Dias.data,
        backgroundColor: '#3b82f6',
        borderRadius: 6
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: { ticks: { callback: v => '$' + v.toLocaleString('es-AR') } }
      }
    }
  });
}

// TAB 2: Ingresos vs Egresos (barras agrupadas)
function iniciarGrafico6Meses() {
  if (chart6Meses) return;
  const ctx = document.getElementById('grafico6Meses');
  if (!ctx) return;
  chart6Meses = new Chart(ctx.getContext('2d'), {
    type: 'bar',
    data: {
      labels: datos6Meses.labels,
      datasets: [
        { label: 'Ingresos', data: datos6Meses.ingresos, backgroundColor: '#10b981', borderRadius: 4 },
        { label: 'Egresos',  data: datos6Meses.egresos,  backgroundColor: '#ef4444', borderRadius: 4 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top' } },
      scales: {
        y: { ticks: { callback: v => '$' + v.toLocaleString('es-AR') } }
      }
    }
  });
}

// TAB 3: Estado de pedidos (donut)
function iniciarGraficoPedidos() {
  if (chartPedidos) return;
  const ctx = document.getElementById('graficoPedidos');
  if (!ctx) return;
  chartPedidos = new Chart(ctx.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels: datosPedidos.labels,
      datasets: [{ data: datosPedidos.data, backgroundColor: COLORES, borderWidth: 2 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } }
    }
  });
  // Leyenda manual
  const leyenda = datosPedidos.labels.map((l, i) =>
    `<div class="d-flex align-items-center mb-2">
      <span style="width:12px;height:12px;border-radius:50%;background:${COLORES[i]};display:inline-block;" class="me-2"></span>
      <small><strong>${l}:</strong> ${datosPedidos.data[i]}</small>
    </div>`
  ).join('');
  const legendaEl = document.getElementById('legendaPedidos');
  if (legendaEl) legendaEl.innerHTML = leyenda;
}

// TAB 4: Gastos por categoría (donut)
function iniciarGraficoGastos() {
  if (chartGastos) return;
  const labels = datosGastos.map(d => d.label);
  const data   = datosGastos.map(d => d.value);
  const ctx = document.getElementById('graficoGastos');
  if (!ctx) return;
  chartGastos = new Chart(ctx.getContext('2d'), {
    type: 'doughnut',
    data: {
      labels,
      datasets: [{ data, backgroundColor: COLORES, borderWidth: 2 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } }
    }
  });
  // Leyenda manual con porcentajes
  const total = data.reduce((a, b) => a + b, 0);
  const leyenda = labels.map((l, i) =>
    `<div class="d-flex align-items-center mb-2">
      <span style="width:12px;height:12px;border-radius:50%;background:${COLORES[i]};display:inline-block;" class="me-2"></span>
      <small><strong>${l}:</strong> $${data[i].toLocaleString('es-AR')} <span class="text-muted">(${total > 0 ? Math.round(data[i]/total*100) : 0}%)</span></small>
    </div>`
  ).join('');
  const legendaEl = document.getElementById('legendaGastos');
  if (legendaEl) legendaEl.innerHTML = leyenda;
}

// Inicializar primer tab al cargar
document.addEventListener('DOMContentLoaded', function() {
  setTimeout(() => iniciarGrafico7Dias(), 300);
});
</script>
