<!-- views/dashboard-new.ejs - REDISEÑO MODERNO Y MINIMALISTA -->

<div class="container-fluid py-5">
  <% if (user && user.rol === 'admin') { %>

  <!-- ════════════════════════════════════════════════════════════════
       ENCABEZADO
       ════════════════════════════════════════════════════════════════ -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Resumen de tu negocio hoy</p>
    </div>
    <div>
      <span id="semaforo-dot" class="semaforo-dot" style="background:#6c757d; width:16px; height:16px; border-radius:50%; display:inline-block;"></span>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       KPI CARDS - 4 COLUMNAS
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- INGRESOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">💰</div>
        <div class="kpi-label">Ingresos este mes</div>
        <div class="kpi-value" style="color: #10b981;">
          $<%= ingresosMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% if (cambioIngresos >= 0) { %>
            <span style="color: #10b981;">↑ <%= cambioIngresos.toFixed(0) %>%</span> vs mes anterior
          <% } else { %>
            <span style="color: #ef4444;">↓ <%= Math.abs(cambioIngresos).toFixed(0) %>%</span> vs mes anterior
          <% } %>
        </div>
      </div>
    </div>

    <!-- GASTOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📊</div>
        <div class="kpi-label">Gastos este mes</div>
        <div class="kpi-value" style="color: #ef4444;">
          $<%= gastosTotalMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Directos + Fijos + Cuotas
        </div>
      </div>
    </div>

    <!-- RESULTADO NETO -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📈</div>
        <div class="kpi-label">Resultado neto</div>
        <div class="kpi-value" style="color: <%= saldoNeto >= 0 ? '#10b981' : '#ef4444' %>;">
          <%= saldoNeto >= 0 ? '+' : '-' %>$<%= Math.abs(saldoNeto).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% const porcentaje = ingresosMes > 0 ? ((saldoNeto / ingresosMes) * 100).toFixed(1) : 0; %>
          <%= porcentaje %>% de margen
        </div>
      </div>
    </div>

    <!-- DEUDA PENDIENTE -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">⚠️</div>
        <div class="kpi-label">Deuda a clientes</div>
        <div class="kpi-value" style="color: #f59e0b;">
          $<%= deudaTotal.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Monto pendiente de cobrar
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ACCIONES RÁPIDAS
       ════════════════════════════════════════════════════════════════ -->
  <div class="card-minimal mb-5">
    <div class="card-header">Acciones Rápidas</div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/pedidos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-plus-circle"></i> Nuevo Pedido
      </a>
      <a href="/presupuestos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-calculator"></i> Nuevo Presupuesto
      </a>
      <a href="/pedidos/listos" class="btn-minimal btn-secondary-minimal">
        <i class="bi bi-check-circle"></i> Listos para entrega
      </a>
      <a href="/reportes" class="btn-minimal btn-secondary-minimal">
        <i class="bi bi-bar-chart"></i> Ver reportes
      </a>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ESTADOS DE PEDIDOS
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <div class="col-md-12">
      <div class="card-minimal">
        <div class="card-header">Estado de Pedidos</div>
        <div class="row g-4 mt-2">
          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #f59e0b;">
                <%= pendientes || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Pendientes
              </div>
              <a href="/pedidos/pendientes" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #3b82f6;">
                <%= en_produccion || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                En Producción
              </div>
              <a href="/pedidos/en-produccion" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #10b981;">
                <%= listos || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Listos
              </div>
              <a href="/pedidos/listos" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #6b7280;">
                <%= entregados || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Entregados
              </div>
              <a href="/pedidos/entregados" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       PRÓXIMOS VENCIMIENTOS
       ════════════════════════════════════════════════════════════════ -->
  <% if (proximosVencimientos && proximosVencimientos.length > 0) { %>
  <div class="card-minimal">
    <div class="card-header">Próximos 5 Vencimientos</div>
    <div class="table-responsive mt-3">
      <table class="table-minimal">
        <thead>
          <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% proximosVencimientos.forEach(v => { %>
          <% const prioridad = v.prioridad || { clase: 'badge-default', label: 'Sin prioridad' }; %>
          <tr>
            <td><strong><%= v.concepto %></strong></td>
            <td><%= new Date(v.fecha_str || v.fecha).toLocaleDateString('es-AR') %></td>
            <td>$<%= v.monto.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></td>
            <td>
              <span class="badge-minimal <%= prioridad.clase %>">
                <%= prioridad.label %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <% } else { %>
  <!-- USUARIO NO ADMIN -->
  <div class="alert-minimal alert-info-minimal">
    <i class="bi bi-info-circle"></i>
    <div>
      <strong>Acceso limitado</strong><br>
      El dashboard está disponible solo para administradores.
    </div>
  </div>
  <% } %>
</div>

<!-- SCRIPT PARA CARGAR SEMÁFORO -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('/api/semaforo');
    const data = await res.json();
    if (data.mostrar && document.getElementById('semaforo-dot')) {
      document.getElementById('semaforo-dot').style.background =
        data.color === 'success' ? '#10b981' :
        data.color === 'warning' ? '#f59e0b' :
        '#ef4444';
    }
  } catch (e) {
    console.error('Error cargando semáforo:', e);
  }
});
</script>
