<!-- views/dashboard.ejs -->
<div class="container-fluid py-0 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-1">
    <div class="col-md-12">
      <h5 style="font-size: 1.2rem; margin-bottom: 0.25rem;"><i class="bi bi-graph-up"></i> Dashboard Financiero</h5>
      <p class="text-muted small mb-0" style="font-size: 0.75rem;">Análisis completo de ingresos, gastos y operaciones</p>
    </div>
  </div>

  <!-- INFORMACIÓN FINANCIERA - SOLO PARA ADMIN -->
  <% if (user && user.rol === 'admin') { %>

  <!-- FILA 1: KPIs PRINCIPALES (6 tarjetas) -->
  <div class="row mb-1">
    <!-- Ingresos Hoy -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💰 Ingresos Hoy</p>
              <h6 class="mb-0 text-success">$<%= ingresosHoy.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ingresos Mes -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">📊 Ingresos Mes</p>
              <h6 class="mb-0 text-success">$<%= ingresosMes.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <% if (cambioIngresos !== 0) { %>
                <small class="<%= cambioIngresos > 0 ? 'text-success' : 'text-danger' %>">
                  <%= cambioIngresos > 0 ? '↑' : '↓' %> <%= Math.abs(cambioIngresos).toFixed(1) %>% vs mes ant.
                </small>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gastos Mes -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💸 Gastos Mes</p>
              <h6 class="mb-0 text-danger">$<%= gastosMes.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <% if (cambioGastos !== 0) { %>
                <small class="<%= cambioGastos > 0 ? 'text-danger' : 'text-success' %>">
                  <%= cambioGastos > 0 ? '↑' : '↓' %> <%= Math.abs(cambioGastos).toFixed(1) %>%
                </small>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Saldo Neto -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">💼 Saldo Neto</p>
              <h6 class="mb-0 <%= saldoNeto >= 0 ? 'text-success' : 'text-danger' %>">$<%= saldoNeto.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <%
                const margen = ingresosMes > 0 ? ((saldoNeto / ingresosMes) * 100) : 0;
              %>
              <small class="text-muted"><%= margen.toFixed(1) %>% margen</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Deuda Total -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">⚠️ Deuda Total</p>
              <h6 class="mb-0 text-warning">$<%= deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></h4>
              <small class="text-muted"><%= deudores.length %> cliente<%= deudores.length !== 1 ? 's' : '' %></small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pedidos Activos -->
    <div class="col-lg-2 col-md-4 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <p class="card-text small text-muted mb-1" style="font-size: 0.75rem;">📋 Activos</p>
              <h6 class="mb-0 text-info"><%= pedidosActivos %></h4>
              <small class="text-muted">En proceso</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GRÁFICOS REMOVIDOS POR PERFORMANCE -->
  <!-- Los 4 gráficos (1200px total de altura) causaban auto-scroll -->

  <!-- FILA 4: ALERTAS Y DEUDORES -->
  <div class="row mb-1">
    <!-- Deudores -->
    <div class="col-lg-6 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-exclamation-triangle"></i> Top 5 Deudores</h6>
          <% if (deudores.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead>
                  <tr class="border-bottom">
                    <th>Cliente</th>
                    <th>Deuda</th>
                    <th>Días</th>
                  </tr>
                </thead>
                <tbody>
                  <% deudores.forEach(d => { %>
                    <tr>
                      <td>
                        <strong><%= d.cliente_nombre || 'Sin nombre' %></strong><br/>
                        <small class="text-muted"><%= d.phone || '-' %></small>
                      </td>
                      <td><strong class="text-danger">$<%= d.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></strong></td>
                      <td>
                        <span class="badge <%= d.dias_deuda > 30 ? 'bg-danger' : (d.dias_deuda > 7 ? 'bg-warning' : 'bg-info') %>">
                          <%= d.dias_deuda %> días
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="mt-2">
              <a href="/reportes/deudores" class="btn btn-sm btn-outline-danger">Ver todos →</a>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">✅ No hay deudas pendientes</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Alertas del Sistema -->
    <div class="col-lg-6 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-bell"></i> Alertas del Sistema</h6>

          <!-- Presupuestos pendientes -->
          <% if (presupuestosPendientes.length > 0) { %>
            <div class="alert alert-warning alert-sm mb-3" role="alert">
              <strong>⏰ <%= presupuestosPendientes.length %> presupuesto<%= presupuestosPendientes.length !== 1 ? 's' : '' %> sin respuesta</strong>
              <div class="small mt-2">
                <% presupuestosPendientes.forEach(p => { %>
                  <div class="mb-1">
                    <%= p.cliente %>: $<%= p.precio_estimado.toLocaleString('es-AR', {minimumFractionDigits: 0}) %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Stock bajo -->
          <% if (stockBajo.length > 0) { %>
            <div class="alert alert-danger alert-sm mb-3" role="alert">
              <strong>📦 <%= stockBajo.length %> producto<%= stockBajo.length !== 1 ? 's' : '' %> con stock bajo</strong>
              <div class="small mt-2">
                <% stockBajo.forEach(s => { %>
                  <div class="mb-1">
                    <%= s.nombre %>: <%= s.cantidad %> <%= s.unidad %> (mín: <%= s.stock_minimo %>)
                  </div>
                <% }); %>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-success alert-sm" role="alert">
              ✅ Todo el stock está bien
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% } else { %>
    <!-- ACCESO A CAJA DIARIA PARA NO-ADMIN -->
    <div class="row mb-1">
      <div class="col-lg-3 col-md-6 mb-1">
        <a href="/caja-diaria" class="text-decoration-none">
          <div class="card border-0 shadow-sm h-100 bg-primary text-white" style="cursor: pointer; transition: transform 0.2s;">
            <div class="card-body p-3 text-center">
              <h3 class="mb-2"><i class="bi bi-cash-coin"></i></h3>
              <h6 class="mb-0">📊 Caja Diaria</h6>
              <small class="mt-2 d-block">Registrar movimientos</small>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% } %>

  <!-- FILA 5: ÚLTIMOS PEDIDOS -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-list-check"></i> Últimos Pedidos</h6>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead>
                <tr class="border-bottom">
                  <th>#</th>
                  <th>Cliente</th>
                  <th>Monto</th>
                  <th>Estado</th>
                  <th>Fecha</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody>
                <% ultimosPedidos.forEach(p => { %>
                  <tr>
                    <td><strong>#<%= p.id %></strong></td>
                    <td><%= p.cliente_nombre || 'Sin cliente' %></td>
                    <td>$<%= p.precio.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></td>
                    <td>
                      <%
                        let badgeClass = 'bg-secondary';
                        if (p.estado === 'PENDIENTE') badgeClass = 'bg-danger';
                        if (p.estado === 'EN_PRODUCCION') badgeClass = 'bg-warning';
                        if (p.estado === 'LISTO') badgeClass = 'bg-info';
                        if (p.estado === 'ENTREGADO') badgeClass = 'bg-success';
                      %>
                      <span class="badge <%= badgeClass %>"><%= p.estado %></span>
                    </td>
                    <td><small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small></td>
                    <td>
                      <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTÓN DE ANÁLISIS CON IA -->
  <div class="row mt-3 mb-2">
    <div class="col-12">
      <button type="button" class="btn btn-lg btn-primary" onclick="abrirAnalisisIA()">
        <i class="bi bi-robot"></i> 🤖 Analizar Situación Financiera
      </button>
    </div>
  </div>
</div>

<!-- MODAL: ANÁLISIS CON IA -->
<div class="modal fade" id="modalAnalisisIA" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">🤖 Análisis Inteligente - Claude IA</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="iaSpinner" class="text-center py-5" style="display: none;">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Analizando...</span>
          </div>
          <p class="mt-3 text-muted">Analizando tu situación financiera con IA...</p>
        </div>
        <div id="iaResultado" style="white-space: pre-wrap; font-family: monospace; font-size: 0.95rem; max-height: 400px; overflow-y: auto; display: none;"></div>
        <div id="iaError" class="alert alert-danger" style="display: none;"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts de gráficos removidos por performance -->

<script>
function abrirAnalisisIA() {
  const modal = new bootstrap.Modal(document.getElementById('modalAnalisisIA'));
  modal.show();

  // Mostrar spinner y ocultar resultados
  document.getElementById('iaSpinner').style.display = 'block';
  document.getElementById('iaResultado').style.display = 'none';
  document.getElementById('iaError').style.display = 'none';

  // Llamar a la API
  fetch('/api/ia/analizar', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'CSRF-Token': '<%= csrfToken %>'
    },
    body: JSON.stringify({})
  })
  .then(res => res.json())
  .then(data => {
    document.getElementById('iaSpinner').style.display = 'none';

    if (data.ok && data.analisis) {
      document.getElementById('iaResultado').textContent = data.analisis;
      document.getElementById('iaResultado').style.display = 'block';
    } else {
      document.getElementById('iaError').textContent = 'Error: ' + (data.error || 'No se pudo generar el análisis');
      document.getElementById('iaError').style.display = 'block';
    }
  })
  .catch(err => {
    document.getElementById('iaSpinner').style.display = 'none';
    document.getElementById('iaError').textContent = 'Error de conexión: ' + err.message;
    document.getElementById('iaError').style.display = 'block';
  });
}
</script>
