<!-- views/dashboard-new.ejs - REDISEÑO MODERNO Y MINIMALISTA -->

<div class="container-fluid py-5">
  <% if (user && user.rol === 'admin') { %>

  <!-- ════════════════════════════════════════════════════════════════
       ENCABEZADO
       ════════════════════════════════════════════════════════════════ -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Gestión operativa en tiempo real</p>
    </div>
    <div>
      <span id="semaforo-dot" class="semaforo-dot" style="background:#6c757d; width:16px; height:16px; border-radius:50%; display:inline-block;"></span>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       FRASE MOTIVACIONAL DE LA SEMANA
       ════════════════════════════════════════════════════════════════ -->
  <% if (frase) { %>
  <div class="alert alert-info mb-4" style="border-left: 4px solid #0ea5e9; background: #f0f9ff; color: #0c2d6b;">
    <p style="margin: 0; font-style: italic; font-size: 0.95rem;">
      💡 <%= frase %>
    </p>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       🔴 ALERTA CRÍTICA: PEDIDOS LISTOS PERO IMPAGOS (AL PRINCIPIO)
       ════════════════════════════════════════════════════════════════ -->
  <% if (pedidosListosImpagos && pedidosListosImpagos.length > 0) { %>
  <div class="card-minimal mb-5" style="border-left: 4px solid #ef4444; background: #fff5f5;">
    <div class="card-header" style="color: #ef4444; font-weight: bold;">
      🔴 ACCIÓN INMEDIATA: <%= pedidosListosImpagos.length %> Pedido(s) Listo(s) Sin Cobrar
    </div>
    <div class="table-responsive" style="margin: 0; padding: 1rem;">
      <table class="table table-sm mb-0" style="margin: 0;">
        <thead style="background: #ffebee;">
          <tr>
            <th>Pedido</th>
            <th>Cliente</th>
            <th>Monto</th>
            <th>Deuda</th>
            <th>Días</th>
            <th style="text-align: center;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% pedidosListosImpagos.forEach(ped => { %>
          <% const diasSinCobrar = Math.floor((new Date() - new Date(ped.fecha)) / (1000 * 60 * 60 * 24)); %>
          <tr style="border-bottom: 1px solid #ffcccc;">
            <td>
              <a href="/pedidos/detalle/<%= ped.id %>" style="font-weight: bold; color: #ef4444;">
                #<%= ped.id %>
              </a>
            </td>
            <td><%= ped.cliente_nombre || '(sin cliente)' %></td>
            <td>$<%= (ped.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
            <td style="font-weight: bold; color: #ef4444;">
              $<%= (ped.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
            </td>
            <td style="font-weight: bold;">
              <% if (diasSinCobrar > 10) { %>
                <span style="color: #ef4444;">🔴 <%= diasSinCobrar %> días</span>
              <% } else if (diasSinCobrar > 5) { %>
                <span style="color: #f59e0b;">🟡 <%= diasSinCobrar %> días</span>
              <% } else { %>
                <span style="color: #6b7280;"><%= diasSinCobrar %> días</span>
              <% } %>
            </td>
            <td style="text-align: center;">
              <div class="btn-group btn-sm" role="group">
                <a href="/pedidos/detalle/<%= ped.id %>" class="btn btn-sm btn-success" title="Cobrar">
                  💰 Cobrar
                </a>
                <a href="https://wa.me/?text=Hola! Tu pedido #<%= ped.id %> está listo para retirar. Total a pagar: $<%= (ped.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>"
                   target="_blank" class="btn btn-sm btn-info" title="Enviar WhatsApp">
                  📱
                </a>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
        <tfoot style="background: #ffcccc; font-weight: bold;">
          <tr>
            <td colspan="4" style="text-align: right;">TOTAL PENDIENTE:</td>
            <td colspan="2" style="color: #ef4444; text-align: center;">$<%= totalImpago.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       KPI CARDS - 4 COLUMNAS
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- INGRESOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">💰</div>
        <div class="kpi-label">Ingresos este mes</div>
        <div class="kpi-value" style="color: #10b981;">
          $<%= ingresosMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% if (cambioIngresos >= 0) { %>
            <span style="color: #10b981;">↑ <%= cambioIngresos.toFixed(0) %>%</span> vs mes anterior
          <% } else { %>
            <span style="color: #ef4444;">↓ <%= Math.abs(cambioIngresos).toFixed(0) %>%</span> vs mes anterior
          <% } %>
        </div>
      </div>
    </div>

    <!-- GASTOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📊</div>
        <div class="kpi-label">Gastos este mes</div>
        <div class="kpi-value" style="color: #ef4444;">
          $<%= gastosTotalMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Directos + Fijos + Cuotas
        </div>
      </div>
    </div>

    <!-- RESULTADO NETO -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📈</div>
        <div class="kpi-label">Resultado neto</div>
        <div class="kpi-value" style="color: <%= saldoNeto >= 0 ? '#10b981' : '#ef4444' %>;">
          <%= saldoNeto >= 0 ? '+' : '-' %>$<%= Math.abs(saldoNeto).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% const porcentaje = ingresosMes > 0 ? ((saldoNeto / ingresosMes) * 100).toFixed(1) : 0; %>
          <%= porcentaje %>% de margen
        </div>
      </div>
    </div>

    <!-- DEUDA PENDIENTE -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">⚠️</div>
        <div class="kpi-label">Deuda a clientes</div>
        <div class="kpi-value" style="color: #f59e0b;">
          $<%= deudaTotal.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Monto pendiente de cobrar
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       MÉTRICAS OPERATIVAS (Caja Hoy + Conversión + Cobro)
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- CAJA HOY vs META DIARIA -->
    <div class="col-lg-4 col-md-6">
      <div class="card-minimal">
        <div style="margin-bottom: 1rem;">
          <div style="font-size: 0.9rem; color: #6b7280; text-transform: uppercase; font-weight: 600;">📊 Caja Hoy</div>
          <div style="font-size: 1.5rem; font-weight: bold; color: #3b82f6; margin-top: 0.5rem;">
            <%= porcentajeMeta.toFixed(0) %>%
          </div>
          <div style="font-size: 0.85rem; color: #6b7280; margin-top: 0.5rem;">
            $<%= ingresosHoy.toLocaleString('es-AR', {maximumFractionDigits: 0}) %> / $<%= metaDiaria.toFixed(0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
          </div>
        </div>
      </div>
    </div>

    <!-- TASA DE CONVERSIÓN PRESUPUESTOS → PEDIDOS -->
    <div class="col-lg-4 col-md-6">
      <div class="card-minimal">
        <div style="margin-bottom: 1rem;">
          <div style="font-size: 0.9rem; color: #6b7280; text-transform: uppercase; font-weight: 600;">📈 Conversión</div>
          <div style="font-size: 1.5rem; font-weight: bold; color: #10b981; margin-top: 0.5rem;">
            <%= tasaConversion %>%
          </div>
          <div style="font-size: 0.85rem; color: #6b7280; margin-top: 0.5rem;">
            <% if (presupuestosAceptadosEsteMes > 0) { %>
              <%= pedidosCreados %> pedidos de <%= presupuestosAceptadosEsteMes %> presupuestos
            <% } else { %>
              Sin presupuestos aceptados
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- DÍAS PROMEDIO DE COBRO -->
    <div class="col-lg-4 col-md-6">
      <div class="card-minimal">
        <div style="margin-bottom: 1rem;">
          <div style="font-size: 0.9rem; color: #6b7280; text-transform: uppercase; font-weight: 600;">⏰ Cobro Promedio</div>
          <div style="font-size: 1.5rem; font-weight: bold; margin-top: 0.5rem;">
            <%= diasPromedioCobro %> <span style="font-size: 0.85rem; color: #6b7280;">días</span>
          </div>
          <div style="font-size: 0.85rem; color: #6b7280; margin-top: 0.5rem;">
            Meta: 7 días
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ACCIONES RÁPIDAS (simplificadas)
       ════════════════════════════════════════════════════════════════ -->
  <div class="card-minimal mb-5">
    <div class="card-header">Acciones Rápidas</div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/pedidos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-plus-circle"></i> Nuevo Pedido
      </a>
      <a href="/presupuestos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-calculator"></i> Nuevo Presupuesto
      </a>
      <a href="/deudas" class="btn-minimal btn-warning-minimal">
        <i class="bi bi-exclamation-triangle"></i> Gestionar Deudas
      </a>
      <a href="/gastos" class="btn-minimal btn-danger-minimal">
        <i class="bi bi-receipt"></i> Registrar Gasto
      </a>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ESTADO OPERATIVO DEL DÍA (mini-widget)
       ════════════════════════════════════════════════════════════════ -->
  <div class="card-minimal mb-5" style="background: #f8f9fa; padding: 1rem;">
    <div style="display: flex; justify-content: space-around; align-items: center; gap: 2rem; text-align: center; flex-wrap: wrap;">
      <div>
        <div style="font-size: 1.5rem; font-weight: 700; color: #f59e0b;">
          <%= pendientes || 0 %>
        </div>
        <small style="color: #6b7280;">Pendientes</small>
      </div>
      <div style="border-left: 1px solid #e5e7eb; padding-left: 2rem;">
        <div style="font-size: 1.5rem; font-weight: 700; color: #3b82f6;">
          <%= en_produccion || 0 %>
        </div>
        <small style="color: #6b7280;">En producción</small>
      </div>
      <div style="border-left: 1px solid #e5e7eb; padding-left: 2rem;">
        <div style="font-size: 1.5rem; font-weight: 700; color: #10b981;">
          <%= listos || 0 %>
        </div>
        <small style="color: #6b7280;">Listos</small>
      </div>
      <div style="border-left: 1px solid #e5e7eb; padding-left: 2rem;">
        <div style="font-size: 1.5rem; font-weight: 700; color: #6b7280;">
          <%= entregados || 0 %>
        </div>
        <small style="color: #6b7280;">Entregados</small>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ⚠️ STOCK CRÍTICO
       ════════════════════════════════════════════════════════════════ -->
  <% const stockEnCero = stockBajo.filter(s => s.cantidad === 0); %>
  <% const stockCritico = stockBajo.filter(s => s.cantidad > 0 && s.cantidad <= s.stock_minimo); %>

  <% if (stockEnCero.length > 0 || stockCritico.length > 0) { %>
  <div class="card-minimal mb-5" style="border-left: 4px solid #dc3545; background: #fff5f5;">
    <div class="card-header" style="color: #dc3545; font-weight: bold;">
      ⚠️ STOCK CRÍTICO
    </div>
    <div style="padding: 1rem;">
      <% if (stockEnCero.length > 0) { %>
      <div class="mb-3">
        <strong style="color: #dc3545;">🔴 EN CERO (No puedo vender):</strong>
        <% stockEnCero.forEach(s => { %>
        <div style="margin-top: 0.5rem; padding: 0.75rem; background: #ffebee; border-radius: 4px; border-left: 3px solid #dc3545;">
          <strong><%= s.nombre %></strong>
        </div>
        <% }); %>
      </div>
      <% } %>

      <% if (stockCritico.length > 0) { %>
      <div>
        <strong style="color: #f59e0b;">🟡 BAJO (próximo a terminar):</strong>
        <% stockCritico.forEach(s => { %>
        <div style="margin-top: 0.5rem; padding: 0.75rem; background: #fffbeb; border-radius: 4px; border-left: 3px solid #f59e0b;">
          <%= s.nombre %> — <strong><%= s.cantidad %></strong> / <%= s.stock_minimo %> <%= s.unidad %>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       DEUDAS Y GASTOS PENDIENTES
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- DEUDAS DE LA EMPRESA (SEPARADAS POR URGENCIA) -->
    <% if (countDeudas > 0) { %>
    <div class="col-md-6">
      <div class="card-minimal">
        <div class="card-header">💳 Deudas de la Empresa</div>

        <!-- VENCIDAS HOY -->
        <% if (deudasPorUrgencia.vencidas.length > 0) { %>
        <div style="margin-top: 1rem; padding: 0.75rem; background: #fff5f5; border-left: 3px solid #dc3545; border-radius: 4px;">
          <div style="font-weight: bold; color: #dc3545; font-size: 0.9rem; margin-bottom: 0.5rem;">
            🔴 VENCIDAS (Pagar HOY):
          </div>
          <% deudasPorUrgencia.vencidas.slice(0, 3).forEach(d => { %>
          <div style="margin-top: 0.5rem; padding: 0.5rem; background: rgba(220, 53, 69, 0.05); border-radius: 3px;">
            <div style="font-size: 0.85rem; font-weight: 600;">
              <%= d.concepto %>
            </div>
            <div style="font-size: 0.85rem; color: #dc3545; font-weight: bold;">
              $<%= (d.monto || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- PRÓXIMAS SEMANAS -->
        <% if (deudasPorUrgencia.urgentes.length > 0) { %>
        <div style="margin-top: 1rem; padding: 0.75rem; background: #fffbeb; border-left: 3px solid #f59e0b; border-radius: 4px;">
          <div style="font-weight: bold; color: #f59e0b; font-size: 0.9rem; margin-bottom: 0.5rem;">
            🟡 PRÓXIMAS SEMANAS:
          </div>
          <% deudasPorUrgencia.urgentes.slice(0, 3).forEach(d => { %>
          <div style="margin-top: 0.5rem; padding: 0.5rem; background: rgba(245, 158, 11, 0.05); border-radius: 3px;">
            <div style="font-size: 0.85rem; font-weight: 600;">
              <%= d.concepto %> <span style="color: #999; font-size: 0.75rem;">(en <%= d.diasHasta %> días)</span>
            </div>
            <div style="font-size: 0.85rem; color: #f59e0b; font-weight: bold;">
              $<%= (d.monto || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- LARGO PLAZO -->
        <% if (deudasPorUrgencia.largoPlazo.length > 0) { %>
        <div style="margin-top: 1rem; padding: 0.75rem; background: #f3f4f6; border-left: 3px solid #9ca3af; border-radius: 4px;">
          <div style="font-weight: bold; color: #6b7280; font-size: 0.9rem; margin-bottom: 0.5rem;">
            ⏳ LARGO PLAZO (> 2 semanas):
          </div>
          <div style="font-size: 0.85rem; color: #6b7280;">
            <%= deudasPorUrgencia.largoPlazo.length %> deuda(s) por un total de
            <strong>$<%= deudasPorUrgencia.largoPlazo.reduce((s, d) => s + (d.monto || 0), 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></strong>
          </div>
        </div>
        <% } %>

        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <small style="color: #6b7280;">Total adeudado</small>
              <div style="font-size: 1.3rem; font-weight: 700; color: #dc3545;">
                $<%= deudaEmpresa.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
            <a href="/deudas" class="btn btn-sm btn-outline-warning">
              <i class="bi bi-arrow-right"></i> Gestionar
            </a>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- GASTOS PENDIENTES -->
    <% if (gastos.pendientes.c > 0 || gastos.fijos.c > 0) { %>
    <div class="col-md-6">
      <div class="card-minimal">
        <div class="card-header">💸 Gastos Pendientes</div>
        <div class="row g-3 mt-3">
          <% if (gastos.pendientes.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #ffebee; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #c62828;">
                <%= gastos.pendientes.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Por Pagar</div>
              <div style="color: #dc3545; font-weight: bold; font-size: 0.9rem;">
                $<%= gastos.pendientes.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (gastos.fijos.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #f3e5f5; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #6a1b9a;">
                <%= gastos.fijos.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Gastos Fijos</div>
              <div style="color: #9c27b0; font-weight: bold; font-size: 0.9rem;">
                $<%= gastos.fijos.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <small style="color: #6b7280;">Total pendiente</small>
              <div style="font-size: 1.5rem; font-weight: 700; color: #9c27b0;">
                $<%= (gastos.pendientes.total + gastos.fijos.total).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
            <a href="/gastos" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-arrow-right"></i> Ver gastos
            </a>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       PRÓXIMOS VENCIMIENTOS
       ════════════════════════════════════════════════════════════════ -->
  <% if (proximosVencimientos && proximosVencimientos.length > 0) { %>
  <div class="card-minimal">
    <div class="card-header">Próximos 5 Vencimientos</div>
    <div class="table-responsive mt-3">
      <table class="table-minimal">
        <thead>
          <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% proximosVencimientos.forEach(v => { %>
          <% const prioridad = v.prioridad || { clase: 'badge-default', label: 'Sin prioridad' }; %>
          <tr>
            <td><strong><%= v.concepto %></strong></td>
            <td><%= new Date(v.fecha_str || v.fecha).toLocaleDateString('es-AR') %></td>
            <td>$<%= v.monto.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></td>
            <td>
              <span class="badge-minimal <%= prioridad.clase %>">
                <%= prioridad.label %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <% } else { %>
  <!-- USUARIO NO ADMIN -->
  <div class="alert-minimal alert-info-minimal">
    <i class="bi bi-info-circle"></i>
    <div>
      <strong>Acceso limitado</strong><br>
      El dashboard está disponible solo para administradores.
    </div>
  </div>
  <% } %>
</div>

<!-- SCRIPT PARA CARGAR SEMÁFORO -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('/api/semaforo');
    const data = await res.json();
    if (data.mostrar && document.getElementById('semaforo-dot')) {
      document.getElementById('semaforo-dot').style.background =
        data.color === 'success' ? '#10b981' :
        data.color === 'warning' ? '#f59e0b' :
        '#ef4444';
    }
  } catch (e) {
    console.error('Error cargando semáforo:', e);
  }
});
</script>
