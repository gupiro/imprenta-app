<!-- views/dashboard-new.ejs - REDISEÑO MODERNO Y MINIMALISTA -->

<div class="container-fluid py-5">
  <% if (user && user.rol === 'admin') { %>

  <!-- ════════════════════════════════════════════════════════════════
       ENCABEZADO
       ════════════════════════════════════════════════════════════════ -->
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Resumen de tu negocio hoy</p>
    </div>
    <div>
      <span id="semaforo-dot" class="semaforo-dot" style="background:#6c757d; width:16px; height:16px; border-radius:50%; display:inline-block;"></span>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       FRASE MOTIVACIONAL
       ════════════════════════════════════════════════════════════════ -->
  <% if (frase) { %>
  <div class="alert alert-info alert-soft mb-4 border-0" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 4px solid #0ea5e9;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <span style="font-size: 20px;">💡</span>
      <p style="margin: 0; font-style: italic; color: #0c2d6b; font-weight: 500;">
        <%= frase %>
      </p>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       KPI CARDS - 4 COLUMNAS
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- INGRESOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">💰</div>
        <div class="kpi-label">Ingresos este mes</div>
        <div class="kpi-value" style="color: #10b981;">
          $<%= ingresosMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% if (cambioIngresos >= 0) { %>
            <span style="color: #10b981;">↑ <%= cambioIngresos.toFixed(0) %>%</span> vs mes anterior
          <% } else { %>
            <span style="color: #ef4444;">↓ <%= Math.abs(cambioIngresos).toFixed(0) %>%</span> vs mes anterior
          <% } %>
        </div>
      </div>
    </div>

    <!-- GASTOS -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📊</div>
        <div class="kpi-label">Gastos este mes</div>
        <div class="kpi-value" style="color: #ef4444;">
          $<%= gastosTotalMes.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Directos + Fijos + Cuotas
        </div>
      </div>
    </div>

    <!-- RESULTADO NETO -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">📈</div>
        <div class="kpi-label">Resultado neto</div>
        <div class="kpi-value" style="color: <%= saldoNeto >= 0 ? '#10b981' : '#ef4444' %>;">
          <%= saldoNeto >= 0 ? '+' : '-' %>$<%= Math.abs(saldoNeto).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          <% const porcentaje = ingresosMes > 0 ? ((saldoNeto / ingresosMes) * 100).toFixed(1) : 0; %>
          <%= porcentaje %>% de margen
        </div>
      </div>
    </div>

    <!-- DEUDA PENDIENTE -->
    <div class="col-lg-3 col-md-6">
      <div class="kpi-card">
        <div class="kpi-icon">⚠️</div>
        <div class="kpi-label">Deuda a clientes</div>
        <div class="kpi-value" style="color: #f59e0b;">
          $<%= deudaTotal.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
        </div>
        <div class="kpi-change">
          Monto pendiente de cobrar
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ACCIONES RÁPIDAS
       ════════════════════════════════════════════════════════════════ -->
  <div class="card-minimal mb-5">
    <div class="card-header">Acciones Rápidas</div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/pedidos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-plus-circle"></i> Nuevo Pedido
      </a>
      <a href="/presupuestos/nuevo" class="btn-minimal btn-primary-minimal">
        <i class="bi bi-calculator"></i> Nuevo Presupuesto
      </a>
      <a href="/pedidos/vista-rapida" class="btn-minimal btn-secondary-minimal">
        <i class="bi bi-eye"></i> Vista Rápida
      </a>
      <a href="/deudas" class="btn-minimal btn-warning-minimal">
        <i class="bi bi-exclamation-triangle"></i> Deudas
      </a>
      <a href="/gastos" class="btn-minimal btn-danger-minimal">
        <i class="bi bi-receipt"></i> Gastos
      </a>
      <a href="/reportes" class="btn-minimal btn-secondary-minimal">
        <i class="bi bi-bar-chart"></i> Reportes
      </a>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       🔴 ALERTA: PEDIDOS LISTOS PERO IMPAGOS (CRÍTICO)
       ════════════════════════════════════════════════════════════════ -->
  <% if (pedidosListosImpagos && pedidosListosImpagos.length > 0) { %>
  <div class="card-minimal mb-5" style="border-left: 4px solid #ef4444; background: #fff5f5;">
    <div class="card-header" style="color: #ef4444; font-weight: bold;">
      <i class="bi bi-exclamation-circle-fill"></i> ⚠️ ACCIÓN REQUERIDA: <%= pedidosListosImpagos.length %> Pedido(s) Listo(s) Sin Cobrar
    </div>
    <div class="table-responsive" style="margin: 0; padding: 1rem;">
      <table class="table table-sm mb-0" style="margin: 0;">
        <thead style="background: #ffebee;">
          <tr>
            <th>Pedido #</th>
            <th>Cliente</th>
            <th>Monto</th>
            <th>Deuda</th>
            <th style="text-align: center;">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% pedidosListosImpagos.forEach(ped => { %>
          <tr style="border-bottom: 1px solid #ffcccc;">
            <td>
              <a href="/pedidos/detalle/<%= ped.id %>" style="font-weight: bold; color: #ef4444;">
                #<%= ped.id %>
              </a>
            </td>
            <td><%= ped.cliente_nombre || '(sin cliente)' %></td>
            <td>$<%= (ped.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
            <td style="font-weight: bold; color: #ef4444;">
              $<%= (ped.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
            </td>
            <td style="text-align: center;">
              <a href="/pedidos/detalle/<%= ped.id %>" class="btn btn-sm btn-danger" style="font-size: 0.8rem;">
                <i class="bi bi-cash-coin"></i> Cobrar
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
        <tfoot style="background: #ffcccc; font-weight: bold;">
          <tr>
            <td colspan="3" style="text-align: right;">TOTAL PENDIENTE:</td>
            <td colspan="2" style="color: #ef4444;">$<%= totalImpago.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       ESTADOS DE PEDIDOS
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <div class="col-md-12">
      <div class="card-minimal">
        <div class="card-header">Estado de Pedidos</div>
        <div class="row g-4 mt-2">
          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #f59e0b;">
                <%= pendientes || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Pendientes
              </div>
              <a href="/pedidos/pendientes" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #3b82f6;">
                <%= en_produccion || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                En Producción
              </div>
              <a href="/pedidos/en-produccion" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #10b981;">
                <%= listos || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Listos
              </div>
              <a href="/pedidos/listos" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>

          <div class="col-lg-3 col-sm-6">
            <div style="text-align: center;">
              <div style="font-size: 2.5rem; font-weight: 700; color: #6b7280;">
                <%= entregados || 0 %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 0.5rem;">
                Entregados
              </div>
              <a href="/pedidos/entregados" style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; color: #2563eb; text-decoration: none;">
                Ver pedidos →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       DEUDAS Y GASTOS PENDIENTES
       ════════════════════════════════════════════════════════════════ -->
  <div class="row mb-5 g-4">
    <!-- DEUDAS DE LA EMPRESA -->
    <% if (countDeudas > 0) { %>
    <div class="col-md-6">
      <div class="card-minimal">
        <div class="card-header">💳 Deudas de la Empresa</div>
        <div class="row g-3 mt-3">
          <% if (deudas.tarjetas.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #fff3cd; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #856404;">
                <%= deudas.tarjetas.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Tarjetas</div>
              <div style="color: #d97706; font-weight: bold; font-size: 0.9rem;">
                $<%= deudas.tarjetas.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (deudas.cheques.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #f8d7da; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #721c24;">
                <%= deudas.cheques.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Cheques</div>
              <div style="color: #dc3545; font-weight: bold; font-size: 0.9rem;">
                $<%= deudas.cheques.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (deudas.prestamos.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #d1ecf1; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #0c5460;">
                <%= deudas.prestamos.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Préstamos</div>
              <div style="color: #17a2b8; font-weight: bold; font-size: 0.9rem;">
                $<%= deudas.prestamos.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (deudas.proveedores.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #e7e8ea; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #383d41;">
                <%= deudas.proveedores.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Proveedores</div>
              <div style="color: #6c757d; font-weight: bold; font-size: 0.9rem;">
                $<%= deudas.proveedores.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <small style="color: #6b7280;">Total adeudado</small>
              <div style="font-size: 1.5rem; font-weight: 700; color: #dc3545;">
                $<%= deudaEmpresa.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
            <a href="/deudas" class="btn btn-sm btn-outline-warning">
              <i class="bi bi-arrow-right"></i> Ver detalles
            </a>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- GASTOS PENDIENTES -->
    <% if (gastos.pendientes.c > 0 || gastos.fijos.c > 0) { %>
    <div class="col-md-6">
      <div class="card-minimal">
        <div class="card-header">💸 Gastos Pendientes</div>
        <div class="row g-3 mt-3">
          <% if (gastos.pendientes.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #ffebee; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #c62828;">
                <%= gastos.pendientes.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Por Pagar</div>
              <div style="color: #dc3545; font-weight: bold; font-size: 0.9rem;">
                $<%= gastos.pendientes.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>

          <% if (gastos.fijos.c > 0) { %>
          <div class="col-6">
            <div style="text-align: center; padding: 1rem; background: #f3e5f5; border-radius: 8px;">
              <div style="font-size: 1.5rem; font-weight: 700; color: #6a1b9a;">
                <%= gastos.fijos.c %>
              </div>
              <div style="color: #6b7280; font-size: 0.875rem; margin-bottom: 0.5rem;">Gastos Fijos</div>
              <div style="color: #9c27b0; font-weight: bold; font-size: 0.9rem;">
                $<%= gastos.fijos.total.toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
          </div>
          <% } %>
        </div>
        <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <small style="color: #6b7280;">Total pendiente</small>
              <div style="font-size: 1.5rem; font-weight: 700; color: #9c27b0;">
                $<%= (gastos.pendientes.total + gastos.fijos.total).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
              </div>
            </div>
            <a href="/gastos" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-arrow-right"></i> Ver gastos
            </a>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       PRÓXIMOS VENCIMIENTOS
       ════════════════════════════════════════════════════════════════ -->
  <% if (proximosVencimientos && proximosVencimientos.length > 0) { %>
  <div class="card-minimal">
    <div class="card-header">Próximos 5 Vencimientos</div>
    <div class="table-responsive mt-3">
      <table class="table-minimal">
        <thead>
          <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% proximosVencimientos.forEach(v => { %>
          <% const prioridad = v.prioridad || { clase: 'badge-default', label: 'Sin prioridad' }; %>
          <tr>
            <td><strong><%= v.concepto %></strong></td>
            <td><%= new Date(v.fecha_str || v.fecha).toLocaleDateString('es-AR') %></td>
            <td>$<%= v.monto.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></td>
            <td>
              <span class="badge-minimal <%= prioridad.clase %>">
                <%= prioridad.label %>
              </span>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <% } else { %>
  <!-- USUARIO NO ADMIN -->
  <div class="alert-minimal alert-info-minimal">
    <i class="bi bi-info-circle"></i>
    <div>
      <strong>Acceso limitado</strong><br>
      El dashboard está disponible solo para administradores.
    </div>
  </div>
  <% } %>
</div>

<!-- SCRIPT PARA CARGAR SEMÁFORO -->
<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch('/api/semaforo');
    const data = await res.json();
    if (data.mostrar && document.getElementById('semaforo-dot')) {
      document.getElementById('semaforo-dot').style.background =
        data.color === 'success' ? '#10b981' :
        data.color === 'warning' ? '#f59e0b' :
        '#ef4444';
    }
  } catch (e) {
    console.error('Error cargando semáforo:', e);
  }
});
</script>
