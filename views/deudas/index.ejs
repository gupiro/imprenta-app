<!-- views/deudas/index.ejs -->
<div class="container-fluid py-0 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-1">
    <div class="col-md-12">
      <h5 class="mb-0" style="font-size: 1rem;"><i class="bi bi-cash-stack"></i> Gestión de Deudas</h5>
      <p class="text-muted small mb-0" style="font-size: 0.75rem;">Control centralizado de pasivos financieros</p>
    </div>
  </div>

  <!-- TOTALES POR TIPO DE DEUDA -->
  <div class="row mb-1">
    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">💳 Tarjetas</p>
          <h6 class="mb-0 text-danger" style="font-size: 1rem;">$<%= totalTarjetas.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></h6>
          <small class="text-danger" style="font-size: 0.65rem;"><%= conteoTarjetas %> act.</small>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">📝 Cheques</p>
          <h6 class="mb-0 text-warning" style="font-size: 1rem;">$<%= totalCheques.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></h6>
          <small class="text-warning" style="font-size: 0.65rem;"><%= conteoCheques %> pend.</small>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0dcaf0;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">🏦 Préstamos</p>
          <h6 class="mb-0 text-info" style="font-size: 1rem;">$<%= totalPrestamos.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></h6>
          <small class="text-info" style="font-size: 0.65rem;"><%= conteoPrestamos %> act.</small>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">🏪 Proveedores</p>
          <h6 class="mb-0 text-success" style="font-size: 1rem;">$<%= totalProveedores.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></h6>
          <small class="text-success" style="font-size: 0.65rem;"><%= conteoProveedores %> deud.</small>
        </div>
      </div>
    </div>
  </div>

  <!-- DEUDA TOTAL CONSOLIDADA -->
  <div class="row mb-1">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm" style="border-left: 6px solid #6f42c1;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">DEUDA TOTAL</p>
          <h5 class="mb-0 text-primary" style="font-size: 1.1rem;">$<%= deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></h5>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTONES DE ACCESO RÁPIDO -->
  <div class="row mb-1">
    <div class="col-md-6 mb-1">
      <div class="card border-0 shadow-sm h-100 cursor-pointer" style="cursor: pointer;" onclick="window.location.href='/deudas/tarjetas'">
        <div class="card-body p-1">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <i class="bi bi-credit-card" style="font-size: 1.5rem; color: #dc3545;"></i>
            </div>
            <div class="flex-grow-1 ms-2">
              <h6 class="card-title mb-0" style="font-size: 0.9rem;">Tarjetas</h6>
              <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">Gestionar saldos</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-1">
      <div class="card border-0 shadow-sm h-100 cursor-pointer" style="cursor: pointer;" onclick="window.location.href='/deudas/cheques'">
        <div class="card-body p-1">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <i class="bi bi-file-earmark-check" style="font-size: 1.5rem; color: #ffc107;"></i>
            </div>
            <div class="flex-grow-1 ms-2">
              <h6 class="card-title mb-0" style="font-size: 0.9rem;">Cheques</h6>
              <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">Cheques diferidos</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-1">
      <div class="card border-0 shadow-sm h-100 cursor-pointer" style="cursor: pointer;" onclick="window.location.href='/deudas/prestamos'">
        <div class="card-body p-1">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <i class="bi bi-bank" style="font-size: 1.5rem; color: #0dcaf0;"></i>
            </div>
            <div class="flex-grow-1 ms-2">
              <h6 class="card-title mb-0" style="font-size: 0.9rem;">Préstamos</h6>
              <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">Control de cuotas</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-1">
      <div class="card border-0 shadow-sm h-100 cursor-pointer" style="cursor: pointer;" onclick="window.location.href='/deudas/proveedores-deuda'">
        <div class="card-body p-1">
          <div class="d-flex align-items-center">
            <div class="flex-shrink-0">
              <i class="bi bi-building" style="font-size: 1.5rem; color: #198754;"></i>
            </div>
            <div class="flex-grow-1 ms-2">
              <h6 class="card-title mb-0" style="font-size: 0.9rem;">Proveedores</h6>
              <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">Cuentas por pagar</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTONES DE ACCIONES -->
  <div class="row mb-1">
    <div class="col-md-12">
      <div class="btn-group w-100" role="group">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
          <i class="bi bi-printer"></i> Imprimir
        </button>
        <a href="/deudas/reporte-pdf" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-file-pdf"></i> Descargar PDF
        </a>
      </div>
    </div>
  </div>

  <!-- GRÁFICOS REMOVIDOS POR PERFORMANCE -->
  <!-- Gráficos causaban auto-scroll al cargar dinámicamente -->

  <!-- BUSCADOR Y FILTROS -->
  <div class="row mb-1">
    <div class="col-md-8">
      <div class="input-group input-group-sm">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="buscarDeudas" class="form-control" placeholder="Buscar...">
        <select id="filtroTipo" class="form-select" style="max-width: 130px;">
          <option value="todos">Todos</option>
          <option value="tarjetas">Tarjetas</option>
          <option value="cheques">Cheques</option>
          <option value="prestamos">Préstamos</option>
          <option value="proveedores">Proveedores</option>
        </select>
      </div>
    </div>
    <div class="col-md-4 text-end">
      <a href="/deudas/reporte-pdf" class="btn btn-sm btn-danger" style="font-size: 0.8rem;">PDF</a>
    </div>
  </div>

  <!-- RESULTADOS DE BÚSQUEDA (oculto por defecto) -->
  <div id="resultadosBusqueda" style="display: none;">
    <div class="row mb-1">
      <div class="col-md-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-1">
            <h6 class="card-title mb-1" style="font-size: 0.75rem;">Resultados de Búsqueda</h6>
            <div id="listaResultados"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VENCIMIENTOS PRÓXIMOS (30 DÍAS) -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-1">
          <h6 class="card-title mb-1" style="font-size: 0.75rem;">Vencimientos (30 días)</h6>
          <% if (vencimientosProximos.length === 0) { %>
            <div class="alert alert-info mb-0 p-1" style="font-size: 0.75rem;">
              Sin vencimientos próximos.
            </div>
          <% } else { %>
            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
              <table class="table table-hover mb-0 sm" style="font-size: 0.75rem;">
                <thead class="table-light">
                  <tr>
                    <th style="width: 70px; padding: 0.2rem;">Tipo</th>
                    <th style="padding: 0.2rem;">Descripción</th>
                    <th style="width: 90px; padding: 0.2rem;">Monto</th>
                    <th style="width: 100px; padding: 0.2rem;">Vencimiento</th>
                    <th style="width: 80px; padding: 0.2rem;">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  <% vencimientosProximos.forEach(v => {
                    const today = new Date();
                    today.setHours(0,0,0,0);
                    const vencDate = new Date(v.fecha_vencimiento);
                    vencDate.setHours(0,0,0,0);
                    const diasDifference = Math.floor((vencDate - today) / (1000 * 60 * 60 * 24));
                    const vencido = diasDifference < 0;
                    const proximo = diasDifference <= 7 && !vencido;
                  %>
                    <tr>
                      <td style="padding: 0.2rem;">
                        <% if (v.tipo === 'cheque') { %>
                          <span class="badge bg-warning text-dark" style="font-size: 0.6rem;">Cheque</span>
                        <% } else if (v.tipo === 'proveedor') { %>
                          <span class="badge bg-success" style="font-size: 0.6rem;">Prov.</span>
                        <% } %>
                      </td>
                      <td style="padding: 0.2rem;"><strong><%= v.descripcion %></strong></td>
                      <td style="padding: 0.2rem;">$<%= v.monto.toLocaleString('es-AR', {minimumFractionDigits: 0}) %></td>
                      <td style="padding: 0.2rem;"><%= new Date(v.fecha_vencimiento).toLocaleDateString('es-AR') %></td>
                      <td style="padding: 0.2rem;">
                        <% if (vencido) { %>
                          <span class="badge bg-danger" style="font-size: 0.6rem;">Vencido</span>
                        <% } else if (proximo) { %>
                          <span class="badge bg-warning text-dark" style="font-size: 0.6rem;">Próximo</span>
                        <% } else { %>
                          <span class="badge bg-success" style="font-size: 0.6rem;">Normal</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Gráficos removidos por performance

  // ════════════════════════════════════════════════════════════════
  // BÚSQUEDA Y FILTROS
  // ════════════════════════════════════════════════════════════════

  let timerBusqueda;

  document.getElementById('buscarDeudas').addEventListener('keyup', function() {
    clearTimeout(timerBusqueda);
    const q = this.value;
    const tipo = document.getElementById('filtroTipo').value;

    if (q.length < 2) {
      document.getElementById('resultadosBusqueda').style.display = 'none';
      return;
    }

    timerBusqueda = setTimeout(async () => {
      try {
        const response = await fetch(`/deudas/buscar?q=${encodeURIComponent(q)}&tipo=${tipo}`);
        const resultados = await response.json();

        if (resultados.error) {
          console.error('Error:', resultados.error);
          return;
        }

        mostrarResultados(resultados);
      } catch (err) {
        console.error('Error en búsqueda:', err);
      }
    }, 500);
  });

  document.getElementById('filtroTipo').addEventListener('change', function() {
    const q = document.getElementById('buscarDeudas').value;
    if (q.length >= 2) {
      document.getElementById('buscarDeudas').dispatchEvent(new Event('keyup'));
    }
  });

  function mostrarResultados(resultados) {
    const contenedor = document.getElementById('listaResultados');

    if (resultados.length === 0) {
      contenedor.innerHTML = '<p class="text-muted">Sin resultados</p>';
      document.getElementById('resultadosBusqueda').style.display = 'block';
      return;
    }

    let html = '<div class="list-group">';
    resultados.forEach(r => {
      let badge = '';
      let color = 'primary';
      if (r.tipo === 'tarjeta') {
        badge = 'Tarjeta';
        color = 'danger';
      } else if (r.tipo === 'cheque') {
        badge = 'Cheque';
        color = 'warning';
      } else if (r.tipo === 'prestamo') {
        badge = 'Préstamo';
        color = 'info';
      } else {
        badge = 'Proveedor';
        color = 'success';
      }

      const url = r.tipo === 'tarjeta' ? `/deudas/tarjetas#card-${r.id}` :
                  r.tipo === 'cheque' ? `/deudas/cheques#card-${r.id}` :
                  r.tipo === 'prestamo' ? `/deudas/prestamos#card-${r.id}` :
                  `/deudas/proveedores-deuda#card-${r.id}`;

      html += `
        <a href="${url}" class="list-group-item list-group-item-action">
          <div class="d-flex w-100 justify-content-between">
            <h6 class="mb-1">
              <span class="badge bg-${color} me-2">${badge}</span>
              ${r.nombre}
            </h6>
            <small>$${r.monto.toLocaleString('es-AR', {minimumFractionDigits: 2})}</small>
          </div>
          <p class="mb-1"><small class="text-muted">${r.estado}</small></p>
        </a>
      `;
    });
    html += '</div>';
    contenedor.innerHTML = html;
    document.getElementById('resultadosBusqueda').style.display = 'block';
  }

  // Cargar gráficos al iniciar
  document.addEventListener('DOMContentLoaded', cargarGraficos);
</script>
