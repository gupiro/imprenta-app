<!-- Page: Deudores -->
<div class="container-lg py-4">
  <!-- BANNER RESUMEN -->
  <div class="row mb-4">
    <div class="col-12">
      <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 2rem; color: white; box-shadow: 0 10px 30px rgba(245, 158, 11, 0.2);">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 2rem;">
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; margin-bottom: 0.5rem;">💰 Deuda Total</div>
            <div style="font-size: 2rem; font-weight: 800;">$<%= totalDeuda.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
          </div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; margin-bottom: 0.5rem;">👥 Deudores</div>
            <div style="font-size: 2rem; font-weight: 800;"><%= totalClientes %></div>
          </div>
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; margin-bottom: 0.5rem;">📊 Promedio</div>
            <div style="font-size: 2rem; font-weight: 800;">$<%= promedio.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA DE DEUDORES -->
  <div class="row">
    <div class="col-12">
      <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="padding: 1.5rem; border-bottom: 1px solid #e5e7eb;">
          <h5 style="margin: 0;">📋 Deudores Activos</h5>
        </div>

        <% if (deudores.length === 0) { %>
          <div style="padding: 3rem; text-align: center; color: #6b7280;">
            <i class="bi bi-check-circle" style="font-size: 3rem; margin-bottom: 1rem; display: block; opacity: 0.5;"></i>
            <p>¡Excelente! No hay deudores pendientes 🎉</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background: #f9fafb; border-top: 1px solid #e5e7eb;">
                <tr>
                  <th style="padding: 1rem; font-weight: 700; color: #374151;">Cliente</th>
                  <th style="padding: 1rem; font-weight: 700; color: #374151;" class="d-none d-md-table-cell">Teléfono</th>
                  <th style="padding: 1rem; font-weight: 700; color: #374151; text-align: right;">Deuda</th>
                  <th style="padding: 1rem; font-weight: 700; color: #374151; text-align: center;" class="d-none d-md-table-cell">Pedidos</th>
                  <th style="padding: 1rem; font-weight: 700; color: #374151;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% deudores.forEach(deudor => { %>
                  <tr style="border-bottom: 1px solid #e5e7eb;">
                    <td style="padding: 1rem; vertical-align: middle;">
                      <div style="font-weight: 700; color: #111827;"><%= deudor.name %></div>
                      <div style="font-size: 0.85rem; color: #6b7280;" class="d-md-none"><%= deudor.phone || '(sin teléfono)' %></div>
                    </td>
                    <td style="padding: 1rem; vertical-align: middle; color: #6b7280;" class="d-none d-md-table-cell">
                      <% if (deudor.phone) { %>
                        <a href="https://wa.me/<%= deudor.phone.replace(/\D/g, '') %>" target="_blank" style="color: #16a34a; text-decoration: none;">
                          <i class="bi bi-whatsapp"></i> <%= deudor.phone %>
                        </a>
                      <% } else { %>
                        <span style="color: #d1d5db;">(sin teléfono)</span>
                      <% } %>
                    </td>
                    <td style="padding: 1rem; text-align: right; vertical-align: middle;">
                      <div style="font-weight: 800; color: #dc2626; font-size: 1.1rem;">$<%= deudor.deuda_total.toLocaleString('es-AR', {maximumFractionDigits: 2}) %></div>
                    </td>
                    <td style="padding: 1rem; text-align: center; vertical-align: middle; color: #6b7280;" class="d-none d-md-table-cell">
                      <span class="badge bg-warning"><%= deudor.pedidos_pendientes %> pedido<%= deudor.pedidos_pendientes !== 1 ? 's' : '' %></span>
                    </td>
                    <td style="padding: 1rem; vertical-align: middle;">
                      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <!-- WhatsApp -->
                        <% if (deudor.phone) { %>
                          <button class="btn btn-sm btn-success" onclick="abrirWhatsApp('<%= deudor.phone.replace(/\D/g, '') %>', '<%= deudor.name %>', <%= deudor.deuda_total %>, <%= JSON.stringify(deudor.pedidos).replace(/'/g, "\\'") %>)" title="Enviar por WhatsApp">
                            <i class="bi bi-whatsapp"></i>
                          </button>
                        <% } %>

                        <!-- Pagar -->
                        <button class="btn btn-sm btn-primary" onclick="abrirModalPago('<%= deudor.id %>', '<%= deudor.name %>', <%= deudor.deuda_total %>, '<%= JSON.stringify(deudor.pedidos).replace(/'/g, "\\'") %>')" title="Registrar pago">
                          <i class="bi bi-cash-coin"></i> Pagar
                        </button>

                        <!-- Ver Pedidos -->
                        <a href="/pedidos/pendientes?cliente_id=<%= deudor.id %>" class="btn btn-sm btn-outline-secondary" title="Ver pedidos del cliente">
                          <i class="bi bi-link-45deg"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Pagar Deudor -->
<div class="modal fade" id="modalPagarDeudor" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-cash-coin"></i> Registrar Pago</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formPagarDeudor" onsubmit="event.preventDefault(); registrarPago();">
        <div class="modal-body">
          <!-- Info Cliente -->
          <div class="mb-3">
            <label class="form-label fw-bold">Cliente</label>
            <div id="infoPagoCliente" style="padding: 0.75rem; background: #f3f4f6; border-radius: 8px; font-weight: 600;"></div>
          </div>

          <!-- Deuda Total -->
          <div class="mb-3">
            <label class="form-label fw-bold">Deuda Total</label>
            <div id="infoPagoDeudaTotal" style="font-size: 1.5rem; font-weight: 800; color: #dc2626;"></div>
          </div>

          <!-- Lista de Pedidos con Checkbox -->
          <div class="mb-3">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <label class="form-label fw-bold mb-0">Pedidos a Pagar</label>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="seleccionarTodosPedidos()">
                Seleccionar Todo
              </button>
            </div>
            <div id="listaPedidosPago" style="max-height: 250px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.75rem;">
            </div>
          </div>

          <!-- Monto a Pagar -->
          <div class="mb-3">
            <label class="form-label fw-bold">Monto a Pagar *</label>
            <div class="input-group input-group-lg">
              <span class="input-group-text">$</span>
              <input type="number" id="montoPagar" class="form-control"
                     step="0.01" min="0.01" placeholder="0.00" required>
            </div>
            <small class="form-text text-muted">Máximo: <span id="montoMaximo">$0</span></small>
          </div>

          <!-- Método de Pago -->
          <div class="mb-3">
            <label class="form-label fw-bold">Método de Pago *</label>
            <select id="metodoPago" class="form-select form-select-lg" required>
              <option value="">-- Seleccionar --</option>
              <option value="Efectivo">💵 Efectivo</option>
              <option value="Transferencia">🏦 Transferencia</option>
              <option value="Tarjeta">💳 Tarjeta</option>
            </select>
          </div>

          <!-- Nota -->
          <div class="mb-0">
            <label class="form-label fw-bold">Nota (opcional)</label>
            <textarea id="notaPago" class="form-control" rows="2"
                      placeholder="Ej: Pago en 2 cuotas, referencia banco..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" id="btnRegistrarPago" class="btn btn-primary btn-lg">
            <i class="bi bi-check-circle"></i> Registrar Pago
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .pedido-checkbox {
    display: flex;
    align-items: center;
    padding: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: background 0.2s;
  }
  .pedido-checkbox:hover {
    background: #f9fafb;
  }
  .pedido-checkbox input[type="checkbox"] {
    margin-right: 0.75rem;
  }
  .pedido-info {
    flex: 1;
  }
  .pedido-monto {
    font-weight: 700;
    color: #dc2626;
    min-width: 80px;
    text-align: right;
  }
</style>

<script>
  // Datos globales del modal
  let clienteIdActual = null;
  let pedidosActuales = [];

  // Abrir modal de pago
  window.abrirModalPago = function(clienteId, clienteNombre, deudaTotal, pedidosJSON) {
    clienteIdActual = clienteId;
    pedidosActuales = JSON.parse(pedidosJSON);

    // Llenar datos
    document.getElementById('infoPagoCliente').textContent = clienteNombre;
    document.getElementById('infoPagoDeudaTotal').textContent = `$${deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 2})}`;
    document.getElementById('montoMaximo').textContent = `$${deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 2})}`;

    // Construir lista de pedidos
    const listaPedidos = document.getElementById('listaPedidosPago');
    listaPedidos.innerHTML = '';
    pedidosActuales.forEach(p => {
      const div = document.createElement('div');
      div.className = 'pedido-checkbox';
      div.innerHTML = `
        <input type="checkbox" class="pedido-check" value="${p.id}" data-monto="${p.monto_restante}">
        <div class="pedido-info">
          <div style="font-weight: 600; color: #111827;">Pedido #${p.id}</div>
          <div style="font-size: 0.85rem; color: #6b7280;">${p.detalle || '(sin detalle)'}</div>
        </div>
        <div class="pedido-monto">$${p.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 2})}</div>
      `;
      div.onclick = () => div.querySelector('input').click();
      listaPedidos.appendChild(div);
    });

    // Event listeners para checkboxes
    document.querySelectorAll('.pedido-check').forEach(cb => {
      cb.addEventListener('change', actualizarMontoSuma);
    });

    // Limpiar formulario
    document.getElementById('formPagarDeudor').reset();
    document.getElementById('metodoPago').value = '';
    document.getElementById('notaPago').value = '';

    // Mostrar modal
    const modal = new bootstrap.Modal(document.getElementById('modalPagarDeudor'));
    modal.show();
  };

  // Seleccionar todos los pedidos
  window.seleccionarTodosPedidos = function() {
    const checkboxes = document.querySelectorAll('.pedido-check');
    const todosSeleccionados = Array.from(checkboxes).every(cb => cb.checked);
    checkboxes.forEach(cb => cb.checked = !todosSeleccionados);
    actualizarMontoSuma();
  };

  // Actualizar monto automáticamente al tildar checkboxes
  function actualizarMontoSuma() {
    const montoPagar = document.getElementById('montoPagar');
    const suma = Array.from(document.querySelectorAll('.pedido-check:checked'))
      .reduce((sum, cb) => sum + parseFloat(cb.dataset.monto), 0);
    montoPagar.value = suma.toFixed(2);
  }

  // Registrar pago
  window.registrarPago = async function() {
    const clienteId = clienteIdActual;
    const montoTotal = parseFloat(document.getElementById('montoPagar').value);
    const metodoPago = document.getElementById('metodoPago').value;
    const nota = document.getElementById('notaPago').value;
    const pedidosIds = Array.from(document.querySelectorAll('.pedido-check:checked'))
      .map(cb => parseInt(cb.value));

    if (!montoTotal || montoTotal <= 0) {
      alert('⚠️ Ingresa un monto válido');
      return;
    }
    if (!metodoPago) {
      alert('⚠️ Selecciona un método de pago');
      return;
    }

    document.getElementById('btnRegistrarPago').disabled = true;
    document.getElementById('btnRegistrarPago').innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Registrando...';

    try {
      const res = await fetch('/deudores/pagar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          cliente_id: clienteId,
          monto_total: montoTotal,
          metodo_pago: metodoPago,
          nota: nota || null,
          pedidos_ids: pedidosIds
        })
      });

      const data = await res.json();

      if (data.ok) {
        // Mostrar success
        const toast = document.createElement('div');
        toast.className = 'alert alert-success alert-dismissible fade show';
        toast.style.position = 'fixed';
        toast.style.top = '20px';
        toast.style.right = '20px';
        toast.style.zIndex = '2000';
        toast.innerHTML = `
          ✅ ${data.message}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(toast);

        // Cerrar modal
        bootstrap.Modal.getInstance(document.getElementById('modalPagarDeudor')).hide();

        // Recargar página en 1 segundo
        setTimeout(() => location.reload(), 1000);
      } else {
        alert('❌ Error: ' + data.error);
      }
    } catch (err) {
      console.error(err);
      alert('❌ Error de conexión');
    } finally {
      document.getElementById('btnRegistrarPago').disabled = false;
      document.getElementById('btnRegistrarPago').innerHTML = '<i class="bi bi-check-circle"></i> Registrar Pago';
    }
  };

  // Enviar por WhatsApp
  window.abrirWhatsApp = function(telefono, nombre, deudaTotal, pedidosJSON) {
    const pedidos = JSON.parse(pedidosJSON);
    const listaPedidos = pedidos
      .map(p => `• Pedido #${p.id} - ${p.detalle || '(sin detalle)'} → $${p.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 2})}`)
      .join('\n');

    const mensaje = `Hola ${nombre}!

Te escribimos desde *Imprenta El Gráfico* de Orán, Salta.

Tu deuda actual es: *$${deudaTotal.toLocaleString('es-AR', {minimumFractionDigits: 2})}*

Pedidos pendientes:
${listaPedidos}

Podés abonar en el local o por transferencia.
¡Gracias! 🙏`;

    const url = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
    window.open(url, '_blank');
  };
</script>
