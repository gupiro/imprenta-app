<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card border-danger">
        <div class="card-header bg-danger text-white">
          <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Error del servidor</h4>
        </div>
        <div class="card-body">
          <p class="lead"><%= typeof mensaje !== 'undefined' ? mensaje : 'Ocurrió un error inesperado.' %></p>
          <% if (typeof error !== 'undefined' && error) { %>
            <pre class="bg-light p-3 rounded text-danger small"><%= error %></pre>
          <% } %>
          <a href="/" class="btn btn-primary mt-3"><i class="bi bi-house"></i> Volver al inicio</a>
        </div>
      </div>
    </div>
  </div>
</div>
