<!-- views/finanzas/facturas-recibidas.ejs - Profesional y responsive -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h1 class="display-6 mb-1"><i class="bi bi-file-earmark-invoice"></i> Facturas Recibidas</h1>
          <p class="text-muted mb-0">Gestión de comprobantes de proveedores</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm ms-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAyuda">
          <i class="bi bi-question-circle me-1"></i> ¿Cómo usar?
        </button>
      </div>
    </div>
    <div class="col-md-4 text-end">
      <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#modalNuevaFactura">
        <i class="bi bi-plus-circle"></i> Nueva Factura
      </button>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- SI NO HAY FACTURAS: EMPTY STATE -->
  <% if (!facturas || facturas.length === 0) { %>
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body py-5">
          <div class="text-center">
            <div style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.5;">📄</div>
            <h3 class="mb-2">Sin facturas registradas</h3>
            <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
              Aquí van las facturas que recibís de proveedores. Registrá cada comprobante para llevar control de gastos y pagos.
            </p>
            <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#modalNuevaFactura">
              <i class="bi bi-plus-circle"></i> Registrar Primera Factura
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% } else { %>

  <!-- RESUMEN: TOTALES -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="card-text small text-muted mb-2">💰 Monto Neto (sin IVA)</p>
          <h4 class="mb-0" style="color: #1e3a8a;">$<%= (totalNeto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h4>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="card-text small text-muted mb-2">🏛️ IVA Total</p>
          <h4 class="mb-0" style="color: #0891b2;">$<%= (totalIva || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h4>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="card-text small text-muted mb-2">📊 Total Facturas</p>
          <h4 class="mb-0" style="color: #10b981;">$<%= (totalFacturas || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h4>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="card-text small text-muted mb-2">⏳ Pendiente de Pago</p>
          <h4 class="mb-0" style="color: #dc2626;">$<%= (totalPendiente || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h4>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA DE FACTURAS -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th style="width: 100px;">Tipo</th>
                <th>Proveedor</th>
                <th style="width: 120px;">Comprobante</th>
                <th style="width: 100px;">Emitido</th>
                <th style="width: 110px;">Monto</th>
                <th style="width: 80px;">IVA</th>
                <th style="width: 100px;">Total</th>
                <th style="width: 80px;">Estado</th>
                <th style="width: 120px;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% facturas.forEach(f => { %>
              <tr>
                <td><span class="badge bg-info"><%= f.tipo_comprobante || 'FC' %></span></td>
                <td>
                  <strong class="truncate-text" title="<%= f.razon_social || '-' %>" style="max-width: 250px; display: inline-block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= f.razon_social || '-' %>
                  </strong>
                </td>
                <td><small><%= f.numero_comprobante || '-' %></small></td>
                <td><small><%= f.fecha_emision ? new Date(f.fecha_emision).toLocaleDateString('es-AR') : '-' %></small></td>
                <td>$<%= (f.monto_neto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                <td>$<%= (f.monto_iva || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                <td><strong>$<%= ((f.monto_neto || 0) + (f.monto_iva || 0)).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong></td>
                <td>
                  <%
                    const montoTotal = (f.monto_neto || 0) + (f.monto_iva || 0);
                    const montoPagado = f.monto_pagado || 0;
                    const porcentajePagado = montoTotal > 0 ? Math.round((montoPagado / montoTotal) * 100) : 0;
                    let badgeColor = 'bg-danger';
                    let badgeText = '❌ Pendiente';
                    if (f.estado === 'pagada') {
                      badgeColor = 'bg-success';
                      badgeText = '✓ Pagada';
                    } else if (f.estado === 'parcial') {
                      badgeColor = 'bg-warning';
                      badgeText = '⏳ Parcial';
                    }
                  %>
                  <span class="badge <%= badgeColor %>"><%= badgeText %></span>
                  <% if (f.estado === 'parcial') { %>
                    <br>
                    <div style="margin-top: 0.5rem;">
                      <small class="text-muted">$<%= montoPagado.toLocaleString('es-AR', {minimumFractionDigits: 2}) %> / $<%= montoTotal.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></small>
                      <div class="progress" style="height: 6px; margin-top: 0.25rem;">
                        <div class="progress-bar bg-warning" style="width: <%= porcentajePagado %>%;"></div>
                      </div>
                    </div>
                  <% } %>
                </td>
                <td>
                  <a href="/finanzas/facturas-recibidas/<%= f.id %>/detalle" class="btn btn-sm btn-outline-primary" title="Ver detalle">
                    <i class="bi bi-eye"></i>
                  </a>
                  <button type="button" class="btn btn-sm btn-outline-danger" onclick="if(confirm('¿Eliminar esta factura?')) { fetch('/finanzas/facturas-recibidas/<%= f.id %>/eliminar', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('[name=_csrf]')?.value || '' } }).then(() => location.reload()); }" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% } %>

</div>

<!-- MODAL: NUEVA FACTURA -->
<div class="modal fade" id="modalNuevaFactura" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-file-earmark-plus"></i> Nueva Factura Recibida</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/finanzas/facturas-recibidas/crear" method="POST" id="formNuevaFactura">
        <div class="modal-body">
          <!-- SECCIÓN 1: PROVEEDOR CON AUTOCOMPLETE -->
          <div class="mb-4 p-3 bg-light rounded">
            <label class="form-label fw-bold">🏢 Proveedor (Buscar o crear)</label>
            <div class="input-group mb-2">
              <input type="text" id="buscarProveedor" class="form-control" placeholder="Escribí nombre o CUIT...">
              <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#modalNuevoProveedor" title="Agregar nuevo proveedor">
                <i class="bi bi-plus"></i>
              </button>
            </div>
            <div id="dropdownProveedores" class="dropdown-menu w-100" style="display: none; position: static; max-height: 200px; overflow-y: auto;">
              <!-- Se llenan con JS -->
            </div>
            <input type="hidden" name="proveedor_id" id="proveedorIdHidden">
            <small class="text-muted d-block mt-2">Seleccionar de la lista auto-llena CUIT, Razón Social e IVA</small>
          </div>

          <!-- SECCIÓN 2: DATOS DEL COMPROBANTE -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Tipo de Comprobante *</label>
              <select name="tipo_comprobante" id="tipoComprobante" class="form-select" required>
                <option value="">-- Seleccionar --</option>
                <optgroup label="Facturas">
                  <option value="Factura A">Factura A (RI a RI)</option>
                  <option value="Factura B">Factura B (a Consumidor Final)</option>
                  <option value="Factura C">Factura C (Monotributista)</option>
                </optgroup>
                <optgroup label="Notas">
                  <option value="Nota de Crédito A">Nota de Crédito A</option>
                  <option value="Nota de Crédito B">Nota de Crédito B</option>
                  <option value="Nota de Crédito C">Nota de Crédito C</option>
                  <option value="Nota de Débito A">Nota de Débito A</option>
                  <option value="Nota de Débito B">Nota de Débito B</option>
                  <option value="Nota de Débito C">Nota de Débito C</option>
                </optgroup>
                <optgroup label="Otros">
                  <option value="Recibo X">Recibo X</option>
                  <option value="Ticket">Ticket</option>
                </optgroup>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Número de Comprobante *</label>
              <input type="text" name="numero_comprobante" class="form-control" placeholder="Ej: 0001-00012345" required>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Fecha de Emisión *</label>
              <input type="date" name="fecha_emision" class="form-control" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Fecha de Vencimiento de Pago</label>
              <input type="date" name="fecha_vencimiento_pago" class="form-control">
            </div>
          </div>

          <!-- SECCIÓN 3: DATOS DEL PROVEEDOR (llena desde select) -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">CUIT/CUIL Proveedor *</label>
              <input type="text" name="cuit_proveedor" id="cuitProveedorInput" class="form-control" placeholder="Ej: 23-12345678-9" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Razón Social *</label>
              <input type="text" name="razon_social" id="razonSocialInput" class="form-control" placeholder="Ej: Distribuidora ABC S.A." required>
            </div>
          </div>

          <!-- SECCIÓN 4: LÍNEAS DE ITEMS CON IVA MÚLTIPLE -->
          <div class="mb-4">
            <label class="form-label fw-bold">📋 Líneas de la Factura (Netos + IVA por línea)</label>
            <div class="table-responsive" style="border: 1px solid #dee2e6; border-radius: 0.375rem; overflow: hidden;">
              <table class="table table-sm mb-0" id="tablaItems">
                <thead class="table-light">
                  <tr>
                    <th style="width: 35%;">Descripción</th>
                    <th style="width: 15%;">Neto $</th>
                    <th style="width: 15%;">IVA %</th>
                    <th style="width: 15%;">IVA $</th>
                    <th style="width: 15%;">Total</th>
                    <th style="width: 5%; text-align: center;">Acc.</th>
                  </tr>
                </thead>
                <tbody id="itemsBody">
                  <tr class="itemRow" data-index="0">
                    <td><input type="text" name="items[0][descripcion]" class="form-control form-control-sm" placeholder="Ej: Papelería" required></td>
                    <td><input type="number" name="items[0][monto_neto]" class="form-control form-control-sm neto" step="0.01" min="0" required></td>
                    <td>
                      <select name="items[0][alicuota_iva]" class="form-select form-select-sm alicuota" onchange="calcularLinea(0)">
                        <option value="0">0%</option>
                        <option value="10.5">10.5%</option>
                        <option value="21" selected>21%</option>
                        <option value="27">27%</option>
                      </select>
                    </td>
                    <td><input type="number" name="items[0][monto_iva]" class="form-control form-control-sm iva" step="0.01" min="0" readonly style="background-color: #f0f0f0;"></td>
                    <td><input type="text" class="form-control form-control-sm total" readonly style="background-color: #e8f5e9; font-weight: bold;"></td>
                    <td style="text-align: center;"><button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarLinea(0)" title="Eliminar línea"><i class="bi bi-trash"></i></button></td>
                  </tr>
                </tbody>
                <tfoot class="table-light">
                  <tr style="font-weight: bold;">
                    <td colspan="1">TOTALES</td>
                    <td><input type="text" id="totalNeto" class="form-control form-control-sm" readonly style="background-color: #fff3cd; font-weight: bold;" value="$0.00"></td>
                    <td colspan="2" style="padding: 0.5rem;"><small style="color: #666;">Desglose por IVA →</small></td>
                    <td><input type="text" id="totalGeneral" class="form-control form-control-sm" readonly style="background-color: #fff3cd; font-weight: bold; color: #d32f2f;" value="$0.00"></td>
                    <td></td>
                  </tr>
                  <tr>
                    <td colspan="6" id="desgoseIva" style="padding: 0.75rem; background-color: #f5f5f5; font-size: 0.85rem; color: #333;">
                      <small>Desglose: IVA 0%: $0.00 | IVA 10.5%: $0.00 | IVA 21%: $0.00 | IVA 27%: $0.00</small>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="agregarLinea()">
              <i class="bi bi-plus"></i> Agregar línea
            </button>
          </div>

          <!-- Hidden fields para enviar totales al servidor -->
          <input type="hidden" name="monto_neto" id="hiddenMontoNeto" value="0">
          <input type="hidden" name="monto_iva" id="hiddenMontoIva" value="0">

          <!-- SECCIÓN 5: PAGO AL CREAR -->
          <div class="mb-3 p-3 bg-info bg-opacity-10 rounded border border-info border-opacity-25">
            <div class="form-check mb-2">
              <input class="form-check-input" type="checkbox" id="registrarPagoCheckbox" onchange="togglePago()">
              <label class="form-check-label fw-bold" for="registrarPagoCheckbox">
                💸 Registrar pago al crear (parcial o total)
              </label>
            </div>
            <div id="seccionPago" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #0dcaf0;">
              <small class="d-block mb-2 text-muted">Total a pagar: <strong id="totalFacturaLabel">$0.00</strong></small>
              <div class="row">
                <div class="col-md-6 mb-2">
                  <label class="form-label small fw-bold">Monto a pagar ($)</label>
                  <input type="number" name="pago_inicial" id="pagoInicial" class="form-control form-control-sm" step="0.01" min="0">
                </div>
                <div class="col-md-6 mb-2">
                  <label class="form-label small fw-bold">Método de pago</label>
                  <select name="metodo_pago_inicial" class="form-select form-select-sm">
                    <option value="efectivo">💵 Efectivo</option>
                    <option value="transferencia">🏦 Transferencia</option>
                    <option value="tarjeta">💳 Tarjeta</option>
                    <option value="cheque">📝 Cheque</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- SECCIÓN 6: NOTAS/OBSERVACIONES -->
          <div class="mb-3">
            <label class="form-label fw-bold">Observaciones/CAE (opcional)</label>
            <textarea name="notas" id="notasInput" class="form-control" rows="2" placeholder="Ej: CAE 12345678901234, o cualquier anotación adicional..."></textarea>
            <small class="text-muted">Para comprobantes electrónicos, podés guardar el CAE aquí</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Registrar Factura
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: NUEVO PROVEEDOR RÁPIDO -->
<div class="modal fade" id="modalNuevoProveedor" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Nuevo Proveedor</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formNuevoProveedor">
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label small fw-bold">Nombre/Razón Social *</label>
            <input type="text" id="provNombre" class="form-control form-control-sm" required>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-bold">CUIT/CUIL *</label>
            <input type="text" id="provCuit" class="form-control form-control-sm" placeholder="Ej: 23-12345678-9" required>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-bold">Email</label>
            <input type="email" id="provEmail" class="form-control form-control-sm">
          </div>
          <div class="mb-0">
            <label class="form-label small fw-bold">Teléfono</label>
            <input type="tel" id="provTelefono" class="form-control form-control-sm">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-sm btn-success" onclick="guardarProveedorRapido()">Crear y usar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// ════════════════════════════════════════════════════════════════
// AUTOCOMPLETE DE PROVEEDORES
// ════════════════════════════════════════════════════════════════

const proveedoresData = <%-JSON.stringify(proveedores || [])%>;

document.getElementById('buscarProveedor').addEventListener('input', function(e) {
  const query = e.target.value.toLowerCase().trim();
  const dropdown = document.getElementById('dropdownProveedores');

  if (query.length < 1) {
    dropdown.style.display = 'none';
    return;
  }

  const filtrados = proveedoresData.filter(p =>
    (p.nombre && p.nombre.toLowerCase().includes(query)) ||
    (p.cuit && p.cuit.includes(query))
  );

  if (filtrados.length === 0) {
    dropdown.innerHTML = '<div class="p-2 text-muted small">No encontrado. Usa el botón + para crear.</div>';
    dropdown.style.display = 'block';
    return;
  }

  dropdown.innerHTML = filtrados.map(p => `
    <button type="button" class="dropdown-item p-2 text-start" onclick="seleccionarProveedor(${p.id}, '${p.nombre}', '${p.cuit}', ${p.alicuota_iva_default || 21})">
      <strong>${p.nombre}</strong><br>
      <small class="text-muted">CUIT: ${p.cuit || 'N/A'}</small>
    </button>
  `).join('');

  dropdown.style.display = 'block';
});

function seleccionarProveedor(id, nombre, cuit, alicuota) {
  document.getElementById('proveedorIdHidden').value = id;
  document.getElementById('razonSocialInput').value = nombre;
  document.getElementById('cuitProveedorInput').value = cuit;
  // Usar la primera alícuota para la primera línea
  const firstRow = document.querySelector('.itemRow');
  if (firstRow) {
    firstRow.querySelector('.alicuota').value = alicuota;
  }
  document.getElementById('buscarProveedor').value = nombre;
  document.getElementById('dropdownProveedores').style.display = 'none';
  calcularTotales();
}

// ════════════════════════════════════════════════════════════════
// TABLA DINÀMICA DE ITEMS CON MÚLTIPLE IVA
// ════════════════════════════════════════════════════════════════

let itemCounter = 1;

function agregarLinea() {
  const tbody = document.getElementById('itemsBody');
  const index = itemCounter++;
  const newRow = document.createElement('tr');
  newRow.className = 'itemRow';
  newRow.dataset.index = index;
  newRow.innerHTML = `
    <td><input type="text" name="items[${index}][descripcion]" class="form-control form-control-sm" placeholder="Ej: Papelería" required></td>
    <td><input type="number" name="items[${index}][monto_neto]" class="form-control form-control-sm neto" step="0.01" min="0" required onchange="calcularLinea(${index})"></td>
    <td>
      <select name="items[${index}][alicuota_iva]" class="form-select form-select-sm alicuota" onchange="calcularLinea(${index})">
        <option value="0">0%</option>
        <option value="10.5">10.5%</option>
        <option value="21" selected>21%</option>
        <option value="27">27%</option>
      </select>
    </td>
    <td><input type="number" name="items[${index}][monto_iva]" class="form-control form-control-sm iva" step="0.01" min="0" readonly style="background-color: #f0f0f0;"></td>
    <td><input type="text" class="form-control form-control-sm total" readonly style="background-color: #e8f5e9; font-weight: bold;"></td>
    <td style="text-align: center;"><button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarLinea(${index})" title="Eliminar línea"><i class="bi bi-trash"></i></button></td>
  `;
  tbody.appendChild(newRow);
  calcularTotales();
}

function calcularLinea(index) {
  const row = document.querySelector(`.itemRow[data-index="${index}"]`);
  if (!row) return;

  const neto = parseFloat(row.querySelector('.neto').value) || 0;
  const alicuota = parseFloat(row.querySelector('.alicuota').value) || 21;
  const iva = neto * (alicuota / 100);
  const total = neto + iva;

  row.querySelector('.iva').value = iva.toFixed(2);
  row.querySelector('.total').value = '$' + total.toLocaleString('es-AR', {minimumFractionDigits: 2});

  calcularTotales();
}

function eliminarLinea(index) {
  const rows = document.querySelectorAll('.itemRow');
  if (rows.length <= 1) {
    alert('Debe haber al menos una línea en la factura');
    return;
  }
  const row = document.querySelector(`.itemRow[data-index="${index}"]`);
  if (row) row.remove();
  calcularTotales();
}

function calcularTotales() {
  let totalNeto = 0;
  let totalIva = 0;
  const ivaByRate = { '0': 0, '10.5': 0, '21': 0, '27': 0 };

  document.querySelectorAll('.itemRow').forEach(row => {
    const neto = parseFloat(row.querySelector('.neto').value) || 0;
    const iva = parseFloat(row.querySelector('.iva').value) || 0;
    const alicuota = row.querySelector('.alicuota').value;

    totalNeto += neto;
    totalIva += iva;
    ivaByRate[alicuota] = (ivaByRate[alicuota] || 0) + iva;
  });

  const totalGeneral = totalNeto + totalIva;

  // Actualizar campos totales
  document.getElementById('totalNeto').value = '$' + totalNeto.toLocaleString('es-AR', {minimumFractionDigits: 2});
  document.getElementById('totalGeneral').value = '$' + totalGeneral.toLocaleString('es-AR', {minimumFractionDigits: 2});

  // Desglose por alícuota
  const desglose = Object.entries(ivaByRate)
    .map(([rate, amount]) => `IVA ${rate}%: $${amount.toLocaleString('es-AR', {minimumFractionDigits: 2})}`)
    .join(' | ');
  document.getElementById('desgoseIva').innerHTML = `<small>Desglose: ${desglose}</small>`;

  // Actualizar hidden fields
  document.getElementById('hiddenMontoNeto').value = totalNeto.toFixed(2);
  document.getElementById('hiddenMontoIva').value = totalIva.toFixed(2);

  // Actualizar label de total en sección pago
  document.getElementById('totalFacturaLabel').textContent = '$' + totalGeneral.toLocaleString('es-AR', {minimumFractionDigits: 2});

  // Actualizar máximo de pago
  const pagoInput = document.getElementById('pagoInicial');
  if (pagoInput) pagoInput.max = totalGeneral.toFixed(2);
}

// ════════════════════════════════════════════════════════════════
// TOGGLE SECCIÓN DE PAGO
// ════════════════════════════════════════════════════════════════

function togglePago() {
  const checkbox = document.getElementById('registrarPagoCheckbox');
  const seccion = document.getElementById('seccionPago');

  if (checkbox.checked) {
    seccion.style.display = 'block';
  } else {
    seccion.style.display = 'none';
    document.getElementById('pagoInicial').value = '';
  }
}

// ════════════════════════════════════════════════════════════════
// CREAR PROVEEDOR RÁPIDO
// ════════════════════════════════════════════════════════════════

async function guardarProveedorRapido() {
  const nombre = document.getElementById('provNombre').value.trim();
  const cuit = document.getElementById('provCuit').value.trim();
  const email = document.getElementById('provEmail').value.trim();
  const telefono = document.getElementById('provTelefono').value.trim();

  if (!nombre || !cuit) {
    alert('Nombre y CUIT son obligatorios');
    return;
  }

  try {
    const res = await fetch('/proveedores', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: new URLSearchParams({
        nombre, cuit, email, telefono,
        '_csrf': document.querySelector('[name=_csrf]')?.value || ''
      })
    });

    if (res.ok) {
      // Recargar la página para obtener el nuevo proveedor
      location.reload();
    } else {
      alert('Error al crear proveedor');
    }
  } catch (err) {
    console.error('Error:', err);
    alert('Error de conexión');
  }
}

// Validar total de factura al enviar
document.getElementById('formNuevaFactura').addEventListener('submit', function(e) {
  // Validar que todas las líneas tengan descripción y neto
  const rows = document.querySelectorAll('.itemRow');
  for (let row of rows) {
    const desc = row.querySelector('.form-control').value.trim();
    const neto = parseFloat(row.querySelector('.neto').value) || 0;
    if (!desc || neto <= 0) {
      e.preventDefault();
      alert('Todas las líneas deben tener descripción y monto neto > 0');
      return;
    }
  }

  const totalNeto = parseFloat(document.getElementById('hiddenMontoNeto').value) || 0;
  const totalIva = parseFloat(document.getElementById('hiddenMontoIva').value) || 0;
  const total = totalNeto + totalIva;

  if (total <= 0) {
    e.preventDefault();
    alert('El total de la factura debe ser mayor a 0');
    return;
  }

  // Validar pago inicial
  if (document.getElementById('registrarPagoCheckbox').checked) {
    const pago = parseFloat(document.getElementById('pagoInicial').value) || 0;
    if (pago < 0 || pago > total) {
      e.preventDefault();
      alert('El pago debe estar entre 0 y $' + total.toFixed(2));
      return;
    }
  }
});
