<!-- JAVASCRIPT -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<script>
let pagoEnProceso = { id: null, nombre: '', falta: 0 };

// Función para agregar rápido desde chips de sugerencias
function sugerencia(nombre, categoria, frecuencia) {
  document.getElementById('inputNombre').value = nombre;
  document.getElementById('selectCategoria').value = categoria;
  document.getElementById('selectFrecuencia').value = frecuencia;
  new bootstrap.Modal(document.getElementById('modalNuevoGastoFijo')).show();
}

// Función para abrir modal de editar
function abrirEditar(id, nombre, categoria, frecuencia, monto, dia, notas, metodo) {
  document.getElementById('editNombre').value = nombre;
  document.getElementById('editCategoria').value = categoria;
  document.getElementById('editFrecuencia').value = frecuencia;
  document.getElementById('editMonto').value = monto;
  document.getElementById('editDiaVencimiento').value = dia;
  document.getElementById('editNotas').value = notas;
  document.getElementById('editMetodo').value = metodo || 'transferencia';
  document.getElementById('formEditarGasto').action = `/finanzas/gastos-fijos/${id}/editar`;
}

// Función para abrir modal de pago parcial
function abrirModalPago(id, nombre, falta) {
  pagoEnProceso = { id, nombre, falta };
  document.getElementById('gastoNombreLabel').textContent = nombre;
  document.getElementById('montoFaltaLabel').textContent =
    '$' + falta.toLocaleString('es-AR', { minimumFractionDigits: 2 });
  document.getElementById('inputMontoPago').value = falta.toFixed(2);
  document.getElementById('inputMontoPago').max = falta;

  const formPago = document.getElementById('formPagoParcial');
  formPago.action = `/finanzas/gastos-fijos/${id}/pago-parcial`;
}

// Registrar pago parcial
document.getElementById('formPagoParcial')?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const monto = document.getElementById('inputMontoPago').value;
  const metodo = document.getElementById('selectMetodoPago').value;
  const notas = document.getElementById('inputNotas').value;

  if (!monto || monto <= 0) {
    alert('❌ El monto debe ser mayor a 0');
    return;
  }

  const response = await fetch(`/finanzas/gastos-fijos/${pagoEnProceso.id}/pago-parcial`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ monto: parseFloat(monto), metodo_pago: metodo, notas })
  });

  const data = await response.json();
  if (data.success) {
    alert(`✅ ${data.message}`);
    bootstrap.Modal.getInstance(document.getElementById('modalPagoParcial')).hide();
    location.reload();
  } else {
    alert('❌ Error: ' + data.error);
  }
});

// Marcar como pagado completo
function marcarPagado(id, nombre) {
  if (confirm(`¿Marcar "${nombre}" como COMPLETAMENTE pagado hoy? Se registrará en Caja Diaria.`)) {
    fetch(`/finanzas/gastos-fijos/${id}/marcar-pagado`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('✅ Gasto marcado como pagado. Se registró en Caja Diaria.');
        location.reload();
      } else {
        alert('❌ Error: ' + data.error);
      }
    })
    .catch(e => alert('Error: ' + e));
  }
}

// Eliminar gasto fijo
function eliminar(id, nombre) {
  if (confirm(`¿Eliminar el gasto "${nombre}"? No se puede deshacer.`)) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/finanzas/gastos-fijos/${id}/eliminar`;
    form.innerHTML = '<input type="hidden" name="_csrf" value="<%= csrfToken %>">';
    document.body.appendChild(form);
    form.submit();
  }
}
</script>
