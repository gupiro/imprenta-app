<!-- views/finanzas/vencimientos-fiscales.ejs -->
<div class="container-fluid py-4">
  <!-- HEADER -->
  <div class="row mb-4 align-items-center">
    <div class="col-md-8">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <h1 class="display-6 mb-1"><i class="bi bi-calendar-x me-2"></i>Vencimientos Fiscales</h1>
          <p class="text-muted mb-0">Calendario de obligaciones impositivas que no podés olvidar</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm ms-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAyuda">
          <i class="bi bi-question-circle me-1"></i> ¿Cómo uso esta sección?
        </button>
      </div>
    </div>
    <div class="col-md-4 text-end">
      <button class="btn btn-warning me-2" data-bs-toggle="modal" data-bs-target="#modalAsistente">
        <i class="bi bi-wand2 me-1"></i>🧭 Cargar obligaciones comunes
      </button>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevo">
        <i class="bi bi-plus-lg me-1"></i>Agregar Vencimiento
      </button>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- PANEL EDUCATIVO NARANJA -->
  <div class="alert border-warning border-start border-5 mb-4" style="background:#fff8f0;">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h5 class="mb-3">⚠️ ¿Por qué es importante esta sección?</h5>
        <p class="mb-2">Como dueño de un negocio en Argentina, tenés obligaciones fiscales con distintos organismos. Esta sección es tu <strong>AGENDA FISCAL</strong>:</p>
        <ul class="mb-0">
          <li><strong>📋 Ingresos Brutos (IIBB):</strong> Si vendés, debés pagar cada mes a la provincia. En Salta, es el 17 del mes.</li>
          <li><strong>📋 Monotributo:</strong> Si sos monotributista, pagás una cuota fija cada mes a AFIP (día 20).</li>
          <li><strong>📋 IVA:</strong> Si facturás como Responsable Inscripto, pagás impuesto cada mes (día 22).</li>
          <li><strong>📋 Cargas Sociales (SIPA):</strong> Si tenés empleados, pagás contribuciones cada mes.</li>
          <li><strong>📋 Ganancias:</strong> Si ganás dinero, declarás ganancias una vez por año.</li>
        </ul>
        <p class="mt-3 mb-0"><strong>💡 Consejo:</strong> Cargá cada obligación una sola vez en esta sección. Si se repite cada mes, marcalo como "recurrente". Si vencés una obligación, tu contador puede ayudarte.</p>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  </div>

  <!-- CARDS RESUMEN MEJORADAS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-danger">
        <div class="card-body">
          <h6 class="card-title text-danger mb-2"><i class="bi bi-exclamation-circle me-1"></i>Vencidos</h6>
          <h3 class="text-danger mb-2"><%= resumen.vencidos %></h3>
          <p class="text-muted small mb-0">⚠️ Contactá a tu contador</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-danger">
        <div class="card-body">
          <h6 class="card-title text-danger mb-2"><i class="bi bi-clock me-1"></i>Urgentes ≤7 días</h6>
          <h3 class="text-danger mb-2"><%= resumen.urgentes %></h3>
          <p class="text-muted small mb-0">¡Pagá esta semana!</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-warning" style="border-color: #ffc107 !important;">
        <div class="card-body">
          <h6 class="card-title" style="color: #cc6600;"><i class="bi bi-calendar me-1"></i>Próximos ≤30 días</h6>
          <h3 style="color: #cc6600;" class="mb-2"><%= resumen.proximos %></h3>
          <p class="text-muted small mb-0">Preparate para pagar</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-success">
        <div class="card-body">
          <h6 class="card-title text-success mb-2"><i class="bi bi-check-circle me-1"></i>Pagados</h6>
          <h3 class="text-success mb-2"><%= resumen.pagados %></h3>
          <p class="text-muted small mb-0">✓ Pagados a tiempo</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FILTROS TABS -->
  <div class="mb-3">
    <div class="btn-group btn-group-sm" role="group">
      <button type="button" class="btn btn-outline-secondary" onclick="filtrarTabla('todos')">Todos</button>
      <button type="button" class="btn btn-outline-danger" onclick="filtrarTabla('vencido')">Vencidos</button>
      <button type="button" class="btn btn-outline-danger" onclick="filtrarTabla('urgente')">Urgentes</button>
      <button type="button" class="btn btn-outline-warning" onclick="filtrarTabla('proximo15')">Próximos</button>
      <button type="button" class="btn btn-outline-success" onclick="filtrarTabla('pagado')">Pagados</button>
    </div>
  </div>

  <!-- TABLA DE VENCIMIENTOS -->
  <% if (vencimientos && vencimientos.length > 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0 small">
          <thead class="table-light">
            <tr>
              <th>Organismo</th>
              <th>Categoría</th>
              <th>Descripción</th>
              <th class="text-center">Vencimiento</th>
              <th class="text-center">Días</th>
              <th class="text-end">Monto</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <%
              const colores = {
                'IVA': 'bg-info',
                'Ingresos Brutos': 'bg-primary',
                'Ganancias': 'bg-warning text-dark',
                'Monotributo': 'bg-success',
                'Autónomos': 'bg-secondary',
                'Cargas Sociales': 'bg-dark text-white',
                'Bienes Personales': 'bg-danger',
                'Balance': 'bg-dark text-white',
                'Inscripción': 'bg-info text-dark',
                'Otros': 'bg-light text-dark'
              };
            %>
            <% vencimientos.forEach(v => { %>
              <tr data-urgencia="<%= v.urgencia %>"
                  <% if (v.urgencia === 'vencido') { %>class="table-danger"<% } %>
                  <% if (v.urgencia === 'urgente') { %>class="table-warning"<% } %>
                  <% if (v.urgencia === 'proximo15') { %>style="background:#fff3cd;"<% } %>
                  <% if (v.urgencia === 'pagado') { %>class="table-success opacity-75"<% } %>>

                <!-- Organismo -->
                <td>
                  <small><%= v.organismo || '—' %></small>
                </td>

                <!-- Categoría -->
                <td>
                  <span class="badge <%= colores[v.categoria] || 'bg-light text-dark' %>">
                    <%= v.categoria %>
                  </span>
                </td>

                <!-- Descripción -->
                <td>
                  <strong><%= v.descripcion %></strong>
                  <% if (v.notas) { %><br/><small class="text-muted"><%= v.notas %></small><% } %>
                  <% if (v.urgencia === 'vencido') { %>
                    <br/><small class="text-danger fw-semibold">⚠️ Vencido hace <%= v.dias_transcurridos %> días — contactá a tu contador</small>
                  <% } %>
                </td>

                <!-- Vencimiento -->
                <td class="text-center">
                  <strong><%= new Date(v.fecha_vencimiento).toLocaleDateString('es-AR') %></strong>
                </td>

                <!-- Días -->
                <td class="text-center">
                  <% if (v.urgencia === 'pagado') { %>
                    <span class="badge bg-success">✓ Pagado</span>
                  <% } else if (v.urgencia === 'vencido') { %>
                    <span class="badge bg-danger">Venció hace <%= v.dias_transcurridos %></span>
                  <% } else if (v.urgencia === 'urgente') { %>
                    <span class="badge bg-danger">en <%= v.dias_restantes %> días</span>
                  <% } else if (v.urgencia === 'proximo15') { %>
                    <span class="badge" style="background:#ffc107; color:#000;">en <%= v.dias_restantes %> días</span>
                  <% } else { %>
                    <span class="badge bg-secondary">en <%= v.dias_restantes %> días</span>
                  <% } %>
                </td>

                <!-- Monto -->
                <td class="text-end">
                  <strong>$<%= (v.monto_estimado || 0).toLocaleString('es-AR', { minimumFractionDigits: 2 }) %></strong>
                </td>

                <!-- Acciones -->
                <td class="text-center">
                  <% if (v.estado !== 'pagado') { %>
                    <button type="button" class="btn btn-sm btn-success"
                            onclick="abrirModalPagar(<%= v.id %>, <%= v.monto_estimado %>)"
                            title="Marcar como pagado">
                      <i class="bi bi-cash-coin"></i>
                    </button>
                  <% } %>
                  <button type="button" class="btn btn-sm btn-primary"
                          onclick="abrirEditar(<%= JSON.stringify(v) %>)"
                          data-bs-toggle="modal" data-bs-target="#modalEditar"
                          title="Editar">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button type="button" class="btn btn-sm btn-danger"
                          data-bs-toggle="modal" data-bs-target="#modalEliminar<%= v.id %>"
                          title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <div class="mb-3" style="font-size:3rem; opacity:0.4;">📆</div>
      <h4 class="text-muted mb-2">No hay vencimientos fiscales cargados</h4>
      <p class="text-muted mb-4 mx-auto" style="max-width:420px;">
        Cargá tus obligaciones con AFIP y la provincia (monotributo, ingresos brutos) para que el sistema te avise antes de que venza. Una multa por olvido puede salir muy cara.
      </p>
      <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#modalAsistente">
        <i class="bi bi-wand2 me-2"></i>Cargar obligaciones comunes
      </button>
      <div class="mt-4 p-3 bg-light rounded mx-auto text-start" style="max-width:420px;">
        <small class="text-muted"><strong>Ejemplo:</strong><br>Monotributo → Día 20 de cada mes → Recurrente mensual</small>
      </div>
    </div>
  <% } %>

  <div class="mt-4">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Volver al Inicio
    </a>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: ASISTENTE 3 PASOS - CARGAR OBLIGACIONES COMUNES -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalAsistente" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title"><i class="bi bi-wand2 me-2"></i>🧭 Cargar Obligaciones Comunes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- PASO 1 -->
        <div id="paso1" class="paso-asistente">
          <h6 class="mb-3">Paso 1 de 3: ¿Cuál es tu condición impositiva?</h6>
          <p class="text-muted small mb-3">Esto determina qué impuestos pagás cada mes</p>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-outline-primary btn-lg" onclick="irPaso2('mono')">
              <i class="bi bi-person-check me-2"></i>
              <strong>Soy monotributista</strong>
              <br><small>Pago una cuota fija cada mes</small>
            </button>
            <button type="button" class="btn btn-outline-primary btn-lg" onclick="irPaso2('ri')">
              <i class="bi bi-building me-2"></i>
              <strong>Soy Responsable Inscripto</strong>
              <br><small>Declaro IVA y tengo más obligaciones</small>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-lg" onclick="irPaso2('nsc')">
              <i class="bi bi-question-circle me-2"></i>
              <strong>No sé / Prefiero otro</strong>
              <br><small>Agregá obligaciones manualmente después</small>
            </button>
          </div>
        </div>

        <!-- PASO 2 -->
        <div id="paso2" class="paso-asistente" style="display: none;">
          <h6 class="mb-3">Paso 2 de 3: ¿Tenés empleados en relación de dependencia?</h6>
          <p class="text-muted small mb-3">Si pagás sueldos, debés pagar cargas sociales cada mes</p>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-outline-success btn-lg" onclick="irPaso3('con')">
              <i class="bi bi-people me-2"></i>
              <strong>Sí, tengo empleados</strong>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-lg" onclick="irPaso3('sin')">
              <i class="bi bi-person me-2"></i>
              <strong>No tengo empleados</strong>
            </button>
            <button type="button" class="btn btn-link" onclick="irPaso1()">
              ← Atrás
            </button>
          </div>
        </div>

        <!-- PASO 3 -->
        <div id="paso3" class="paso-asistente" style="display: none;">
          <h6 class="mb-3">Paso 3 de 3: Selecciona las obligaciones a cargar</h6>
          <p class="text-muted small mb-3">Podés agregar más obligaciones después si es necesario</p>
          <div id="listaObligs" class="mb-3" style="max-height: 300px; overflow-y: auto;">
            <!-- Se llenará con JavaScript -->
          </div>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-success" onclick="agregarObligacionesSeleccionadas()">
              <i class="bi bi-plus-circle me-1"></i>Agregar seleccionadas
            </button>
            <button type="button" class="btn btn-link" onclick="irPaso2Volver()">
              ← Atrás
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: MODAL DE PAGO -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalPagar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-cash-coin me-2"></i>Confirmar Pago</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formPagar" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Monto pagado ($) *</label>
            <input type="number" name="monto_real_pagado" id="pagar_monto" class="form-control"
                   step="0.01" min="0" required placeholder="0.00">
            <small class="text-muted">El monto real que pagaste. Si es diferente al estimado, ponelo aquí.</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Fecha de pago *</label>
            <input type="date" name="fecha_real_pago" id="pagar_fecha" class="form-control" required>
            <small class="text-muted">La fecha en que efectuaste el pago</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success">✓ Marcar como Pagado</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: Agregar Vencimiento -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalNuevo" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Agregar Vencimiento</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/finanzas/vencimientos-fiscales/crear" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Descripción *</label>
            <input type="text" name="descripcion" class="form-control"
                   placeholder="Ej: 'Monotributo mensual', 'IIBB Régimen General' etc" required>
            <small class="text-muted">Descrición clara de la obligación</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Tipo de obligación *</label>
            <select name="categoria" class="form-select" required>
              <option value="">-- Seleccionar obligación --</option>
              <optgroup label="Frecuentes">
                <option value="Monotributo">Monotributo (mensual)</option>
                <option value="Ingresos Brutos">Ingresos Brutos - IIBB (mensual)</option>
                <option value="IVA">IVA - Responsable Inscripto (mensual)</option>
                <option value="Cargas Sociales">Cargas Sociales SIPA (mensual)</option>
                <option value="Ganancias">Ganancias (anual)</option>
              </optgroup>
              <optgroup label="Otros">
                <option value="Autónomos">Autónomos</option>
                <option value="Bienes Personales">Bienes Personales</option>
                <option value="Otros">Otro</option>
              </optgroup>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Organismo *</label>
            <select name="organismo" class="form-select" required>
              <option value="">-- Seleccionar --</option>
              <option value="AFIP">AFIP</option>
              <option value="Rentas Salta">Rentas Salta</option>
              <option value="Municipalidad de Orán">Municipalidad de Orán</option>
              <option value="Otro">Otro</option>
            </select>
            <small class="text-muted">El organismo a quien le pagás</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Fecha de vencimiento *</label>
            <input type="date" name="fecha_vencimiento" class="form-control" required>
            <small class="text-muted">El día exacto que vence. Lo podés ver en el calendario de AFIP o preguntárselo a tu contador</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Período</label>
            <input type="text" name="periodo" class="form-control" placeholder="Ej: Enero 2026, 2026-01">
            <small class="text-muted">Opcional: mes o período de la obligación</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Monto estimado ($)</label>
            <input type="number" name="monto_estimado" class="form-control" placeholder="0.00" step="0.01" min="0">
            <small class="text-muted">Si no sabés el monto exacto, ponelo del mes anterior. Lo importante es tener la fecha</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Notas</label>
            <textarea name="notas" class="form-control" rows="2" placeholder="Notas adicionales"></textarea>
          </div>

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="es_recurrente" id="es_recurrente" onchange="togglePeriodicidad()">
            <label class="form-check-label" for="es_recurrente">
              <strong>¿Se repite todos los meses?</strong>
            </label>
          </div>

          <div class="mb-3" id="periodicidadDiv" style="display: none;">
            <label class="form-label fw-semibold">Cada cuánto tiempo</label>
            <select name="periodicidad" class="form-select">
              <option value="">-- Seleccionar --</option>
              <option value="mensual">Mensual</option>
              <option value="bimestral">Bimestral</option>
              <option value="trimestral">Trimestral</option>
              <option value="semestral">Semestral</option>
              <option value="anual">Anual</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: Editar Vencimiento -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar Vencimiento</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formEditar" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Descripción *</label>
            <input type="text" name="descripcion" id="edit_descripcion" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Tipo de obligación *</label>
            <select name="categoria" id="edit_categoria" class="form-select" required>
              <optgroup label="Frecuentes">
                <option value="Monotributo">Monotributo (mensual)</option>
                <option value="Ingresos Brutos">Ingresos Brutos - IIBB (mensual)</option>
                <option value="IVA">IVA - Responsable Inscripto (mensual)</option>
                <option value="Cargas Sociales">Cargas Sociales SIPA (mensual)</option>
                <option value="Ganancias">Ganancias (anual)</option>
              </optgroup>
              <optgroup label="Otros">
                <option value="Autónomos">Autónomos</option>
                <option value="Bienes Personales">Bienes Personales</option>
                <option value="Otros">Otros</option>
              </optgroup>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Organismo</label>
            <select name="organismo" id="edit_organismo" class="form-select">
              <option value="">-- Seleccionar --</option>
              <option value="AFIP">AFIP</option>
              <option value="Rentas Salta">Rentas Salta</option>
              <option value="Municipalidad de Orán">Municipalidad de Orán</option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Fecha de vencimiento *</label>
            <input type="date" name="fecha_vencimiento" id="edit_fecha_vencimiento" class="form-control" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Período</label>
            <input type="text" name="periodo" id="edit_periodo" class="form-control">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Monto estimado ($)</label>
            <input type="number" name="monto_estimado" id="edit_monto_estimado" class="form-control" step="0.01" min="0">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Notas</label>
            <textarea name="notas" id="edit_notas" class="form-control" rows="2"></textarea>
          </div>

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="es_recurrente" id="edit_es_recurrente" onchange="togglePeriodicidadEdit()">
            <label class="form-check-label" for="edit_es_recurrente">
              ¿Se repite todos los meses?
            </label>
          </div>

          <div class="mb-3" id="periodicidadEditDiv" style="display: none;">
            <label class="form-label fw-semibold">Cada cuánto tiempo</label>
            <select name="periodicidad" id="edit_periodicidad" class="form-select">
              <option value="">-- Seleccionar --</option>
              <option value="mensual">Mensual</option>
              <option value="bimestral">Bimestral</option>
              <option value="trimestral">Trimestral</option>
              <option value="semestral">Semestral</option>
              <option value="anual">Anual</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-info">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODALES: Eliminar (dinámicos) -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<% if (vencimientos && vencimientos.length > 0) { %>
  <% vencimientos.forEach(v => { %>
    <div class="modal fade" id="modalEliminar<%= v.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title"><i class="bi bi-trash me-2"></i>Eliminar Vencimiento</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p>¿Eliminar el vencimiento "<strong><%= v.descripcion %></strong>"?</p>
            <p class="text-muted small">Esta acción no se puede deshacer.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <form action="/finanzas/vencimientos-fiscales/<%= v.id %>/eliminar" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-danger">Eliminar</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- OFFCANVAS AYUDA -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAyuda">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title">Vencimientos Fiscales</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <h6 class="text-primary mb-1">¿Para qué sirve esta sección?</h6>
    <p class="small text-muted">Como dueño de un negocio, tenés obligaciones fiscales con AFIP, la provincia y municipios. Una multa por olvido puede salir muy cara. Esta sección es tu "alarma" para que no se te pase ningún vencimiento importante.</p>
    <hr>
    <h6 class="text-primary mb-1">¿Qué cargar y cuándo?</h6>
    <ul class="small text-muted ps-3">
      <li><strong>Al empezar:</strong> Usá el botón "🧭 Cargar obligaciones comunes" para agregar rápidamente las que correspondan</li>
      <li><strong>Si cambia tu situación:</strong> Si te volvés Responsable Inscripto o tomás empleados, agrega nuevas obligaciones</li>
      <li><strong>Cuando pagás:</strong> Marcá la obligación como pagada para saber cuáles ya están hechas</li>
    </ul>
    <hr>
    <h6 class="text-warning mb-1">⚠️ Errores comunes</h6>
    <ul class="small text-muted ps-3">
      <li>Olvidar que el Monotributo se paga el día 20 (si pasó, hay multa)</li>
      <li>No actualizar cuando se vence el monotributo y te tenés que dar de baja</li>
      <li>Confundir fechas de vencimiento (cada obligación tiene su fecha específica)</li>
    </ul>
    <hr>
    <h6 class="text-success mb-1">Ejemplo concreto</h6>
    <div class="p-3 bg-light rounded small">
      <strong>Mi obligaciones como monotributista en Salta:</strong><br>
      • Monotributo: $1.200 (día 20 de cada mes)<br>
      • Ingresos Brutos: Varía (día 17 de cada mes)<br>
      • Si no pagás, multa = 100% + intereses.<br>
      <strong>= Cargar estas 2 obligaciones en el sistema para no olvidar</strong>
    </div>
  </div>
</div>

<script>
// ════════════════════════════════════════════════════════════════
// ASISTENTE: Variables de estado
// ════════════════════════════════════════════════════════════════
let asistenteState = {
  condicion: null,  // 'mono' o 'ri'
  empleados: null   // 'con' o 'sin'
};

// Lista de obligaciones por tipo
const OBLIGACIONES = {
  mono_sin: [
    { desc: 'Monotributo mensual', cat: 'Monotributo', org: 'AFIP', dia: 20 },
    { desc: 'IIBB Régimen Simplificado', cat: 'Ingresos Brutos', org: 'Rentas Salta', dia: 17 }
  ],
  mono_con: [
    { desc: 'Monotributo mensual', cat: 'Monotributo', org: 'AFIP', dia: 20 },
    { desc: 'IIBB Régimen Simplificado', cat: 'Ingresos Brutos', org: 'Rentas Salta', dia: 17 },
    { desc: 'Cargas Sociales SIPA', cat: 'Cargas Sociales', org: 'AFIP', dia: 10 }
  ],
  ri_sin: [
    { desc: 'IVA mensual', cat: 'IVA', org: 'AFIP', dia: 22 },
    { desc: 'IIBB Régimen General', cat: 'Ingresos Brutos', org: 'Rentas Salta', dia: 17 },
    { desc: 'Ganancias anual', cat: 'Ganancias', org: 'AFIP', dia: 30, mesAnual: 6 }
  ],
  ri_con: [
    { desc: 'IVA mensual', cat: 'IVA', org: 'AFIP', dia: 22 },
    { desc: 'IIBB Régimen General', cat: 'Ingresos Brutos', org: 'Rentas Salta', dia: 17 },
    { desc: 'Ganancias anual', cat: 'Ganancias', org: 'AFIP', dia: 30, mesAnual: 6 },
    { desc: 'Cargas Sociales SIPA', cat: 'Cargas Sociales', org: 'AFIP', dia: 10 }
  ]
};

function irPaso1() {
  document.getElementById('paso1').style.display = 'block';
  document.getElementById('paso2').style.display = 'none';
  document.getElementById('paso3').style.display = 'none';
}

function irPaso2(condicion) {
  asistenteState.condicion = condicion;
  if (condicion === 'nsc') {
    let modal = bootstrap.Modal.getInstance(document.getElementById('modalAsistente'));
    modal.hide();
    return;
  }
  document.getElementById('paso1').style.display = 'none';
  document.getElementById('paso2').style.display = 'block';
  document.getElementById('paso3').style.display = 'none';
}

function irPaso2Volver() {
  document.getElementById('paso1').style.display = 'block';
  document.getElementById('paso2').style.display = 'none';
  document.getElementById('paso3').style.display = 'none';
}

function irPaso3(empleados) {
  asistenteState.empleados = empleados;
  const key = `${asistenteState.condicion}_${empleados}`;
  const obligs = OBLIGACIONES[key] || [];

  const html = obligs.map((o, i) => `
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" name="oblig_<%= i %>"
             id="oblig_${i}" value='${JSON.stringify(o)}' checked>
      <label class="form-check-label" for="oblig_${i}">
        <strong>${o.desc}</strong>
        <br>
        <small class="text-muted">${o.cat} · ${o.org} · día ${o.dia}</small>
      </label>
    </div>
  `).join('');

  document.getElementById('listaObligs').innerHTML = html;

  document.getElementById('paso1').style.display = 'none';
  document.getElementById('paso2').style.display = 'none';
  document.getElementById('paso3').style.display = 'block';
}

async function agregarObligacionesSeleccionadas() {
  const checkboxes = document.querySelectorAll('#listaObligs input[type="checkbox"]:checked');
  if (checkboxes.length === 0) {
    alert('Selecciona al menos una obligación');
    return;
  }

  let exito = 0;
  let error = 0;

  for (const cb of checkboxes) {
    const oblig = JSON.parse(cb.value);
    const hoy = new Date();

    // Calcular próxima fecha de vencimiento
    let proxFecha = new Date(hoy.getFullYear(), hoy.getMonth() + 1, oblig.dia);
    if (proxFecha <= hoy) {
      proxFecha = new Date(hoy.getFullYear(), hoy.getMonth() + 2, oblig.dia);
    }
    const fechaStr = proxFecha.toISOString().slice(0, 10);

    const formData = new URLSearchParams();
    formData.append('descripcion', oblig.desc);
    formData.append('categoria', oblig.cat);
    formData.append('organismo', oblig.org);
    formData.append('fecha_vencimiento', fechaStr);
    formData.append('es_recurrente', '1');
    formData.append('periodicidad', 'mensual');

    try {
      const res = await fetch('/finanzas/vencimientos-fiscales/crear', {
        method: 'POST',
        body: formData
      });
      if (res.ok) {
        exito++;
      } else {
        error++;
      }
    } catch (e) {
      error++;
    }
  }

  let modal = bootstrap.Modal.getInstance(document.getElementById('modalAsistente'));
  modal.hide();

  if (error === 0) {
    alert(`✓ ${exito} obligacione(s) agregada(s) correctamente. Recargá la página para verlas.`);
    location.reload();
  } else {
    alert(`${exito} agregadas, ${error} con error. Recargá la página.`);
    location.reload();
  }
}

// ════════════════════════════════════════════════════════════════
// MODAL DE PAGO
// ════════════════════════════════════════════════════════════════
function abrirModalPagar(id, montoEstimado) {
  const hoy = new Date().toISOString().slice(0, 10);
  document.getElementById('pagar_monto').value = montoEstimado || 0;
  document.getElementById('pagar_fecha').value = hoy;
  document.getElementById('formPagar').action = `/finanzas/vencimientos-fiscales/${id}/pagar`;

  let modal = new bootstrap.Modal(document.getElementById('modalPagar'));
  modal.show();
}

// ════════════════════════════════════════════════════════════════
// MODALES DE FORMULARIOS
// ════════════════════════════════════════════════════════════════
function togglePeriodicidad() {
  const check = document.getElementById('es_recurrente').checked;
  document.getElementById('periodicidadDiv').style.display = check ? 'block' : 'none';
}

function togglePeriodicidadEdit() {
  const check = document.getElementById('edit_es_recurrente').checked;
  document.getElementById('periodicidadEditDiv').style.display = check ? 'block' : 'none';
}

function abrirEditar(vencimiento) {
  document.getElementById('formEditar').action = '/finanzas/vencimientos-fiscales/' + vencimiento.id + '/editar';
  document.getElementById('edit_descripcion').value = vencimiento.descripcion || '';
  document.getElementById('edit_categoria').value = vencimiento.categoria || '';
  document.getElementById('edit_organismo').value = vencimiento.organismo || '';
  document.getElementById('edit_fecha_vencimiento').value = vencimiento.fecha_vencimiento || '';
  document.getElementById('edit_periodo').value = vencimiento.periodo || '';
  document.getElementById('edit_monto_estimado').value = vencimiento.monto_estimado || 0;
  document.getElementById('edit_notas').value = vencimiento.notas || '';
  document.getElementById('edit_es_recurrente').checked = vencimiento.es_recurrente ? true : false;
  document.getElementById('edit_periodicidad').value = vencimiento.periodicidad || '';
  togglePeriodicidadEdit();
}

function filtrarTabla(tipo) {
  document.querySelectorAll('tbody tr[data-urgencia]').forEach(tr => {
    const urgencia = tr.dataset.urgencia;
    let mostrar = false;

    if (tipo === 'todos') {
      mostrar = true;
    } else if (tipo === 'pendientes') {
      mostrar = urgencia !== 'pagado';
    } else if (tipo === urgencia) {
      mostrar = true;
    }

    tr.style.display = mostrar ? '' : 'none';
  });
}
</script>
