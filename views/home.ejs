     title="Nuevo Pedido">
    <i class="bi bi-plus-lg"></i>
  </a>

  <!-- ROJO: Gasto Rápido -->
  <button id="btnGastoRapido" class="btn btn-danger" onclick="abrirGastoRapido()"
          style="width: 60px; height: 60px; border-radius: 50%; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4); transition: all 0.2s ease; border: none; cursor: pointer;"
          title="Gasto Rápido">
