<!-- Panel Principal Ejecutivo - Control de Negocio -->

<div class="container-fluid py-4">

  <!-- ════════════════════════════════════════════════════════════════
       CAPA 1 - URGENCIAS (Solo si hay datos críticos)
       ════════════════════════════════════════════════════════════════ -->

  <% if (user && user.rol === 'admin') { %>

  <!-- HERO METRIC - DINERO HOY -->
  <%
  const metaDiaria = ingresosMes / (new Date().getDate() || 1);
  const porcentajeMeta = metaDiaria > 0 ? (ingresosHoy / metaDiaria) * 100 : 0;
  const heroColor = porcentajeMeta >= 100
    ? 'linear-gradient(135deg, #10b981, #059669)'
    : porcentajeMeta >= 70
    ? 'linear-gradient(135deg, #f59e0b, #d97706)'
    : 'linear-gradient(135deg, #ef4444, #dc2626)';
  %>
  <div class="hero-metric mb-4" style="background: <%= heroColor %>;">
    <div class="hero-label">💰 HOY</div>
    <div class="hero-amount">$<%= (ingresosHoy || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
    <div class="hero-progress">
      <div class="hero-progress-bar" style="width: <%= Math.min(porcentajeMeta, 100) %>%;"></div>
    </div>
    <div class="hero-meta">Meta: $<%= metaDiaria.toLocaleString('es-AR', {maximumFractionDigits: 0}) %> — <strong><%= porcentajeMeta.toFixed(0) %>%</strong></div>
  </div>

  <!-- URGENCIAS: 3 BLOQUES CRÍTICOS -->
  <%
    const deudasVencidas = (deudasVencidas && Array.isArray(deudasVencidas)) ? deudasVencidas : [];
    const deudasProximas = (deudasProximas && Array.isArray(deudasProximas)) ? deudasProximas : [];
    const totalVencidas = deudasVencidas.reduce((s, d) => s + (d.monto || 0), 0);
    const totalProximas = deudasProximas.reduce((s, d) => s + (d.monto || 0), 0);
    const deudoresImpagos = deudores ? deudores.length : 0;
  %>

  <div class="row g-3 mb-4">
    <!-- COBRANZA URGENTE -->
    <div class="col-md-4">
      <div class="card-urgencia card-urgencia-rojo">
        <div class="urgencia-badge">🔴 COBRAR AHORA</div>
        <div class="urgencia-amount">$<%= ((deudores && deudores.reduce((s, d) => s + (d.monto_restante || 0), 0)) || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
        <div class="urgencia-subtitle"><%= deudoresImpagos %> clientes con deuda</div>
        <% if (deudoresImpagos > 0) { %>
          <a href="#deudores-lista" class="urgencia-action">Ver detalles →</a>
        <% } %>
      </div>
    </div>

    <!-- DEUDAS VENCIDAS -->
    <div class="col-md-4">
      <div class="card-urgencia card-urgencia-vencido">
        <div class="urgencia-badge">🔴 VENCIDAS</div>
        <div class="urgencia-amount">$<%= totalVencidas.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
        <div class="urgencia-subtitle"><%= deudasVencidas.length %> deudas vencidas</div>
        <% if (deudasVencidas.length > 0) { %>
          <a href="/deudas" class="urgencia-action">Gestionar →</a>
        <% } %>
      </div>
    </div>

    <!-- PRÓXIMOS 7 DÍAS -->
    <div class="col-md-4">
      <div class="card-urgencia card-urgencia-naranja">
        <div class="urgencia-badge">🟡 PRÓXIMOS 7D</div>
        <div class="urgencia-amount">$<%= totalProximas.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
        <div class="urgencia-subtitle"><%= deudasProximas.length %> pagos programados</div>
        <% if (deudasProximas.length > 0) { %>
          <a href="/deudas" class="urgencia-action">Planificar →</a>
        <% } %>
      </div>
    </div>
  </div>

  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       CAPA 2 - OPERACIÓN (Estados + Últimos Pedidos + Stock)
       ════════════════════════════════════════════════════════════════ -->

  <!-- ESTADOS DE PEDIDOS (4 CARDS) -->
  <div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
      <a href="/pedidos/pendientes" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important; cursor: pointer;">
          <div class="card-body">
            <p class="small mb-2 opacity-75"><i class="bi bi-clock-history"></i> Pendientes</p>
            <h2 class="text-danger mb-0 fw-bold"><%= counts.pendientes || 0 %></h2>
            <small class="text-muted">Esperando producción</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-lg-3">
      <a href="/pedidos/en-produccion" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important; cursor: pointer;">
          <div class="card-body">
            <p class="small mb-2 opacity-75"><i class="bi bi-gear"></i> En Producción</p>
            <h2 class="text-warning mb-0 fw-bold"><%= counts.en_produccion || 0 %></h2>
            <small class="text-muted">Trabajos activos</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-lg-3">
      <a href="/pedidos/listos" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0dcaf0 !important; cursor: pointer;">
          <div class="card-body">
            <p class="small mb-2 opacity-75"><i class="bi bi-check-circle"></i> Listos</p>
            <h2 class="text-info mb-0 fw-bold"><%= counts.listos || 0 %></h2>
            <small class="text-muted">Para entregar</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-6 col-lg-3">
      <a href="/pedidos/entregados" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important; cursor: pointer;">
          <div class="card-body">
            <p class="small mb-2 opacity-75"><i class="bi bi-box-seam"></i> Entregados</p>
            <h2 class="text-success mb-0 fw-bold"><%= counts.entregados || 0 %></h2>
            <small class="text-muted">Completados</small>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- ACCIONES RÁPIDAS (PARA EMPLEADOS) -->
  <% if (isEmpleado) { %>
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <a href="/caja-diaria" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; cursor: pointer;">
          <div class="card-body text-center py-4">
            <i class="bi bi-cash-coin" style="font-size: 2rem;"></i>
            <h5 class="mt-3 mb-0 fw-bold">Caja Diaria</h5>
            <p class="small opacity-75 mt-2">Registrar ingresos y egresos</p>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a href="/pedidos" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; cursor: pointer;">
          <div class="card-body text-center py-4">
            <i class="bi bi-kanban-fill" style="font-size: 2rem;"></i>
            <h5 class="mt-3 mb-0 fw-bold">Mis Trabajos</h5>
            <p class="small opacity-75 mt-2">Ver y gestionar pedidos</p>
          </div>
        </div>
      </a>
    </div>
  </div>
  <% } %>

  <!-- ÚLTIMOS PEDIDOS + STOCK (2 COLS) -->
  <% if (!isEmpleado) { %>
  <div class="row g-4 mb-4">
    <!-- ÚLTIMOS PEDIDOS -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light" style="border-bottom: 2px solid #e5e7eb;">
          <h6 class="mb-0"><i class="bi bi-list-ul"></i> Últimos Pedidos</h6>
        </div>
        <div style="max-height: 300px; overflow-y: auto;">
          <% if (ultimosPedidos && ultimosPedidos.length > 0) { %>
            <% ultimosPedidos.slice(0, 8).forEach(ped => { %>
            <div style="padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; cursor: pointer;" onclick="location.href='/pedidos/detalle/<%= ped.id %>';">
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600; color: #2563eb;">#<%= ped.id %></div>
                <small style="color: #9ca3af; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">
                  <%= (ped.cliente_nombre || 'Sin cliente').substring(0, 28) %>
                </small>
              </div>
              <div style="text-align: right; white-space: nowrap; margin-left: 1rem;">
                <span style="font-weight: 600;">$<%= (ped.precio || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></span>
                <div style="font-size: 0.75rem; color: #9ca3af;">
                  <%
                    const estado = ped.estado === 'ENTREGADO' ? '✓' : ped.estado === 'LISTO' ? '✓' : ped.estado === 'EN_PRODUCCION' ? '⚙️' : '📋';
                  %>
                  <%= estado %> <%= ped.estado.replace('_', ' ') %>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div style="padding: 2rem; text-align: center; color: #9ca3af;">No hay pedidos</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- STOCK CRÍTICO + TOP DEUDORES -->
    <div class="col-lg-5">
      <!-- STOCK CRÍTICO -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-light" style="border-bottom: 2px solid #e5e7eb;">
          <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Stock Crítico</h6>
        </div>
        <div style="padding: 1rem;">
          <%
            const stockBajoCount = stockBajo ? stockBajo.length : 0;
            if (stockBajoCount === 0) {
          %>
            <div style="text-align: center; color: #10b981; font-weight: 600;">✓ Stock OK</div>
          <% } else { %>
            <ul style="margin: 0; padding-left: 1rem; list-style: disc;">
              <% (stockBajo || []).slice(0, 4).forEach(item => { %>
              <li style="color: #1f2937; font-size: 0.9rem; margin-bottom: 0.4rem;">
                <strong><%= (item.nombre || '').substring(0, 22) %></strong> • <%= item.cantidad %>/<%= item.stock_minimo %>
              </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>

      <!-- TOP DEUDORES -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light" style="border-bottom: 2px solid #e5e7eb;">
          <h6 class="mb-0"><i class="bi bi-exclamation-circle"></i> Top Deudores</h6>
        </div>
        <div style="max-height: 250px; overflow-y: auto;">
          <% if (deudores && deudores.length > 0) { %>
            <% deudores.slice(0, 5).forEach((d, idx) => { %>
            <div style="padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: start;">
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 600; color: #1f2937; font-size: 0.95rem;">
                  <%= (d.cliente_nombre || 'Cliente').substring(0, 24) %>
                </div>
                <small style="color: #9ca3af;">Pedido #<%= d.id %></small>
              </div>
              <div style="text-align: right; margin-left: 0.5rem; white-space: nowrap;">
                <div style="font-weight: 600; color: #ef4444;">$<%= (d.monto_restante || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div style="padding: 1.5rem; text-align: center; color: #10b981; font-weight: 600;">✓ Sin deudas</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       CAPA 3 - KPIs FINANCIEROS (6 MÉTRICAS - ADMIN ONLY)
       ════════════════════════════════════════════════════════════════ -->

  <% if (user && user.rol === 'admin') { %>
  <div class="kpi-grid mb-4">
    <!-- INGRESOS MES -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Ingresos Mes</div>
      <div class="kpi-exec-value" style="color: #10b981;">
        $<%= (ingresosMes || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
      </div>
      <div class="kpi-exec-change">Acumulado</div>
    </div>

    <!-- GASTOS MES -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Gastos Mes</div>
      <div class="kpi-exec-value" style="color: #ef4444;">
        $<%= (gastosMes || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
      </div>
      <div class="kpi-exec-change">Egresos totales</div>
    </div>

    <!-- SALDO NETO -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Saldo Neto</div>
      <div class="kpi-exec-value" style="color: <%= ((ingresosMes || 0) - (gastosMes || 0)) >= 0 ? '#10b981' : '#ef4444' %>;">
        $<%= (((ingresosMes || 0) - (gastosMes || 0)) || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
      </div>
      <div class="kpi-exec-change">Resultado</div>
    </div>

    <!-- MARGEN % -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Margen Neto</div>
      <div class="kpi-exec-value" style="color: <%= (((ingresosMes || 0) - (gastosMes || 0)) / (ingresosMes || 1) * 100 >= 40) ? '#10b981' : '#f59e0b' %>;">
        <%= ((((ingresosMes || 0) - (gastosMes || 0)) / (ingresosMes || 1) * 100) || 0).toFixed(1) %>%
      </div>
      <div class="kpi-exec-change">Meta: 40%</div>
    </div>

    <!-- DEUDA CLIENTES -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Deuda Clientes</div>
      <div class="kpi-exec-value" style="color: #f59e0b;">
        $<%= ((deudores && deudores.reduce((s, d) => s + (d.monto_restante || 0), 0)) || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
      </div>
      <div class="kpi-exec-change"><%= deudores ? deudores.length : 0 %> clientes</div>
    </div>

    <!-- CLIENTES ACTIVOS -->
    <div class="kpi-card-exec">
      <div class="kpi-exec-label">Clientes Activos</div>
      <div class="kpi-exec-value" style="color: #0ea5e9;">
        <%= counts.clientes || 0 %>
      </div>
      <div class="kpi-exec-change">Base de datos</div>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       NAVEGACIÓN RÁPIDA (OPERACIÓN)
       ════════════════════════════════════════════════════════════════ -->

  <% if (!isEmpleado) { %>
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <a href="/catalogo" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
          <div class="card-body text-center">
            <i class="bi bi-card-list" style="font-size: 1.5rem; color: #0d6efd;"></i>
            <h6 class="mt-2 mb-0 fw-bold">Catálogo</h6>
            <small class="text-muted">Productos</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/gastos" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important;">
          <div class="card-body text-center">
            <i class="bi bi-receipt" style="font-size: 1.5rem; color: #dc3545;"></i>
            <h6 class="mt-2 mb-0 fw-bold">Gastos</h6>
            <small class="text-muted">Egresos</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/proveedores" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important;">
          <div class="card-body text-center">
            <i class="bi bi-truck" style="font-size: 1.5rem; color: #ffc107;"></i>
            <h6 class="mt-2 mb-0 fw-bold">Proveedores</h6>
            <small class="text-muted">Contactos</small>
          </div>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/reportes" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
          <div class="card-body text-center">
            <i class="bi bi-bar-chart-fill" style="font-size: 1.5rem; color: #198754;"></i>
            <h6 class="mt-2 mb-0 fw-bold">Reportes</h6>
            <small class="text-muted">Análisis</small>
          </div>
        </div>
      </a>
    </div>
  </div>
  <% } %>

</div>

<!-- ════════════════════════════════════════════════════════════════
     Scripts para interactividad
     ════════════════════════════════════════════════════════════════ -->

<script>
  function toggleDeudores() {
    const container = document.getElementById('contenedorDeudores');
    const icon = document.getElementById('iconDeudores');
    if (container) {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      icon.style.transform = container.style.display === 'none' ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  }

  function toggleStock() {
    const container = document.getElementById('contenedorStock');
    const icon = document.getElementById('iconStock');
    if (container) {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      icon.style.transform = container.style.display === 'none' ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  }

  function toggleProximos() {
    const container = document.getElementById('contenedorProximos');
    const icon = document.getElementById('iconProximos');
    if (container) {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      icon.style.transform = container.style.display === 'none' ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  }

  function toggleDeudasVencidas() {
    const container = document.getElementById('contenedorDeudasVencidas');
    const icon = document.getElementById('iconDeudasVencidas');
    if (container) {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      icon.style.transform = container.style.display === 'none' ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  }

  function toggleDeudasProximas() {
    const container = document.getElementById('contenedorDeudasProximas');
    const icon = document.getElementById('iconDeudasProximas');
    if (container) {
      container.style.display = container.style.display === 'none' ? 'block' : 'none';
      icon.style.transform = container.style.display === 'none' ? 'rotate(0deg)' : 'rotate(180deg)';
    }
  }
</script>
