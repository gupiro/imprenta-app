<!-- MODAL: Gasto Rápido -->
<div class="modal fade" id="modalGastoRapido" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-flash-fill"></i> Gasto Rápido</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formGastoRapido" onsubmit="event.preventDefault(); registrarGastoRapido();">
        <div class="modal-body">
          <!-- Monto -->
          <div class="mb-3">
            <label class="form-label fw-bold">Monto *</label>
            <div class="input-group input-group-lg">
              <span class="input-group-text">$</span>
              <input type="number" id="gastoRapidoMonto" class="form-control"
                     step="0.01" min="0.01" placeholder="500" required autofocus>
            </div>
          </div>

          <!-- Categoría -->
          <div class="mb-3">
            <label class="form-label fw-bold">Categoría *</label>
            <select id="gastoRapidoCategoria" class="form-select form-select-lg" required>
              <option value="">-- Seleccionar --</option>
              <option value="Materia Prima e Insumos">📦 Materia Prima</option>
              <option value="Mantenimiento de Máquinas">🔧 Mantenimiento</option>
              <option value="Sueldos y Personal">👥 Sueldos</option>
              <option value="Servicios (luz/gas/internet negocio)">⚡ Servicios</option>
              <option value="Transporte y Fletes">🚗 Transporte</option>
              <option value="Publicidad">📢 Publicidad</option>
              <option value="Otros gastos del negocio">📌 Otros</option>
            </select>
          </div>

          <!-- Descripción (opcional) -->
          <div class="mb-0">
            <label class="form-label fw-bold">Descripción (opcional)</label>
            <input type="text" id="gastoRapidoDescripcion" class="form-control"
                   placeholder="Ej: Resma A4 para trabajos">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" id="btnEnviarGasto" class="btn btn-danger btn-lg">
            <i class="bi bi-plus-circle"></i> Registrar Gasto
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- TOAST: Gasto Registrado -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
  <div id="toastGastoExito" class="toast align-items-center text-white bg-success border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body" id="toastMensaje"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>
