<!-- Panel Principal Ejecutivo - Imprenta Profesional -->

<div class="container-fluid py-4" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); min-height: 100vh;">

  <!-- ════════════════════════════════════════════════════════════════
       SECCIÓN PRINCIPAL: COBRANZA (GRANDE Y PROMINENTE)
       ════════════════════════════════════════════════════════════════ -->

  <% if (user && user.rol === 'admin') { %>

  <div class="row mb-5">
    <div class="col-12">
      <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 16px; padding: 3rem; color: white; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 2rem;">
          <div style="flex: 1;">
            <div style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #cbd5e1; margin-bottom: 0.5rem;">💰 Flujo de Caja Diario</div>
            <div style="font-size: 3rem; font-weight: 800; letter-spacing: -1px; font-family: 'Georgia', serif; margin-bottom: 0.5rem;">
              $<%= (ingresosHoy || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
            </div>
            <div style="font-size: 0.95rem; color: #cbd5e1; margin-bottom: 0.5rem;">
              Este mes: $<%= (ingresosMes || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %>
            </div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 3rem; opacity: 0.2;">📊</div>
          </div>
        </div>

        <!-- COBRANZA URGENTE: 3 BLOQUES -->
        <%
          const deudVencidas = (typeof deudasVencidas !== 'undefined' && Array.isArray(deudasVencidas)) ? deudasVencidas : [];
          const deudProximas = (typeof deudasProximas !== 'undefined' && Array.isArray(deudasProximas)) ? deudasProximas : [];
          const totalVencidas = deudVencidas.reduce((s, d) => s + (d.monto || 0), 0);
          const totalProximas = deudProximas.reduce((s, d) => s + (d.monto || 0), 0);
          const deudoresImpagos = deudores ? deudores.length : 0;
        %>

        <div class="grid-cobranza">
          <!-- COBRANZA CLIENTES -->
          <div class="cobranza-card">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; margin-bottom: 0.5rem;">⏳ Por Cobrar</div>
            <div style="font-size: 1.875rem; font-weight: 800; margin-bottom: 0.25rem;">$<%= ((deudores && deudores.reduce((s, d) => s + (d.monto_restante || 0), 0)) || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
            <div style="font-size: 0.85rem; color: #cbd5e1;"><%= deudoresImpagos %> clientes</div>
          </div>

          <!-- VENCIDAS -->
          <div class="cobranza-card">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #fca5a5; margin-bottom: 0.5rem;">🔴 Vencidas</div>
            <div style="font-size: 1.875rem; font-weight: 800; margin-bottom: 0.25rem; color: #fca5a5;">$<%= totalVencidas.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
            <div style="font-size: 0.85rem; color: #cbd5e1;"><%= deudVencidas.length %> deudas</div>
          </div>

          <!-- PRÓXIMAS SEMANA -->
          <div class="cobranza-card">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #fed7aa; margin-bottom: 0.5rem;">📅 Próx 7 días</div>
            <div style="font-size: 1.875rem; font-weight: 800; margin-bottom: 0.25rem; color: #fed7aa;">$<%= totalProximas.toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
            <div style="font-size: 0.85rem; color: #cbd5e1;"><%= deudProximas.length %> pagos</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       FLUJO DE TRABAJO VISUAL (5 ETAPAS)
       ════════════════════════════════════════════════════════════════ -->

  <div class="row mb-5">
    <div class="col-12">
      <h6 style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 1.5rem;">🔄 Estado de Producción</h6>

      <div class="grid-etapas">
        <!-- ETAPA 1: PENDIENTES -->
        <a href="/pedidos/pendientes" style="text-decoration: none;">
          <div class="etapa-card"
               onmouseover="this.style.borderColor='#7c2d12'; this.style.boxShadow='0 8px 20px rgba(124, 45, 18, 0.15)';"
               onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)';">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📋</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem;">Pendientes</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #7c2d12; margin-bottom: 0.25rem;"><%= counts.pendientes || 0 %></div>
            <div style="font-size: 0.8rem; color: #94a3b8;">Esperando producción</div>
          </div>
        </a>

        <!-- ETAPA 2: EN PRODUCCIÓN -->
        <a href="/pedidos/en-produccion" style="text-decoration: none;">
          <div class="etapa-card"
               onmouseover="this.style.borderColor='#92400e'; this.style.boxShadow='0 8px 20px rgba(146, 64, 14, 0.15)';"
               onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)';">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">⚙️</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem;">En Producción</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #92400e; margin-bottom: 0.25rem;"><%= counts.en_produccion || 0 %></div>
            <div style="font-size: 0.8rem; color: #94a3b8;">Trabajos activos</div>
          </div>
        </a>

        <!-- ETAPA 3: LISTOS -->
        <a href="/pedidos/listos" style="text-decoration: none;">
          <div class="etapa-card"
               onmouseover="this.style.borderColor='#15803d'; this.style.boxShadow='0 8px 20px rgba(21, 128, 61, 0.15)';"
               onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)';">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">✅</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem;">Listos</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #15803d; margin-bottom: 0.25rem;"><%= counts.listos || 0 %></div>
            <div style="font-size: 0.8rem; color: #94a3b8;">Para entregar</div>
          </div>
        </a>

        <!-- ETAPA 4: ENTREGADOS -->
        <a href="/pedidos/entregados" style="text-decoration: none;">
          <div class="etapa-card"
               onmouseover="this.style.borderColor='#0f766e'; this.style.boxShadow='0 8px 20px rgba(15, 118, 110, 0.15)';"
               onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)';">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📦</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem;">Entregados</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #0f766e; margin-bottom: 0.25rem;"><%= counts.entregados || 0 %></div>
            <div style="font-size: 0.8rem; color: #94a3b8;">Completados</div>
          </div>
        </a>

        <!-- ETAPA 5: PRESUPUESTOS -->
        <a href="/presupuestos" style="text-decoration: none;">
          <div class="etapa-card"
               onmouseover="this.style.borderColor='#1e3a8a'; this.style.boxShadow='0 8px 20px rgba(30, 58, 138, 0.15)';"
               onmouseout="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)';">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📊</div>
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem;">Presupuestos</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: #1e3a8a; margin-bottom: 0.25rem;"><%= counts.presupuestos || 0 %></div>
            <div style="font-size: 0.8rem; color: #94a3b8;">Pendientes</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       ACCESO DIRECTO: NUEVO PEDIDO + CAJA DIARIA (DESTACADOS)
       ════════════════════════════════════════════════════════════════ -->

  <div class="row g-3 mb-5">
    <!-- NUEVO PEDIDO -->
    <div class="col-12 col-md-6">
      <a href="/pedidos/nuevo" style="text-decoration: none;">
        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 16px; padding: 2rem; color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 12px 40px rgba(16, 185, 129, 0.25);"
             onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 16px 50px rgba(16, 185, 129, 0.35)';"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 12px 40px rgba(16, 185, 129, 0.25)';">
          <div style="display: flex; align-items: center; gap: 1.5rem;">
            <div style="font-size: 2.5rem;">➕</div>
            <div>
              <h5 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; font-weight: 700; font-family: 'Georgia', serif;">Nuevo Pedido</h5>
              <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Crear y gestionar pedidos</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <!-- CAJA DIARIA -->
    <div class="col-12 col-md-6">
      <a href="/caja-diaria" style="text-decoration: none;">
        <div style="background: linear-gradient(135deg, #0f766e 0%, #115e59 100%); border-radius: 16px; padding: 2rem; color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 12px 40px rgba(15, 118, 110, 0.25);"
             onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 16px 50px rgba(15, 118, 110, 0.35)';"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 12px 40px rgba(15, 118, 110, 0.25)';">
          <div style="display: flex; align-items: center; gap: 1.5rem;">
            <div style="font-size: 2.5rem;">💰</div>
            <div>
              <h5 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; font-weight: 700; font-family: 'Georgia', serif;">Caja Diaria</h5>
              <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;">Registrar ingresos y egresos</p>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════
       CAJA DIARIA + MIS TRABAJOS (Si es empleado)
       ════════════════════════════════════════════════════════════════ -->

  <% if (isEmpleado) { %>
  <div class="row mb-5">
    <div class="col-12 col-md-6">
      <a href="/pedidos" style="text-decoration: none;">
        <div style="background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 100%); border-radius: 14px; padding: 2.5rem; color: white; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 10px 30px rgba(92, 33, 182, 0.2);"
             onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 15px 40px rgba(92, 33, 182, 0.3)';"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 30px rgba(92, 33, 182, 0.2)';">
          <div style="font-size: 3rem; margin-bottom: 1rem;">📋</div>
          <h4 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; font-family: 'Georgia', serif;">Mis Trabajos</h4>
          <p style="font-size: 0.95rem; opacity: 0.9; margin-bottom: 0;">Ver y gestionar pedidos</p>
        </div>
      </a>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       ÚLTIMOS PEDIDOS + TOP DEUDORES (2 COLUMNAS)
       ════════════════════════════════════════════════════════════════ -->

  <% if (!isEmpleado) { %>
  <div class="row g-4 mb-5">
    <!-- ÚLTIMOS PEDIDOS -->
    <div class="col-lg-7">
      <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">
        <div style="padding: 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 0.75rem;">
          <span style="font-size: 1.25rem;">📋</span>
          <h6 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Últimos Pedidos</h6>
        </div>
        <div style="max-height: 350px; overflow-y: auto;">
          <% if (ultimosPedidos && ultimosPedidos.length > 0) { %>
            <% ultimosPedidos.slice(0, 8).forEach(ped => { %>
            <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: all 0.2s; background: white;"
                 onclick="location.href='/pedidos/detalle/<%= ped.id %>';"
                 onmouseover="this.style.background='#f8fafc';"
                 onmouseout="this.style.background='white';">
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 700; color: #1e3a8a; font-size: 0.95rem;">#<%= ped.id %></div>
                <small class="truncate truncate-tooltip truncate-sm" style="color: #64748b; display: block; margin-top: 0.2rem;" title="<%= ped.cliente_nombre || 'Sin cliente' %>">
                  <%= ped.cliente_nombre || 'Sin cliente' %>
                </small>
              </div>
              <div style="text-align: right; margin-left: 1rem; white-space: nowrap;">
                <span style="font-weight: 700; color: #0f172a;">$<%= (ped.precio || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></span>
                <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.2rem;">
                  <%= ped.estado === 'ENTREGADO' ? '✓ Entregado' : ped.estado === 'LISTO' ? '✓ Listo' : ped.estado === 'EN_PRODUCCION' ? '⚙️ En Prod' : '📋 Pendiente' %>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon">📋</div>
              <div class="empty-state-title">Sin Pedidos</div>
              <div class="empty-state-description">No hay pedidos para mostrar. ¡Crea uno nuevo!</div>
              <a href="/pedidos/nuevo" class="empty-state-cta">+ Crear Pedido</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- TOP DEUDORES + STOCK -->
    <div class="col-lg-5">
      <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); margin-bottom: 1.5rem;">
        <div style="padding: 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 0.75rem;">
          <span style="font-size: 1.25rem;">⚠️</span>
          <h6 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Top Deudores</h6>
        </div>
        <div style="max-height: 250px; overflow-y: auto;">
          <% if (deudores && deudores.length > 0) { %>
            <% deudores.slice(0, 5).forEach(d => { %>
            <div style="padding: 1rem 1.5rem; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: start;">
              <div style="flex: 1; min-width: 0;">
                <div style="font-weight: 700; color: #0f172a; font-size: 0.9rem;">
                  <span class="truncate truncate-tooltip truncate-sm" title="<%= d.cliente_nombre || 'Cliente' %>">
                    <%= d.cliente_nombre || 'Cliente' %>
                  </span>
                </div>
                <small style="color: #64748b; display: block; margin-top: 0.2rem;">Pedido #<%= d.id %></small>
              </div>
              <div style="text-align: right; margin-left: 0.5rem; white-space: nowrap;">
                <div style="font-weight: 700; color: #7c2d12;">$<%= (d.monto_restante || 0).toLocaleString('es-AR', {maximumFractionDigits: 0}) %></div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon">✓</div>
              <div class="empty-state-title">Excelente</div>
              <div class="empty-state-description">No hay deudas pendientes</div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- STOCK CRÍTICO -->
      <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">
        <div style="padding: 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 0.75rem;">
          <span style="font-size: 1.25rem;">📦</span>
          <h6 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Stock Crítico</h6>
        </div>
        <div style="padding: 1.5rem;">
          <%
            const stockBajoCount = stockBajo ? stockBajo.length : 0;
            if (stockBajoCount === 0) {
          %>
            <div class="empty-state">
              <div class="empty-state-icon">📦</div>
              <div class="empty-state-title">Stock OK</div>
              <div class="empty-state-description">Todos los productos están dentro de niveles normales</div>
            </div>
          <% } else { %>
            <ul style="margin: 0; padding-left: 1.25rem; list-style: disc;">
              <% (stockBajo || []).slice(0, 4).forEach(item => { %>
              <li style="color: #475569; font-size: 0.9rem; margin-bottom: 0.5rem;">
                <strong>
                  <span class="truncate truncate-tooltip truncate-sm" title="<%= item.nombre || '' %>">
                    <%= item.nombre || '' %>
                  </span>
                </strong> • <%= item.cantidad %>/<%= item.stock_minimo %>
              </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ════════════════════════════════════════════════════════════════
       NAVEGACIÓN RÁPIDA
       ════════════════════════════════════════════════════════════════ -->

  <% if (!isEmpleado) { %>
  <div class="row g-3">
    <div class="col-md-3">
      <a href="/catalogo" style="text-decoration: none;">
        <div style="background: white; border-radius: 12px; padding: 1.5rem; text-align: center; border: 1px solid #e2e8f0; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);"
             onmouseover="this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.1)'; this.style.transform='translateY(-2px)';"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)'; this.style.transform='translateY(0)';">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">📚</div>
          <h6 style="margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 700; color: #0f172a;">Catálogo</h6>
          <small style="color: #94a3b8;">Productos</small>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/gastos" style="text-decoration: none;">
        <div style="background: white; border-radius: 12px; padding: 1.5rem; text-align: center; border: 1px solid #e2e8f0; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);"
             onmouseover="this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.1)'; this.style.transform='translateY(-2px)';"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)'; this.style.transform='translateY(0)';">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">💸</div>
          <h6 style="margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 700; color: #0f172a;">Gastos</h6>
          <small style="color: #94a3b8;">Egresos</small>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/proveedores" style="text-decoration: none;">
        <div style="background: white; border-radius: 12px; padding: 1.5rem; text-align: center; border: 1px solid #e2e8f0; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);"
             onmouseover="this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.1)'; this.style.transform='translateY(-2px)';"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)'; this.style.transform='translateY(0)';">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🚚</div>
          <h6 style="margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 700; color: #0f172a;">Proveedores</h6>
          <small style="color: #94a3b8;">Contactos</small>
        </div>
      </a>
    </div>

    <div class="col-md-3">
      <a href="/reportes" style="text-decoration: none;">
        <div style="background: white; border-radius: 12px; padding: 1.5rem; text-align: center; border: 1px solid #e2e8f0; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);"
             onmouseover="this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.1)'; this.style.transform='translateY(-2px)';"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0, 0, 0, 0.05)'; this.style.transform='translateY(0)';">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">📈</div>
          <h6 style="margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 700; color: #0f172a;">Reportes</h6>
          <small style="color: #94a3b8;">Análisis</small>
        </div>
      </a>
    </div>
  </div>
  <% } %>

</div>

<style>
  /* Scrollbar estilizado */
  ::-webkit-scrollbar {
    width: 6px;
  }
