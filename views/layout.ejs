<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Imprenta El Gráfico' %></title>

  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#2563eb" />

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/modern-minimal.css" />
  <link rel="stylesheet" href="/css/layout-new.css" />
  <link rel="stylesheet" href="/styles.css" />

  <style>
    :root {
      --sidebar-width: 280px;
      --sidebar-width-mobile: 70px;
      --navbar-height: 60px;
      --color-primary: #2563eb;
      --color-success: #10b981;
      --color-danger: #ef4444;
      --color-warning: #f59e0b;
      --color-info: #0ea5e9;
      --bg-primary: #f8fafc;
      --bg-secondary: #ffffff;
      --text-primary: #1f2937;
      --text-secondary: #6b7280;
      --border-color: #e5e7eb;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      background-color: var(--bg-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      color: var(--text-primary);
    }

    body {
      display: flex;
      flex-direction: column;
    }

    /* ════════════════════════════════════════════════════════════════
       NAVBAR SUPERIOR
       ════════════════════════════════════════════════════════════════ */

    .navbar-top {
      background: linear-gradient(135deg, var(--color-primary) 0%, #1e40af 100%);
      height: var(--navbar-height);
      display: flex;
      align-items: center;
      padding: 0 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .navbar-brand-section {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex: 1;
    }

    .navbar-toggle-btn {
      background: none;
      border: none;
      color: white;
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0.5rem;
      display: none;
    }

    .navbar-brand-section h1 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 700;
      color: white;
      letter-spacing: -0.5px;
    }

    .navbar-brand-section p {
      margin: 0;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.8);
    }

    .navbar-user {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: white;
      margin-left: auto;
    }

    .navbar-user-info {
      text-align: right;
      font-size: 0.875rem;
    }

    .navbar-user-info .name {
      font-weight: 600;
    }

    .navbar-user-info .role {
      font-size: 0.75rem;
      opacity: 0.9;
    }

    .navbar-user-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1rem;
    }

    .navbar-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .navbar-actions button {
      background: rgba(255, 255, 255, 0.2);
      border: none;
      color: white;
      cursor: pointer;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      font-size: 1rem;
      transition: background 0.2s;
    }

    .navbar-actions button:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    /* ════════════════════════════════════════════════════════════════
       CONTENEDOR PRINCIPAL (SIDEBAR + CONTENT)
       ════════════════════════════════════════════════════════════════ */

    .main-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* ════════════════════════════════════════════════════════════════
       SIDEBAR
       ════════════════════════════════════════════════════════════════ */

    .sidebar {
      width: var(--sidebar-width);
      background: var(--bg-secondary);
      border-right: 1px solid var(--border-color);
      overflow-y: auto;
      padding: 1.5rem 0;
      box-shadow: 2px 0 4px rgba(0, 0, 0, 0.05);
      transition: transform 0.3s ease, width 0.3s ease;
      position: relative;
      z-index: 99;
    }

    .sidebar.collapsed {
      width: var(--sidebar-width-mobile);
      padding: 1rem 0;
    }

    .sidebar-section {
      padding: 0 1rem 1.5rem 1rem;
    }

    .sidebar-section:first-child {
      padding-top: 0;
    }

    .sidebar.collapsed .sidebar-section {
      padding: 0 0.5rem 1rem 0.5rem;
    }

    .sidebar-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-secondary);
      letter-spacing: 0.5px;
      margin-bottom: 0.75rem;
      padding: 0 0.5rem;
    }

    .sidebar.collapsed .sidebar-label {
      display: none;
    }

    .sidebar-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sidebar-menu-item {
      position: relative;
    }

    .sidebar-menu-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.2s;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-menu-link span {
      display: none;
    }

    .sidebar.collapsed .sidebar-menu-link {
      justify-content: center;
      gap: 0;
    }

    .sidebar-menu-link:hover {
      background: var(--bg-primary);
      color: var(--color-primary);
    }

    .sidebar-menu-link.active {
      background: rgba(37, 99, 235, 0.1);
      color: var(--color-primary);
      font-weight: 600;
    }

    .sidebar-menu-link.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--color-primary);
      border-radius: 0 3px 3px 0;
    }

    .sidebar-menu-link i {
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    /* Submenu */
    .sidebar-submenu {
      list-style: none;
      padding-left: 1.5rem;
      margin-top: 0.25rem;
      display: none;
      flex-direction: column;
      gap: 0.1rem;
    }

    .sidebar-submenu.show {
      display: flex;
    }

    .sidebar.collapsed .sidebar-submenu {
      display: none !important;
    }

    .sidebar-submenu-link {
      display: flex;
      align-items: center;
      padding: 0.5rem 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 4px;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .sidebar-submenu-link:hover {
      color: var(--color-primary);
      background: var(--bg-primary);
    }

    .sidebar-submenu-link.active {
      color: var(--color-primary);
      font-weight: 600;
    }

    /* ════════════════════════════════════════════════════════════════
       CONTENIDO PRINCIPAL
       ════════════════════════════════════════════════════════════════ */

    .main-content {
      flex: 1;
      overflow-y: auto;
      padding: 2rem;
      background: var(--bg-primary);
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 0.5rem 0;
    }

    .page-subtitle {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin: 0;
    }

    /* ════════════════════════════════════════════════════════════════
       ALERTAS
       ════════════════════════════════════════════════════════════════ */

    .alert-container {
      margin-bottom: 1.5rem;
    }

    .alert {
      padding: 1rem 1.25rem;
      border-radius: 8px;
      border-left: 4px solid;
      margin-bottom: 0.75rem;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .alert-success {
      background: #ecfdf5;
      border-color: var(--color-success);
      color: #065f46;
    }

    .alert-danger {
      background: #fef2f2;
      border-color: var(--color-danger);
      color: #7f1d1d;
    }

    .alert-warning {
      background: #fffbeb;
      border-color: var(--color-warning);
      color: #92400e;
    }

    .alert-info {
      background: #f0f9ff;
      border-color: var(--color-info);
      color: #0c2d6b;
    }

    /* ════════════════════════════════════════════════════════════════
       RESPONSIVE
       ════════════════════════════════════════════════════════════════ */

    @media (max-width: 768px) {
      :root {
        --sidebar-width: 70px;
      }

      .navbar-toggle-btn {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: -280px;
        width: 280px;
        height: 100vh;
        top: var(--navbar-height);
        bottom: 0;
        z-index: 98;
        transition: left 0.3s ease;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
      }

      .sidebar.open {
        left: 0;
      }

      .main-content {
        padding: 1.5rem;
      }

      .page-title {
        font-size: 1.5rem;
      }

      .navbar-user-info {
        display: none;
      }
    }

    @media (max-width: 576px) {
      .navbar-top {
        padding: 0 1rem;
      }

      .main-content {
        padding: 1rem;
      }

      .page-title {
        font-size: 1.25rem;
      }
    }

    /* ═════════════════════════════════════════════════════════════════
       DARK MODE STYLES
       ═════════════════════════════════════════════════════════════════ */
    :root.dark-mode {
      --bs-body-bg: #1a1d23;
      --bs-body-color: #e0e0e0;
      --bs-border-color: #404854;
    }

    :root.dark-mode body {
      background-color: #1a1d23;
      color: #e0e0e0;
    }

    :root.dark-mode .navbar-top {
      background: linear-gradient(135deg, #1e2228 0%, #272d34 100%);
      border-bottom: 1px solid #404854;
    }

    :root.dark-mode .sidebar {
      background: #1e2228;
      border-right: 1px solid #404854;
    }

    :root.dark-mode .sidebar-menu-link {
      color: #b0b8c1;
    }

    :root.dark-mode .sidebar-menu-link:hover,
    :root.dark-mode .sidebar-menu-link.active {
      color: #2563eb;
      background: rgba(37, 99, 235, 0.1);
    }

    :root.dark-mode .card-minimal {
      background: #2a2f36;
      border-color: #404854;
    }

    :root.dark-mode .card-minimal:hover {
      border-color: #2563eb;
    }

    :root.dark-mode .card-header {
      color: #e0e0e0;
      border-color: #404854;
    }

    :root.dark-mode .table-minimal thead {
      background-color: #272d34;
      border-color: #404854;
    }

    :root.dark-mode .table-minimal th {
      color: #b0b8c1;
    }

    :root.dark-mode .table-minimal td {
      color: #d0d8e0;
      border-color: #404854;
    }

    :root.dark-mode .table-minimal tbody tr:hover {
      background-color: #2a2f36;
    }

    :root.dark-mode .modal-content {
      background: #2a2f36;
      border-color: #404854;
    }

    :root.dark-mode .modal-header {
      background: #1e2228;
      border-color: #404854;
      color: #e0e0e0;
    }

    :root.dark-mode .form-control,
    :root.dark-mode .form-select {
      background: #1e2228;
      color: #e0e0e0;
      border-color: #404854;
    }

    :root.dark-mode .form-control:focus,
    :root.dark-mode .form-select:focus {
      background: #1e2228;
      color: #e0e0e0;
      border-color: #2563eb;
    }

    :root.dark-mode .alert {
      background: rgba(37, 99, 235, 0.15);
      border-color: #2563eb;
      color: #d0d8e0;
    }

    :root.dark-mode .badge-default {
      background: #3a3f47;
      color: #b0b8c1;
    }

    :root.dark-mode .form-label {
      color: #d0d8e0;
    }
  </style>
</head>

<body>
  <!-- ════════════════════════════════════════════════════════════════
       NAVBAR SUPERIOR
       ════════════════════════════════════════════════════════════════ -->

  <nav class="navbar-top">
    <div class="navbar-brand-section">
      <button class="navbar-toggle-btn" id="sidebarToggle" title="Alternar menú">
        <i class="bi bi-list"></i>
      </button>
      <div>
        <h1>📊 Imprenta El Gráfico</h1>
        <p>Gestión Integrada</p>
      </div>
    </div>

    <div class="navbar-user">
      <div class="navbar-user-info">
        <div class="name"><%= user?.email || 'Usuario' %></div>
        <div class="role"><%= (user?.rol || 'Sin rol').charAt(0).toUpperCase() + (user?.rol || '').slice(1).toLowerCase() %></div>
      </div>
      <div class="navbar-user-avatar">
        <%= (user?.email?.charAt(0) || 'U').toUpperCase() %>
      </div>
      <div class="navbar-actions">
        <button id="darkModeToggle" title="Cambiar tema" onclick="toggleDarkMode()">
          <i class="bi bi-moon-fill" id="darkModeIcon"></i>
        </button>
        <button title="Soporte" onclick="alert('Ayuda: 3878 22-4908')">
          <i class="bi bi-question-circle"></i>
        </button>
        <a href="/auth/logout" style="text-decoration: none; color: white; display: flex; align-items: center; padding: 0.5rem 0.75rem; border-radius: 6px; background: rgba(255,255,255,0.2);" title="Cerrar sesión">
          <i class="bi bi-box-arrow-right"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- ════════════════════════════════════════════════════════════════
       CONTENEDOR PRINCIPAL
       ════════════════════════════════════════════════════════════════ -->

  <div class="main-container">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-label">Principal</div>
        <ul class="sidebar-menu">
          <li class="sidebar-menu-item">
            <a href="/" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'home') ? 'active' : '' %>">
              <i class="bi bi-house-fill"></i>
              <span>Inicio</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">📋 Operativo Diario</div>
        <ul class="sidebar-menu">
          <li class="sidebar-menu-item">
            <a href="/caja-diaria" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'caja-diaria') ? 'active' : '' %>">
              <i class="bi bi-cash-coin"></i>
              <span>Caja Diaria</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/pedidos" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'pedidos') ? 'active' : '' %>">
              <i class="bi bi-kanban-fill"></i>
              <span>Producción</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/clientes" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'clientes') ? 'active' : '' %>">
              <i class="bi bi-people-fill"></i>
              <span>Clientes</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/presupuestos" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'presupuestos') ? 'active' : '' %>">
              <i class="bi bi-calculator"></i>
              <span>Presupuestos</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">💳 Finanzas</div>
        <ul class="sidebar-menu">
          <li class="sidebar-menu-item">
            <a href="/gastos" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'gastos') ? 'active' : '' %>">
              <i class="bi bi-receipt"></i>
              <span>Gastos</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/pagos" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'pagos') ? 'active' : '' %>">
              <i class="bi bi-calendar-check"></i>
              <span>Centro Pagos</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/reportes" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'reportes') ? 'active' : '' %>">
              <i class="bi bi-bar-chart-fill"></i>
              <span>Reportes</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">🛒 Ventas</div>
        <ul class="sidebar-menu">
          <li class="sidebar-menu-item">
            <a href="/catalogo" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'catalogo') ? 'active' : '' %>">
              <i class="bi bi-card-list"></i>
              <span>Catálogo</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-label">⚙️ Admin</div>
        <ul class="sidebar-menu">
          <li class="sidebar-menu-item">
            <a href="/usuarios" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'usuarios') ? 'active' : '' %>">
              <i class="bi bi-gear-fill"></i>
              <span>Usuarios</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/stock" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'stock') ? 'active' : '' %>">
              <i class="bi bi-boxes"></i>
              <span>Stock</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/proveedores" class="sidebar-menu-link <%= pages && pages.find(p => p.name === 'proveedores') ? 'active' : '' %>">
              <i class="bi bi-truck"></i>
              <span>Proveedores</span>
            </a>
          </li>
        </ul>
      </div>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">
      <!-- Alertas -->
      <div class="alert-container">
        <% if (success && success.length > 0) { %>
          <% if (Array.isArray(success)) { %>
            <% success.forEach(msg => { %>
              <div class="alert alert-success">
                <i class="bi bi-check-circle"></i> <%= msg %>
              </div>
            <% }); %>
          <% } else { %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle"></i> <%= success %>
            </div>
          <% } %>
        <% } %>

        <% if (error && error.length > 0) { %>
          <% if (Array.isArray(error)) { %>
            <% error.forEach(msg => { %>
              <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i> <%= msg %>
              </div>
            <% }); %>
          <% } else { %>
            <div class="alert alert-danger">
              <i class="bi bi-exclamation-triangle"></i> <%= error %>
            </div>
          <% } %>
        <% } %>
      </div>

      <!-- Contenido renderizado -->
      <%- body %>
    </main>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
  <script src="/js/table-interactive.js"></script>

  <script>
    // Toggle Sidebar en móvil
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('open');
    });

    // Cerrar sidebar al hacer click en un link (móvil)
    document.querySelectorAll('.sidebar-menu-link').forEach(link => {
      link.addEventListener('click', function() {
        const sidebar = document.getElementById('sidebar');
        if (window.innerWidth <= 768) {
          sidebar.classList.remove('open');
        }
      });
    });

    // Marcar item activo en sidebar
    document.querySelectorAll('.sidebar-menu-link').forEach(link => {
      if (link.getAttribute('href') === window.location.pathname) {
        link.classList.add('active');
      }
    });

    // Dark Mode Toggle
    function toggleDarkMode() {
      const html = document.documentElement;
      const isDarkMode = html.classList.toggle('dark-mode');
      const icon = document.getElementById('darkModeIcon');

      // Guardar preferencia en localStorage
      localStorage.setItem('darkMode', isDarkMode);

      // Cambiar icono
      icon.className = isDarkMode ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    }

    // Cargar preferencia de dark mode al iniciar
    function initDarkMode() {
      const isDarkMode = localStorage.getItem('darkMode') === 'true';
      const html = document.documentElement;
      const icon = document.getElementById('darkModeIcon');

      if (isDarkMode) {
        html.classList.add('dark-mode');
        icon.className = 'bi bi-sun-fill';
      } else {
        html.classList.remove('dark-mode');
        icon.className = 'bi bi-moon-fill';
      }
    }

    // Inicializar dark mode al cargar
    document.addEventListener('DOMContentLoaded', initDarkMode);
  </script>
</body>

</html>
