  <!-- ═══════════════════════════════════════════════════════════════
       SCRIPTS
       ═══════════════════════════════════════════════════════════════ -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/table-interactive.js"></script>
  <script src="/js/truncate-helper.js"></script>

  <script>
    // Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(reg => console.log('✔ SW registrado:', reg.scope))
          .catch(err => console.error('❌ SW error:', err));
      });
    }

    // Marcar página activa
    document.addEventListener('DOMContentLoaded', function() {
      const currentPath = window.location.pathname;
      document.querySelectorAll('.navbar-nav .nav-link').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
          link.classList.add('active');
        }
      });
    });

    // ═══════════════════════════════════════════════════════════════
    // PREVENIR AUTO-SCROLL AL CARGAR LA PÁGINA
    // ═══════════════════════════════════════════════════════════════
    (function() {
      // Forzar scroll a top al cargar
      window.addEventListener('load', function() {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
      });

      // También al inicio del DOM
      window.scrollTo(0, 0);

      // Prevenir que los gráficos causen scroll
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
          window.scrollTo(0, 0);
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        }, 100);
      });

      // Si hay clicks en elementos, mantener en top
      let lastScrollTop = 0;
      window.addEventListener('scroll', function() {
        if (window.scrollY > 50 && lastScrollTop === 0) {
          window.scrollTo(0, 0);
        }
        lastScrollTop = window.scrollY <= 0 ? 0 : window.scrollY;
      }, { passive: true });

      // ═════════════════════════════════════════════════════════════
      // ACTUALIZAR COLORES DE ESTADOS EN SELECT
      // ═════════════════════════════════════════════════════════════
      document.querySelectorAll('.estado-select').forEach(select => {
        // Establecer color inicial
        const updateColor = () => {
          select.setAttribute('data-estado', select.value);
        };
        updateColor();
        select.addEventListener('change', updateColor);
      });

      // ═════════════════════════════════════════════════════════════
      // INICIALIZAR POPOVERS Y TOOLTIPS BOOTSTRAP
      // ═════════════════════════════════════════════════════════════
      document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
        new bootstrap.Popover(el, { trigger: 'click', html: false });
      });

      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
        new bootstrap.Tooltip(el);
le]').setAttribute('title', data.tooltip);
            // Inicializar Bootstrap Tooltip
            new bootstrap.Tooltip(semaforoDot.parentElement, { placement: 'bottom' });
          })
          .catch(() => {});
      }
    })();

    // Dark Mode Toggle
    function toggleDarkMode() {
      const html = document.documentElement;
      const isDarkMode = html.classList.toggle('dark-mode');
      const icon = document.getElementById('darkModeIcon');

      // Guardar preferencia en localStorage
      localStorage.setItem('darkMode', isDarkMode);

      // Cambiar icono
      icon.className = isDarkMode ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    }

    // Cargar preferencia de dark mode al iniciar
    function initDarkMode() {
      const isDarkMode = localStorage.getItem('darkMode') === 'true';
      const html = document.documentElement;
      const icon = document.getElementById('darkModeIcon');

      if (isDarkMode) {
        html.classList.add('dark-mode');
        icon.className = 'bi bi-sun-fill';
      } else {
        html.classList.remove('dark-mode');
        icon.className = 'bi bi-moon-fill';
      }
    }

    // Inicializar dark mode al cargar
    document.addEventListener('DOMContentLoaded', initDarkMode);

    // ════════════════════════════════════════════════════════════════
    // SIDEBAR FLOTANTE
    // ════════════════════════════════════════════════════════════════
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebarClose = document.getElementById('sidebar-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    if (sidebarToggle && sidebar && overlay) {
      // Abrir sidebar
      sidebarToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        sidebar.classList.add('open');
        overlay.classList.add('active');
      });

      // Cerrar sidebar con botón X
      if (sidebarClose) {
        sidebarClose.addEventListener('click', () => {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
        });
      }

      // Cerrar sidebar cuando haces click en overlay
      overlay.addEventListener('click', () => {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
      });

      // Cerrar sidebar cuando haces click en un link del menú
      const sidebarLinks = sidebar.querySelectorAll('a');
      sidebarLinks.forEach(link => {
        link.addEventListener('click', () => {
          sidebar.classList.remove('open');
          overlay.classList.remove('active');
        });
      });
    }

    // ════════════════════════════════════════════════════════════════
    // GASTO RÁPIDO - BOTÓN FLOTANTE
    // ════════════════════════════════════════════════════════════════
    function abrirGastoRapido() {
      const modal = new bootstrap.Modal(document.getElementById('modalGastoRapido'));
      modal.show();
      // Limpiar formulario
      document.getElementById('formGastoRapido').reset();
      document.getElementById('btnEnviarGasto').disabled = false;
      document.getElementById('btnEnviarGasto').innerHTML = '<i class="bi bi-plus-circle"></i> Registrar Gasto';
    }

    function registrarGastoRapido() {
      const btnEnviar = document.getElementById('btnEnviarGasto');
      const monto = parseFloat(document.getElementById('gastoRapidoMonto').value);
      const categoria = document.getElementById('gastoRapidoCategoria').value;
      const descripcion = document.getElementById('gastoRapidoDescripcion').value || '(sin descripción)';

      // Validaciones
      if (!monto || monto <= 0) {
        alert('⚠️ Ingresa un monto válido');
        return;
      }
      if (!categoria) {
        alert('⚠️ Selecciona una categoría');
        return;
      }

      btnEnviar.disabled = true;
      btnEnviar.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

      // Enviar datos al servidor
      fetch('/gastos/rapido', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
        },
        body: JSON.stringify({
          monto,
          categoria,
          descripcion
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.ok) {
          // ✅ Mostrar toast de éxito
          const toastEl = document.getElementById('toastGastoExito');
          const toast = new bootstrap.Toast(toastEl);
          document.getElementById('toastMensaje').textContent = `✅ $${monto.toLocaleString('es-AR', {minimumFractionDigits: 2})} registrado en ${categoria}`;
          toast.show();

          // Cerrar modal
          bootstrap.Modal.getInstance(document.getElementById('modalGastoRapido')).hide();

          // Reset botón
          btnEnviar.disabled = false;
          btnEnviar.innerHTML = '<i class="bi bi-plus-circle"></i> Registrar Gasto';
        } else {
          alert('❌ Error: ' + (data.error || 'No se pudo registrar el gasto'));
          btnEnviar.disabled = false;
          btnEnviar.innerHTML = '<i class="bi bi-plus-circle"></i> Registrar Gasto';
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('❌ Error de conexión');
        btnEnviar.disabled = false;
        btnEnviar.innerHTML = '<i class="bi bi-plus-circle"></i> Registrar Gasto';
      });
    }
  </script>

  <!-- BOTÓN FLOTANTE: Gasto Rápido -->
  <button id="btnGastoRapido" class="btn btn-danger" onclick="abrirGastoRapido()"
          style="position: fixed; bottom: 30px; right: 30px; z-index: 1000; width: 60px; height: 60px; border-radius: 50%; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 28px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4); transition: all 0.2s ease;">
    <i class="bi bi-plus"></i>
  </button>

  <!-- Efecto hover al botón flotante -->
  <style>
    #btnGastoRapido:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 16px rgba(239, 68, 68, 0.5);
    }
    #btnGastoRapido:active {
      transform: scale(0.95);
    }
  </style>

  <!-- MODAL: Gasto Rápido -->
  <div class="modal fade" id="modalGastoRapido" tabindex="-1">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="bi bi-flash-fill"></i> Gasto Rápido</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="formGastoRapido" onsubmit="event.preventDefault(); registrarGastoRapido();">
          <div class="modal-body">
            <!-- Monto -->
            <div class="mb-3">
              <label class="form-label fw-bold">Monto *</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text">$</span>
                <input type="number" id="gastoRapidoMonto" class="form-control"
                       step="0.01" min="0.01" placeholder="500" required autofocus>
              </div>
            </div>

            <!-- Categoría -->
            <div class="mb-3">
              <label class="form-label fw-bold">Categoría *</label>
              <select id="gastoRapidoCategoria" class="form-select form-select-lg" required>
                <option value="">-- Seleccionar --</option>
                <option value="Materia Prima e Insumos">📦 Materia Prima</option>
                <option value="Mantenimiento de Máquinas">🔧 Mantenimiento</option>
                <option value="Sueldos y Personal">👥 Sueldos</option>
                <option value="Servicios (luz/gas/internet negocio)">⚡ Servicios</option>
                <option value="Transporte y Fletes">🚗 Transporte</option>
                <option value="Publicidad">📢 Publicidad</option>
                <option value="Otros gastos del negocio">📌 Otros</option>
              </select>
            </div>

            <!-- Descripción (opcional) -->
            <div class="mb-0">
              <label class="form-label fw-bold">Descripción (opcional)</label>
              <input type="text" id="gastoRapidoDescripcion" class="form-control"
                     placeholder="Ej: Resma A4 para trabajos">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" id="btnEnviarGasto" class="btn btn-danger btn-lg">
              <i class="bi bi-plus-circle"></i> Registrar Gasto
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- TOAST: Gasto Registrado -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
    <div id="toastGastoExito" class="toast align-items-center text-white bg-success border-0" role="alert">
      <div class="d-flex">
        <div class="toast-body" id="toastMensaje"></div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>


</body>
</html>
