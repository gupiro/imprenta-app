<!-- views/pagos/index.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <h1 class="display-6"><i class="bi bi-calendar-check"></i> Centro de Pagos</h1>
      <p class="text-muted">Gestión consolidada de todos los pagos pendientes</p>
    </div>
  </div>

  <!-- Panel de Alertas -->
  <div class="row mb-4">
    <div class="col-12">
      <% const alert_type = (totalUrgente > saldoDisponible) ? 'danger' : 'warning'; %>
      <div class="alert alert-<%= alert_type %>">
        <div class="row align-items-center">
          <div class="col-md-8">
            <strong>💳 Pagos urgentes esta semana:</strong> <span class="fs-5">$<%= totalUrgente.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
            &nbsp; | &nbsp;
            <strong>📅 Próximos 30 días:</strong> <span class="fs-5">$<%= totalProximos30.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
          </div>
          <div class="col-md-4 text-end">
            <strong>Saldo disponible:</strong> <span class="fs-5 <%= (totalProximos30 > saldoDisponible) ? 'text-danger' : 'text-success' %>">
              $<%= saldoDisponible.toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs de Navegación -->
  <ul class="nav nav-tabs mb-4" id="pagosTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="tab-todos" data-bs-toggle="tab" data-bs-target="#todos" type="button">
        Todos (<%= todos.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-tarjetas" data-bs-toggle="tab" data-bs-target="#tarjetas" type="button">
        Tarjetas (<%= tarjetas.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-cheques" data-bs-toggle="tab" data-bs-target="#cheques" type="button">
        Cheques (<%= cheques.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-prestamos" data-bs-toggle="tab" data-bs-target="#prestamos" type="button">
        Préstamos (<%= prestamos.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-proveedores" data-bs-toggle="tab" data-bs-target="#proveedores" type="button">
        Proveedores (<%= proveedores.length %>)
      </button>
    </li>
  </ul>

  <!-- Contenido de Tabs -->
  <div class="tab-content" id="pagosTabsContent">
    <!-- Tab: TODOS -->
    <div class="tab-pane fade show active" id="todos" role="tabpanel">
      <% if (todos.length === 0) { %>
        <div class="alert alert-info text-center py-5">
          <i class="bi bi-inbox" style="font-size: 3rem;"></i>
          <p class="mt-3 mb-0"><strong>No hay pagos pendientes</strong></p>
        </div>
      <% } else { %>
        <div class="card border-0 shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th style="width: 120px;">Prioridad</th>
                  <th>Descripción</th>
                  <th style="width: 100px;">Tipo</th>
                  <th style="width: 120px;">Monto</th>
                  <th style="width: 120px;">Vencimiento</th>
                  <th style="width: 100px;">Días</th>
                </tr>
              </thead>
              <tbody>
                <% todos.forEach(pago => { %>
                  <tr class="<%= (pago.dias_restantes !== null && pago.dias_restantes < 0) ? 'table-danger' : '' %>">
                    <td>
                      <span class="badge <%= pago.prioridad.clase %>"><%= pago.prioridad.label %></span>
                    </td>
                    <td><%= pago.titulo %></td>
                    <td><span class="badge bg-secondary"><%= pago.source_tipo %></span></td>
                    <td class="fw-bold">$<%= (pago.monto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td>
                      <% if (pago.fecha_calculada) { %>
                        <%= pago.fecha_calculada.toLocaleDateString('es-AR') %>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (pago.dias_restantes !== null) { %>
                        <small class="<%= (pago.dias_restantes < 0) ? 'text-danger fw-bold' : '' %>">
                          <%= (pago.dias_restantes < 0) ? Math.abs(pago.dias_restantes) + ' vencido' : pago.dias_restantes + ' días' %>
                        </small>
                      <% } else { %>
                        <small class="text-muted">—</small>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Tab: TARJETAS -->
    <div class="tab-pane fade" id="tarjetas" role="tabpanel">
      <% if (tarjetas.length === 0) { %>
        <div class="alert alert-info">No hay tarjetas registradas.</div>
      <% } else { %>
        <div class="card border-0 shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Tarjeta</th>
                  <th>Saldo Adeudado</th>
                  <th>Monto Mínimo</th>
                  <th style="width: 120px;">Vencimiento</th>
                  <th style="width: 120px;">Prioridad</th>
                </tr>
              </thead>
              <tbody>
                <% tarjetas.forEach(t => { %>
                  <tr>
                    <td><strong><%= t.titulo %></strong></td>
                    <td>$<%= (t.saldo_adeudado || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td>$<%= (t.monto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td><%= t.fecha_calculada ? t.fecha_calculada.toLocaleDateString('es-AR') : '—' %></td>
                    <td>
                      <span class="badge <%= t.prioridad.clase %>"><%= t.prioridad.label %></span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Tab: CHEQUES -->
    <div class="tab-pane fade" id="cheques" role="tabpanel">
      <% if (cheques.length === 0) { %>
        <div class="alert alert-info">No hay cheques pendientes.</div>
      <% } else { %>
        <div class="card border-0 shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Cheque #</th>
                  <th>Banco</th>
                  <th>Monto</th>
                  <th style="width: 120px;">Vencimiento</th>
                  <th style="width: 120px;">Prioridad</th>
                </tr>
              </thead>
              <tbody>
                <% cheques.forEach(ch => { %>
                  <tr class="<%= (ch.dias_restantes !== null && ch.dias_restantes < 0) ? 'table-danger' : '' %>">
                    <td><strong><%= ch.titulo %></strong></td>
                    <td><%= ch.subtitulo %></td>
                    <td>$<%= (ch.monto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td><%= ch.fecha_calculada ? ch.fecha_calculada.toLocaleDateString('es-AR') : '—' %></td>
                    <td>
                      <span class="badge <%= ch.prioridad.clase %>"><%= ch.prioridad.label %></span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Tab: PRÉSTAMOS -->
    <div class="tab-pane fade" id="prestamos" role="tabpanel">
      <% if (prestamos.length === 0) { %>
        <div class="alert alert-info">No hay préstamos activos.</div>
      <% } else { %>
        <div class="card border-0 shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Préstamo</th>
                  <th>Entidad</th>
                  <th>Cuota Mensual</th>
                  <th>Saldo Pendiente</th>
                  <th style="width: 120px;">Próxima Cuota</th>
                  <th style="width: 120px;">Prioridad</th>
                </tr>
              </thead>
              <tbody>
                <% prestamos.forEach(p => { %>
                  <tr>
                    <td><strong><%= p.titulo %></strong></td>
                    <td><%= p.subtitulo %></td>
                    <td>$<%= (p.monto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td>$<%= (p.monto_pendiente || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td><%= p.fecha_calculada ? p.fecha_calculada.toLocaleDateString('es-AR') : '—' %></td>
                    <td>
                      <span class="badge <%= p.prioridad.clase %>"><%= p.prioridad.label %></span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Tab: PROVEEDORES -->
    <div class="tab-pane fade" id="proveedores" role="tabpanel">
      <% if (proveedores.length === 0) { %>
        <div class="alert alert-info">No hay deudas con proveedores.</div>
      <% } else { %>
        <div class="card border-0 shadow-sm">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Proveedor</th>
                  <th>Concepto</th>
                  <th>Monto</th>
                  <th style="width: 120px;">Vencimiento</th>
                  <th style="width: 120px;">Prioridad</th>
                </tr>
              </thead>
              <tbody>
                <% proveedores.forEach(prov => { %>
                  <tr class="<%= (prov.dias_restantes !== null && prov.dias_restantes < 0) ? 'table-danger' : '' %>">
                    <td><strong><%= prov.titulo.split(' - ')[0] %></strong></td>
                    <td><small><%= prov.subtitulo %></small></td>
                    <td>$<%= (prov.monto || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td><%= prov.fecha_calculada ? prov.fecha_calculada.toLocaleDateString('es-AR') : '—' %></td>
                    <td>
                      <span class="badge <%= prov.prioridad.clase %>"><%= prov.prioridad.label %></span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="mt-4">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Volver al Inicio
    </a>
  </div>
</div>
