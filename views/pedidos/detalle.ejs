<!-- views/pedidos/detalle.ejs - SIMPLIFICADO -->
<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
    <% if (pedido.estado !== 'ENTREGADO' && pedido.estado !== 'CANCELADO') { %>
      <a href="/pedidos/editar/<%= pedido.id %>" class="btn btn-outline-warning">
        <i class="bi bi-pencil"></i> Editar Pedido
      </a>
    <% } %>
  </div>

  <!-- HEADER CON ESTADO -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Pedido #<%= pedido.id %></h1>
      <p class="text-muted mb-0">Creado: <%= new Date(pedido.fecha).toLocaleDateString('es-AR') %></p>
      <% if (pedido.fecha_entrega) { %>
        <p class="mb-0">
          <span class="badge bg-info text-dark fs-6">
            <i class="bi bi-calendar-check"></i>
            Entrega: <%= new Date(pedido.fecha_entrega + 'T12:00:00').toLocaleDateString('es-AR') %>
          </span>
        </p>
      <% } %>
    </div>
    <span class="badge bg-<%= pedido.estado === 'ENTREGADO' ? 'success' : pedido.estado === 'LISTO' ? 'info' : pedido.estado === 'EN_PRODUCCION' ? 'warning' : 'secondary' %> fs-5">
      <%= pedido.estado %>
    </span>
  </div>

  <!-- ALERTAS -->
  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle"></i>
      <%= Array.isArray(error) ? error.join('<br>') : error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle"></i>
      <%= Array.isArray(success) ? success.join('<br>') : success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- INFORMACIÓN DEL CLIENTE -->
  <div class="card mb-4 border-start border-primary border-5">
    <div class="card-body">
      <h6 class="text-muted mb-3">👤 CLIENTE</h6>
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><%= pedido.cliente_nombre %></h5>
        <button class="btn btn-sm btn-success" onclick="enviarWhatsApp(<%= pedido.id %>, '<%= pedido.cliente_nombre.replace(/'/g, "\\'") %>', <%= pedido.monto_restante %>, '<%= pedido.estado %>')">
          <i class="bi bi-whatsapp"></i> Contactar
        </button>
      </div>
    </div>
  </div>

  <!-- DETALLE DEL TRABAJO -->
  <div class="card mb-4 border-start border-secondary border-5">
    <div class="card-body">
      <h6 class="text-muted mb-3">📝 DETALLE DEL TRABAJO</h6>
      <p><%= pedido.detalle ? pedido.detalle.replace(/\n/g, '<br>') : '<em>No definido</em>' %></p>
    </div>
  </div>

  <!-- CAMBIO DE ESTADO -->
  <div class="card mb-4 border-start border-info border-5">
    <div class="card-body">
      <h6 class="text-muted mb-3">🔄 CAMBIAR ESTADO</h6>
      <form id="formCambiarEstado" action="/pedidos/<%= pedido.id %>/cambiar-estado" method="POST" class="d-flex gap-2 align-items-end">
        <div class="flex-grow-1">
          <select id="selectEstado" name="estado" class="form-select form-select-lg" required>
            <option value="">-- Seleccionar estado --</option>
            <option value="PENDIENTE" <% if (pedido.estado === 'PENDIENTE') { %>selected<% } %>>📋 PENDIENTE</option>
            <option value="EN_PRODUCCION" <% if (pedido.estado === 'EN_PRODUCCION') { %>selected<% } %>>⚙️ EN PRODUCCIÓN</option>
            <option value="LISTO" <% if (pedido.estado === 'LISTO') { %>selected<% } %>>✅ LISTO</option>
            <option value="ENTREGADO" <% if (pedido.estado === 'ENTREGADO') { %>selected<% } %>>🎉 ENTREGADO</option>
            <option value="CANCELADO" <% if (pedido.estado === 'CANCELADO') { %>selected<% } %>>❌ CANCELADO</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="bi bi-save"></i> Guardar
        </button>
      </form>
    </div>
  </div>

  <!-- PRODUCTOS -->
  <div class="card mb-4 border-start border-success border-5">
    <div class="card-header bg-light">
      <h6 class="mb-0">📦 PRODUCTOS</h6>
    </div>
    <div class="card-body">
      <% if (pedido.productos && pedido.productos.length) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Descripción</th>
                <th style="width: 100px;" class="text-center">Cantidad</th>
                <th style="width: 120px;" class="text-center">Medidas</th>
                <th style="width: 120px;" class="text-end">Precio</th>
              </tr>
            </thead>
            <tbody>
              <% pedido.productos.forEach(prod => { %>
                <tr>
                  <td>
                    <strong><%= prod.material %></strong><br>
                    <small class="text-muted"><%= prod.descripcion || '(sin descripción)' %></small>
                  </td>
                  <td class="text-center"><%= prod.cantidad || 1 %></td>
                  <td class="text-center">
                    <% if (prod.ancho || prod.alto) { %>
                      <%= prod.ancho %>m × <%= prod.alto %>m
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="text-end fw-bold">$<%= (prod.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted text-center py-3">No hay productos en este pedido</p>
      <% } %>
    </div>
  </div>

  <!-- FINANCIERO -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card bg-primary text-white position-relative">
        <div class="card-body">
          <p class="mb-2 opacity-75">💰 TOTAL</p>
          <h3 class="mb-0">$<%= (pedido.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h3>
        </div>
        <button class="btn btn-light btn-sm position-absolute top-2 end-2" title="Sugerir precio con IA" onclick="sugerirPrecio()">
          <i class="bi bi-robot"></i> Sugerir
        </button>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card <% if (pedido.monto_restante > 0) { %>bg-danger<% } else { %>bg-success<% } %> text-white">
        <div class="card-body">
          <p class="mb-2 opacity-75">
            <% if (pedido.monto_restante > 0) { %>
              🔴 DEUDA
            <% } else { %>
              ✅ PAGADO
            <% } %>
          </p>
          <h3 class="mb-0">$<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTONES DE ACCIÓN -->
  <div class="row g-2 mb-4">
    <div class="col-md-4">
      <a href="/pedidos/<%= pedido.id %>/comprobante" class="btn btn-info btn-lg w-100" target="_blank">
        <i class="bi bi-printer"></i> 🖨️ Imprimir Comprobante
      </a>
    </div>
    <!-- BOTÓN PRINCIPAL: Cobrar Pedido (cuando está LISTO) -->
    <% if (pedido.estado === 'LISTO' && pedido.monto_restante > 0) { %>
      <div class="col-md-4">
        <button class="btn btn-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalCobrarPedido" style="font-weight: bold; box-shadow: 0 4px 8px rgba(25, 135, 84, 0.3);">
          <i class="bi bi-cash-coin"></i> 💰 Cobrar Pedido
        </button>
      </div>
    <% } else if (pedido.monto_restante > 0 && pedido.estado !== 'ENTREGADO') { %>
      <!-- Botón alternativo para otros estados con deuda -->
      <div class="col-md-4">
        <button class="btn btn-outline-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalCancelarDeuda">
          <i class="bi bi-cash-coin"></i> Cobrar Deuda
        </button>
      </div>
    <% } %>
    <% if (pedido.estado === 'ENTREGADO' && pedido.monto_restante > 0) { %>
      <div class="col-md-4">
        <button class="btn btn-primary btn-lg w-100" onclick="enviarWhatsApp(<%= pedido.id %>, '<%= pedido.cliente_nombre.replace(/'/g, "\\'") %>', <%= pedido.monto_restante %>)">
          <i class="bi bi-chat-dots"></i> WhatsApp
        </button>
      </div>
    <% } %>
    <% if (pedido.estado !== 'CANCELADO' && pedido.estado !== 'ENTREGADO') { %>
      <div class="col-md-4">
        <button class="btn btn-danger btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalCancelarPedido">
          <i class="bi bi-x-circle"></i> Cancelar Pedido
        </button>
      </div>
    <% } %>
  </div>

  <!-- IMÁGENES DE PRODUCTOS -->
  <% if (pedido.productos && pedido.productos.some(p => p.imagenes && p.imagenes.length)) { %>
    <div class="card mb-4 border-start border-warning border-5">
      <div class="card-header bg-light">
        <h6 class="mb-0">🖼️ IMÁGENES</h6>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <% pedido.productos.forEach(prod => { %>
            <% if (prod.imagenes && prod.imagenes.length) { %>
              <% prod.imagenes.forEach(img => { %>
                <% const ext = img.split('.').pop().toLowerCase(); %>
                <div class="col-md-3">
                  <% if (['jpg','jpeg','png','gif'].includes(ext)) { %>
                    <a href="/uploads/<%= encodeURIComponent(img) %>" target="_blank">
                      <img src="/uploads/<%= encodeURIComponent(img) %>" class="img-fluid rounded border" style="max-height: 150px; width: 100%; object-fit: cover;">
                    </a>
                  <% } else { %>
                    <a href="/uploads/<%= encodeURIComponent(img) %>" target="_blank" class="btn btn-outline-secondary w-100">
                      📄 <%= img %>
                    </a>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>
</main>

<!-- MODAL: Cobrar Pedido (para LISTO) -->
<div class="modal fade" id="modalCobrarPedido" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-success border-3">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-cash-coin"></i> 💰 Cobrar Pedido</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/pedidos/<%= pedido.id %>/cancelar-deuda">
        <div class="modal-body">
          <div class="alert alert-success mb-3">
            <strong>✅ Pedido LISTO para retirar</strong><br>
            <small>Monto pendiente: $<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Monto a cobrar *</label>
            <input type="number" name="monto_a_pagar" class="form-control form-control-lg"
                   step="0.01" min="0.01" max="<%= pedido.monto_restante || 0 %>"
                   value="<%= pedido.monto_restante || 0 %>" required
                   onchange="actualizarSaldoRestantePedido()">
            <small class="text-muted mt-1 d-block">Puedes cobrar el total o una cantidad parcial</small>
          </div>

          <div class="mb-3">
            <div class="row">
              <div class="col-6">
                <label class="form-label text-muted">Monto Total</label>
                <p class="fw-bold fs-5">$<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
              </div>
              <div class="col-6">
                <label class="form-label text-muted">Te quedarán</label>
                <p class="fw-bold fs-5" id="saldoRestantePedido">$0.00</p>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Método de Pago *</label>
            <select name="metodo_pago" class="form-select form-select-lg" required>
              <option value="">-- Seleccionar --</option>
              <option value="Efectivo" selected>💵 Efectivo</option>
              <option value="Transferencia">🏦 Transferencia</option>
              <option value="Tarjeta">💳 Tarjeta</option>
              <option value="QR">📱 QR</option>
            </select>
          </div>

          <div class="alert alert-info mt-4">
            <small><strong>📌 Después de cobrar:</strong> Podrás marcar el pedido como ENTREGADO en la sección "Cambiar Estado"</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success btn-lg">
            <i class="bi bi-check-circle"></i> Cobrar & Registrar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: Cancelar Deuda (fallback para otros estados) -->
<div class="modal fade" id="modalCancelarDeuda" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-cash-coin"></i> Cobrar Deuda</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/pedidos/<%= pedido.id %>/cancelar-deuda">
        <div class="modal-body">
          <div class="alert alert-info mb-3">
            <strong>Deuda a cobrar:</strong> $<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Monto a pagar *</label>
            <input type="number" name="monto_a_pagar" class="form-control form-control-lg"
                   step="0.01" min="0.01" max="<%= pedido.monto_restante || 0 %>"
                   value="<%= pedido.monto_restante || 0 %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">Método de Pago *</label>
            <select name="metodo_pago" class="form-select form-select-lg" required>
              <option value="">-- Seleccionar --</option>
              <option value="Efectivo">💵 Efectivo</option>
              <option value="Transferencia">🏦 Transferencia</option>
              <option value="Tarjeta">💳 Tarjeta</option>
              <option value="QR">📱 QR</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success btn-lg">
            <i class="bi bi-check"></i> Cobrar & Registrar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: Cancelar Pedido -->
<div class="modal fade" id="modalCancelarPedido" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-x-circle"></i> Cancelar Pedido</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3">
          <strong>⚠️ Advertencia:</strong> Esta acción no se puede deshacer.
        </div>
        <% if (pedido.monto_entregado > 0) { %>
          <div class="alert alert-info">
            Será registrada una devolución de: <strong>$<%= (pedido.monto_entregado || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
          </div>
        <% } %>
        <p>¿Confirmas que quieres cancelar este pedido?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No, volver</button>
        <form method="POST" action="/pedidos/<%= pedido.id %>/cancelar-pedido" class="d-inline">
          <button type="submit" class="btn btn-danger btn-lg">
            <i class="bi bi-check"></i> Sí, Cancelar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Sugerir Precio -->
<div class="modal fade" id="modalSugerirPrecio" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-robot"></i> Sugerencia de Precio con IA</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="sugerenciaCargando" class="text-center py-4">
          <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="mt-2 text-muted">Analizando precios históricos...</p>
        </div>
        <div id="sugerenciaResultado" style="display: none;">
          <div class="alert alert-info mb-3">
            <p class="mb-2"><strong>Precio Sugerido:</strong></p>
            <h4 class="mb-0" id="precioSugeridoText"></h4>
          </div>
          <div id="justificacionArea" style="display: none;">
            <hr>
            <p class="mb-2"><strong>Análisis:</strong></p>
            <p id="justificacionText" class="text-muted"></p>
          </div>
          <div id="historialArea" style="display: none;">
            <hr>
            <p class="mb-2"><strong>Historial de Precios Similares:</strong></p>
            <div id="historialList"></div>
          </div>
        </div>
        <div id="sugerenciaError" style="display: none;" class="alert alert-danger mb-0"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-success" id="btnAplicarPrecio" style="display: none;" onclick="aplicarPrecioSugerido()">
          <i class="bi bi-check-circle"></i> Aplicar Precio
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Confirmar Cambio de Estado -->
<div class="modal fade" id="modalConfirmarEstado" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title"><i class="bi bi-arrow-repeat"></i> Confirmar Cambio de Estado</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info mb-3">
          <p class="mb-0"><strong>Nuevo estado:</strong> <span id="nuevoEstadoText"></span></p>
        </div>

        <% if (pedido.monto_restante > 0) { %>
          <div class="alert alert-warning mb-3">
            <strong>⚠️ Deuda Pendiente:</strong> $<span id="montoDeuda"><%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold">¿Deseas cobrar esta deuda antes de cambiar el estado?</label>
            <div class="btn-group w-100" role="group">
              <input type="radio" class="btn-check" name="opcCobro" id="cobrarAhora" value="cobrar">
              <label class="btn btn-outline-success" for="cobrarAhora">
                <i class="bi bi-cash-coin"></i> Cobrar Ahora
              </label>

              <input type="radio" class="btn-check" name="opcCobro" id="sinCobrar" value="sin-cobrar" checked>
              <label class="btn btn-outline-secondary" for="sinCobrar">
                <i class="bi bi-skip"></i> Sin Cobrar
              </label>
            </div>
          </div>

          <!-- Campos para cobrar (ocultos inicialmente) -->
          <div id="seccionCobro" style="display: none;">
            <hr class="my-3">
            <div class="mb-3">
              <label class="form-label fw-bold">Monto a pagar *</label>
              <input type="number" id="montoPagar" class="form-control form-control-lg"
                     step="0.01" min="0.01" max="<%= pedido.monto_restante || 0 %>"
                     value="<%= pedido.monto_restante || 0 %>">
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold">Método de Pago *</label>
              <select id="metodoPago" class="form-select form-select-lg">
                <option value="">-- Seleccionar --</option>
                <option value="Efectivo">💵 Efectivo</option>
                <option value="Transferencia">🏦 Transferencia</option>
                <option value="Tarjeta">💳 Tarjeta</option>
                <option value="QR">📱 QR</option>
              </select>
            </div>
          </div>
        <% } %>

        <p class="text-muted mb-0"><small>El pedido pasará a estado <strong id="nuevoEstadoTextSmall"></strong> después de guardar.</small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary btn-lg" onclick="confirmarCambioEstado()">
          <i class="bi bi-check"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let estadoAntiguoSelect = '<%= pedido.estado %>';
  let nuevoEstadoSeleccionado = '';
  let precioSugridoActual = null;
  let modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmarEstado'));
  let modalSugerir = new bootstrap.Modal(document.getElementById('modalSugerirPrecio'));

  async function sugerirPrecio() {
    // Limpiar modal
    document.getElementById('sugerenciaCargando').style.display = 'block';
    document.getElementById('sugerenciaResultado').style.display = 'none';
    document.getElementById('sugerenciaError').style.display = 'none';
    document.getElementById('btnAplicarPrecio').style.display = 'none';

    modalSugerir.show();

    try {
      const response = await fetch('/api/ia/sugerir-precio', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ pedido_id: <%= pedido.id %> })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Error desconocido');
      }

      const data = await response.json();

      if (data.ok) {
        precioSugridoActual = data.precioSugerido;

        // Mostrar precio sugerido
        document.getElementById('precioSugeridoText').textContent =
          '$' + data.precioSugerido.toLocaleString('es-AR', { minimumFractionDigits: 2 });

        // Mostrar justificación si existe
        if (data.respuesta) {
          document.getElementById('justificacionText').textContent = data.respuesta;
          document.getElementById('justificacionArea').style.display = 'block';
        }

        // Mostrar historial de precios
        if (data.historialPrecios && data.historialPrecios.length > 0) {
          const html = data.historialPrecios.map(h => `
            <div class="card mb-2">
              <div class="card-body py-2 px-3">
                <strong>${h.material}</strong><br>
                <small class="text-muted">Cantidad: ${h.cantidad}, Medidas: ${h.medidas}</small><br>
                <small>Precio actual: $${h.precioActual}, Promedio histórico: $${h.precioPromedio}</small>
              </div>
            </div>
          `).join('');
          document.getElementById('historialList').innerHTML = html;
          document.getElementById('historialArea').style.display = 'block';
        }

        document.getElementById('btnAplicarPrecio').style.display = 'inline-block';
        document.getElementById('sugerenciaCargando').style.display = 'none';
        document.getElementById('sugerenciaResultado').style.display = 'block';
      } else {
        throw new Error(data.error || 'Error en la respuesta');
      }
    } catch (error) {
      console.error('Error:', error);
      document.getElementById('sugerenciaError').textContent = error.message || 'Error al sugerir precio';
      document.getElementById('sugerenciaError').style.display = 'block';
      document.getElementById('sugerenciaCargando').style.display = 'none';
    }
  }

  function aplicarPrecioSugerido() {
    if (!precioSugridoActual) return;
    if (confirm(`¿Aplicar precio sugerido de $${precioSugridoActual}?`)) {
      modalSugerir.hide();
      // Nota: Para aplicar el precio, necesitarías tener un endpoint para editarlo
      // o incluir un formulario oculto que se envíe aquí
      alert('Funcionalidad de actualizar precio a implementar. Precio sugerido: $' + precioSugridoActual);
    }
  }


  // Interceptar submit del formulario
  document.getElementById('formCambiarEstado').addEventListener('submit', function(e) {
    e.preventDefault();

    const selectEstado = document.getElementById('selectEstado');
    nuevoEstadoSeleccionado = selectEstado.value;

    if (!nuevoEstadoSeleccionado || nuevoEstadoSeleccionado === estadoAntiguoSelect) {
      return; // Si no cambió o está vacío, no hacer nada
    }

    // Mostrar el nuevo estado en el modal
    const estadoLabels = {
      'PENDIENTE': '📋 PENDIENTE',
      'EN_PRODUCCION': '⚙️ EN PRODUCCIÓN',
      'LISTO': '✅ LISTO',
      'ENTREGADO': '🎉 ENTREGADO',
      'CANCELADO': '❌ CANCELADO'
    };

    document.getElementById('nuevoEstadoText').textContent = estadoLabels[nuevoEstadoSeleccionado] || nuevoEstadoSeleccionado;
    document.getElementById('nuevoEstadoTextSmall').textContent = estadoLabels[nuevoEstadoSeleccionado] || nuevoEstadoSeleccionado;

    <% if (pedido.monto_restante > 0) { %>
      // Mostrar modal con opciones de cobro si hay deuda
      document.getElementById('cobrarAhora').addEventListener('change', function() {
        document.getElementById('seccionCobro').style.display = 'block';
      });
      document.getElementById('sinCobrar').addEventListener('change', function() {
        document.getElementById('seccionCobro').style.display = 'none';
      });
    <% } %>

    modalConfirmar.show();
  });

  function confirmarCambioEstado() {
    const form = document.getElementById('formCambiarEstado');

    <% if (pedido.monto_restante > 0) { %>
      const opcCobro = document.querySelector('input[name="opcCobro"]:checked')?.value;

      if (opcCobro === 'cobrar') {
        const monto = parseFloat(document.getElementById('montoPagar').value);
        const metodo = document.getElementById('metodoPago').value;

        if (!monto || monto <= 0) {
          alert('Ingresa un monto válido');
          return;
        }
        if (!metodo) {
          alert('Selecciona un método de pago');
          return;
        }

        // Cobrar deuda primero
        fetch('/pedidos/<%= pedido.id %>/cancelar-deuda', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            monto_a_pagar: monto,
            metodo_pago: metodo
          })
        })
        .then(r => {
          if (r.ok) {
            // Cambiar estado después de cobrar
            form.submit();
          } else {
            alert('Error al cobrar la deuda');
          }
        })
        .catch(err => {
          console.error('Error:', err);
          alert('Error al procesar el pago');
        });

        return;
      }
    <% } %>

    // Cambiar estado sin cobrar
    form.submit();
  }

  // Actualizar saldo restante en modalCobrarPedido (tiempo real)
  function actualizarSaldoRestantePedido() {
    const inputMonto = document.querySelector('#modalCobrarPedido input[name="monto_a_pagar"]');
    if (!inputMonto) return;

    const montoIngresado = parseFloat(inputMonto.value) || 0;
    const montoTotal = <%= pedido.monto_restante || 0 %>;
    const saldoRestante = Math.max(0, montoTotal - montoIngresado);

    const saldoEl = document.getElementById('saldoRestantePedido');
    if (saldoEl) {
      saldoEl.textContent = '$' + saldoRestante.toLocaleString('es-AR', {minimumFractionDigits: 2});

      // Cambiar color si se paga todo
      if (saldoRestante <= 0.01) {
        saldoEl.classList.remove('text-muted');
        saldoEl.classList.add('text-success');
      } else {
        saldoEl.classList.remove('text-success');
        saldoEl.classList.add('text-muted');
      }
    }
  }

  // Inicializar el saldo cuando se abre el modal
  const modalCobrarPedido = document.getElementById('modalCobrarPedido');
  if (modalCobrarPedido) {
    modalCobrarPedido.addEventListener('show.bs.modal', function() {
      actualizarSaldoRestantePedido();
    });
  }

  // Enviar mensaje Por WhatsApp (dinámico según estado)
  function enviarWhatsApp(pedidoId, cliente, deuda, estado) {
    fetch(`/api/pedidos/${pedidoId}/cliente-phone`)
      .then(r => r.json())
      .then(data => {
        if (data.phone) {
          const tel = data.phone.replace(/\D/g, '');
          let mensaje = `Hola ${cliente},\n\n`;

          // Personalizar mensaje según estado del pedido
          if (estado === 'LISTO') {
            mensaje += `✅ Tu pedido #${pedidoId} está listo para retirar.\n\n`;
          } else if (estado === 'EN_PRODUCCION') {
            mensaje += `⚙️ Tu pedido #${pedidoId} está en producción.\n\n`;
          } else if (estado === 'ENTREGADO') {
            mensaje += `🎉 Tu pedido #${pedidoId} fue entregado.\n\n`;
          } else {
            mensaje += `📋 Sobre tu pedido #${pedidoId}:\n\n`;
          }

          // Agregar monto si hay deuda
          if (deuda && deuda > 0) {
            mensaje += `💰 Deuda pendiente: $${Math.round(deuda)}\n\n`;
          }

          mensaje += `Imprenta El Gráfico | 3878 22-4908`;

          const msg = encodeURIComponent(mensaje);
          window.open(`https://wa.me/549${tel}?text=${msg}`, '_blank');
        } else {
          alert('⚠️ No hay número de teléfono disponible para este cliente');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('❌ Error al obtener el teléfono');
      });
  }
</script>
