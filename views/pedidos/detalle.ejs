<!-- views/pedidos/detalle.ejs - SIMPLIFICADO -->
<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
    <% if (pedido.estado !== 'ENTREGADO' && pedido.estado !== 'CANCELADO') { %>
      <a href="/pedidos/editar/<%= pedido.id %>" class="btn btn-outline-warning">
        <i class="bi bi-pencil"></i> Editar Pedido
      </a>
    <% } %>
  </div>

  <!-- HEADER CON ESTADO -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Pedido #<%= pedido.id %></h1>
      <p class="text-muted mb-0">Creado: <%= new Date(pedido.fecha).toLocaleDateString('es-AR') %></p>
      <% if (pedido.fecha_entrega) { %>
        <p class="mb-0">
          <span class="badge bg-info text-dark fs-6">
            <i class="bi bi-calendar-check"></i>
            Entrega: <%= new Date(pedido.fecha_entrega + 'T12:00:00').toLocaleDateString('es-AR') %>
          </span>
        </p>
      <% } %>
    </div>
    <span class="badge bg-<%= pedido.estado === 'ENTREGADO' ? 'success' : pedido.estado === 'LISTO' ? 'info' : pedido.estado === 'EN_PRODUCCION' ? 'warning' : 'secondary' %> fs-5">
      <%= pedido.estado %>
    </span>
  </div>

  <!-- ALERTAS -->
  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle"></i>
      <%= Array.isArray(error) ? error.join('<br>') : error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle"></i>
      <%= Array.isArray(success) ? success.join('<br>') : success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- INFORMACIÓN DEL CLIENTE -->
  <div class="card mb-4 border-start border-primary border-5">
    <div class="card-body">
      <h6 class="text-muted mb-3">👤 CLIENTE</h6>
      <h5><%= pedido.cliente_nombre %></h5>
    </div>
  </div>

  <!-- CAMBIO DE ESTADO -->
  <div class="card mb-4 border-start border-info border-5">
    <div class="card-body">
      <h6 class="text-muted mb-3">🔄 CAMBIAR ESTADO</h6>
      <form action="/pedidos/<%= pedido.id %>/cambiar-estado" method="POST" class="d-flex gap-2 align-items-end">
        <div class="flex-grow-1">
          <select name="estado" class="form-select form-select-lg" required>
            <option value="">-- Seleccionar estado --</option>
            <option value="PENDIENTE" <% if (pedido.estado === 'PENDIENTE') { %>selected<% } %>>📋 PENDIENTE</option>
            <option value="EN_PRODUCCION" <% if (pedido.estado === 'EN_PRODUCCION') { %>selected<% } %>>⚙️ EN PRODUCCIÓN</option>
            <option value="LISTO" <% if (pedido.estado === 'LISTO') { %>selected<% } %>>✅ LISTO</option>
            <option value="ENTREGADO" <% if (pedido.estado === 'ENTREGADO') { %>selected<% } %>>🎉 ENTREGADO</option>
            <option value="CANCELADO" <% if (pedido.estado === 'CANCELADO') { %>selected<% } %>>❌ CANCELADO</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="bi bi-save"></i> Guardar
        </button>
      </form>
    </div>
  </div>

  <!-- PRODUCTOS -->
  <div class="card mb-4 border-start border-success border-5">
    <div class="card-header bg-light">
      <h6 class="mb-0">📦 PRODUCTOS</h6>
    </div>
    <div class="card-body">
      <% if (pedido.productos && pedido.productos.length) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Descripción</th>
                <th style="width: 100px;" class="text-center">Cantidad</th>
                <th style="width: 120px;" class="text-center">Medidas</th>
                <th style="width: 120px;" class="text-end">Precio</th>
              </tr>
            </thead>
            <tbody>
              <% pedido.productos.forEach(prod => { %>
                <tr>
                  <td>
                    <strong><%= prod.material %></strong><br>
                    <small class="text-muted"><%= prod.descripcion || '(sin descripción)' %></small>
                  </td>
                  <td class="text-center"><%= prod.cantidad || 1 %></td>
                  <td class="text-center">
                    <% if (prod.ancho || prod.alto) { %>
                      <%= prod.ancho %>m × <%= prod.alto %>m
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="text-end fw-bold">$<%= (prod.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted text-center py-3">No hay productos en este pedido</p>
      <% } %>
    </div>
  </div>

  <!-- FINANCIERO -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card bg-primary text-white">
        <div class="card-body">
          <p class="mb-2 opacity-75">💰 TOTAL</p>
          <h3 class="mb-0">$<%= (pedido.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card <% if (pedido.monto_restante > 0) { %>bg-danger<% } else { %>bg-success<% } %> text-white">
        <div class="card-body">
          <p class="mb-2 opacity-75">
            <% if (pedido.monto_restante > 0) { %>
              🔴 DEUDA
            <% } else { %>
              ✅ PAGADO
            <% } %>
          </p>
          <h3 class="mb-0">$<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTONES DE ACCIÓN -->
  <div class="row g-2 mb-4">
    <div class="col-md-4">
      <a href="/pedidos/<%= pedido.id %>/comprobante" class="btn btn-info btn-lg w-100" target="_blank">
        <i class="bi bi-printer"></i> 🖨️ Imprimir Comprobante
      </a>
    </div>
    <% if (pedido.monto_restante > 0) { %>
      <div class="col-md-4">
        <button class="btn btn-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalCancelarDeuda">
          <i class="bi bi-cash-coin"></i> Cobrar Deuda
        </button>
      </div>
    <% } %>
    <% if (pedido.estado === 'ENTREGADO' && pedido.monto_restante > 0) { %>
      <div class="col-md-4">
        <button class="btn btn-primary btn-lg w-100" onclick="enviarWhatsApp(<%= pedido.id %>, '<%= pedido.cliente_nombre.replace(/'/g, "\\'") %>', <%= pedido.monto_restante %>)">
          <i class="bi bi-chat-dots"></i> WhatsApp
        </button>
      </div>
    <% } %>
    <% if (pedido.estado !== 'CANCELADO' && pedido.estado !== 'ENTREGADO') { %>
      <div class="col-md-4">
        <button class="btn btn-danger btn-lg w-100" data-bs-toggle="modal" data-bs-target="#modalCancelarPedido">
          <i class="bi bi-x-circle"></i> Cancelar Pedido
        </button>
      </div>
    <% } %>
  </div>

  <!-- IMÁGENES DE PRODUCTOS -->
  <% if (pedido.productos && pedido.productos.some(p => p.imagenes && p.imagenes.length)) { %>
    <div class="card mb-4 border-start border-warning border-5">
      <div class="card-header bg-light">
        <h6 class="mb-0">🖼️ IMÁGENES</h6>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <% pedido.productos.forEach(prod => { %>
            <% if (prod.imagenes && prod.imagenes.length) { %>
              <% prod.imagenes.forEach(img => { %>
                <% const ext = img.split('.').pop().toLowerCase(); %>
                <div class="col-md-3">
                  <% if (['jpg','jpeg','png','gif'].includes(ext)) { %>
                    <a href="/uploads/<%= encodeURIComponent(img) %>" target="_blank">
                      <img src="/uploads/<%= encodeURIComponent(img) %>" class="img-fluid rounded border" style="max-height: 150px; width: 100%; object-fit: cover;">
                    </a>
                  <% } else { %>
                    <a href="/uploads/<%= encodeURIComponent(img) %>" target="_blank" class="btn btn-outline-secondary w-100">
                      📄 <%= img %>
                    </a>
                  <% } %>
                </div>
              <% }); %>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>
</main>

<!-- MODAL: Cancelar Deuda -->
<div class="modal fade" id="modalCancelarDeuda" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="bi bi-cash-coin"></i> Cobrar Deuda</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/pedidos/<%= pedido.id %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">/cancelar-deuda">
        <div class="modal-body">
          <div class="alert alert-info mb-3">
            <strong>Deuda a cobrar:</strong> $<%= (pedido.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-bold">Monto a pagar *</label>
            <input type="number" name="monto_a_pagar" class="form-control form-control-lg" 
                   step="0.01" min="0.01" max="<%= pedido.monto_restante || 0 %>"
                   value="<%= pedido.monto_restante || 0 %>" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label fw-bold">Método de Pago *</label>
            <select name="metodo_pago" class="form-select form-select-lg" required>
              <option value="">-- Seleccionar --</option>
              <option value="Efectivo">💵 Efectivo</option>
              <option value="Transferencia">🏦 Transferencia</option>
              <option value="Tarjeta">💳 Tarjeta</option>
              <option value="QR">📱 QR</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success btn-lg">
            <i class="bi bi-check"></i> Cobrar & Registrar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL: Cancelar Pedido -->
<div class="modal fade" id="modalCancelarPedido" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="bi bi-x-circle"></i> Cancelar Pedido</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3">
          <strong>⚠️ Advertencia:</strong> Esta acción no se puede deshacer.
        </div>
        <% if (pedido.monto_entregado > 0) { %>
          <div class="alert alert-info">
            Será registrada una devolución de: <strong>$<%= (pedido.monto_entregado || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
          </div>
        <% } %>
        <p>¿Confirmas que quieres cancelar este pedido?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No, volver</button>
        <form method="POST" action="/pedidos/<%= pedido.id %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">/cancelar-pedido" class="d-inline">
          <button type="submit" class="btn btn-danger btn-lg">
            <i class="bi bi-check"></i> Sí, Cancelar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function enviarWhatsApp(pedidoId, cliente, deuda) {
    fetch(`/api/pedidos/${pedidoId}/cliente-phone`)
      .then(r => r.json())
      .then(data => {
        if (data.phone) {
          const tel = data.phone.replace(/\D/g, '');
          const precio = deuda ? '$' + Math.round(deuda) : 'a definir';
          const msg = encodeURIComponent(
            `Hola ${cliente},\n\n` +
            `✅ Tu pedido #${pedidoId} está listo para retirar.\n\n` +
            `💰 Deuda pendiente: ${precio}\n\n` +
            `¿Te va bien? ¡Gracias!`
          );
          window.open(`https://wa.me/549${tel}?text=${msg}`, '_blank');
        } else {
          alert('No hay número de teléfono disponible');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Error al obtener el teléfono');
      });
  }
</script>
