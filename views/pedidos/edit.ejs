<div class="container py-4">
  <div class="mb-3">
    <a href="/pedidos/detalle/<%= pedido.id %>" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Volver al detalle
    </a>
  </div>
  <h1 class="mb-1">Editar Pedido #<%= pedido.id %></h1>
  <p class="text-muted mb-4">Cliente actual: <strong><%= pedido.cliente_nombre %></strong></p>

  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= Array.isArray(error) ? error.join('<br>') : error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= Array.isArray(success) ? success.join('<br>') : success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <form action="/pedidos/editar/<%= pedido.id %>" method="POST" enctype="multipart/form-data">

    <% items.forEach(item => { %>
      <input type="hidden" name="item_id[]" value="<%= item.id %>">
    <% }) %>

    <!-- ═══ DATOS DEL PEDIDO ═══════════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h6 class="mb-0"><i class="bi bi-info-circle"></i> Datos del Pedido</h6>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Cliente</label>
            <select name="client_id" class="form-select" required>
              <% clients.forEach(c => { %>
                <option value="<%= c.id %>" <%= c.id === pedido.client_id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Monto Adelantado ($)</label>
            <input type="number" name="monto_entregado" step="0.01" class="form-control"
                   value="<%= pedido.monto_entregado || 0 %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Método de Pago</label>
            <select name="medio_pago" class="form-select">
              <option value="Efectivo"      <%= pedido.medio_pago === 'Efectivo'      ? 'selected' : '' %>>💵 Efectivo</option>
              <option value="Transferencia" <%= pedido.medio_pago === 'Transferencia' ? 'selected' : '' %>>🏦 Transferencia</option>
              <option value="Tarjeta"       <%= pedido.medio_pago === 'Tarjeta'       ? 'selected' : '' %>>💳 Tarjeta</option>
              <option value="QR"            <%= pedido.medio_pago === 'QR'            ? 'selected' : '' %>>📱 QR</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">📅 Fecha de Entrega</label>
            <input type="date" name="fecha_entrega" class="form-control"
                   value="<%= pedido.fecha_entrega ? pedido.fecha_entrega.slice(0,10) : '' %>">
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ PRODUCTOS ═══════════════════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-success text-white">
        <h6 class="mb-0"><i class="bi bi-box"></i> Productos del Pedido</h6>
      </div>
      <div class="card-body">
        <% if (items.length === 0) { %>
          <p class="text-muted text-center py-3">No hay productos en este pedido</p>
        <% } %>
        <% items.forEach(item => { %>
          <div class="card mb-3 border border-secondary-subtle">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <h6 class="mb-0 text-muted">#<%= item.id %> — <strong><%= item.material %></strong></h6>
                <button type="submit"
                        formaction="/pedidos/editar/<%= pedido.id %>/eliminar/<%= item.id %>"
                        formmethod="POST"
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('¿Eliminar este producto?')">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </div>
              <div class="row g-3">
                <div class="col-md-2">
                  <label class="form-label">Ancho (m)</label>
                  <input type="number" step="0.01" name="ancho_<%= item.id %>" class="form-control"
                         value="<%= item.ancho || '' %>">
                </div>
                <div class="col-md-2">
                  <label class="form-label">Alto (m)</label>
                  <input type="number" step="0.01" name="alto_<%= item.id %>" class="form-control"
                         value="<%= item.alto || '' %>">
                </div>
                <div class="col-md-2">
                  <label class="form-label fw-bold">Precio ($)</label>
                  <input type="number" step="0.01" name="precio_<%= item.id %>" class="form-control fw-bold"
                         value="<%= item.precio || 0 %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Descripción</label>
                  <textarea name="descripcion_<%= item.id %>" class="form-control" rows="2"><%= item.descripcion || '' %></textarea>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ═══ BOTONES ═══════════════════════════════════════════════════ -->
    <div class="d-flex gap-3">
      <a href="/pedidos/detalle/<%= pedido.id %>" class="btn btn-secondary btn-lg">
        <i class="bi bi-x"></i> Cancelar
      </a>
      <button type="submit" class="btn btn-primary btn-lg px-5">
        <i class="bi bi-save"></i> Guardar Cambios
      </button>
    </div>
  </form>
</div>
