<div class="container py-4">
  <div class="mb-3">
    <a href="/pedidos/detalle/<%= pedido.id %>" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Volver al detalle
    </a>
  </div>
  <h1 class="mb-1">Editar Pedido #<%= pedido.id %></h1>
  <p class="text-muted mb-4">Cliente actual: <strong><%= pedido.cliente_nombre %></strong></p>

  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= Array.isArray(error) ? error.join('<br>') : error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= Array.isArray(success) ? success.join('<br>') : success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <form action="/pedidos/editar/<%= pedido.id %>" method="POST" enctype="multipart/form-data">

    <% items.forEach(item => { %>
      <input type="hidden" name="item_id[]" value="<%= item.id %>">
    <% }) %>

    <!-- ═══ DATOS DEL PEDIDO ═══════════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h6 class="mb-0"><i class="bi bi-info-circle"></i> Datos del Pedido</h6>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Cliente</label>
            <select name="client_id" class="form-select" required>
              <% clients.forEach(c => { %>
                <option value="<%= c.id %>" <%= c.id === pedido.client_id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Monto Adelantado ($)</label>
            <input type="number" name="monto_entregado" step="0.01" class="form-control"
                   value="<%= pedido.monto_entregado || 0 %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Método de Pago</label>
            <select name="medio_pago" class="form-select">
              <option value="Efectivo"      <%= pedido.medio_pago === 'Efectivo'      ? 'selected' : '' %>>💵 Efectivo</option>
              <option value="Transferencia" <%= pedido.medio_pago === 'Transferencia' ? 'selected' : '' %>>🏦 Transferencia</option>
              <option value="Tarjeta"       <%= pedido.medio_pago === 'Tarjeta'       ? 'selected' : '' %>>💳 Tarjeta</option>
              <option value="QR"            <%= pedido.medio_pago === 'QR'            ? 'selected' : '' %>>📱 QR</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold">📅 Fecha de Entrega</label>
            <input type="date" name="fecha_entrega" class="form-control"
                   value="<%= pedido.fecha_entrega ? pedido.fecha_entrega.slice(0,10) : '' %>">
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ PRODUCTOS EXISTENTES ══════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-success text-white">
        <h6 class="mb-0"><i class="bi bi-box"></i> Productos del Pedido</h6>
      </div>
      <div class="card-body">
        <% if (items.length === 0) { %>
          <p class="text-muted text-center py-3">No hay productos en este pedido</p>
        <% } %>
        <% items.forEach(item => {
          const cant = item.cantidad || 1;
          const ancho = item.ancho || 0;
          const alto = item.alto || 0;
          const area = (ancho > 0 && alto > 0) ? ancho * alto : 1;
          const pu = parseFloat((item.precio / (cant * area)).toFixed(4));
        %>
          <div class="card mb-3 border border-secondary-subtle">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <h6 class="mb-0 text-muted">#<%= item.id %> — <strong><%= item.material %></strong></h6>
                <button type="submit"
                        formaction="/pedidos/editar/<%= pedido.id %>/eliminar/<%= item.id %>"
                        formmethod="POST"
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('¿Eliminar este producto?')">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </div>
              <div class="row g-3 align-items-end">
                <div class="col-6 col-md-2">
                  <label class="form-label fw-bold">P.U. ($)</label>
                  <input type="number" step="0.01" id="pu_<%= item.id %>" class="form-control"
                         value="<%= pu %>"
                         onchange="calcularExistente(<%= item.id %>)">
                  <small class="text-muted">Precio por unidad/m²</small>
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label">Cantidad</label>
                  <input type="number" step="1" name="cantidad_<%= item.id %>" id="cant_<%= item.id %>" class="form-control"
                         value="<%= cant %>" min="1"
                         onchange="calcularExistente(<%= item.id %>)">
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label">Ancho (m)</label>
                  <input type="number" step="0.01" name="ancho_<%= item.id %>" id="ancho_<%= item.id %>" class="form-control"
                         value="<%= ancho || '' %>" placeholder="0.00"
                         onchange="calcularExistente(<%= item.id %>)">
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label">Alto (m)</label>
                  <input type="number" step="0.01" name="alto_<%= item.id %>" id="alto_<%= item.id %>" class="form-control"
                         value="<%= alto || '' %>" placeholder="0.00"
                         onchange="calcularExistente(<%= item.id %>)">
                </div>
                <div class="col-md-2">
                  <label class="form-label fw-bold text-success">Total ($)</label>
                  <input type="number" step="0.01" name="precio_<%= item.id %>" id="precio_<%= item.id %>" class="form-control fw-bold text-success"
                         value="<%= item.precio || 0 %>" required>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-muted" style="font-size:0.8rem;">Área / Cálculo</label>
                  <div id="formula_<%= item.id %>" class="form-control-plaintext text-muted small" style="font-size:0.8rem;"></div>
                </div>
              </div>
              <div class="row g-3 mt-1">
                <div class="col-12">
                  <label class="form-label">Descripción</label>
                  <textarea name="descripcion_<%= item.id %>" class="form-control" rows="2"><%= item.descripcion || '' %></textarea>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ═══ AGREGAR NUEVOS PRODUCTOS ════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-plus-circle"></i> Agregar Nuevos Productos</h6>
        <button type="button" class="btn btn-sm btn-warning" onclick="agregarNuevoProducto()">
          <i class="bi bi-plus"></i> Agregar Producto
        </button>
      </div>
      <div class="card-body">
        <div id="nuevosProductos"></div>
        <p id="sinNuevos" class="text-muted text-center py-2 mb-0">
          Hacé click en "Agregar Producto" para añadir ítems al pedido.
        </p>
      </div>
    </div>

    <!-- ═══ TOTAL DEL PEDIDO ══════════════════════════════════════ -->
    <div class="card border-0 shadow-sm mb-4 border-warning border-2">
      <div class="card-body bg-light">
        <div class="row align-items-center">
          <div class="col">
            <span class="text-muted">Total calculado del pedido:</span>
          </div>
          <div class="col-auto">
            <span class="fs-4 fw-bold text-success" id="totalEditDisplay">$0,00</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ BOTONES ═══════════════════════════════════════════════════ -->
    <div class="d-flex gap-3">
      <a href="/pedidos/detalle/<%= pedido.id %>" class="btn btn-secondary btn-lg">
        <i class="bi bi-x"></i> Cancelar
      </a>
      <button type="submit" class="btn btn-primary btn-lg px-5">
        <i class="bi bi-save"></i> Guardar Cambios
      </button>
    </div>
  </form>
</div>

<script>
let nuevoIdx = 0;
let productosCache = {};

// ═══ CÁLCULO PARA PRODUCTOS EXISTENTES ═══════════════════════
function calcularExistente(itemId) {
  const pu     = parseFloat(document.getElementById('pu_' + itemId).value)    || 0;
  const cant   = parseFloat(document.getElementById('cant_' + itemId).value)   || 1;
  const ancho  = parseFloat(document.getElementById('ancho_' + itemId).value)  || 0;
  const alto   = parseFloat(document.getElementById('alto_' + itemId).value)   || 0;

  let total;
  let formula;
  if (ancho > 0 && alto > 0) {
    const area = ancho * alto;
    total = pu * area * cant;
    formula = `${pu} × ${ancho}m × ${alto}m × ${cant} = $${total.toFixed(2)}`;
  } else {
    total = pu * cant;
    formula = `${pu} × ${cant} = $${total.toFixed(2)}`;
  }

  document.getElementById('precio_' + itemId).value = total.toFixed(2);
  const formulaEl = document.getElementById('formula_' + itemId);
  if (formulaEl) formulaEl.textContent = formula;

  actualizarTotalEdit();
}

// ═══ CÁLCULO PARA NUEVOS PRODUCTOS ═══════════════════════════
function calcularNuevo(idx) {
  const pu    = parseFloat(document.getElementById('np_pu_' + idx).value)    || 0;
  const cant  = parseFloat(document.getElementById('np_cant_' + idx).value)  || 1;
  const ancho = parseFloat(document.getElementById('np_ancho_' + idx).value) || 0;
  const alto  = parseFloat(document.getElementById('np_alto_' + idx).value)  || 0;

  let total;
  let formula;
  if (ancho > 0 && alto > 0) {
    const area = ancho * alto;
    total = pu * area * cant;
    formula = `${pu} × ${ancho}m × ${alto}m × ${cant} = $${total.toFixed(2)}`;
  } else {
    total = pu * cant;
    formula = `${pu} × ${cant} = $${total.toFixed(2)}`;
  }

  document.getElementById('np_precio_' + idx).value = total.toFixed(2);
  const formulaEl = document.getElementById('np_formula_' + idx);
  if (formulaEl) formulaEl.textContent = formula;

  actualizarTotalEdit();
}

// ═══ TOTAL GENERAL ════════════════════════════════════════════
function actualizarTotalEdit() {
  let suma = 0;
  // Sumar items existentes
  document.querySelectorAll('[id^="precio_"]').forEach(el => {
    if (/^precio_\d+$/.test(el.id)) suma += parseFloat(el.value) || 0;
  });
  // Sumar nuevos items
  document.querySelectorAll('[id^="np_precio_"]').forEach(el => {
    suma += parseFloat(el.value) || 0;
  });
  document.getElementById('totalEditDisplay').textContent =
    '$' + suma.toLocaleString('es-AR', { minimumFractionDigits: 2 });
}

// ═══ INICIALIZAR FÓRMULAS DE ITEMS EXISTENTES ════════════════
document.addEventListener('DOMContentLoaded', () => {
  <% items.forEach(item => { %>
    calcularExistente(<%= item.id %>);
  <% }) %>
  actualizarTotalEdit();
});

// ═══ AGREGAR NUEVO PRODUCTO ═══════════════════════════════════
function agregarNuevoProducto() {
  document.getElementById('sinNuevos').style.display = 'none';
  const idx = nuevoIdx++;
  const html = `
    <div id="np_row_${idx}" class="card mb-3 border border-warning">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h6 class="mb-0 text-muted">Nuevo Producto</h6>
          <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarNuevoProducto(${idx})">
            <i class="bi bi-trash"></i> Eliminar
          </button>
        </div>
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label fw-bold">Producto / Material *</label>
            <input type="text" id="np_buscar_${idx}" name="nuevo_material[]" class="form-control"
                   placeholder="Busca por nombre o código..."
                   oninput="buscarProductoNuevo(${idx}, this.value)">
            <div id="np_dropdown_${idx}" class="list-group mt-1" style="max-height:200px; overflow-y:auto; position:relative; z-index:100;"></div>
            <small class="text-muted" id="np_hint_${idx}" style="display:none;">Seleccioná de la lista</small>
          </div>
          <div class="col-6 col-md-2">
            <label class="form-label fw-bold">P.U. ($)</label>
            <input type="number" step="0.01" id="np_pu_${idx}" class="form-control"
                   placeholder="0.00" onchange="calcularNuevo(${idx})" oninput="calcularNuevo(${idx})">
            <small class="text-muted">Precio unitario/m²</small>
          </div>
          <div class="col-6 col-md-1">
            <label class="form-label">Cantidad</label>
            <input type="number" step="1" id="np_cant_${idx}" name="nuevo_cantidad[]" class="form-control"
                   value="1" min="1" onchange="calcularNuevo(${idx})">
          </div>
          <div class="col-6 col-md-1">
            <label class="form-label">Ancho (m)</label>
            <input type="number" step="0.01" id="np_ancho_${idx}" name="nuevo_ancho[]" class="form-control"
                   placeholder="0.00" onchange="calcularNuevo(${idx})" oninput="calcularNuevo(${idx})">
          </div>
          <div class="col-6 col-md-1">
            <label class="form-label">Alto (m)</label>
            <input type="number" step="0.01" id="np_alto_${idx}" name="nuevo_alto[]" class="form-control"
                   placeholder="0.00" onchange="calcularNuevo(${idx})" oninput="calcularNuevo(${idx})">
          </div>
          <div class="col-md-2">
            <label class="form-label fw-bold text-success">Total ($)</label>
            <input type="number" step="0.01" id="np_precio_${idx}" name="nuevo_precio[]" class="form-control fw-bold text-success"
                   placeholder="0.00" min="0" required>
          </div>
          <div class="col-md-1">
            <label class="form-label text-muted" style="font-size:0.75rem;">Cálculo</label>
            <div id="np_formula_${idx}" class="text-muted" style="font-size:0.75rem;"></div>
          </div>
        </div>
        <div class="row g-3 mt-1">
          <div class="col-12">
            <label class="form-label">Descripción</label>
            <textarea name="nuevo_descripcion[]" class="form-control" rows="2" placeholder="Notas adicionales..."></textarea>
          </div>
        </div>
      </div>
    </div>
  `;
  document.getElementById('nuevosProductos').insertAdjacentHTML('beforeend', html);
}

// ═══ BUSCAR PRODUCTO (AUTOCOMPLETE) ══════════════════════════
async function buscarProductoNuevo(idx, q) {
  const dropdown = document.getElementById('np_dropdown_' + idx);
  const hint = document.getElementById('np_hint_' + idx);

  if (q.length < 2) {
    dropdown.innerHTML = '';
    hint.style.display = 'none';
    return;
  }

  try {
    const res = await fetch('/api/autocomplete/productos?q=' + encodeURIComponent(q));
    const productos = await res.json();

    if (productos.length === 0) {
      dropdown.innerHTML = '<div class="list-group-item text-muted">No hay resultados</div>';
      hint.style.display = 'none';
      return;
    }

    productosCache[idx] = productos;
    hint.style.display = '';
    dropdown.innerHTML = productos.map((p, pidx) => `
      <div class="list-group-item list-group-item-action text-start np-producto-item"
           data-idx="${idx}" data-pidx="${pidx}" style="cursor:pointer;">
        <div class="fw-bold">${p.nombre}</div>
        <small class="text-muted">
          P.U.: $${parseFloat(p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2})}
          ${p.codigo ? ' • ' + p.codigo : ''}
          ${p.tipo ? ' • ' + p.tipo : ''}
        </small>
      </div>
    `).join('');

    dropdown.querySelectorAll('.np-producto-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        seleccionarProductoDesdeDropdown(
          parseInt(item.getAttribute('data-idx')),
          parseInt(item.getAttribute('data-pidx'))
        );
      });
    });
  } catch (err) {
    console.error('Error buscando productos:', err);
    dropdown.innerHTML = '<div class="list-group-item text-danger">Error en la búsqueda</div>';
  }
}

function seleccionarProductoDesdeDropdown(idx, pidx) {
  const p = productosCache[idx] && productosCache[idx][pidx];
  if (!p) return;
  document.getElementById('np_buscar_' + idx).value = p.nombre;
  document.getElementById('np_pu_' + idx).value = parseFloat(p.precio || 0).toFixed(2);
  document.getElementById('np_dropdown_' + idx).innerHTML = '';
  document.getElementById('np_hint_' + idx).style.display = 'none';
  calcularNuevo(idx);
}

function eliminarNuevoProducto(idx) {
  document.getElementById('np_row_' + idx).remove();
  delete productosCache[idx];
  if (document.getElementById('nuevosProductos').children.length === 0) {
    document.getElementById('sinNuevos').style.display = '';
  }
  actualizarTotalEdit();
}
</script>
