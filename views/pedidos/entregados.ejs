<!-- views/pedidos/entregados.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="display-6"><i class="bi bi-check-circle"></i> Trabajos Entregados</h1>
      <p class="text-muted">Completados y entregados a clientes</p>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- LISTA DE PEDIDOS -->
  <% if (pedidos && pedidos.length > 0) { %>
    <div class="row g-4">
      <% pedidos.forEach(p => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100 border-left border-success" style="border-left: 4px solid #198754 !important;">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0">Pedido #<%= p.id %></h5>
            </div>
            <div class="card-body">
              <p><strong>Cliente:</strong> <%= p.cliente_nombre || 'N/A' %></p>
              <p><strong>Fecha:</strong> <%= new Date(p.fecha).toLocaleDateString('es-AR') %></p>
              <p><strong>Total:</strong> $<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
              
              <% if (p.monto_restante > 0) { %>
                <p class="text-danger"><strong>Deuda:</strong> $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
              <% } else { %>
                <p class="text-success"><strong>✓ Completamente Pagado</strong></p>
              <% } %>
              
              <div class="mb-3">
                <strong>Productos:</strong>
                <ul class="list-group list-group-sm mt-2">
                  <% p.productos.forEach(prod => { %>
                    <li class="list-group-item">
                      <%= prod.material %>
                      <br><small class="text-muted">$<%= (prod.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></small>
                    </li>
                  <% }); %>
                </ul>
              </div>

              <div class="d-flex gap-2 flex-wrap">
                <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-eye"></i> Detalle
                </a>
                <a href="/pedidos/<%= p.id %>/comprobante" class="btn btn-sm btn-outline-info">
                  <i class="bi bi-receipt"></i> Comprobante
                </a>
                <% if (p.monto_restante > 0) { %>
                  <a href="javascript:void(0)" class="btn btn-sm btn-success" onclick="enviarWhatsApp(<%= p.id %>, '<%= p.cliente_nombre.replace(/'/g, '') %>', <%= p.monto_restante %>)">
                    <i class="bi bi-chat-dots"></i> WhatsApp
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> No hay trabajos entregados en este momento.
    </div>
  <% } %>

  <div class="mt-4">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Volver al Inicio
    </a>
  </div>
</div>

<script>
  function enviarWhatsApp(pedidoId, cliente, deuda) {
    fetch(`/api/pedidos/${pedidoId}/cliente-phone`)
      .then(r => r.json())
      .then(data => {
        if (data.phone) {
          const tel = data.phone.replace(/\D/g, '');
          const precio = deuda ? '$' + Math.round(deuda) : 'a definir';
          const msg = encodeURIComponent(
            `Hola ${cliente},\n\n` +
            `✅ Tu pedido #${pedidoId} está listo para retirar.\n\n` +
            `💰 Deuda pendiente: ${precio}\n\n` +
            `¿Te va bien? ¡Gracias!`
          );
          window.open(`https://wa.me/549${tel}?text=${msg}`, '_blank');
        } else {
          alert('No hay número de teléfono disponible para este cliente');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Error al obtener el teléfono del cliente');
      });
  }
</script>
