<!-- views/pedidos/entregados.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <h1 class="display-6"><i class="bi bi-check-circle"></i> Trabajos Entregados</h1>
      <p class="text-muted">Completados y entregados a clientes</p>
    </div>
    <div class="col-md-4 text-end">
      <span class="badge bg-info fs-6">
        <i class="bi bi-collection"></i> <%= pedidos.length %> trabajos
      </span>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- CONTROLES: BÚSQUEDA, FILTRO Y VISTAS -->
  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
      <form method="GET" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label fw-semibold">🔍 Buscar por Cliente o ID</label>
          <input type="text" name="search" class="form-control" placeholder="Ej: Juan, #123" value="<%= search %>">
        </div>

        <div class="col-md-3">
          <label class="form-label fw-semibold">📊 Ordenar por</label>
          <select name="sortBy" class="form-select">
            <option value="fecha" <%= sortBy === 'fecha' ? 'selected' : '' %>>📅 Fecha</option>
            <option value="cliente" <%= sortBy === 'cliente' ? 'selected' : '' %>>👤 Cliente</option>
            <option value="monto" <%= sortBy === 'monto' ? 'selected' : '' %>>💰 Monto</option>
            <option value="id" <%= sortBy === 'id' ? 'selected' : '' %>>🏷️ ID</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold">⬆️⬇️ Dirección</label>
          <select name="sortDir" class="form-select">
            <option value="desc" <%= sortDir === 'desc' ? 'selected' : '' %>>↓ Descendente</option>
            <option value="asc" <%= sortDir === 'asc' ? 'selected' : '' %>>↑ Ascendente</option>
          </select>
        </div>

        <div class="col-md-3">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-funnel"></i> Filtrar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- SELECTOR DE VISTA Y AGRUPAMIENTO -->
  <div class="row g-2 mb-3">
    <div class="col-md-6">
      <label class="form-label fw-semibold small">Vista</label>
      <div class="btn-group d-flex" role="group" style="width: 100%;">
        <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=cards&groupBy=<%= groupBy %>"
           class="btn <%= view === 'cards' ? 'btn-primary' : 'btn-outline-primary' %>" style="flex: 1;">
          <i class="bi bi-grid-3x2-gap"></i> Tarjetas
        </a>
        <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=tabla&groupBy=<%= groupBy %>"
           class="btn <%= view === 'tabla' ? 'btn-primary' : 'btn-outline-primary' %>" style="flex: 1;">
          <i class="bi bi-table"></i> Tabla
        </a>
        <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=compacto&groupBy=<%= groupBy %>"
           class="btn <%= view === 'compacto' ? 'btn-primary' : 'btn-outline-primary' %>" style="flex: 1;">
          <i class="bi bi-list-ul"></i> Compacto
        </a>
      </div>
    </div>
    <div class="col-md-6">
      <label class="form-label fw-semibold small">Agrupar por</label>
      <div class="btn-group d-flex" role="group" style="width: 100%;">
        <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=<%= view %>&groupBy=none"
           class="btn <%= groupBy === 'none' ? 'btn-success' : 'btn-outline-success' %>" style="flex: 1;">
          <i class="bi bi-layout-split"></i> Sin Agrupar
        </a>
        <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=<%= view %>&groupBy=semana"
           class="btn <%= groupBy === 'semana' ? 'btn-success' : 'btn-outline-success' %>" style="flex: 1;">
          <i class="bi bi-calendar-week"></i> Por Semana
        </a>
      </div>
    </div>
  </div>

  <!-- CONTENIDO AGRUPADO -->
  <% if (groupBy === 'semana' && pedidosAgrupados && pedidosAgrupados.length > 0) { %>
    <% pedidosAgrupados.forEach(grupo => { %>
      <!-- HEADER DE SEMANA -->
      <div class="mb-4">
        <div class="card border-0 bg-light mb-3">
          <div class="card-body py-3">
            <h5 class="mb-0">
              <i class="bi bi-calendar-week"></i> <%= grupo.label %>
              <span class="badge bg-secondary"><%= grupo.pedidos.length %> entregados</span>
            </h5>
          </div>
        </div>

        <!-- VISTA: TARJETAS (AGRUPADAS) -->
        <% if (view === 'cards') { %>
          <div class="row g-4 mb-4">
            <% grupo.pedidos.forEach(p => { %>
              <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 border-left" style="border-left: 4px solid #198754 !important;">
                  <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                      <h5 class="mb-0">Pedido #<%= p.id %></h5>
                      <small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small>
                    </div>
                  </div>
                  <div class="card-body">
                    <p><strong>👤 Cliente:</strong> <%= p.cliente_nombre || 'N/A' %></p>
                    <p><strong>💰 Total:</strong> <span class="text-primary fs-5">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span></p>
                    <% if (p.monto_restante > 0) { %>
                      <p class="text-danger"><strong>⚠️ Deuda:</strong> $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
                    <% } else { %>
                      <p class="text-success"><strong>✓ Pagado</strong></p>
                    <% } %>
                    <div class="mb-3">
                      <small><strong>Productos:</strong></small>
                      <div class="small text-muted" style="max-height: 100px; overflow-y: auto;">
                        <% p.productos.forEach((prod, idx) => { %>
                          <div>• <%= prod.material %></div>
                        <% }); %>
                      </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                      <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Detalle
                      </a>
                      <a href="/pedidos/<%= p.id %>/comprobante" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-receipt"></i> Comprobante
                      </a>
                      <% if (p.monto_restante > 0) { %>
                        <button class="btn btn-sm btn-success" onclick="enviarWhatsApp(<%= p.id %>, '<%= p.cliente_nombre.replace(/'/g, "\\'") %>', <%= p.monto_restante %>)">
                          <i class="bi bi-chat-dots"></i> WhatsApp
                        </button>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- VISTA: TABLA (AGRUPADA) -->
        <% if (view === 'tabla') { %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-dark">
                  <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Deuda</th>
                    <th>Productos</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% grupo.pedidos.forEach(p => { %>
                  <tr>
                    <td><strong>#<%= p.id %></strong></td>
                    <td><%= p.cliente_nombre || 'N/A' %></td>
                    <td><small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small></td>
                    <td class="fw-bold">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                    <td>
                      <% if (p.monto_restante > 0) { %>
                        <span class="text-danger">$<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
                      <% } else { %>
                        <span class="text-success">Pagado</span>
                      <% } %>
                    </td>
                    <td>
                      <small>
                        <% p.productos.slice(0, 2).forEach(prod => { %>
                          <div>• <%= prod.material %></div>
                        <% }); %>
                        <% if (p.productos.length > 2) { %>
                          <small class="text-muted">+ <%= p.productos.length - 2 %> más</small>
                        <% } %>
                      </small>
                    </td>
                    <td>
                      <div class="d-flex gap-1">
                        <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Detalle</a>
                        <a href="/pedidos/<%= p.id %>/comprobante" class="btn btn-sm btn-outline-info">Comprobante</a>
                      </div>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>

        <!-- VISTA: COMPACTO (AGRUPADA) -->
        <% if (view === 'compacto') { %>
          <div class="list-group mb-4">
            <% grupo.pedidos.forEach(p => { %>
            <div class="list-group-item list-group-item-action">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h6 class="mb-1">
                    <i class="bi bi-box"></i> Pedido #<%= p.id %> - <%= p.cliente_nombre || 'N/A' %>
                  </h6>
                  <small class="text-muted">
                    <%= new Date(p.fecha).toLocaleDateString('es-AR') %> •
                    $<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
                    <% if (p.monto_restante > 0) { %>
                      • 💰 Deuda: $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
                    <% } else { %>
                      • <span class="text-success">✓ Pagado</span>
                    <% } %>
                  </small>
                </div>
                <div class="ms-3">
                  <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Ver</a>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% }); %>

  <% } else if (groupBy === 'none' && pedidos && pedidos.length > 0) { %>
    <!-- VISTA: TARJETAS (SIN AGRUPAR) -->
    <% if (view === 'cards') { %>
      <div class="row g-4">
        <% pedidos.forEach(p => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 border-left" style="border-left: 4px solid #198754 !important;">
              <div class="card-header bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="mb-0">Pedido #<%= p.id %></h5>
                  <small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small>
                </div>
              </div>
              <div class="card-body">
                <p><strong>👤 Cliente:</strong> <%= p.cliente_nombre || 'N/A' %></p>
                <p><strong>💰 Total:</strong> <span class="text-primary fs-5">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span></p>
                <% if (p.monto_restante > 0) { %>
                  <p class="text-danger"><strong>⚠️ Deuda:</strong> $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
                <% } else { %>
                  <p class="text-success"><strong>✓ Pagado</strong></p>
                <% } %>
                <div class="mb-3">
                  <small><strong>Productos:</strong></small>
                  <div class="small text-muted" style="max-height: 100px; overflow-y: auto;">
                    <% p.productos.forEach((prod, idx) => { %>
                      <div>• <%= prod.material %></div>
                    <% }); %>
                  </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                  <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye"></i> Detalle
                  </a>
                  <a href="/pedidos/<%= p.id %>/comprobante" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-receipt"></i> Comprobante
                  </a>
                  <% if (p.monto_restante > 0) { %>
                    <button class="btn btn-sm btn-success" onclick="enviarWhatsApp(<%= p.id %>, '<%= p.cliente_nombre.replace(/'/g, "\\'") %>', <%= p.monto_restante %>)">
                      <i class="bi bi-chat-dots"></i> WhatsApp
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- VISTA: TABLA (SIN AGRUPAR) -->
    <% if (view === 'tabla') { %>
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-dark">
              <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Deuda</th>
                <th>Productos</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% pedidos.forEach(p => { %>
              <tr>
                <td><strong>#<%= p.id %></strong></td>
                <td><%= p.cliente_nombre || 'N/A' %></td>
                <td><small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small></td>
                <td class="fw-bold">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                <td>
                  <% if (p.monto_restante > 0) { %>
                    <span class="text-danger">$<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
                  <% } else { %>
                    <span class="text-success">Pagado</span>
                  <% } %>
                </td>
                <td>
                  <small>
                    <% p.productos.slice(0, 2).forEach(prod => { %>
                      <div>• <%= prod.material %></div>
                    <% }); %>
                    <% if (p.productos.length > 2) { %>
                      <small class="text-muted">+ <%= p.productos.length - 2 %> más</small>
                    <% } %>
                  </small>
                </td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Detalle</a>
                    <a href="/pedidos/<%= p.id %>/comprobante" class="btn btn-sm btn-outline-info">Comprobante</a>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- VISTA: COMPACTO (SIN AGRUPAR) -->
    <% if (view === 'compacto') { %>
      <div class="list-group">
        <% pedidos.forEach(p => { %>
        <div class="list-group-item list-group-item-action">
          <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
              <h6 class="mb-1">
                <i class="bi bi-box"></i> Pedido #<%= p.id %> - <%= p.cliente_nombre || 'N/A' %>
              </h6>
              <small class="text-muted">
                <%= new Date(p.fecha).toLocaleDateString('es-AR') %> •
                $<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
                <% if (p.monto_restante > 0) { %>
                  • 💰 Deuda: $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
                <% } else { %>
                  • <span class="text-success">✓ Pagado</span>
                <% } %>
              </small>
            </div>
            <div class="ms-3">
              <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Ver</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>

  <% } else if (pedidos && pedidos.length === 0) { %>
    <!-- SIN RESULTADOS -->
    <div class="alert alert-info text-center py-5">
      <i class="bi bi-inbox" style="font-size: 3rem; color: #198754;"></i>
      <p class="mt-3 mb-0"><strong>No hay trabajos entregados</strong></p>
      <small class="text-muted">Intenta cambiar los filtros de búsqueda</small>
    </div>
  <% } %>

  <div class="mt-4">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Volver al Inicio
    </a>
  </div>
</div>

<script>
  function enviarWhatsApp(pedidoId, cliente, deuda) {
    fetch(`/api/pedidos/${pedidoId}/cliente-phone`)
      .then(r => r.json())
      .then(data => {
        if (data.phone) {
          const tel = data.phone.replace(/\D/g, '');
          const precio = deuda ? '$' + Math.round(deuda) : 'a definir';
          const msg = encodeURIComponent(
            `Hola ${cliente},\n\n` +
            `✅ Tu pedido #${pedidoId} está listo para retirar.\n\n` +
            `💰 Deuda pendiente: ${precio}\n\n` +
            `¿Te va bien? ¡Gracias!`
          );
          window.open(`https://wa.me/549${tel}?text=${msg}`, '_blank');
        } else {
          alert('❌ No hay número de teléfono registrado para este cliente');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Error al obtener el número de teléfono');
      });
  }
</script>
