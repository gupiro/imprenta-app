<!-- views/pedidos/nuevo.ejs -->
<div class="container-fluid py-5">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="display-6"><i class="bi bi-plus-circle"></i> Crear Nuevo Pedido</h1>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <form action="/pedidos/nuevo" method="POST" enctype="multipart/form-data" id="formPedido">
    <div class="row g-4">
      <!-- ═════════════════════════════════════════
           SECCIÓN 1: CLIENTE
           ════════════════════════════════════════= -->
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-person"></i> 1️⃣ CLIENTE</h6>
          </div>
          <div class="card-body">
            <div class="btn-group mb-3" role="group">
              <input type="radio" class="btn-check" name="tipoCliente" id="clienteExistente" value="existente" checked onchange="cambiarTipoCliente()">
              <label class="btn btn-outline-primary" for="clienteExistente">
                <i class="bi bi-database"></i> Cliente Existente
              </label>
              
              <input type="radio" class="btn-check" name="tipoCliente" id="clienteNuevo" value="nuevo" onchange="cambiarTipoCliente()">
              <label class="btn btn-outline-success" for="clienteNuevo">
                <i class="bi bi-person-plus"></i> Cliente Nuevo
              </label>
            </div>

            <!-- OPCIÓN 1: Cliente Existente (con Autocomplete) -->
            <div id="seccionClienteExistente">
              <div class="row g-3">
                <div class="col-md-12">
                  <label class="form-label fw-bold">🔍 Buscar Cliente (Nombre, Teléfono o CUIT) *</label>
                  <div class="position-relative">
                    <input 
                      type="text" 
                      id="buscadorCliente" 
                      class="form-control form-control-lg" 
                      placeholder="Ej: Juan García, 3874567890, o 23-12345678-9"
                      autocomplete="off"
                      oninput="buscarClientes(this.value)"
                    >
                    <input type="hidden" name="clienteExistente" id="clienteSeleccionadoId" required>
                    <ul id="dropdownClientes" class="dropdown-menu w-100" style="display:none; position:absolute; top:100%; left:0; z-index:1000;"></ul>
                  </div>
                  <small class="text-muted d-block mt-2">
                    <span id="clienteSeleccionadoInfo" class="text-success fw-bold"></span>
                  </small>
                </div>
              </div>
            </div>

            <!-- OPCIÓN 2: Cliente Nuevo -->
            <div id="seccionClienteNuevo" style="display: none;">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">Nombre *</label>
                  <input type="text" name="clienteInput" id="clienteNombreInput" class="form-control form-control-lg" placeholder="Nombre del cliente">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">Teléfono *</label>
                  <input type="text" name="telefonoNuevo" id="telefonoNuevoInput" class="form-control form-control-lg" placeholder="(387) 123-4567">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Email</label>
                  <input type="email" name="emailNuevo" id="emailNuevoInput" class="form-control" placeholder="email@ejemplo.com">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Dirección</label>
                  <input type="text" name="direccionNuevo" id="direccionNuevoInput" class="form-control" placeholder="Calle 123">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═════════════════════════════════════════
           SECCIÓN 2: PRODUCTOS
           ════════════════════════════════════════= -->
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-success text-white">
            <h6 class="mb-0"><i class="bi bi-box"></i> 2️⃣ PRODUCTOS/SERVICIOS</h6>
          </div>
          <div class="card-body">
            <div id="contenedorProductos"></div>
            <button type="button" class="btn btn-outline-success w-100" onclick="agregarProducto()">
              <i class="bi bi-plus-circle"></i> Agregar Producto
            </button>
          </div>
        </div>
      </div>

      <!-- ═════════════════════════════════════════
           SECCIÓN 3: DESCUENTO GENERAL
           ════════════════════════════════════════= -->
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-info text-white">
            <h6 class="mb-0"><i class="bi bi-percent"></i> 3️⃣ DESCUENTO GENERAL (OPCIONAL)</h6>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-bold">Descuento (%)</label>
                <input type="number" id="descuentoGeneral" class="form-control form-control-lg" step="0.01" value="0" min="0" max="100" onchange="recalcularTotal()">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold">Descuento ($)</label>
                <input type="number" id="descuentoDolaresGeneral" class="form-control form-control-lg" step="0.01" value="0" min="0" readonly style="background-color: #f0f0f0;">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold">Subtotal ($)</label>
                <input type="number" id="subtotalGeneral" class="form-control form-control-lg" step="0.01" readonly style="background-color: #f0f0f0;">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═════════════════════════════════════════
           SECCIÓN 4: TOTALES Y PAGO
           ════════════════════════════════════════= -->
      <div class="col-12">
        <div class="card border-0 shadow-sm border-warning border-4">
          <div class="card-header bg-warning text-dark">
            <h6 class="mb-0"><i class="bi bi-cash-coin"></i> 4️⃣ TOTALES Y PAGO</h6>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-bold">💰 Total del Pedido ($) *</label>
                <input type="number" id="totalPedido" name="precioTotalPedido" class="form-control form-control-lg fw-bold" step="0.01" readonly style="background-color: #fff3cd; font-size: 1.3rem;">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold">💵 Monto Adelantado ($)</label>
                <input type="number" name="monto_entregado" class="form-control form-control-lg" step="0.01" value="0" required>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold">💳 Método de Pago</label>
                <select name="medio_pago" class="form-select form-select-lg" required>
                  <option value="">-- Seleccionar --</option>
                  <option value="Efectivo">💵 Efectivo</option>
                  <option value="Transferencia">🏦 Transferencia</option>
                  <option value="Tarjeta">💳 Tarjeta</option>
                  <option value="QR">📱 QR</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-bold">📅 Fecha de Entrega</label>
                <input type="date" name="fecha_entrega" class="form-control form-control-lg">
                <small class="text-muted">Opcional — ¿para cuándo está el trabajo?</small>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═════════════════════════════════════════
           BOTONES
           ════════════════════════════════════════= -->
      <div class="col-12">
        <div class="d-flex gap-3 justify-content-center">
          <a href="/" class="btn btn-secondary btn-lg px-5">
            <i class="bi bi-arrow-left"></i> Cancelar
          </a>
          <button type="submit" class="btn btn-success btn-lg px-5" onclick="return validarFormulario()">
            <i class="bi bi-save"></i> Guardar Pedido
          </button>
        </div>
      </div>
    </div>
  </form>
</div>


<script>
const materiales = <%- JSON.stringify(materiales) %>;
let contadorProductos = 0;
let timerBusquedaClientes = null;
let timerBusquedaProductos = {};

function cambiarTipoCliente() {
  const tipo = document.querySelector('input[name="tipoCliente"]:checked').value;
  
  if (tipo === 'existente') {
    document.getElementById('seccionClienteExistente').style.display = 'block';
    document.getElementById('seccionClienteNuevo').style.display = 'none';
  } else {
    document.getElementById('seccionClienteExistente').style.display = 'none';
    document.getElementById('seccionClienteNuevo').style.display = 'block';
  }
}

// ════════════════════════════════════════════════════════════════
// BUSCAR CLIENTES CON AUTOCOMPLETE
// ════════════════════════════════════════════════════════════════

function buscarClientes(query) {
  clearTimeout(timerBusquedaClientes);
  
  if (!query || query.length < 1) {
    document.getElementById('dropdownClientes').style.display = 'none';
    return;
  }

  timerBusquedaClientes = setTimeout(async () => {
    try {
      const res = await fetch('/api/autocomplete/clientes?q=' + encodeURIComponent(query));
      const clientes = await res.json();
      const dropdown = document.getElementById('dropdownClientes');
      
      if (!clientes || !clientes.length) {
        dropdown.innerHTML = '<li class="dropdown-item text-muted">Sin resultados</li>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = clientes.map(c => `
        <li class="dropdown-item cursor-pointer" style="cursor:pointer;" 
            onclick="seleccionarCliente(${c.id}, '${c.name.replace(/'/g, "\\'")}', '${c.cuit || ''}')">
          <strong>${c.name}</strong><br>
          <small class="text-muted">
            ${c.cuit ? '🆔 ' + c.cuit : ''} ${c.phone ? '📱 ' + c.phone : ''}
          </small>
        </li>
      `).join('');
      
      dropdown.style.display = 'block';
    } catch (err) {
      console.error('Error:', err);
    }
  }, 300);
}

function seleccionarCliente(id, nombre, cuit) {
  document.getElementById('clienteSeleccionadoId').value = id;
  document.getElementById('buscadorCliente').value = nombre;
  document.getElementById('clienteSeleccionadoInfo').textContent = '✓ ' + nombre + (cuit ? ' (' + cuit + ')' : '');
  document.getElementById('dropdownClientes').style.display = 'none';
}

document.addEventListener('click', (e) => {
  if (!e.target.closest('#buscadorCliente') && !e.target.closest('#dropdownClientes')) {
    document.getElementById('dropdownClientes').style.display = 'none';
  }
});

// ════════════════════════════════════════════════════════════════
// AGREGAR PRODUCTO
// ════════════════════════════════════════════════════════════════

function agregarProducto() {
  contadorProductos++;
  const idx = contadorProductos;
  const html = `
    <div class="producto-item mb-4 p-3 border rounded bg-light" id="producto_${idx}">
      <div class="row g-3">
        <div class="col-md-5 position-relative">
          <label class="form-label fw-bold">🔍 Producto *</label>
          <input 
            type="text" 
            class="form-control buscador-producto" 
            placeholder="Busca por código o nombre"
            data-idx="${idx}"
            autocomplete="off"
            oninput="buscarProductos(this.value, ${idx})"
          >
          <input type="hidden" name="material[]" id="producto_nombre_${idx}" value="" required>
          <input type="hidden" name="producto_id[]" id="producto_id_${idx}" value="">
          <ul id="dropdown_productos_${idx}" class="dropdown-menu w-100" style="display:none; position:absolute; top:100%; left:0; z-index:1000; max-height:300px; overflow-y:auto;"></ul>
          <small id="producto_info_${idx}" class="text-success fw-bold d-block mt-1"></small>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-bold">Cantidad *</label>
          <input type="number" name="cantidad[]" class="form-control" step="1" value="1" min="1" onchange="calcularPrecio(${idx})" required>
        </div>

        <div class="col-md-1 campos-lona-${idx}" style="display:none;">
          <label class="form-label">Ancho (m)</label>
          <input type="number" name="ancho[]" class="form-control" step="0.01" onchange="calcularPrecio(${idx})">
        </div>

        <div class="col-md-1 campos-lona-${idx}" style="display:none;">
          <label class="form-label">Alto (m)</label>
          <input type="number" name="alto[]" class="form-control" step="0.01" onchange="calcularPrecio(${idx})">
        </div>

        <div class="col-md-1">
          <label class="form-label fw-bold">P.U. ($)</label>
          <input type="number" name="precio_unitario[]" id="preciounit_${idx}" class="form-control" step="0.01" readonly style="background-color:#f0f0f0;">
        </div>

        <div class="col-md-1">
          <label class="form-label">Desc. (%)</label>
          <input type="number" name="descuento_item[]" id="descuento_${idx}" class="form-control" step="0.01" value="0" min="0" max="100" onchange="calcularPrecio(${idx})">
        </div>

        <div class="col-md-1">
          <label class="form-label fw-bold">Subtotal ($)</label>
          <input type="number" name="precio[]" id="precio_${idx}" class="form-control" step="0.01" readonly style="background-color:#f0f0f0;">
        </div>

        <div class="col-md-12">
          <label class="form-label">Descripción</label>
          <textarea name="descripcion[]" class="form-control" rows="2" placeholder="Detalles..."></textarea>
        </div>

        <div class="col-12 text-end">
          <button type="button" class="btn btn-sm btn-danger" onclick="eliminarProducto(${idx})">
            <i class="bi bi-trash"></i> Eliminar
          </button>
        </div>
      </div>
    </div>
  `;
  
  document.getElementById('contenedorProductos').insertAdjacentHTML('beforeend', html);
}

// ════════════════════════════════════════════════════════════════
// BUSCAR PRODUCTOS CON AUTOCOMPLETE
// ════════════════════════════════════════════════════════════════

function buscarProductos(query, idx) {
  clearTimeout(timerBusquedaProductos[idx]);
  
  if (!query || query.length < 1) {
    document.getElementById('dropdown_productos_' + idx).style.display = 'none';
    return;
  }

  timerBusquedaProductos[idx] = setTimeout(async () => {
    try {
      const res = await fetch('/api/autocomplete/productos?q=' + encodeURIComponent(query));
      const productos = await res.json();
      const dropdown = document.getElementById('dropdown_productos_' + idx);
      
      if (!productos || !productos.length) {
        dropdown.innerHTML = '<li class="dropdown-item text-muted">Sin resultados</li>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = productos.map(p => `
        <li class="dropdown-item cursor-pointer" style="cursor:pointer;" 
            onclick="seleccionarProducto(${idx}, ${p.id}, '${p.nombre.replace(/'/g, "\\'")}', '${p.codigo || ''}', '${p.tipo}', ${p.precio})">
          <strong>[${p.codigo || 'S/C'}] ${p.nombre}</strong><br>
          <small class="text-muted">💵 $${p.precio} • ${p.tipo}</small>
        </li>
      `).join('');
      
      dropdown.style.display = 'block';
    } catch (err) {
      console.error('Error:', err);
    }
  }, 300);
}

function seleccionarProducto(idx, productoId, nombre, codigo, tipo, precio) {
  const item = document.getElementById('producto_' + idx);
  
  item.querySelector('.buscador-producto').value = '[' + (codigo || 'S/C') + '] ' + nombre;
  document.getElementById('producto_id_' + idx).value = productoId;
  document.getElementById('producto_nombre_' + idx).value = nombre;
  document.getElementById('preciounit_' + idx).value = precio.toFixed(2);
  document.getElementById('producto_info_' + idx).textContent = '✓ ' + nombre;
  
  // Mostrar/ocultar campos de lona
  const lonaFields = document.querySelectorAll('.campos-lona-' + idx);
  const esLona = tipo.toLowerCase().includes('lona');
  lonaFields.forEach(f => {
    f.style.display = esLona ? 'block' : 'none';
  });
  
  document.getElementById('dropdown_productos_' + idx).style.display = 'none';
  calcularPrecio(idx);
}

document.addEventListener('click', (e) => {
  document.querySelectorAll('[id^="dropdown_productos_"]').forEach(dd => {
    if (!e.target.closest('[data-idx="' + dd.id.split('_')[2] + '"]') && !e.target.closest('#' + dd.id)) {
      dd.style.display = 'none';
    }
  });
});

// ════════════════════════════════════════════════════════════════
// CALCULAR PRECIOS
// ════════════════════════════════════════════════════════════════

function calcularPrecio(idx) {
  const producto = document.getElementById('producto_' + idx);
  if (!producto) return;
  
  const precioBase = parseFloat(document.getElementById('preciounit_' + idx).value) || 0;
  const cantidad = parseFloat(producto.querySelector('input[name="cantidad[]"]').value) || 1;
  const descuento = parseFloat(document.getElementById('descuento_' + idx).value) || 0;
  const ancho = parseFloat(producto.querySelector('input[name="ancho[]"]')?.value) || 0;
  const alto = parseFloat(producto.querySelector('input[name="alto[]"]')?.value) || 0;
  
  let precioUnitario = precioBase;
  if (ancho && alto) {
    precioUnitario = (ancho * alto) * precioBase;
  }
  
  const subtotal = precioUnitario * cantidad;
  const descuentoMonto = subtotal * (descuento / 100);
  const precioFinal = subtotal - descuentoMonto;
  
  document.getElementById('precio_' + idx).value = precioFinal.toFixed(2);
  recalcularTotal();
}

function recalcularTotal() {
  let suma = 0;
  document.querySelectorAll('input[name="precio[]"]').forEach(input => {
    suma += parseFloat(input.value) || 0;
  });
  
  const descuentoGeneral = parseFloat(document.getElementById('descuentoGeneral').value) || 0;
  const descuentoMonto = suma * (descuentoGeneral / 100);
  const total = suma - descuentoMonto;
  
  document.getElementById('subtotalGeneral').value = suma.toFixed(2);
  document.getElementById('descuentoDolaresGeneral').value = descuentoMonto.toFixed(2);
  document.getElementById('totalPedido').value = total.toFixed(2);
}

function eliminarProducto(idx) {
  const elem = document.getElementById('producto_' + idx);
  if (elem) elem.remove();
  recalcularTotal();
}


// ════════════════════════════════════════════════════════════════
// VALIDAR FORMULARIO
// ════════════════════════════════════════════════════════════════

function validarFormulario() {
  const tipo = document.querySelector('input[name="tipoCliente"]:checked').value;
  
  if (tipo === 'existente') {
    if (!document.getElementById('clienteSeleccionadoId').value) {
      alert('⚠️ Selecciona un cliente');
      return false;
    }
  } else {
    if (!document.getElementById('clienteNombreInput').value.trim()) {
      alert('⚠️ Ingresa nombre del cliente');
      return false;
    }
    if (!document.getElementById('telefonoNuevoInput').value.trim()) {
      alert('⚠️ Ingresa teléfono del cliente');
      return false;
    }
  }
  
  const productos = document.querySelectorAll('.producto-item');
  if (productos.length === 0) {
    alert('⚠️ Agrega al menos un producto');
    return false;
  }
  
  let valido = true;
  productos.forEach((prod, i) => {
    const id = prod.querySelector('input[name="producto_id[]"]').value;
    if (!id) {
      alert('⚠️ Selecciona un producto para cada línea');
      valido = false;
    }
  });
  
  return valido;
}
</script>
