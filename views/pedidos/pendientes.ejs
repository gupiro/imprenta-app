<!-- views/pedidos/pendientes.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <h1 class="display-6"><i class="bi bi-clock-history"></i> Trabajos Pendientes</h1>
      <p class="text-muted">Esperando inicio de producción</p>
    </div>
    <div class="col-md-4 text-end">
      <span class="badge bg-info fs-6">
        <i class="bi bi-collection"></i> <%= pedidos.length %> trabajos
      </span>
    </div>
  </div>

  <!-- ALERTAS -->
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- NAVEGACIÓN RÁPIDA ENTRE ESTADOS -->
  <div class="mb-4 d-flex gap-2 flex-wrap">
    <a href="/pedidos/pendientes"
       class="btn btn-sm <%= estadoActual === 'PENDIENTE' ? 'btn-danger' : 'btn-outline-danger' %>">
      📋 Pendientes
      <span class="badge bg-light text-dark ms-1"><%= (estadoCounts && estadoCounts['PENDIENTE']) || 0 %></span>
    </a>
    <a href="/pedidos/en-produccion"
       class="btn btn-sm <%= estadoActual === 'EN_PRODUCCION' ? 'btn-warning' : 'btn-outline-warning' %>">
      ⚙️ En Producción
      <span class="badge bg-light text-dark ms-1"><%= (estadoCounts && estadoCounts['EN_PRODUCCION']) || 0 %></span>
    </a>
    <a href="/pedidos/listos"
       class="btn btn-sm <%= estadoActual === 'LISTO' ? 'btn-info' : 'btn-outline-info' %>">
      ✅ Listos
      <span class="badge bg-light text-dark ms-1"><%= (estadoCounts && estadoCounts['LISTO']) || 0 %></span>
    </a>
    <a href="/pedidos/entregados"
       class="btn btn-sm <%= estadoActual === 'ENTREGADO' ? 'btn-success' : 'btn-outline-success' %>">
      🎉 Entregados
      <span class="badge bg-light text-dark ms-1"><%= (estadoCounts && estadoCounts['ENTREGADO']) || 0 %></span>
    </a>
  </div>

  <!-- CONTROLES: BÚSQUEDA, FILTRO Y VISTAS -->
  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
      <form method="GET" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label fw-semibold">🔍 Buscar por Cliente o ID</label>
          <input type="text" name="search" class="form-control" placeholder="Ej: Juan, #123" value="<%= search %>">
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold">📊 Ordenar por</label>
          <select name="sortBy" class="form-select">
            <option value="fecha" <%= sortBy === 'fecha' ? 'selected' : '' %>>📅 Fecha creación</option>
            <option value="fecha_entrega" <%= sortBy === 'fecha_entrega' ? 'selected' : '' %>>📆 Fecha entrega</option>
            <option value="cliente" <%= sortBy === 'cliente' ? 'selected' : '' %>>👤 Cliente</option>
            <option value="monto" <%= sortBy === 'monto' ? 'selected' : '' %>>💰 Monto</option>
            <option value="deuda" <%= sortBy === 'deuda' ? 'selected' : '' %>>💸 Deuda</option>
            <option value="id" <%= sortBy === 'id' ? 'selected' : '' %>>🏷️ ID</option>
            <option value="estado" <%= sortBy === 'estado' ? 'selected' : '' %>>📌 Estado</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label fw-semibold">📍 Estado</label>
          <select name="estado" class="form-select">
            <option value="">Todos</option>
            <option value="PENDIENTE" <%= estadoActual === 'PENDIENTE' ? 'selected' : '' %>>📋 Pendiente</option>
            <option value="EN_PRODUCCION" <%= estadoActual === 'EN_PRODUCCION' ? 'selected' : '' %>>⚙️ En producción</option>
            <option value="LISTO" <%= estadoActual === 'LISTO' ? 'selected' : '' %>>✅ Listo</option>
            <option value="ENTREGADO" <%= estadoActual === 'ENTREGADO' ? 'selected' : '' %>>🎉 Entregado</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label fw-semibold">💰 Deuda</label>
          <select name="deuda" class="form-select">
            <option value="">Todos</option>
            <option value="con" <%= (typeof deuda !== 'undefined' && deuda === 'con') ? 'selected' : '' %>>Con deuda</option>
            <option value="sin" <%= (typeof deuda !== 'undefined' && deuda === 'sin') ? 'selected' : '' %>>Sin deuda</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label fw-semibold">📅 Hoy</label>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="hoy" id="hoy" value="1" <%= (typeof hoy !== 'undefined' && hoy === '1') ? 'checked' : '' %>>
            <label class="form-check-label" for="hoy">Solo entrega hoy</label>
          </div>
        </div>

        <div class="col-md-2">
          <label class="form-label fw-semibold">⬆️⬇️ Dirección</label>
          <select name="sortDir" class="form-select">
            <option value="desc" <%= sortDir === 'desc' ? 'selected' : '' %>>↓ Descendente</option>
            <option value="asc" <%= sortDir === 'asc' ? 'selected' : '' %>>↑ Ascendente</option>
          </select>
        </div>

        <div class="col-md-3">
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-funnel"></i> Filtrar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- SELECTOR DE VISTA -->
  <div class="mb-3">
    <div class="btn-group" role="group">
      <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=cards"
         class="btn <%= view === 'cards' ? 'btn-primary' : 'btn-outline-primary' %>">
        <i class="bi bi-grid-3x2-gap"></i> Tarjetas
      </a>
      <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=tabla"
         class="btn <%= (view === 'tabla' || !view) ? 'btn-primary' : 'btn-outline-primary' %>">
        <i class="bi bi-table"></i> Tabla
      </a>
      <a href="?search=<%= search %>&sortBy=<%= sortBy %>&sortDir=<%= sortDir %>&view=compacto"
         class="btn <%= view === 'compacto' ? 'btn-primary' : 'btn-outline-primary' %>">
        <i class="bi bi-list-ul"></i> Compacto
      </a>
    </div>
  </div>

  <!-- VISTA: TARJETAS -->
  <% if (view === 'cards' && pedidos && pedidos.length > 0) { %>
    <div class="row g-4">
      <% pedidos.forEach(p => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100 border-left" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-header bg-danger text-white">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Pedido #<%= p.id %></h5>
                <small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small>
              </div>
            </div>
            <div class="card-body">
              <p><strong>👤 Cliente:</strong> <%= p.cliente_nombre || 'N/A' %></p>
              <p><strong>🧑‍💼 Responsable:</strong> <%= p.username || '-' %></p>
              <p><strong>📅 Entrega:</strong> <%= p.fecha_entrega ? new Date(p.fecha_entrega).toLocaleDateString('es-AR') : 'No definida' %></p>
              <p><strong>📝 Detalle:</strong> 
                <% const textoDetalle = (p.detalle || '').trim(); %>
                <% if (!textoDetalle) { %>
                  <em>No definido</em>
                <% } else if (textoDetalle.length <= 120) { %>
                  <%= textoDetalle %>
                <% } else { %>
                  <span id="detalleCorto-<%= p.id %>"><%= textoDetalle.substring(0, 120) %>...</span>
                  <span id="detalleCompleto-<%= p.id %>" class="d-none"><%= textoDetalle %></span>
                  <a href="#" onclick="event.preventDefault(); document.getElementById('detalleCorto-<%= p.id %>').classList.toggle('d-none'); document.getElementById('detalleCompleto-<%= p.id %>').classList.toggle('d-none');">Ver más</a>
                <% } %>
              </p>
              <p><strong>💰 Total:</strong> <span class="text-primary fs-5">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span></p>
              <% if ((p.monto_entregado || 0) < (p.precio || 0)) { %>
                <p class="text-danger"><strong>⚠️ Deuda:</strong> $<%= ((p.precio || 0) - (p.monto_entregado || 0)).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></p>
              <% } else if ((p.precio || 0) > 0) { %>
                <p class="text-success"><strong>✓ Pagado</strong></p>
              <% } else { %>
                <p class="text-muted"><small>Sin precio definido</small></p>
              <% } %>
              <div class="mb-3">
                <small><strong>Productos:</strong></small>
                <div class="small text-muted" style="max-height: 100px; overflow-y: auto;">
                  <% p.productos.forEach((prod, idx) => { %>
                    <div>• <%= prod.material %></div>
                  <% }); %>
                </div>
              </div>
              <form action="/pedidos/<%= p.id %>/cambiar-estado" method="POST" class="mb-2">
                <select name="estado" class="form-select form-select-sm estado-select" data-estado="PENDIENTE"
                        onchange="confirmarCambioEstado(this, <%= p.id %>, <%= p.precio || 0 %>, <%= p.monto_entregado || 0 %>)">
                  <option value="PENDIENTE" selected>📋 Pendiente</option>
                  <option value="EN_PRODUCCION">⚙️ Producción</option>
                  <option value="LISTO">✅ Listo</option>
                  <option value="ENTREGADO">🎉 Entregado</option>
                </select>
              </form>
              <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary w-100">
                <i class="bi bi-eye"></i> Detalle
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- VISTA: TABLA (DEFAULT) -->
  <% if ((view === 'tabla' || !view) && pedidos && pedidos.length > 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>ID</th>
              <th>Cliente</th>
              <th>Fecha</th>
              <th>Entrega</th>
              <th>Detalle</th>
              <th>Estado</th>
              <th>Responsable</th>
              <th>Monto</th>
              <th>Deuda</th>
              <th>Productos</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% pedidos.forEach(p => { %>
            <tr>
              <td><strong>#<%= p.id %></strong></td>
              <td><%= p.cliente_nombre || 'N/A' %></td>
              <td><small><%= new Date(p.fecha).toLocaleDateString('es-AR') %></small></td>
              <td><small><%= p.fecha_entrega ? new Date(p.fecha_entrega).toLocaleDateString('es-AR') : '-' %></small></td>
              <td style="max-width: 240px;">
                <% const detalleTexto = (p.detalle || '').trim(); %>
                <% if (!detalleTexto) { %>
                  <span class="text-muted">No definido</span>
                <% } else if (detalleTexto.length <= 60) { %>
                  <%= detalleTexto %>
                <% } else { %>
                  <span><%= detalleTexto.substring(0,60) %>...</span>
                  <details><summary style="cursor:pointer; color:#0d6efd;">Ver más</summary><div><%= detalleTexto %></div></details>
                <% } %>
              </td>
              <td><span class="badge bg-secondary"><%= p.estado %></span></td>
              <td><%= p.username || '-' %></td>
              <td class="fw-bold">$<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
              <td>
                <% if (p.monto_restante > 0) { %>
                  <span class="text-danger">$<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span>
                <% } else { %>
                  <span class="text-success">Pagado</span>
                <% } %>
              </td>
              <td>
                <small>
                  <% p.productos.slice(0, 2).forEach(prod => { %>
                    <div>• <%= prod.material %></div>
                  <% }); %>
                  <% if (p.productos.length > 2) { %>
                    <small class="text-muted">+ <%= p.productos.length - 2 %> más</small>
                  <% } %>
                </small>
              </td>
              <td>
                <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Detalle</a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- VISTA: COMPACTO (LISTA) -->
  <% if (view === 'compacto' && pedidos && pedidos.length > 0) { %>
    <div class="list-group">
      <% pedidos.forEach(p => { %>
      <div class="list-group-item list-group-item-action">
        <div class="d-flex justify-content-between align-items-start">
          <div class="flex-grow-1">
            <h6 class="mb-1">
              <i class="bi bi-box"></i> Pedido #<%= p.id %> - <%= p.cliente_nombre || 'N/A' %>
            </h6>
            <small class="text-muted">
              <%= new Date(p.fecha).toLocaleDateString('es-AR') %> •
              $<%= (p.precio || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
              <% if (p.monto_restante > 0) { %>
                • 💰 Deuda: $<%= (p.monto_restante || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>
              <% } else { %>
                • <span class="text-success">✓ Pagado</span>
              <% } %>
            </small>
          </div>
          <div class="ms-3">
            <a href="/pedidos/detalle/<%= p.id %>" class="btn btn-sm btn-outline-primary">Ver</a>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  <% } %>

  <!-- SIN RESULTADOS -->
  <% if (pedidos && pedidos.length === 0) { %>
    <div class="alert alert-info text-center py-5">
      <i class="bi bi-inbox" style="font-size: 3rem; color: #0dcaf0;"></i>
      <p class="mt-3 mb-0"><strong>No hay trabajos pendientes</strong></p>
      <small class="text-muted">Intenta cambiar los filtros de búsqueda</small>
    </div>
  <% } %>

  <div class="mt-4">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Volver al Inicio
    </a>
  </div>
</div>

<!-- MODAL: Pedido con deuda al entregar -->
<div class="modal fade" id="modalEntregadoDeuda" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">💰 Pedido con deuda pendiente</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Este pedido tiene una deuda de <strong id="montoDeudaModal"></strong></p>
        <p>¿Deseás cobrar antes de marcar como entregado?</p>
      </div>
      <div class="modal-footer">
        <a id="btnCobrarModal" href="#" class="btn btn-success">💰 Cobrar ahora</a>
        <button id="btnEntregarSinCobrar" class="btn btn-warning">🎉 Entregar sin cobrar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      </div>
    </div>
  </div>
</div>

<script>
function confirmarCambioEstado(select, pedidoId, precio, montoEntregado) {
  if (select.value === 'ENTREGADO' && montoEntregado < precio) {
    const deuda = precio - montoEntregado;
    document.getElementById('montoDeudaModal').textContent =
      '$' + deuda.toLocaleString('es-AR', { minimumFractionDigits: 2 });
    document.getElementById('btnCobrarModal').href = '/pedidos/detalle/' + pedidoId;
    document.getElementById('btnEntregarSinCobrar').onclick = function() { select.form.submit(); };
    new bootstrap.Modal(document.getElementById('modalEntregadoDeuda')).show();
  } else {
    select.form.submit();
  }
}
</script>
