<!-- views/presupuestos/detalle.ejs - SIMPLIFICADO SIN SECCIONES INNECESARIAS -->
<style>
  @media print {
    .no-print { display: none !important; }
    body { font-size: 11pt; font-family: Arial, sans-serif; }
    .card { border: 1px solid #ccc !important; box-shadow: none !important; }
    .card-header { background-color: #eee !important; -webkit-print-color-adjust: exact; color: #000 !important; }
    table { font-size: 10pt; }
    .badge { border: 1px solid #333 !important; color: #000 !important; background: #eee !important; }
    h2, h4 { color: #000 !important; }
  }
</style>

<% if (typeof error !== 'undefined' && error && error.length) { %>
  <div class="alert alert-danger no-print alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle"></i>
    <%= Array.isArray(error) ? error.join('<br>') : error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if (typeof success !== 'undefined' && success && success.length) { %>
  <div class="alert alert-success no-print alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle"></i>
    <%= Array.isArray(success) ? success.join('<br>') : success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- MEMBRETE PROFESIONAL -->
<div class="text-center mb-4" style="border-bottom: 3px solid #333; padding-bottom: 1.5rem;">
  <h2 class="fw-bold mb-1" style="font-size: 1.8rem; letter-spacing: 1px;">Imprenta El Gráfico</h2>
  <p class="mb-0" style="font-size: 0.95rem;">Lopez y Planes 541, Orán - Salta</p>
  <p class="mb-2" style="font-size: 0.95rem; font-weight: bold;">Tel: 3878 22-4908</p>
  <div style="background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; display: inline-block; padding: 0.5rem 2rem; margin-top: 0.5rem;">
    <h4 class="mb-0 fw-bold text-uppercase" style="letter-spacing: 2px;">PRESUPUESTO N° <%= presupuesto.id %></h4>
    <p class="small text-muted mb-0">Fecha: <%= presupuesto.fecha_creacion ? new Date(presupuesto.fecha_creacion).toLocaleDateString('es-AR', {day:'2-digit',month:'2-digit',year:'numeric'}) : new Date().toLocaleDateString('es-AR', {day:'2-digit',month:'2-digit',year:'numeric'}) %></p>
  </div>
</div>

<!-- BOTONES DE ACCIÓN (sin imprimir) -->
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
  <h4>Detalle del Presupuesto</h4>
  <div class="d-flex gap-2">
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
      🖨️ Imprimir / PDF
    </button>
    <% if (presupuesto.telefono_cliente) {
      const tel = presupuesto.telefono_cliente.replace(/\D/g,'');
      const precio = presupuesto.precio_estimado ? '$' + Math.round(presupuesto.precio_estimado) : 'a definir';
      const msg = encodeURIComponent(
        `Hola ${presupuesto.nombre_cliente}, le enviamos el presupuesto:\n\n` +
        `💰 *Precio:* ${precio}\n` +
        `Para confirmar, responda este mensaje. ¡Gracias!`
      );
    %>
      <a href="https://wa.me/549<%= tel %>?text=<%= msg %>" target="_blank" class="btn btn-success btn-sm">
        📲 WhatsApp
      </a>
    <% } %>
  </div>
</div>

<!-- INFORMACIÓN PRINCIPAL -->
<div class="card mb-4">
  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-6">
        <p><strong>Cliente:</strong><br><%= presupuesto.nombre_cliente %></p>
        <% if (presupuesto.email_cliente) { %>
          <p><strong>Email:</strong> <%= presupuesto.email_cliente %></p>
        <% } %>
        <% if (presupuesto.telefono_cliente) { %>
          <p><strong>Teléfono:</strong> <%= presupuesto.telefono_cliente %></p>
        <% } %>
        <% if (presupuesto.username) { %>
          <p><small class="text-muted"><i class="bi bi-person"></i> <strong>Creado por:</strong> <%= presupuesto.username %></small></p>
        <% } %>
      </div>
      <div class="col-md-6 text-end">
        <form action="/presupuestos/<%= presupuesto.id %>/cambiar-estado" method="POST" class="mb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="form-label fw-bold">Estado:</label>
          <div class="d-flex gap-2">
            <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
              <option value="PENDIENTE" <% if (presupuesto.estado === 'PENDIENTE') { %>selected<% } %>>📋 PENDIENTE</option>
              <option value="ACEPTADO" <% if (presupuesto.estado === 'ACEPTADO') { %>selected<% } %>>✅ ACEPTADO</option>
              <option value="RECHAZADO" <% if (presupuesto.estado === 'RECHAZADO') { %>selected<% } %>>❌ RECHAZADO</option>
              <option value="CONVERTIDO" <% if (presupuesto.estado === 'CONVERTIDO') { %>selected<% } %>>🎯 CONVERTIDO</option>
            </select>
          </div>
        </form>
        <% if (presupuesto.usado) { %>
          <p><span class="badge bg-success">✔ Pedido creado</span></p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ITEMS DEL PRESUPUESTO -->
<% if (items && items.length > 0) { %>
  <div class="card mb-4">
    <div class="card-header bg-light">
      <h6 class="mb-0">📦 Ítems del Presupuesto</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th>Descripción</th>
              <th style="width: 80px;">Cantidad</th>
              <th style="width: 100px;">P.Unitario</th>
              <th style="width: 80px;">Descuento</th>
              <th style="width: 100px;">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
            <tr>
              <td><%= item.descripcion %></td>
              <td class="text-center"><%= parseFloat(item.cantidad).toFixed(2) %></td>
              <td class="text-end">$<%= (item.precio_unitario || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
              <td class="text-end">$<%= (item.descuento_item || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
              <td class="text-end"><strong>$<%= (item.subtotal || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- DETALLE Y ACLARACIONES -->
<% if (presupuesto.detalle) { %>
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h6 class="mb-0">📝 Detalle y Aclaraciones</h6>
    </div>
    <div class="card-body">
      <p><%= presupuesto.detalle %></p>
    </div>
  </div>
<% } %>

<!-- TOTAL Y TÉRMINOS -->
<div class="card mb-4">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6"></div>
      <div class="col-md-6 text-end">
        <% if (presupuesto.precio_extra && presupuesto.precio_extra > 0) { %>
          <h6>Items: $<%= (presupuesto.precio_estimado - presupuesto.precio_extra).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h6>
          <h6>Precio Extra: +$<%= presupuesto.precio_extra.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h6>
          <hr>
        <% } %>
        <h5>Precio Estimado:</h5>
        <h3 class="text-success">$<%= presupuesto.precio_estimado ? Math.round(presupuesto.precio_estimado).toLocaleString('es-AR') : '0.00' %></h3>
      </div>
    </div>
  </div>
</div>

<!-- TÉRMINOS Y CONDICIONES -->
<div class="mt-4 pt-3" style="border-top: 1px solid #dee2e6; font-size: 0.85rem; color: #666;">
  <div class="row">
    <div class="col-md-8">
      <strong>Condiciones:</strong>
      <ul class="mb-0 mt-1" style="padding-left: 1.2rem;">
        <li>Presupuesto válido por 7 días desde la fecha de emisión</li>
        <li>Se requiere 50% de seña al confirmar el trabajo</li>
        <li>Precios sujetos a variación sin previo aviso</li>
      </ul>
    </div>
    <div class="col-md-4 text-end">
      <div class="mt-3">
        <p class="mb-0"><strong style="color: #333;">Firma y aclaración del cliente:</strong></p>
        <div style="border-bottom: 1px solid #333; margin-top: 2rem; width: 100%; min-height: 3rem;"></div>
      </div>
    </div>
  </div>
</div>

<!-- BOTONES DE ACCIÓN (sin imprimir) -->
<div class="d-flex gap-2 no-print flex-wrap mt-4">
  <a href="/presupuestos" class="btn btn-secondary">← Volver</a>
  <button type="button" class="btn btn-info" onclick="estimarGanancia()">
    <i class="bi bi-robot"></i> Estimar Ganancia
  </button>
  <% if (!presupuesto.usado) { %>
    <a href="/presupuestos/<%= presupuesto.id %>/editar" class="btn btn-warning">
      ✏️ Editar
    </a>
    <form action="/presupuestos/<%= presupuesto.id %>/crear-pedido" method="POST" class="d-inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary" onclick="return confirm('¿Crear pedido desde este presupuesto?');">
        ✅ Crear Pedido
      </button>
    </form>
  <% } %>
  <form action="/presupuestos/<%= presupuesto.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este presupuesto?');">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-outline-danger">🗑️ Eliminar</button>
  </form>
</div>

<!-- MODAL: Estimar Ganancia -->
<div class="modal fade" id="modalEstimarGanancia" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title"><i class="bi bi-robot"></i> Análisis de Ganancia con IA</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="estimacionCargando" class="text-center py-4">
          <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Cargando...</span>
          </div>
          <p class="mt-2 text-muted">Analizando costos y precios...</p>
        </div>
        <div id="estimacionResultado" style="display: none;">
          <div class="row mb-3">
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Precio de Venta</p>
                  <h5 id="precioVentaText" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body">
                  <p class="text-muted mb-1">Costo Estimado</p>
                  <h5 id="costoEstimadoText" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <div class="card bg-success text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Ganancia Bruta</p>
                  <h5 id="gananciaBrutaText" class="mb-0">$0</h5>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-primary text-white">
                <div class="card-body">
                  <p class="text-white-50 mb-1">Margen Actual</p>
                  <h5 id="margenActualText" class="mb-0">0%</h5>
                </div>
              </div>
            </div>
          </div>

          <div class="card mb-3 border-warning">
            <div class="card-body">
              <p class="text-muted mb-2"><strong>Margen Recomendado:</strong> <span id="margenRecomendadoText">35%</span></p>
              <p class="text-muted mb-0"><strong>Precio Recomendado:</strong> <span id="precioRecomendadoText" class="text-success fs-5">$0</span></p>
            </div>
          </div>

          <div id="desgloseCostos" style="display: none;" class="card mb-3">
            <div class="card-header">
              <h6 class="mb-0">Desglose de Costos</h6>
            </div>
            <div class="card-body p-0">
              <div id="listaCostos"></div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">Análisis y Recomendaciones</h6>
            </div>
            <div class="card-body">
              <p id="analisisText" class="text-muted mb-0"></p>
            </div>
          </div>
        </div>
        <div id="estimacionError" style="display: none;" class="alert alert-danger mb-0"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script>
  let modalEstimar = new bootstrap.Modal(document.getElementById('modalEstimarGanancia'));

  async function estimarGanancia() {
    // Limpiar modal
    document.getElementById('estimacionCargando').style.display = 'block';
    document.getElementById('estimacionResultado').style.display = 'none';
    document.getElementById('estimacionError').style.display = 'none';

    modalEstimar.show();

    try {
      const response = await fetch('/api/ia/estimar-ganancia', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ presupuesto_id: <%= presupuesto.id %> })
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Error desconocido');
      }

      const data = response.json();

      data.then(d => {
        if (d.ok) {
          // Mostrar resultados
          document.getElementById('precioVentaText').textContent =
            '$' + d.precioActual.toLocaleString('es-AR', { minimumFractionDigits: 2 });
          document.getElementById('costoEstimadoText').textContent =
            '$' + d.costoEstimado.toLocaleString('es-AR', { minimumFractionDigits: 2 });
          document.getElementById('gananciaBrutaText').textContent =
            '$' + d.gananciaBruta.toLocaleString('es-AR', { minimumFractionDigits: 2 });
          document.getElementById('margenActualText').textContent = d.margenActual.toFixed(1) + '%';
          document.getElementById('margenRecomendadoText').textContent = d.margenRecomendado.toFixed(1) + '%';
          document.getElementById('precioRecomendadoText').textContent =
            '$' + d.precioRecomendado.toLocaleString('es-AR', { minimumFractionDigits: 0 });

          // Mostrar desglose de costos si existe
          if (d.detallesCosto && d.detallesCosto.length > 0) {
            const html = d.detallesCosto.map(c => `
              <div class="d-flex justify-content-between py-2 px-3 border-bottom">
                <span>${c.material} (${c.cantidad})</span>
                <strong>$${c.costoEstimado.toLocaleString('es-AR')}</strong>
              </div>
            `).join('');
            document.getElementById('listaCostos').innerHTML = html;
            document.getElementById('desgloseCostos').style.display = 'block';
          }

          // Mostrar análisis
          document.getElementById('analisisText').textContent = d.analisis;

          document.getElementById('estimacionCargando').style.display = 'none';
          document.getElementById('estimacionResultado').style.display = 'block';
        } else {
          throw new Error(d.error || 'Error en la respuesta');
        }
      });
    } catch (error) {
      console.error('Error:', error);
      document.getElementById('estimacionError').textContent = error.message || 'Error al estimar ganancia';
      document.getElementById('estimacionError').style.display = 'block';
      document.getElementById('estimacionCargando').style.display = 'none';
    }
  }
</script>
