<!-- views/presupuestos/editar.ejs - TOTALMENTE REESCRITO PARA PERMITIR EDICIÓN -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>✏️ Editar Presupuesto #<%= presupuesto.id %></h2>
    <a href="/presupuestos/<%= presupuesto.id %>" class="btn btn-outline-secondary">← Volver</a>
  </div>

  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= Array.isArray(error) ? error.join('<br>') : error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <form action="/presupuestos/<%= presupuesto.id %>/editar" method="POST">

    <!-- DATOS DEL CLIENTE -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">👤 Datos del Cliente</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Nombre *</label>
            <input type="text" name="nombre_cliente" class="form-control" value="<%= presupuesto.nombre_cliente %>" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Teléfono *</label>
            <input type="text" name="telefono_cliente" class="form-control" value="<%= presupuesto.telefono_cliente %>" required>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Email</label>
            <input type="email" name="email_cliente" class="form-control" value="<%= presupuesto.email_cliente || '' %>">
          </div>
        </div>
      </div>
    </div>

    <!-- ITEMS EDITABLES -->
    <div class="card mb-4">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0">📦 Ítems del Presupuesto</h5>
      </div>
      <div class="card-body">
        <div id="itemsContainer">
          <% if (items && items.length > 0) { %>
            <% items.forEach((item, index) => { %>
              <div class="card mb-3 itemCard">
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-6 mb-3">
                      <label class="form-label fw-bold">Descripción</label>
                      <input type="text" name="descripcion[]" class="form-control" value="<%= item.descripcion %>" required>
                    </div>
                    <div class="col-md-3 mb-3">
                      <label class="form-label fw-bold">Cantidad *</label>
                      <input type="number" name="cantidad[]" class="form-control cantidad" value="<%= item.cantidad %>" step="any" min="0.01" onchange="calcularSubtotal()" required>
                    </div>
                    <div class="col-md-3 mb-3">
                      <label class="form-label fw-bold">P.Unitario ($)</label>
                      <input type="number" name="precio_unitario[]" class="form-control precioUnitario" value="<%= item.precio_unitario %>" step="0.01" min="0" onchange="calcularSubtotal()" required>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-md-4 mb-3">
                      <label class="form-label fw-bold">Descuento ($)</label>
                      <input type="number" name="descuento_item[]" class="form-control descuentoItem" value="<%= item.descuento_item || 0 %>" step="0.01" min="0" onchange="calcularSubtotal()">
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label fw-bold">Subtotal</label>
                      <input type="text" class="form-control subtotalDisplay" value="$<%= (item.subtotal || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %>" readonly>
                    </div>
                    <div class="col-md-4 mb-3 d-flex align-items-end">
                      <button type="button" class="btn btn-outline-danger w-100" onclick="eliminarItem(this)">🗑️ Eliminar</button>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
        <button type="button" class="btn btn-outline-success" onclick="agregarItem()">
          ➕ Agregar Item
        </button>
      </div>
    </div>

    <!-- DETALLE Y ACLARACIONES -->
    <div class="card mb-4">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0">📝 Detalle y Aclaraciones</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-8 mb-3">
            <label class="form-label fw-bold">Notas / Aclaraciones (opcional)</label>
            <textarea name="detalle" class="form-control" rows="3" placeholder="Ej: Incluye diseño, espacio para logo, etc."><%= presupuesto.detalle || '' %></textarea>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Precio Extra ($)</label>
            <input type="number" name="precio_extra" class="form-control" step="0.01" value="<%= presupuesto.precio_extra || 0 %>" min="0" onchange="calcularSubtotal()" placeholder="0.00">
          </div>
        </div>
      </div>
    </div>

    <!-- TOTAL -->
    <div class="card mb-4 bg-light">
      <div class="card-body">
        <div class="row text-center">
          <div class="col-md-4">
            <h6 class="text-muted">Descuento Total</h6>
            <h3 class="text-warning">-$<span id="descuentoTotal">0.00</span></h3>
          </div>
          <div class="col-md-4">
            <h6 class="text-muted">Precio Extra</h6>
            <h3 class="text-info">+$<span id="precioExtraDisplay">0.00</span></h3>
          </div>
          <div class="col-md-4">
            <h6 class="text-muted">TOTAL</h6>
            <h3 class="text-success">$<span id="totalFinal"><%= (presupuesto.precio_estimado || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></span></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTONES -->
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary btn-lg px-5">
        ✅ Guardar Cambios
      </button>
      <a href="/presupuestos/<%= presupuesto.id %>" class="btn btn-outline-secondary btn-lg px-5">
        ❌ Cancelar
      </a>
    </div>
  </form>
</div>

<script>
  let itemCounter = <%= items ? items.length : 0 %>;

  function agregarItem() {
    itemCounter++;
    const idx = itemCounter;
    const html = `
      <div class="card mb-3 itemCard" id="item_${idx}">
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Buscar Producto (nombre/código)</label>
              <div class="position-relative">
                <input type="text"
                  class="form-control productoInput"
                  placeholder="Ej: Lona estándar o 001-T"
                  data-item="${idx}"
                  onkeyup="buscarProductosEditar(${idx})"
                  autocomplete="off">
                <input type="hidden" name="producto_id[]" class="productoIdHidden">
                <div class="dropdown-menu w-100 position-absolute"
                  style="display:none; top:100%; left:0; z-index:1000; max-height:200px; overflow-y:auto;"
                  id="dropdown_${idx}"></div>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Descripción *</label>
              <input type="text" name="descripcion[]" class="form-control descripcion" placeholder="Descripción del item" required>
            </div>
          </div>

          <div id="camposDinamicos_${idx}" class="row mb-3"></div>

          <div class="row">
            <div class="col-md-3">
              <label class="form-label fw-bold">Cantidad *</label>
              <input type="number" name="cantidad[]" class="form-control cantidad" value="1" step="any" min="0.01" required onchange="calcularSubtotal()">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-bold">P.Unitario ($) *</label>
              <input type="number" name="precio_unitario[]" class="form-control precioUnitario" step="0.01" min="0" required onchange="calcularSubtotal()">
            </div>
            <div class="col-md-2">
              <label class="form-label fw-bold">Descuento ($)</label>
              <input type="number" name="descuento_item[]" class="form-control descuentoItem" value="0" step="0.01" min="0" onchange="calcularSubtotal()">
            </div>
            <div class="col-md-2">
              <label class="form-label fw-bold">Subtotal</label>
              <input type="text" class="form-control subtotalDisplay" value="$0.00" readonly>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="button" class="btn btn-outline-danger w-100" onclick="eliminarItem(this)">🗑️ Eliminar</button>
            </div>
          </div>
        </div>
      </div>
    `;
    document.getElementById('itemsContainer').insertAdjacentHTML('beforeend', html);
  }

  async function buscarProductosEditar(itemNum) {
    const card = document.getElementById(`item_${itemNum}`);
    const input = card.querySelector('.productoInput');
    const dropdown = document.getElementById(`dropdown_${itemNum}`);
    const query = input.value.trim();

    if (query.length < 1) {
      dropdown.style.display = 'none';
      return;
    }

    try {
      const response = await fetch(`/api/autocomplete/productos?q=${encodeURIComponent(query)}`);
      const productos = await response.json();

      if (productos.length === 0) {
        dropdown.innerHTML = '<div class="dropdown-item text-muted">No hay productos encontrados</div>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = productos.map(p => `
        <button type="button" class="dropdown-item"
          onclick="seleccionarProductoEditar(${itemNum}, ${p.id}, '${p.nombre.replace(/'/g, "\\'")}', ${p.precio}, '${p.tipo}', '${p.unidad}')">
          <strong>[${p.codigo}]</strong> ${p.nombre}<br>
          <small class="text-muted">$${p.precio} - ${p.unidad}</small>
        </button>
      `).join('');
      dropdown.style.display = 'block';
    } catch (err) {
      console.error('Error buscando productos:', err);
    }
  }

  function seleccionarProductoEditar(itemNum, productoId, nombre, precio, tipo, unidad) {
    const card = document.getElementById(`item_${itemNum}`);
    const input = card.querySelector('.productoInput');
    const hiddenId = card.querySelector('.productoIdHidden');
    const dropdown = document.getElementById(`dropdown_${itemNum}`);

    input.value = nombre;
    hiddenId.value = productoId;
    dropdown.style.display = 'none';

    card.querySelector('.descripcion').value = nombre;
    card.querySelector('.precioUnitario').value = precio.toFixed(2);

    const dinamicos = document.getElementById(`camposDinamicos_${itemNum}`);
    dinamicos.innerHTML = '';

    if (tipo === 'lona') {
      dinamicos.innerHTML = `
        <div class="col-md-2">
          <label class="form-label fw-bold">Ancho (m) *</label>
          <input type="number" class="form-control ancho" step="0.01" min="0" required onchange="calcularSubtotal()" placeholder="0.00">
        </div>
        <div class="col-md-2">
          <label class="form-label fw-bold">Alto (m) *</label>
          <input type="number" class="form-control alto" step="0.01" min="0" required onchange="calcularSubtotal()" placeholder="0.00">
        </div>
        <div class="col-md-2">
          <label class="form-label fw-bold">Unidades *</label>
          <input type="number" class="form-control unidades" step="1" min="1" value="1" required onchange="calcularSubtotal()" placeholder="1">
        </div>
        <div class="col-md-6">
          <p class="text-muted small mt-3"><strong>📐 Tipo:</strong> Metro Cuadrado</p>
        </div>
      `;
    } else {
      dinamicos.innerHTML = `
        <div class="col-12">
          <p class="text-muted small"><strong>📦 Tipo:</strong> ${unidad}</p>
        </div>
      `;
    }

    card.querySelector('.cantidad').value = '1';
    calcularSubtotal();
  }

  function eliminarItem(btn) {
    btn.closest('.itemCard').remove();
    calcularSubtotal();
  }

  function calcularSubtotal() {
    let totalFinal = 0;
    let descuentoTotal = 0;

    document.querySelectorAll('.itemCard').forEach(card => {
      const dinamicos = card.querySelector('[id^="camposDinamicos_"]');
      const esMarcaLona = dinamicos && dinamicos.textContent.includes('Metro Cuadrado');

      let cantidad = 0;

      if (esMarcaLona) {
        const ancho = parseFloat(card.querySelector('.ancho')?.value) || 0;
        const alto = parseFloat(card.querySelector('.alto')?.value) || 0;
        const unidades = parseFloat(card.querySelector('.unidades')?.value) || 1;
        cantidad = (ancho * alto) * unidades;
      } else {
        cantidad = parseFloat(card.querySelector('.cantidad').value) || 0;
      }

      const precioUnitario = parseFloat(card.querySelector('.precioUnitario').value) || 0;
      const descuento = parseFloat(card.querySelector('.descuentoItem').value) || 0;

      const subtotal = (cantidad * precioUnitario) - descuento;
      card.querySelector('.subtotalDisplay').value = '$' + subtotal.toFixed(2);
      card.querySelector('.cantidad').value = cantidad.toFixed(2);

      totalFinal += subtotal;
      descuentoTotal += descuento;
    });

    // Agregar precio extra
    const precioExtra = parseFloat(document.querySelector('input[name="precio_extra"]')?.value) || 0;
    totalFinal += precioExtra;

    document.getElementById('descuentoTotal').textContent = descuentoTotal.toFixed(2);
    document.getElementById('precioExtraDisplay').textContent = precioExtra.toFixed(2);
    document.getElementById('totalFinal').textContent = totalFinal.toFixed(2);
  }

  // Calcular al cargar la página
  document.addEventListener('DOMContentLoaded', calcularSubtotal);

  // Cerrar dropdown al hacer clic fuera
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.position-relative')) {
      document.querySelectorAll('[id^="dropdown_"]').forEach(d => d.style.display = 'none');
    }
  });
</script>
