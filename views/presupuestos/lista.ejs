<div class="container py-4">
  <div class="mb-4">
    <h1 class="display-6 mb-2"><i class="bi bi-file-earmark-text"></i> Presupuestos</h1>
    <p class="text-muted">Gestión y seguimiento de presupuestos</p>
  </div>

  <div class="mb-4 d-flex justify-content-between align-items-center gap-3">
    <div class="flex-grow-1">
      <form action="/presupuestos" method="GET" class="row g-2">
        <div class="col-md-4">
          <input type="text" name="nombre" class="form-control" placeholder="Filtrar por nombre cliente..." 
                 value="<%= filtros?.nombre || '' %>">
        </div>
        <div class="col-md-3">
          <input type="date" name="fecha" class="form-control" 
                 value="<%= filtros?.fecha || '' %>">
        </div>
        <div class="col-md-3">
          <input type="text" name="busqueda" class="form-control" placeholder="Búsqueda rápida..." 
                 value="<%= filtros?.busqueda || '' %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-info w-100">
            <i class="bi bi-search"></i> Buscar
          </button>
        </div>
      </form>
    </div>
    <a href="/presupuestos/nuevo" class="btn btn-primary">
      <i class="bi bi-plus-circle"></i> Nuevo
    </a>
  </div>

  <% if (filtros && (filtros.nombre || filtros.fecha || filtros.busqueda)) { %>
    <div class="alert alert-info mb-3">
      <i class="bi bi-funnel"></i> Filtros activos: 
      <% if (filtros.nombre) { %> Nombre: <strong><%= filtros.nombre %></strong> <% } %>
      <% if (filtros.fecha) { %> Fecha: <strong><%= filtros.fecha %></strong> <% } %>
      <% if (filtros.busqueda) { %> Búsqueda: <strong><%= filtros.busqueda %></strong> <% } %>
      <a href="/presupuestos" class="ms-2">✕ Limpiar filtros</a>
    </div>
  <% } %>

  <% if (!presupuestos || presupuestos.length === 0) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> 
      <%= (filtros && (filtros.nombre || filtros.fecha || filtros.busqueda)) ? 
          'No hay presupuestos que coincidan con los filtros.' : 
          'No hay presupuestos registrados todavía.' %>
    </div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
      <thead class="table-dark">
        <tr>
          <th style="width: 60px;">#</th>
          <th>Cliente</th>
          <th>Teléfono</th>
          <th style="width: 100px;">Usuario</th>
          <th>Fecha</th>
          <th class="text-end">Precio</th>
          <th>Estado</th>
          <th style="width: 180px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% presupuestos.forEach(p => { %>
          <tr class="<%= p.estado === 'CONVERTIDO' ? 'text-muted' : (p.estado === 'RECHAZADO' ? 'table-danger' : '') %>">
            <td>
              <a href="/presupuestos/<%= p.id %>" class="btn btn-sm btn-outline-primary">
                #<%= p.id %>
              </a>
            </td>
            <td>
              <strong><%= p.nombre_cliente || 'Sin cliente' %></strong>
              <% if (p.email_cliente) { %>
                <br><small class="text-muted"><%= p.email_cliente %></small>
              <% } %>
            </td>
            <td><%= p.telefono_cliente || '-' %></td>
            <td><small><% if (p.username) { %><i class="bi bi-person"></i> <%= p.username %><% } else { %><em class="text-muted">-</em><% } %></small></td>
            <td><small><%= new Date(p.fecha_creacion).toLocaleDateString('es-AR') %></small></td>
            <td class="text-end">
              <strong>$<%= (parseFloat(p.precio_estimado) || 0).toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
            </td>
            <td>
              <% 
                let badgeClass = 'bg-warning text-dark';
                if (p.estado === 'ACEPTADO') badgeClass = 'bg-info';
                else if (p.estado === 'RECHAZADO') badgeClass = 'bg-danger';
                else if (p.estado === 'CONVERTIDO') badgeClass = 'bg-success';
              %>
              <span class="badge <%= badgeClass %>"><%= p.estado %></span>
              <% if (p.usado) { %>
                <span class="badge bg-success ms-1"><i class="bi bi-check"></i> Pedido #<%= p.id %></span>
              <% } %>
            </td>
            <td>
              <div class="btn-group btn-group-sm" role="group">
                <a href="/presupuestos/<%= p.id %>" class="btn btn-outline-primary" title="Ver detalle">
                  <i class="bi bi-eye"></i> Ver
                </a>
                <% if (!p.usado && p.estado !== 'RECHAZADO') { %>
                  <a href="/presupuestos/<%= p.id %>/editar" class="btn btn-outline-warning" title="Editar">
                    <i class="bi bi-pencil"></i>
                  </a>
                <% } %>
                <form action="/presupuestos/<%= p.id %>/eliminar" method="POST" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este presupuesto?');">
                  <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
