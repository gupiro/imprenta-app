<div class="container my-5">
  <h1 class="mb-4">Nuevo Presupuesto</h1>

  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-danger"><%= Array.isArray(error) ? error.join('<br>') : error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success && success.length) { %>
    <div class="alert alert-success"><%= Array.isArray(success) ? success.join('<br>') : success %></div>
  <% } %>

  <form action="/presupuestos/nuevo" method="POST" enctype="multipart/form-data" id="formPresupuesto">
    
    <!-- SECCIÓN 1: DATOS DEL CLIENTE -->
    <div class="card mb-4">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">👤 Datos del Cliente</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Buscar Cliente Existente (nombre o DNI)</label>
            <div class="position-relative">
              <input type="text" id="buscarClienteInput" class="form-control"
                     placeholder="Ej: Juan García o 20-12345678-1"
                     autocomplete="off" oninput="buscarClientes()">
              <input type="hidden" name="cliente_id" id="cliente_id">
              <div id="dropdownClientes" class="dropdown-menu w-100 position-absolute"
                   style="display:none; top:100%; left:0; z-index:1000; max-height:200px; overflow-y:auto;"></div>
            </div>
            <small class="text-muted">Escribe para buscar, o dejá vacío para cliente nuevo</small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Nombre del Cliente *</label>
            <input type="text" name="nombre_cliente" id="nombre_cliente" class="form-control" required placeholder="Nombre completo">
          </div>
        </div>
        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label">Teléfono *</label>
            <input type="text" name="telefono_cliente" id="telefono_cliente" class="form-control" required placeholder="Número">
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email_cliente" id="email_cliente" class="form-control" placeholder="Correo">
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">Archivo de Referencia</label>
            <input type="file" name="archivo_imagen" class="form-control" accept="image/*">
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 2: ITEMS DEL PRESUPUESTO -->
    <div class="card mb-4">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0">📦 Ítems del Presupuesto</h5>
      </div>
      <div class="card-body">
        <div id="itemsContainer">
          <!-- Los items se agregan dinámicamente aquí -->
        </div>
        <button type="button" class="btn btn-outline-success" onclick="agregarItem()">
          ➕ Agregar Item
        </button>
      </div>
    </div>

    <!-- SECCIÓN 3: DETALLE Y ACLARACIONES -->
    <div class="card mb-4">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0">📝 Detalle y Aclaraciones</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-8 mb-3">
            <label class="form-label">Notas / Aclaraciones (opcional)</label>
            <textarea name="detalle" class="form-control" rows="3" placeholder="Ej: Incluye diseño, espacio para logo, etc."></textarea>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">Precio Extra ($)</label>
            <input type="number" name="precio_extra" class="form-control" step="0.01" value="0" min="0" onchange="calcularTotales()" placeholder="0.00">
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 4: RESUMEN -->
    <div class="card mb-4 bg-light">
      <div class="card-body">
        <div class="row text-center">
          <div class="col-md-4">
            <h6 class="text-muted">Descuento Total</h6>
            <h3 class="text-warning">-$<span id="descuentoTotal">0.00</span></h3>
          </div>
          <div class="col-md-4">
            <h6 class="text-muted">Precio Extra</h6>
            <h3 class="text-info">+$<span id="precioExtraDisplay">0.00</span></h3>
          </div>
          <div class="col-md-4">
            <h6 class="text-muted">TOTAL</h6>
            <h3 class="text-success">$<span id="totalFinal">0.00</span></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTONES -->
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary btn-lg">
        ✅ Guardar Presupuesto
      </button>
      <a href="/presupuestos" class="btn btn-outline-secondary">Cancelar</a>
    </div>
  </form>
</div>

<script>
  let itemCounter = 0;

  function cargarClienteExistente() {
    const select = document.getElementById('cliente_id');
    const opt = select.options[select.selectedIndex];
    if (opt && opt.value) {
      document.getElementById('nombre_cliente').value = opt.dataset.name || '';
      document.getElementById('telefono_cliente').value = opt.dataset.phone || '';
      document.getElementById('email_cliente').value = opt.dataset.email || '';
    }
  }

  function agregarItem() {
    itemCounter++;
    const html = `
      <div class="card mb-3 itemCard" id="item_${itemCounter}">
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Buscar Producto (nombre/código)</label>
              <div class="position-relative">
                <input type="text"
                  class="form-control productoInput"
                  placeholder="Ej: Lona estándar o 001-T"
                  data-item="${itemCounter}"
                  onkeyup="buscarProductos(${itemCounter})"
                  autocomplete="off">
                <input type="hidden" name="producto_id[]" class="productoIdHidden">
                <div class="dropdown-menu w-100 position-absolute"
                  style="display:none; top:100%; left:0; z-index:1000; max-height:200px; overflow-y:auto;"
                  id="dropdown_${itemCounter}"></div>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Descripción *</label>
              <input type="text" name="descripcion[]" class="form-control descripcion" placeholder="Descripción del item" required>
            </div>
          </div>
          
          <div id="camposDinamicos_${itemCounter}" class="row mb-3"></div>

          <div class="row">
            <div class="col-md-3">
              <label class="form-label">Cantidad *</label>
              <input type="number" name="cantidad[]" class="form-control cantidad" value="1" min="0.01" step="any" required onchange="calcularSubtotal(${itemCounter})">
            </div>
            <div class="col-md-3">
              <label class="form-label">Precio Unitario ($) *</label>
              <input type="number" name="precio_unitario[]" class="form-control precioUnitario" step="0.01" min="0" required onchange="calcularSubtotal(${itemCounter})">
            </div>
            <div class="col-md-3">
              <label class="form-label">Descuento ($)</label>
              <input type="number" name="descuento_item[]" class="form-control descuentoItem" step="0.01" value="0" min="0" onchange="calcularSubtotal(${itemCounter})">
            </div>
            <div class="col-md-3">
              <label class="form-label">Subtotal</label>
              <input type="text" class="form-control subtotalItem" readonly placeholder="$0.00">
            </div>
          </div>

          <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="eliminarItem(${itemCounter})">
            🗑️ Eliminar Item
          </button>
        </div>
      </div>
    `;
    document.getElementById('itemsContainer').insertAdjacentHTML('beforeend', html);
  }

  async function buscarProductos(itemNum) {
    const card = document.getElementById(`item_${itemNum}`);
    const input = card.querySelector('.productoInput');
    const dropdown = document.getElementById(`dropdown_${itemNum}`);
    const query = input.value.trim();

    if (query.length < 1) {
      dropdown.style.display = 'none';
      return;
    }

    try {
      const response = await fetch(`/api/autocomplete/productos?q=${encodeURIComponent(query)}`);
      const productos = await response.json();

      if (productos.length === 0) {
        dropdown.innerHTML = '<div class="dropdown-item text-muted">No hay productos encontrados</div>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = productos.map(p => `
        <button type="button" class="dropdown-item"
          onclick="seleccionarProducto(${itemNum}, ${p.id}, '${p.nombre.replace(/'/g, "\\'")}', ${p.precio}, '${p.tipo}', '${p.unidad}')">
          <strong>[${p.codigo}]</strong> ${p.nombre}<br>
          <small class="text-muted">$${p.precio} - ${p.unidad}</small>
        </button>
      `).join('');
      dropdown.style.display = 'block';
    } catch (err) {
      console.error('Error buscando productos:', err);
    }
  }

  function seleccionarProducto(itemNum, productoId, nombre, precio, tipo, unidad) {
    const card = document.getElementById(`item_${itemNum}`);
    const input = card.querySelector('.productoInput');
    const hiddenId = card.querySelector('.productoIdHidden');
    const dropdown = document.getElementById(`dropdown_${itemNum}`);

    input.value = nombre;
    hiddenId.value = productoId;
    dropdown.style.display = 'none';

    // Establecer descripción con el nombre del producto
    card.querySelector('.descripcion').value = nombre;

    // Establecer precio unitario
    card.querySelector('.precioUnitario').value = precio.toFixed(2);

    // Limpiar campos dinámicos
    const dinamicos = document.getElementById(`camposDinamicos_${itemNum}`);
    dinamicos.innerHTML = '';

    // Agregar campos según tipo (LONA necesita Ancho x Alto)
    if (tipo === 'lona') {
      dinamicos.innerHTML = `
        <div class="col-md-2">
          <label class="form-label">Ancho (m) *</label>
          <input type="number" class="form-control ancho" step="0.01" min="0" required onchange="calcularSubtotal(${itemNum})" placeholder="0.00">
        </div>
        <div class="col-md-2">
          <label class="form-label">Alto (m) *</label>
          <input type="number" class="form-control alto" step="0.01" min="0" required onchange="calcularSubtotal(${itemNum})" placeholder="0.00">
        </div>
        <div class="col-md-2">
          <label class="form-label">Unidades *</label>
          <input type="number" class="form-control unidades" step="1" min="1" value="1" required onchange="calcularSubtotal(${itemNum})" placeholder="1">
        </div>
        <div class="col-md-4">
          <p class="text-muted small mt-3"><strong>📐 Tipo:</strong> Metro Cuadrado</p>
        </div>
      `;
    } else {
      dinamicos.innerHTML = `
        <div class="col-12">
          <p class="text-muted small"><strong>📦 Tipo:</strong> ${unidad}</p>
        </div>
      `;
    }

    card.querySelector('.cantidad').value = '1';
    calcularSubtotal(itemNum);
  }

  // Cerrar dropdown al hacer clic fuera
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.position-relative')) {
      document.querySelectorAll('.dropdown-menu').forEach(d => d.style.display = 'none');
    }
  });

  function calcularSubtotal(itemNum) {
    const card = document.getElementById(`item_${itemNum}`);
    const hiddenId = card.querySelector('.productoIdHidden');

    if (!hiddenId || !hiddenId.value) return;

    // Obtener el tipo desde el texto dinámico o la descripción
    const dinamicos = document.getElementById(`camposDinamicos_${itemNum}`);
    const esMarcaLona = dinamicos.textContent.includes('Metro Cuadrado');

    let cantidad = 1;

    if (esMarcaLona) {
      const ancho = parseFloat(card.querySelector('.ancho')?.value) || 0;
      const alto = parseFloat(card.querySelector('.alto')?.value) || 0;
      const unidades = parseFloat(card.querySelector('.unidades')?.value) || 1;
      cantidad = (ancho * alto) * unidades;
    } else {
      cantidad = Math.max(parseFloat(card.querySelector('.cantidad').value) || 1, 1);
    }

    const precioUnitario = parseFloat(card.querySelector('.precioUnitario').value) || 0;
    const descuento = parseFloat(card.querySelector('.descuentoItem').value) || 0;

    const subtotal = (cantidad * precioUnitario) - descuento;

    card.querySelector('.cantidad').value = cantidad.toFixed(2);
    card.querySelector('.precioUnitario').value = precioUnitario.toFixed(2);
    card.querySelector('.subtotalItem').value = '$' + subtotal.toFixed(2);

    calcularTotales();
  }

  function calcularTotales() {
    let totalFinal = 0;
    let descuentoTotal = 0;

    document.querySelectorAll('.itemCard').forEach(card => {
      const precioUnitario = parseFloat(card.querySelector('.precioUnitario').value) || 0;
      const cantidad = parseFloat(card.querySelector('.cantidad').value) || 0;
      const descuento = parseFloat(card.querySelector('.descuentoItem').value) || 0;

      const subtotal = (cantidad * precioUnitario) - descuento;
      totalFinal += subtotal;
      descuentoTotal += descuento;
    });

    // Agregar precio extra
    const precioExtra = parseFloat(document.querySelector('input[name="precio_extra"]')?.value) || 0;
    totalFinal += precioExtra;

    document.getElementById('descuentoTotal').textContent = descuentoTotal.toFixed(2);
    document.getElementById('precioExtraDisplay').textContent = precioExtra.toFixed(2);
    document.getElementById('totalFinal').textContent = totalFinal.toFixed(2);
  }

  function eliminarItem(itemNum) {
    document.getElementById(`item_${itemNum}`).remove();
    calcularTotales();
  }

  // Agregar primer item al cargar
  document.addEventListener('DOMContentLoaded', function() {
    agregarItem();
  });

  // ========== AUTOCOMPLETE DE CLIENTES ==========
  async function buscarClientes() {
    const query = document.getElementById('buscarClienteInput').value.trim();
    const dropdown = document.getElementById('dropdownClientes');

    if (query.length < 2) {
      dropdown.style.display = 'none';
      return;
    }

    try {
      const res = await fetch(`/api/autocomplete/clientes?q=${encodeURIComponent(query)}`);
      const clientes = await res.json();

      if (!clientes.length) {
        dropdown.innerHTML = '<div class="dropdown-item text-muted">No se encontraron clientes</div>';
        dropdown.style.display = 'block';
        return;
      }

      dropdown.innerHTML = clientes.map(c => `
        <button type="button" class="dropdown-item"
          onclick="seleccionarCliente(${c.id}, '${c.name.replace(/'/g, "\\'")}', '${(c.phone || '').replace(/'/g, "\\'")}', '${(c.email || '').replace(/'/g, "\\'")}')" style="text-align: left;">
          <strong>${c.name}</strong><br>
          <small class="text-muted">${c.cuit ? 'CUIT: ' + c.cuit + ' | ' : ''}${c.phone || 'Sin tel'}</small>
        </button>
      `).join('');
      dropdown.style.display = 'block';
    } catch (err) {
      console.error('Error buscando clientes:', err);
    }
  }

  function seleccionarCliente(id, nombre, telefono, email) {
    document.getElementById('cliente_id').value = id;
    document.getElementById('buscarClienteInput').value = nombre;
    document.getElementById('nombre_cliente').value = nombre;
    document.getElementById('telefono_cliente').value = telefono;
    document.getElementById('email_cliente').value = email;
    document.getElementById('dropdownClientes').style.display = 'none';
  }

  // Cerrar dropdown al hacer clic fuera
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#buscarClienteInput') && !e.target.closest('#dropdownClientes')) {
      document.getElementById('dropdownClientes').style.display = 'none';
    }
  });
</script>
