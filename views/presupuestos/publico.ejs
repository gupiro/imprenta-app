// routes/pedidos.js (fragmento modificado)

// Desde presupuesto: unificar catálogo público
router.get('/desde-presupuesto/:id', checkPermission, (req, res) => {
  const { id } = req.params;

  const presupuesto = db.prepare(
    `SELECT p.*, c.nombre AS producto_nombre, c.tipo, c.precio_base, c.minimo
       FROM presupuestos p
  LEFT JOIN catalogo_productos c ON p.producto_id = c.id
      WHERE p.id = ?`
  ).get(id);

  if (!presupuesto) {
    req.flash('error', 'Presupuesto no encontrado');
    return res.redirect('/presupuestos');
  }

  const clientes = db.prepare('SELECT * FROM clients ORDER BY id ASC').all();

  // Catálogo público unificado (productos + materials)
  const catalogo = db.prepare(
    `SELECT id,
            nombre AS name,
            tipo   AS tipoUnidad,
            precio_base AS price
       FROM catalogo_productos
      WHERE publico = 1
     UNION ALL
     SELECT id,
            name,
            tipo AS tipoUnidad,
            price
       FROM materials
      WHERE publico = 1
     ORDER BY name ASC`
  ).all();

  res.render('pedidos/nuevo', {
    title:      'Nuevo Pedido desde Presupuesto',
    clientes,
    catalogo,    // antes era `materiales`
    presupuesto,
    success:    req.flash('success'),
    error:      req.flash('error')
  });
});

// Formulario de Nuevo Pedido (unificado)
router.get('/nuevo', checkPermission, (req, res) => {
  const clientes = db.prepare('SELECT * FROM clients ORDER BY id ASC').all();

  // Mismo catálogo público unificado
  const catalogo = db.prepare(
    `SELECT id,
            nombre AS name,
            tipo   AS tipoUnidad,
            precio_base AS price
       FROM catalogo_productos
      WHERE publico = 1
     UNION ALL
     SELECT id,
            name,
            tipo AS tipoUnidad,
            price
       FROM materials
      WHERE publico = 1
     ORDER BY name ASC`
  ).all();

  res.render('pedidos/nuevo', {
    title:      'Nuevo Pedido',
    clientes,
    catalogo,   // reemplaza `materiales`
    success:    req.flash('success'),
    error:      req.flash('error')
  });
});
