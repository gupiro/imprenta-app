<!-- views/reportes/clientes.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1 class="display-6"><i class="bi bi-people-fill"></i> Reporte de Clientes</h1>
    </div>
  </div>

  <!-- TABLA DE CLIENTES -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <% if (clientes && clientes.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Total Pedidos</th>
                <th>Total Gastado</th>
                <th>Deuda</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% clientes.forEach(c => { %>
                <tr>
                  <td>
                    <strong><%= c.name %></strong>
                  </td>
                  <td><%= c.phone || '-' %></td>
                  <td><%= c.email || '-' %></td>
                  <td class="text-center">
                    <span class="badge bg-primary"><%= c.total_pedidos %></span>
                  </td>
                  <td>
                    <strong class="text-success">$<%= c.total_gastado.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
                  </td>
                  <td>
                    <% if (c.deuda > 0) { %>
                      <strong class="text-danger">$<%= c.deuda.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong>
                    <% } else { %>
                      <span class="badge bg-success">Pagado</span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/clientes/<%= c.id %>" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye"></i> Ver
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="mt-3 d-flex justify-content-between align-items-center">
          <small class="text-muted">Total de clientes: <%= clientes.length %></small>
          <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer"></i> Imprimir
          </button>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle"></i> No hay clientes registrados
        </div>
      <% } %>
    </div>
  </div>
</div>
