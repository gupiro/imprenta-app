<!-- views/reportes/deudores.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1 class="display-6"><i class="bi bi-cash-circle"></i> Reporte de Deudores</h1>
    </div>
  </div>

  <!-- RESUMEN -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body">
          <h6 class="card-title mb-2">Deuda Total</h6>
          <h2 class="mb-0">$<%= totalDeuda.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h2>
          <small><%= deudores.length %> deudores registrados</small>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA DE DEUDORES -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <% if (deudores && deudores.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Total Pedido</th>
                <th>Pagado</th>
                <th>Deuda</th>
                <th>% Deuda</th>
                <th>Días Pendientes</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% deudores.forEach(d => { %>
                <tr>
                  <td><strong>#<%= d.id %></strong></td>
                  <td><%= d.cliente_nombre || 'Sin nombre' %></td>
                  <td><%= d.phone || '-' %></td>
                  <td>$<%= d.precio.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                  <td>$<%= d.monto_entregado.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                  <td><strong class="text-danger">$<%= d.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong></td>
                  <td>
                    <% const pct = d.porcentaje_deuda || 0; %>
                    <div class="progress" style="height: 20px;">
                      <div class="progress-bar bg-danger" role="progressbar" style="width: <%= pct %>%" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
                        <%= pct %>%
                      </div>
                    </div>
                  </td>
                  <td>
                    <% const dias = d.dias_pendientes || 0; %>
                    <span class="badge <%= dias > 30 ? 'bg-danger' : dias > 7 ? 'bg-warning text-dark' : 'bg-info' %>">
                      <%= dias %> días
                    </span>
                  </td>
                  <td>
                    <a href="/pedidos/detalle/<%= d.id %>" class="btn btn-sm btn-danger">
                      <i class="bi bi-cash-coin"></i> Cobrar
                    </a>
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalCancelarDeuda" onclick="abrirModalCancelarDeuda(<%= d.id %>, '<%= d.cliente_nombre %>', <%= d.monto_restante %>)">
                      <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="mt-3 d-flex justify-content-between align-items-center">
          <small class="text-muted">Total de deudas: <%= deudores.length %></small>
          <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer"></i> Imprimir
          </button>
        </div>
      <% } else { %>
        <div class="alert alert-success mb-0">
          <i class="bi bi-check-circle"></i> ¡Excelente! No hay deudores registrados
        </div>
      <% } %>
    </div>
  </div>

  <!-- MODAL: Cancelar Deuda -->
  <div class="modal fade" id="modalCancelarDeuda" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-warning">
          <h5 class="modal-title">⚠️ Cancelar Deuda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>¿Deseas cancelar la deuda de <strong id="montoDeudaLabel"></strong> del cliente <strong id="clienteLabel"></strong>?</p>
          <div class="alert alert-warning">
            <small>Esta acción marcará el pedido como completamente pagado sin registrar el pago en Caja Diaria.</small>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="registrarPago" checked>
            <label class="form-check-label" for="registrarPago">
              Registrar como ingreso en Caja Diaria
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" onclick="confirmarCancelarDeuda()">
            <i class="bi bi-check-circle"></i> Cancelar Deuda
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let deudaAuCancelar = { pedidoId: null, monto: 0 };

    function abrirModalCancelarDeuda(pedidoId, cliente, monto) {
      deudaAuCancelar = { pedidoId, monto };
      document.getElementById('montoDeudaLabel').textContent =
        '$' + monto.toLocaleString('es-AR', { minimumFractionDigits: 2 });
      document.getElementById('clienteLabel').textContent = cliente || 'Sin nombre';
    }

    function confirmarCancelarDeuda() {
      if (!deudaAuCancelar.pedidoId) return;

      const registrarPago = document.getElementById('registrarPago').checked;

      fetch('/reportes/cancelar-deuda', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          pedidoId: deudaAuCancelar.pedidoId,
          monto: deudaAuCancelar.monto,
          registrarPago: registrarPago
        })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('modalCancelarDeuda')).hide();
          location.reload();
        } else {
          alert('Error: ' + (data.error || 'Unknown error'));
        }
      })
      .catch(e => alert('Error: ' + e));
    }
  </script>
</div>
