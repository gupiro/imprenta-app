<!-- views/reportes/deudores.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1 class="display-6"><i class="bi bi-cash-circle"></i> Reporte de Deudores</h1>
    </div>
  </div>

  <!-- RESUMEN -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body">
          <h6 class="card-title mb-2">Deuda Total</h6>
          <h2 class="mb-0">$<%= totalDeuda.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></h2>
          <small><%= deudores.length %> deudores registrados</small>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA DE DEUDORES -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <% if (deudores && deudores.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Total Pedido</th>
                <th>Pagado</th>
                <th>Deuda</th>
                <th>% Deuda</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% deudores.forEach(d => { %>
                <tr>
                  <td><strong>#<%= d.id %></strong></td>
                  <td><%= d.cliente_nombre || 'Sin nombre' %></td>
                  <td><%= d.phone || '-' %></td>
                  <td>$<%= d.precio.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                  <td>$<%= d.monto_entregado.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></td>
                  <td><strong class="text-danger">$<%= d.monto_restante.toLocaleString('es-AR', {minimumFractionDigits: 2}) %></strong></td>
                  <td>
                    <% const pct = d.porcentaje_deuda || 0; %>
                    <div class="progress" style="height: 20px;">
                      <div class="progress-bar bg-danger" role="progressbar" style="width: <%= pct %>%" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
                        <%= pct %>%
                      </div>
                    </div>
                  </td>
                  <td>
                    <a href="/pedidos/detalle/<%= d.id %>" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-eye"></i> Cobrar
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="mt-3 d-flex justify-content-between align-items-center">
          <small class="text-muted">Total de deudas: <%= deudores.length %></small>
          <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer"></i> Imprimir
          </button>
        </div>
      <% } else { %>
        <div class="alert alert-success mb-0">
          <i class="bi bi-check-circle"></i> ¡Excelente! No hay deudores registrados
        </div>
      <% } %>
    </div>
  </div>
</div>
