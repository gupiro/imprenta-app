<!-- views/reportes/productos.ejs -->
<div class="container-fluid py-0 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-1">
    <div class="col-md-12">
      <h5 class="mb-0" style="font-size: 1rem;"><i class="bi bi-bar-chart-steps"></i> Análisis ABC de Productos</h5>
      <p class="text-muted small mb-0" style="font-size: 0.75rem;">Identificar qué productos generan 80% de ingresos</p>
    </div>
  </div>

  <!-- SELECTOR DE PERÍODO -->
  <div class="row mb-2">
    <div class="col-md-12">
      <div class="btn-group w-100" role="group" style="gap: 2px;">
        <a href="?periodo=mes" class="btn btn-sm btn-outline-primary <%= periodo === 'mes' ? 'active' : '' %>">
          Mes
        </a>
        <a href="?periodo=trimestre" class="btn btn-sm btn-outline-primary <%= periodo === 'trimestre' ? 'active' : '' %>">
          Trimestre
        </a>
        <a href="?periodo=semestre" class="btn btn-sm btn-outline-primary <%= periodo === 'semestre' ? 'active' : '' %>">
          Semestre
        </a>
        <a href="?periodo=año" class="btn btn-sm btn-outline-primary <%= periodo === 'año' ? 'active' : '' %>">
          Año
        </a>
        <a href="?periodo=todo" class="btn btn-sm btn-outline-primary <%= periodo === 'todo' ? 'active' : '' %>">
          Todo
        </a>
      </div>
    </div>
  </div>

  <!-- RESUMEN ABC -->
  <div class="row mb-1">
    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">Total Productos</p>
          <h6 class="mb-0" style="font-size: 1rem;"><%= productosVentas.length %></h6>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">🟢 Clase A</p>
          <h6 class="mb-0 text-success" style="font-size: 1rem;"><%= conteoA %></h6>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">🟡 Clase B</p>
          <h6 class="mb-0 text-warning" style="font-size: 1rem;"><%= conteoB %></h6>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-1">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545;">
        <div class="card-body p-1">
          <p class="card-text text-muted mb-0" style="font-size: 0.7rem;">🔴 Clase C</p>
          <h6 class="mb-0 text-danger" style="font-size: 1rem;"><%= conteoC %></h6>
        </div>
      </div>
    </div>
  </div>

  <!-- GRÁFICOS REMOVIDOS POR PERFORMANCE -->
  <!-- Gráficos causaban auto-scroll al cargar dinámicamente -->

  <!-- TABLA COMPLETA -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-1">
          <h6 class="card-title mb-1" style="font-size: 0.75rem;">Listado ABC</h6>
          <% if (productosVentas.length === 0) { %>
            <div class="alert alert-info mb-0" style="font-size: 0.75rem; padding: 0.3rem;">
              Sin datos aún. Crea pedidos para ver el análisis.
            </div>
          <% } else { %>
            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
              <table class="table table-hover mb-0 sm" style="font-size: 0.75rem;">
                <thead class="table-light">
                  <tr>
                    <th style="width: 40px; padding: 0.2rem;">Rank</th>
                    <th style="padding: 0.2rem;">Producto</th>
                    <th style="width: 70px; padding: 0.2rem;">Pedidos</th>
                    <th style="width: 80px; padding: 0.2rem;">Unid.</th>
                    <th style="width: 100px; padding: 0.2rem;">Ventas</th>
                    <th style="width: 60px; padding: 0.2rem;">%</th>
                    <th style="width: 80px; padding: 0.2rem;">% Acum.</th>
                    <th style="width: 60px; padding: 0.2rem;">Clase</th>
                  </tr>
                </thead>
                <tbody>
                  <%
                    let ultimaClase = null;
                    for (let i = 0; i < productosVentas.length; i++) {
                      const p = productosVentas[i];
                      if (ultimaClase && ultimaClase !== p.clase) {
                  %>
                      <tr style="border-top: 2px solid #e0e0e0;"></tr>
                  <%
                      }
                  %>
                    <tr>
                      <td style="padding: 0.2rem;"><strong><%= p.rank %></strong></td>
                      <td style="padding: 0.2rem;"><%= p.producto %></td>
                      <td style="padding: 0.2rem;"><span class="badge bg-info" style="font-size: 0.65rem;"><%= p.pedidos_count %></span></td>
                      <td style="padding: 0.2rem;"><%= p.unidades_vendidas %></td>
                      <td style="padding: 0.2rem;"><strong>$<%= (p.ventas_totales || 0).toLocaleString('es-AR', {minimumFractionDigits: 0}) %></strong></td>
                      <td style="padding: 0.2rem;"><%= p.porcentaje.toFixed(1) %>%</td>
                      <td style="padding: 0.2rem;">
                        <div class="progress" style="height: 14px;">
                          <div class="progress-bar <%
                            let bgColor = 'bg-secondary';
                            if (p.clase === 'A') bgColor = 'bg-success';
                            else if (p.clase === 'B') bgColor = 'bg-warning';
                            else if (p.clase === 'C') bgColor = 'bg-danger';
                          %><%= bgColor %>"
                            style="width: <%= p.porcentaje_acumulado %>%; font-size: 0.6rem;"
                            role="progressbar">
                            <%= p.porcentaje_acumulado.toFixed(0) %>%
                          </div>
                        </div>
                      </td>
                      <td style="padding: 0.2rem;">
                        <% if (p.clase === 'A') { %>
                          <span class="badge bg-success" style="font-size: 0.6rem;">A</span>
                        <% } else if (p.clase === 'B') { %>
                          <span class="badge bg-warning text-dark" style="font-size: 0.6rem;">B</span>
                        <% } else { %>
                          <span class="badge bg-danger" style="font-size: 0.6rem;">C</span>
                        <% } %>
                      </td>
                    </tr>
                  <%
                      ultimaClase = p.clase;
                    }
                  %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- INFO -->
  <div class="row mt-2">
    <div class="col-md-12">
      <div class="alert alert-light border p-2" style="font-size: 0.8rem;">
        <strong style="font-size: 0.85rem;"><i class="bi bi-lightbulb"></i> Interpretación</strong>
        <ul class="mb-0" style="margin-left: 1.5rem;">
          <li><strong>A:</strong> 80% ingresos - Enfoque máximo</li>
          <li><strong>B:</strong> 15% ingresos - Mantener</li>
          <li><strong>C:</strong> 5% ingresos - Revisar</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Scripts de gráficos removidos por performance -->
