<!-- views/reportes/productos.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1 class="display-6"><i class="bi bi-bar-chart-steps"></i> Análisis ABC de Productos</h1>
      <p class="text-muted">Identificar qué productos generan 80% de ingresos (Regla de Pareto)</p>
    </div>
  </div>

  <!-- SELECTOR DE PERÍODO -->
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="btn-group w-100" role="group">
        <a href="?periodo=mes" class="btn btn-outline-primary <%= periodo === 'mes' ? 'active' : '' %>">
          <i class="bi bi-calendar3"></i> Mes
        </a>
        <a href="?periodo=trimestre" class="btn btn-outline-primary <%= periodo === 'trimestre' ? 'active' : '' %>">
          <i class="bi bi-calendar-month"></i> Trimestre
        </a>
        <a href="?periodo=semestre" class="btn btn-outline-primary <%= periodo === 'semestre' ? 'active' : '' %>">
          <i class="bi bi-calendar-range"></i> Semestre
        </a>
        <a href="?periodo=año" class="btn btn-outline-primary <%= periodo === 'año' ? 'active' : '' %>">
          <i class="bi bi-calendar2"></i> Año
        </a>
        <a href="?periodo=todo" class="btn btn-outline-primary <%= periodo === 'todo' ? 'active' : '' %>">
          <i class="bi bi-clock-history"></i> Todo
        </a>
      </div>
    </div>
  </div>

  <!-- RESUMEN ABC -->
  <div class="row mb-4">
    <div class="col-lg-3 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="card-text small text-muted mb-2">📊 Total Productos</p>
              <h4 class="mb-0"><%= productosVentas.length %></h4>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-3">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="card-text small text-muted mb-2">🟢 Clase A (80%)</p>
              <h4 class="mb-0 text-success"><%= conteoA %> productos</h4>
              <small class="text-success">Enfoque máximo</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-3">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="card-text small text-muted mb-2">🟡 Clase B (15%)</p>
              <h4 class="mb-0 text-warning"><%= conteoB %> productos</h4>
              <small class="text-warning">Mantener</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-3 mb-3">
      <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545;">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="card-text small text-muted mb-2">🔴 Clase C (5%)</p>
              <h4 class="mb-0 text-danger"><%= conteoC %> productos</h4>
              <small class="text-danger">Revisar</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GRÁFICOS -->
  <div class="row mb-4">
    <div class="col-lg-8 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-bar-chart"></i> Top 10 Productos por Ventas</h6>
          <canvas id="graficoTop10" style="height: 300px;"></canvas>
        </div>
      </div>
    </div>

    <div class="col-lg-4 mb-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-pie-chart"></i> Ingresos por Clase ABC</h6>
          <canvas id="graficoClases" style="height: 300px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA COMPLETA -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title"><i class="bi bi-table"></i> Listado Completo ABC</h6>
          <% if (productosVentas.length === 0) { %>
            <div class="alert alert-info mb-0">
              <i class="bi bi-info-circle"></i> Sin datos aún en este período. Crea pedidos para ver el análisis.
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>Producto</th>
                    <th style="width: 100px;">Pedidos</th>
                    <th style="width: 100px;">Unidades</th>
                    <th style="width: 120px;">Ventas ($)</th>
                    <th style="width: 80px;">% Total</th>
                    <th style="width: 100px;">% Acum.</th>
                    <th style="width: 80px;">Clase</th>
                  </tr>
                </thead>
                <tbody>
                  <%
                    let ultimaClase = null;
                    for (let i = 0; i < productosVentas.length; i++) {
                      const p = productosVentas[i];
                      if (ultimaClase && ultimaClase !== p.clase) {
                  %>
                      <tr style="border-top: 2px solid #e0e0e0;"></tr>
                  <%
                      }
                  %>
                    <tr>
                      <td><strong><%= p.rank %></strong></td>
                      <td><strong><%= p.producto %></strong></td>
                      <td><span class="badge bg-info"><%= p.pedidos_count %></span></td>
                      <td><%= p.unidades_vendidas %></td>
                      <td><strong>$<%= (p.ventas_totales || 0).toLocaleString('es-AR', {minimumFractionDigits: 0}) %></strong></td>
                      <td><%= p.porcentaje.toFixed(1) %>%</td>
                      <td>
                        <div class="progress" style="height: 20px;">
                          <div class="progress-bar <%
                            let bgColor = 'bg-secondary';
                            if (p.clase === 'A') bgColor = 'bg-success';
                            else if (p.clase === 'B') bgColor = 'bg-warning';
                            else if (p.clase === 'C') bgColor = 'bg-danger';
                          %><%= bgColor %>"
                            style="width: <%= p.porcentaje_acumulado %>%"
                            role="progressbar">
                            <%= p.porcentaje_acumulado.toFixed(0) %>%
                          </div>
                        </div>
                      </td>
                      <td>
                        <% if (p.clase === 'A') { %>
                          <span class="badge bg-success">🟢 A</span>
                        <% } else if (p.clase === 'B') { %>
                          <span class="badge bg-warning text-dark">🟡 B</span>
                        <% } else { %>
                          <span class="badge bg-danger">🔴 C</span>
                        <% } %>
                      </td>
                    </tr>
                  <%
                      ultimaClase = p.clase;
                    }
                  %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- INFO -->
  <div class="row mt-4">
    <div class="col-md-12">
      <div class="alert alert-light border">
        <h6><i class="bi bi-lightbulb"></i> Interpretación del Análisis ABC</h6>
        <ul class="mb-0 small">
          <li><strong>Clase A (80%):</strong> Estos productos generan el 80% de tus ingresos. Enfócate en mantenerlos, mejorar su disponibilidad y expandir su venta.</li>
          <li><strong>Clase B (15%):</strong> Productos medianos. Son importantes pero no requieren el mismo nivel de enfoque que los A.</li>
          <li><strong>Clase C (5%):</strong> Bajo rendimiento. Considera si valen la pena mantener en catálogo o si hay oportunidad de mejorar su venta.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  // Gráfico: Top 10 productos
  const ctx1 = document.getElementById('graficoTop10').getContext('2d');
  new Chart(ctx1, {
    type: 'bar',
    data: {
      labels: <%- top10Labels %>,
      datasets: [{
        label: 'Ventas ($)',
        data: <%- top10Datos %>,
        backgroundColor: '#0d6efd',
        borderRadius: 5
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { beginAtZero: true } }
    }
  });

  // Gráfico: Clases ABC
  const clasesData = <%- ingresosPorClase %>;
  const ctx2 = document.getElementById('graficoClases').getContext('2d');
  new Chart(ctx2, {
    type: 'doughnut',
    data: {
      labels: clasesData.map(d => d.label),
      datasets: [{
        data: clasesData.map(d => d.value),
        backgroundColor: clasesData.map(d => d.color)
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom' } }
    }
  });
</script>
