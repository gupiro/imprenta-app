<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0"><i class="bi bi-boxes me-2"></i>Stock de Materiales</h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevo">
    <i class="bi bi-plus-lg me-1"></i>Agregar Material
  </button>
</div>

<% const bajos = items.filter(i => i.cantidad <= i.stock_minimo) %>
<% if (bajos.length) { %>
  <div class="alert alert-danger d-flex align-items-center mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
    <strong><%= bajos.length %> material(es) por debajo del mínimo:</strong>
    &nbsp;<%= bajos.map(b => b.nombre).join(', ') %>
  </div>
<% } %>

<% if (!items.length) { %>
  <div class="alert alert-info">No hay materiales registrados todavía.</div>
<% } else { %>
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Material</th>
          <th>Unidad</th>
          <th>Stock actual</th>
          <th>Mínimo</th>
          <th>Costo unit.</th>
          <th>Proveedor</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
        <tr>
          <td class="fw-semibold"><%= item.nombre %></td>
          <td><%= item.unidad %></td>
          <td><%= item.cantidad %></td>
          <td><%= item.stock_minimo %></td>
          <td>$<%= (item.precio_costo || 0).toLocaleString('es-AR') %></td>
          <td><%= item.proveedor_nombre || '—' %></td>
          <td>
            <% if (item.cantidad <= item.stock_minimo) { %>
              <span class="badge bg-danger">Stock bajo</span>
            <% } else { %>
              <span class="badge bg-success">OK</span>
            <% } %>
          </td>
          <td>
            <button class="btn btn-sm btn-outline-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalEditar<%= item.id %>">
              <i class="bi bi-pencil"></i>
            </button>
            <form action="/stock/eliminar/<%= item.id %>" method="POST" class="d-inline"
                  onsubmit="return confirm('¿Eliminar este material?')">
              <button class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </td>
        </tr>

        <!-- Modal editar inline -->
        <div class="modal fade" id="modalEditar<%= item.id %>" tabindex="-1">
          <div class="modal-dialog modal-sm">
            <div class="modal-content">
              <form action="/stock/actualizar/<%= item.id %>" method="POST">
                <div class="modal-header">
                  <h6 class="modal-title">Actualizar: <%= item.nombre %></h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-2">
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Cantidad actual</label>
                    <input type="number" name="cantidad" step="0.01"
                           class="form-control" value="<%= item.cantidad %>" required>
                  </div>
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Stock mínimo</label>
                    <input type="number" name="stock_minimo" step="0.01"
                           class="form-control" value="<%= item.stock_minimo %>">
                  </div>
                  <div class="col-12">
                    <label class="form-label small fw-semibold">Costo unitario $</label>
                    <input type="number" name="precio_costo" step="0.01"
                           class="form-control" value="<%= item.precio_costo || 0 %>">
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="submit" class="btn btn-primary btn-sm w-100">Guardar</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Modal Nuevo Material -->
<div class="modal fade" id="modalNuevo" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/stock/nuevo" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Agregar Material</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body row g-3">
          <div class="col-12">
            <label class="form-label fw-semibold">Nombre *</label>
            <input type="text" name="nombre" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Unidad</label>
            <select name="unidad" class="form-select">
              <option value="unidad">Unidad</option>
              <option value="kg">Kg</option>
              <option value="metro">Metro</option>
              <option value="m2">m²</option>
              <option value="litro">Litro</option>
              <option value="resma">Resma</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Cantidad inicial</label>
            <input type="number" name="cantidad" step="0.01" class="form-control" value="0">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Stock mínimo</label>
            <input type="number" name="stock_minimo" step="0.01" class="form-control" value="0">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Costo unitario $</label>
            <input type="number" name="precio_costo" step="0.01" class="form-control" value="0">
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Proveedor</label>
            <select name="proveedor_id" class="form-select">
              <option value="">Sin proveedor</option>
              <% proveedores.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.nombre %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>
