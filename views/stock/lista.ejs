<!-- views/stock/lista.ejs -->
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-8">
      <h1 class="display-6"><i class="bi bi-boxes"></i> Gestión de Stock</h1>
    </div>
    <div class="col-md-4 text-end">
      <a href="/stock/nuevo-movimiento" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Movimiento
      </a>
      <a href="/stock/movimientos" class="btn btn-outline-secondary">
        <i class="bi bi-history"></i> Historial
      </a>
    </div>
  </div>

  <!-- RESUMEN -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title text-muted">📦 Artículos</h6>
          <h3 class="text-primary"><%= cantidadArticulos %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title text-muted">💰 Valor Total</h6>
          <h3 class="text-success">$<%= totalValor %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h6 class="card-title text-muted">⚠️  Stock Bajo</h6>
          <h3 class="text-danger"><%= articulosBajos %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- TABLA DE STOCK -->
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <% if (stocks && stocks.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr class="border-bottom">
                <th>Producto</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Stock Mínimo</th>
                <th>Precio Costo</th>
                <th>Valor Total</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% stocks.forEach(s => {
                const estado = s.cantidad <= s.stock_minimo ? 'danger' : (s.cantidad <= s.stock_minimo * 1.5 ? 'warning' : 'success');
                const statusText = s.cantidad <= s.stock_minimo ? 'Stock Bajo' : (s.cantidad <= s.stock_minimo * 1.5 ? 'Advertencia' : 'OK');
              %>
                <tr>
                  <td><strong><%= s.nombre %></strong></td>
                  <td><span class="badge bg-light text-dark"><%= s.tipo %></span></td>
                  <td>
                    <strong><%= s.cantidad %></strong>
                    <span class="text-muted">(<%= s.unidad %>)</span>
                  </td>
                  <td><%= s.stock_minimo %></td>
                  <td>$<%= (s.precio_costo || 0).toFixed(2) %></td>
                  <td>$<%= ((s.cantidad * s.precio_costo) || 0).toFixed(2) %></td>
                  <td>
                    <span class="badge bg-<%= estado %>"><%= statusText %></span>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAjuste" data-id="<%= s.id %>" data-cantidad="<%= s.cantidad %>">
                      <i class="bi bi-pencil"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-info mb-0">
          <i class="bi bi-info-circle"></i> No hay artículos en stock
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- MODAL: Ajuste de Stock -->
<div class="modal fade" id="modalAjuste" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/stock/ajustar/0">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title">Ajustar Stock</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Cantidad Actual</label>
            <input type="number" class="form-control" id="cantidadActual" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label">Nueva Cantidad</label>
            <input type="number" step="0.01" class="form-control" name="cantidad" required id="nuevaCantidad">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const modalAjuste = document.getElementById('modalAjuste');
  modalAjuste.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    const id = btn.getAttribute('data-id');
    const cantidad = btn.getAttribute('data-cantidad');
    
    document.getElementById('cantidadActual').value = cantidad;
    document.getElementById('nuevaCantidad').value = cantidad;
    
    modalAjuste.querySelector('form').action = '/stock/ajustar/' + id;
  });
</script>
