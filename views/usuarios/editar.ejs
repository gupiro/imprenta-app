<!-- views/usuarios/editar.ejs -->
<div class="container-fluid py-2 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-2">
    <div class="col-md-8">
      <h5 style="font-size: 1.2rem; margin-bottom: 0.5rem;"><i class="bi bi-pencil-square"></i> Editar Usuario</h5>
      <p class="text-muted small mb-0" style="font-size: 0.75rem;">Modifica los datos del usuario seleccionado</p>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <form method="POST" action="/usuarios/editar/<%= usuario.id %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">">

            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label" style="font-size: 0.9rem;"><strong>Nombre de Usuario</strong></label>
              <input type="text" class="form-control form-control-sm" id="username" name="username" value="<%= usuario.username %>" required style="font-size: 0.9rem;">
              <small class="form-text text-muted" style="font-size: 0.8rem;">El nombre único con que inicia sesión</small>
            </div>

            <!-- Rol -->
            <div class="mb-3">
              <label for="rol" class="form-label" style="font-size: 0.9rem;"><strong>Rol</strong></label>
              <select class="form-select form-select-sm" id="rol" name="rol" required style="font-size: 0.9rem;">
                <option value="">-- Seleccionar Rol --</option>
                <option value="admin" <%= usuario.rol === 'admin' ? 'selected' : '' %>>Admin (Acceso Total)</option>
                <option value="vendedor" <%= usuario.rol === 'vendedor' ? 'selected' : '' %>>Vendedor (Pedidos, Presupuestos, Reportes, Caja)</option>
                <option value="operador" <%= usuario.rol === 'operador' ? 'selected' : '' %>>Operador (Pedidos, Catálogo)</option>
                <option value="empleado" <%= usuario.rol === 'empleado' ? 'selected' : '' %>>Empleado (Pedidos, Presupuestos, Catálogo, Caja)</option>
                <option value="recepcionista" <%= usuario.rol === 'recepcionista' ? 'selected' : '' %>>Recepcionista (Pedidos, Presupuestos, Catálogo, Caja)</option>
              </select>
              <small class="form-text text-muted" style="font-size: 0.8rem;">Define los permisos del usuario en el sistema</small>
            </div>

            <!-- Password -->
            <div class="mb-3">
              <label for="password" class="form-label" style="font-size: 0.9rem;"><strong>Contraseña Nueva (Opcional)</strong></label>
              <input type="password" class="form-control form-control-sm" id="password" name="password" style="font-size: 0.9rem;">
              <small class="form-text text-muted" style="font-size: 0.8rem;">Dejar vacío si no deseas cambiar la contraseña. Mínimo 4 caracteres si se proporciona una nueva.</small>
            </div>

            <!-- Botones -->
            <div class="d-flex gap-2 mt-4">
              <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-check-lg"></i> Guardar Cambios
              </button>
              <a href="/usuarios" class="btn btn-sm btn-secondary">
                <i class="bi bi-x-lg"></i> Cancelar
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Información adicional -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-2">
          <h6 class="card-title mb-2" style="font-size: 0.85rem;"><i class="bi bi-info-circle"></i> Información</h6>
          <p class="card-text" style="font-size: 0.8rem; line-height: 1.4;">
            <strong>Usuario Actual:</strong> <%= usuario.username %><br>
            <strong>ID:</strong> <%= usuario.id %><br><br>
            <strong>Roles disponibles:</strong><br>
            • <span class="badge bg-danger" style="font-size: 0.65rem;">admin</span> - Acceso total<br>
            • <span class="badge bg-success" style="font-size: 0.65rem;">vendedor</span> - Ventas avanzadas<br>
            • <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">operador</span> - Solo producción<br>
            • <span class="badge bg-info" style="font-size: 0.65rem;">empleado</span> - Básico<br>
            • <span class="badge bg-primary" style="font-size: 0.65rem;">recepcionista</span> - Recepción
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

