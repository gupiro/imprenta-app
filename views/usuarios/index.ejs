<!-- views/usuarios/index.ejs -->
<div class="container-fluid py-2 px-1" style="max-height: calc(100vh - 100px); display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden;">
  <div class="row mb-2">
    <div class="col-md-12">
      <h5 style="font-size: 1.2rem; margin-bottom: 0.5rem;"><i class="bi bi-people"></i> Gestión de Usuarios</h5>
      <p class="text-muted small mb-1" style="font-size: 0.75rem;">Crear, editar y administrar usuarios del sistema</p>
    </div>
  </div>

  <!-- Botón nuevo usuario -->
  <div class="row mb-2">
    <div class="col-md-12">
      <a href="/usuarios/nuevo" class="btn btn-sm btn-primary">
        <i class="bi bi-person-plus"></i> Nuevo Usuario
      </a>
    </div>
  </div>

  <!-- Tabla de usuarios -->
  <div class="row">
    <div class="col-md-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-2">
          <h6 class="card-title mb-2" style="font-size: 0.85rem;">Usuarios del Sistema</h6>

          <% if (usuarios.length === 0) { %>
            <div class="alert alert-info mb-0" style="font-size: 0.8rem; padding: 0.5rem;">
              <i class="bi bi-info-circle"></i> No hay usuarios en el sistema
            </div>
          <% } else { %>
            <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
              <table class="table table-sm table-hover mb-0" style="font-size: 0.8rem;">
                <thead class="table-light sticky-top">
                  <tr>
                    <th style="width: 40px; padding: 0.3rem;">#</th>
                    <th style="padding: 0.3rem;">Usuario</th>
                    <th style="width: 130px; padding: 0.3rem;">Rol</th>
                    <th style="width: 140px; padding: 0.3rem;">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% usuarios.forEach((u, idx) => {
                    let rolColor = 'bg-secondary';
                    if (u.rol === 'admin') rolColor = 'bg-danger';
                    else if (u.rol === 'vendedor') rolColor = 'bg-success';
                    else if (u.rol === 'operador') rolColor = 'bg-warning';
                    else if (u.rol === 'empleado') rolColor = 'bg-info';
                    else if (u.rol === 'recepcionista') rolColor = 'bg-primary';
                  %>
                    <tr>
                      <td style="padding: 0.3rem;"><strong><%= u.id %></strong></td>
                      <td style="padding: 0.3rem;"><strong><%= u.username %></strong></td>
                      <td style="padding: 0.3rem;">
                        <span class="badge <%= rolColor %>" style="font-size: 0.7rem;">
                          <%= u.rol %>
                        </span>
                      </td>
                      <td style="padding: 0.3rem;">
                        <a href="/usuarios/editar/<%= u.id %>" class="btn btn-xs btn-outline-primary" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                          <i class="bi bi-pencil"></i> Editar
                        </a>
                        <button class="btn btn-xs btn-outline-danger" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;" onclick="eliminarUsuario(<%= u.id %>, '<%= u.username %>')">
                          <i class="bi bi-trash"></i> Eliminar
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function eliminarUsuario(id, nombre) {
    if (confirm(`¿Estás seguro de que deseas eliminar al usuario "${nombre}"? Esta acción no se puede deshacer.`)) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/usuarios/eliminar/${id}`;
      document.body.appendChild(form);
      form.submit();
    }
  }
</script>
