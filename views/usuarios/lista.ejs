
<h1 class="mb-4">👥 Gestión de Usuarios</h1>

<a href="/usuarios/registro" class="btn btn-primary mb-3">➕ Nuevo Usuario</a>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Usuario</th>
      <th>Rol</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% usuarios.forEach(user => { %>
      <tr>
        <td><strong><%= user.username %></strong></td>
        <td>
          <span class="badge bg-info"><%= user.rol %></span>
        </td>
        <td>
          <!-- Botón Cambiar Rol -->
          <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalCambiarRol"
                  onclick="setUserData('<%= user.id %>', '<%= user.username %>', '<%= user.rol %>')">
            🔄 Cambiar Rol
          </button>

          <!-- Botón Eliminar -->
          <form method="POST" action="/usuarios/eliminar/<%= user.id %>
                onsubmit="return confirm('¿Eliminar usuario <%= user.username %>? Esta acción no se puede deshacer.')">
            <button class="btn btn-sm btn-danger">🗑️ Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<!-- Modal para cambiar rol -->
<div class="modal fade" id="modalCambiarRol" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title">🔄 Cambiar Rol de Usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" id="formCambiarRol">
        <div class="modal-body">
          <p>Usuario: <strong id="usernameTxt"></strong></p>
          <p>Rol actual: <span class="badge bg-info" id="rolActual"></span></p>

          <div class="mb-3">
            <label class="form-label fw-bold">Nuevo Rol *</label>
            <select name="rol" class="form-select" required>
              <option value="">-- Seleccionar --</option>
              <option value="admin">Admin (Control Total)</option>
              <option value="vendedor">Vendedor (Ventas + Reportes)</option>
              <option value="operador">Operador (Producción)</option>
              <option value="empleado">Empleado (Empleado de Taller)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-warning">✅ Cambiar Rol</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function setUserData(id, username, rol) {
  document.getElementById('usernameTxt').textContent = username;
  document.getElementById('rolActual').textContent = rol;
  document.getElementById('formCambiarRol').action = '/usuarios/cambiar-rol/' + id;
}
</script>

