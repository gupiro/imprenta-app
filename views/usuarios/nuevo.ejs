
<h1>Nuevo Usuario</h1>
<form action="/usuarios/nuevo" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="mb-3">
    <label class="form-label">Usuario</label>
    <input name="username" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Contraseña</label>
    <input name="password" type="password" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Rol</label>
    <select name="rol" class="form-select" required>
      <option value="admin">👑 Admin (acceso total)</option>
      <option value="vendedor">📋 Vendedor (ventas y reportes)</option>
      <option value="operador">🖨️ Operador (solo producción)</option>
      <option value="empleado">👤 Empleado (pedidos y caja)</option>
      <option value="recepcionista">📞 Recepcionista (pedidos, presupuestos, caja)</option>
    </select>
  </div>
  <button class="btn btn-success">Crear</button>
</form>
